// 首批候选纯语法糖：降级后只保留基座 AST 形态。
import ast;
import desugar;
import diag;
import parse;
import parse_expr;
import types;

function emit_diag(diags: &diag::DiagBuffer:ReadWrite, code: u16, span: types::Span): void!AllocError {
    diag::diagbuf_emit(diags, diag::Diag { code: types::error_code(code), severity: 0, span: span, unit: 0, refs: diag::diag_refs_none(), args: diag::diag_args_none() })?;
    return;
}

// S-1：loop { B } 与 label: loop { B } 原位降级为 while true { B }。
function lower_loops(pool: &ast::AstPool:ReadWrite): void!AllocError {
    var s: u32 = 0;
    while s < @len(pool.stmts) as u32 {
        if pool.stmts[s].kind == 19 {
            let loop_id: u32 = pool.stmts[s].data;
            if loop_id < @len(pool.loops) as u32 {
                let lp: ast::LoopStmt = pool.loops[loop_id];
                let true_expr: u32 = @len(pool.exprs) as u32;
                @push(pool.exprs, ast::Expr { kind: 3, span: lp.span, data: 1u64, integer_suffix: 0 })?;
                let while_id: u32 = @len(pool.whiles) as u32;
                @push(pool.whiles, ast::WhileStmt { label: lp.label, condition: true_expr, body: lp.body, span: lp.span })?;
                pool.stmts[s].kind = 15;
                pool.stmts[s].data = while_id;
            }
        }
        s = s + 1;
    }
    pool.loops = [];
    return;
}

// S-8：消费候选解析器留下的动作标记，输出基座原语或 MoveArg。
function lower_chained_actions(pool: &ast::AstPool:ReadWrite, diags: &diag::DiagBuffer:ReadWrite): void!AllocError {
    var s: u32 = 0;
    while s < @len(pool.stmts) as u32 {
        if pool.stmts[s].kind == 13 {
            let expr_id: u32 = pool.stmts[s].data;
            if parse_expr::chained_action(&*pool:Read, expr_id) == 4 {
                let call_id: u32 = pool.exprs[expr_id].data as u32;
                if !pool.calls[call_id].grouped {
                    let mem_id: u32 = pool.exprs[pool.calls[call_id].callee].data as u32;
                    pool.stmts[s].kind = 18;
                    pool.stmts[s].span = pool.calls[call_id].span;
                    pool.stmts[s].data = pool.members[mem_id].object;
                    pool.calls[call_id].chain_action = 0;
                }
            }
        }
        s = s + 1;
    }

    // 调用池按后序登记：先降级内层动作，再决定外层调用的实参形式。
    var c: u32 = 0;
    while c < @len(pool.calls) as u32 {
        var a: u32 = 0;
        while a < @len(pool.calls[c].args) as u32 {
            let arg: ast::CallArg = pool.calls[c].args[a];
            if arg.kind == 0 && parse_expr::chained_action(&*pool:Read, arg.value) == 1 {
                let inner: u32 = pool.exprs[arg.value].data as u32;
                if inner < c && !pool.calls[inner].grouped && @len(pool.calls[inner].args) == 1 {
                    pool.calls[c].args[a].kind = 2;
                    pool.calls[c].args[a].value = pool.calls[inner].args[0].value;
                }
            }
            a = a + 1;
        }
        let act: u8 = pool.calls[c].chain_action;
        if act == 4 {
            emit_diag(diags, 2001u16, pool.calls[c].span)?;
        } elseif act != 0 {
            let callee: u32 = pool.calls[c].callee;
            let mem_id: u32 = pool.exprs[callee].data as u32;
            let receiver: u32 = pool.members[mem_id].object;
            var bid: u64 = 20481u64;
            if act == 2 { bid = 20482u64; }
            elseif act == 3 { bid = 20483u64; }
            pool.exprs[callee].kind = 29;
            pool.exprs[callee].data = bid;
            var args: ast::CallArg[] = [];
            @push(args, ast::CallArg { kind: 0, value: receiver, span: pool.exprs[receiver].span })?;
            pool.calls[c].args = @move(args);
        }
        c = c + 1;
    }
    c = 0;
    while c < @len(pool.calls) as u32 {
        pool.calls[c].chain_action = 0;
        pool.calls[c].grouped = false;
        c = c + 1;
    }
    return;
}

export function lower_stage1(parsed: &parse::ParseResult:ReadWrite, diags: &diag::DiagBuffer:ReadWrite): bool!AllocError {
    lower_loops(&parsed.pool:ReadWrite)?;
    lower_chained_actions(&parsed.pool:ReadWrite, diags)?;
    if diag::diagbuf_has_error(&*diags:Read) { return false; }
    return desugar::verify_stage1_candidate(&parsed.file:Read, &parsed.pool:Read, diags)?;
}
