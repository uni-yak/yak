// 构造 MIR 模块的静态数据、常量镜像与只读事实表。
import ast;
import consteval;
import diag;
import layout;
import lex;
import mir;
import typecheck;

// 把常量镜像字节写入静态池的 [start, start+size) 区间。调用方在写入前已把整区间
// 零填充，因此对齐 padding 与枚举未激活分支的 payload 自然保持零字节（const.md 2.7）。
// 尺寸、元素 stride、枚举 tag 宽与 payload 偏移一律取自 layout 单一真源：
// 定长数组 stride 用元素 LayoutInfo.size——聚合尺寸已向上对齐到自身 align，
// 故 align_up(size, align) == size，stride 即尺寸，此处是向真源取值而非重写公式。
// 返回 false 表示常量值与类型布局不一致，调用方必须按真实拒绝处理，不得写半截字节。
function write_const_mirror(bytes: &u8[]:ReadWrite, table: &layout::LayoutTable:Read, tc: &typecheck::TypeCheckResult:Read, start: u32, value: u32, value_type_id: u32, depth: u32): bool!AllocError {
    if depth > 16 { return false; }
    if value == 0 || value > @len(tc.consts.values) as u32 { return false; }
    if value_type_id == 0 || value_type_id > @len(tc.types.entries) as u32 { return false; }
    if value_type_id > @len(table.items) as u32 { return false; }
    let entry: typecheck::TypeEntry = tc.types.entries[value_type_id - 1];
    let info: layout::LayoutInfo = table.items[value_type_id - 1];
    if !info.known { return false; }
    let item: consteval::ConstValue = tc.consts.values[value - 1];
    if item.value_type_id != value_type_id { return false; }
    if item.kind == 1 || item.kind == 2 || item.kind == 3 {
        // 标量写入宽度即该类型在布局表里的尺寸（layout 单一真源，与 type_bytes 同源）。
        if info.size > 8 { return false; }
        var k: u64 = 0;
        while k < info.size {
            bytes[start + k as u32] = ((item.bits >> (k * 8u64)) & 255u64) as u8;
            k = k + 1;
        }
        return true;
    }
    if item.kind == 6 {
        if entry.kind != 7 { return false; }
        let count: u32 = item.children_count;
        if count == 0 || count as u64 != entry.length { return false; }
        if item.children_start > @len(tc.consts.children) as u32 || count > @len(tc.consts.children) as u32 - item.children_start { return false; }
        if entry.elem == 0 || entry.elem > @len(table.items) as u32 { return false; }
        let elem_info: layout::LayoutInfo = table.items[entry.elem - 1];
        if !elem_info.known || elem_info.size == 0 { return false; }
        let stride: u64 = elem_info.size;
        var i: u32 = 0;
        while i < count {
            let at: u64 = (stride * i as u64);
            if at > info.size || stride > info.size - at { return false; }
            // children 是 0 基下标区间，表内存放子常量值索引（1 基），按元素序连续排列。
            if !write_const_mirror(bytes, table, tc, start + at as u32, tc.consts.children[item.children_start + i], entry.elem, depth + 1)? { return false; }
            i = i + 1;
        }
        return true;
    }
    if item.kind == 5 {
        if entry.kind != 2 { return false; }
        var ei: u32 = 0;
        var i: u32 = 0;
        while i < @len(tc.enums.items) as u32 {
            if tc.enums.items[i].def == entry.def { ei = i + 1; break; }
            i = i + 1;
        }
        if ei == 0 { return false; }
        // 变体表经 &...:Read 借出：不得把数组字段整体绑定为局部（部分移动禁止），
        // 故按下标逐个取 payload 类型。
        let variant_count: u32 = @len(tc.enums.items[ei - 1].payloads) as u32;
        if item.variant >= variant_count { return false; }
        let tag_width: u64 = info.tag_size as u64;
        if tag_width == 0 || tag_width > info.size { return false; }
        var k: u64 = 0;
        while k < tag_width {
            bytes[start + k as u32] = ((item.variant as u64 >> (k * 8u64)) & 255u64) as u8;
            k = k + 1;
        }
        let payload: u32 = tc.enums.items[ei - 1].payloads[item.variant];
        if payload == 0 {
            if item.children_count != 0 { return false; }
            return true;
        }
        if item.children_count != 1 { return false; }
        if item.children_start >= @len(tc.consts.children) as u32 { return false; }
        if info.payload_off > info.size { return false; }
        let payload_info: layout::LayoutInfo = table.items[payload - 1];
        if !payload_info.known || payload_info.size > info.size - info.payload_off { return false; }
        return write_const_mirror(bytes, table, tc, start + info.payload_off as u32, tc.consts.children[item.children_start], payload, depth + 1)?;
    }
    return false;
}

// 深拷贝导入布局摘要与字段偏移：模块按值持有，不保留对检查阶段结果的视图。
export function copy_imported_layouts(src: &layout::ImportedLayoutTable:Read): layout::ImportedLayoutTable!AllocError {
    var dst: layout::ImportedLayoutTable = layout::ImportedLayoutTable { items: [] };
    var i: u32 = 0;
    while i < @len(src.items) as u32 { @push(dst.items, src.items[i])?; i = i + 1; }
    return dst;
}

// 模块常量预物化：在字符串条目之后，把检查阶段已求值的枚举与定长数组常量
// 按 layout 单一真源落成静态池里的聚合字节镜像，建立 DefId→static_index 映射。
// 数组序即 bindings 数组序（DefId 升序），同一常量多次引用只物化一次（按绑定条目）；
// 不去重、不排序，保证「同源码→同字节」的确定性（mir.md 七）。
// 返回 false 表示字节镜像与布局不一致或池规模超出可编码范围，调用方整体拒绝。
export function materialize_consts(module: &mir::MirModule:ReadWrite, tc: &typecheck::TypeCheckResult:Read, defs: u32, map: &u32[]:ReadWrite, lens: &u64[]:ReadWrite): bool!AllocError {
    var i: u32 = 0;
    while i < defs { @push(*map, 0)?; @push(*lens, 0u64)?; i = i + 1; }
    // 只有聚合常量需要布局；没有聚合绑定时不重复检查整个模块。
    var has_aggregate: bool = false;
    i = 0;
    while i < @len(tc.consts.bindings) as u32 {
        let value: u32 = tc.consts.bindings[i].value;
        if value == 0 || value > @len(tc.consts.values) as u32 { return false; }
        let kind: u8 = tc.consts.values[value - 1].kind;
        if kind == 5 || kind == 6 { has_aggregate = true; break; }
        i = i + 1;
    }
    if !has_aggregate { return true; }
    var scratch: diag::DiagBuffer = diag::diagbuf_new();
    let table: layout::LayoutTable = layout::layout_table_with_imports(&module.types:Read, &module.fields:Read, &module.enums:Read, &module.imported_layouts:Read, &module.imported_enums:Read, &scratch:ReadWrite)?;
    i = 0;
    while i < @len(tc.consts.bindings) as u32 {
        let binding: consteval::ConstBinding = tc.consts.bindings[i];
        if binding.value == 0 || binding.value > @len(tc.consts.values) as u32 { return false; }
        let item: consteval::ConstValue = tc.consts.values[binding.value - 1];
        // 标量、字符、布尔与 &[u8] 视图保持既有降级路径：字节镜像只覆盖 kind5/kind6。
        if item.kind != 5 && item.kind != 6 { i = i + 1; continue; }
        if binding.def == 0 || binding.def > defs { return false; }
        if !mir::aggregate_static_type(&module.types:Read, &module.enums:Read, binding.value_type_id) { return false; }
        if binding.value_type_id > @len(table.items) as u32 { return false; }
        let info: layout::LayoutInfo = table.items[binding.value_type_id - 1];
        if !info.known || info.size == 0 || info.size > 4294967295u64 { return false; }
        if item.value_type_id != binding.value_type_id { return false; }
        let offset: u64 = @len(module.static_bytes) as u64;
        if offset + info.size > 4294967295u64 { return false; }
        var pad: u64 = 0;
        while pad < info.size {
            @push(module.static_bytes, 0)?;
            pad = pad + 1;
        }
        if !write_const_mirror(&module.static_bytes:ReadWrite, &table:Read, tc, offset as u32, binding.value, binding.value_type_id, 0)? { return false; }
        @push(module.statics, mir::MirStatic { value_type_id: binding.value_type_id, offset: offset as u32, length: info.size as u32 })?;
        map[binding.def - 1] = @len(module.statics) as u32;
        lens[binding.def - 1] = info.size;
        i = i + 1;
    }
    return true;
}

export function copy_tables(module: &mir::MirModule:ReadWrite, tc: &typecheck::TypeCheckResult:Read): void!AllocError {
    var i: u32 = 0;
    while i < @len(tc.types.entries) as u32 { @push(module.types.entries, tc.types.entries[i])?; i = i + 1; }
    i = 0;
    while i < @len(tc.types.members) as u32 { @push(module.types.members, tc.types.members[i])?; i = i + 1; }
    i = 0;
    while i < @len(tc.funcs.items) as u32 {
        @push(module.signatures.items, typecheck::FuncSig { def: tc.funcs.items[i].def, params: [], ret: tc.funcs.items[i].ret, service: tc.funcs.items[i].service })?;
        var p: u32 = 0;
        while p < @len(tc.funcs.items[i].params) as u32 { @push(module.signatures.items[i].params, tc.funcs.items[i].params[p])?; p = p + 1; }
        i = i + 1;
    }
    i = 0;
    while i < @len(tc.funcs.by_def) as u32 {
        @push(module.signatures.by_def, tc.funcs.by_def[i])?;
        i = i + 1;
    }
    // 布局只依赖字段声明序及类型。复用字段表的存储结构时，清除前端的 NameId。
    i = 0;
    while i < @len(tc.fields.items) as u32 {
        @push(module.fields.items, typecheck::FieldType { def: tc.fields.items[i].def, name: 0, type_id: tc.fields.items[i].type_id })?;
        i = i + 1;
    }
    i = 0;
    while i < @len(tc.enums.items) as u32 {
        @push(module.enums.items, typecheck::EnumType { def: tc.enums.items[i].def, payloads: [] })?;
        var e: u32 = 0;
        while e < @len(tc.enums.items[i].payloads) as u32 { @push(module.enums.items[i].payloads, tc.enums.items[i].payloads[e])?; e = e + 1; }
        i = i + 1;
    }
    return;
}

// 把解析池的静态表与字节池复制进模块：const_bytes 的 static_index 直接索引 statics。
// 返回 false 表示静态区间越过字节池边界，调用方按结构错误拒绝。
export function copy_statics(pool: &ast::AstPool:Read, module: &mir::MirModule:ReadWrite, string_type: u32): bool!AllocError {
    var i: u32 = 0;
    while i < @len(pool.statics) as u32 {
        let entry: lex::StaticEntry = pool.statics[i];
        let offset: u32 = entry.offset;
        let length: u32 = entry.length;
        if offset > @len(pool.static_bytes) as u32 || length > @len(pool.static_bytes) as u32 - offset { return false; }
        @push(module.statics, mir::MirStatic { value_type_id: string_type, offset: offset, length: length })?;
        i = i + 1;
    }
    i = 0;
    while i < @len(pool.static_bytes) as u32 {
        @push(module.static_bytes, pool.static_bytes[i])?;
        i = i + 1;
    }
    return true;
}
