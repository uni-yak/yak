// 类型表、签名、引用类型解析和导入类型重映射。
import types;
import ast;
import diag;
import resolve;
import resolve_refs;
import consteval;
import buf;

const BUILTIN_U8: u16 = 4097;
const BUILTIN_U16: u16 = 4098;
const BUILTIN_U32: u16 = 4099;
const BUILTIN_U64: u16 = 4100;
const BUILTIN_I8: u16 = 4101;
const BUILTIN_I16: u16 = 4102;
const BUILTIN_I32: u16 = 4103;
const BUILTIN_I64: u16 = 4104;
const BUILTIN_BOOL: u16 = 4105;
const BUILTIN_CHAR: u16 = 4106;
const BUILTIN_VOID: u16 = 4107;

// TypeEntry.kind 固定值。
const TK_VOID: u8 = 0;
const TK_BUILTIN: u8 = 1;
const TK_LOCAL: u8 = 2;
const TK_IMPORTED: u8 = 3;
const TK_REF: u8 = 4;
const TK_SLICE: u8 = 5;
const TK_DYN_ARRAY: u8 = 6;
const TK_FIXED_ARRAY: u8 = 7;
const TK_FN_REF: u8 = 8;

const TK_FALLIBLE: u8 = 9;
const TK_NULLABLE: u8 = 10;
const TK_ERROR_SET: u8 = 11;
const TK_PLAIN_UNION: u8 = 12;
const TK_TEXT: u8 = 13;
const TK_TEXT_VIEW: u8 = 14;

export struct TypeEntry {
    kind: u8,
    builtin: u16,
    def: u32,
    dep: u16,
    export_id: u32,
    elem: u32,
    cap: u8,
    length: u64,
    success: u32,
    members_start: u32,
    members_count: u32,
}
export struct TypeTable { entries: TypeEntry[], members: u32[] }
// 文档声明和函数体各有独立的类型驻留预算，不参与类型身份或布局。
export struct InternBudget { limited: bool, remaining: u32, exhausted: bool, index_local: bool, local_types: u32[] }
export struct FuncSig { def: u32, params: u32[], ret: u32, service: u8 }
export struct FuncTable { items: FuncSig[], by_def: u32[] }
export struct DefTypeTable { items: u32[] }
export struct FieldType { def: u32, name: u32, type_id: u32 }
export struct FieldTable { items: FieldType[] }
export struct EnumType { def: u32, payloads: u32[] }
export struct EnumTable { items: EnumType[] }
export struct CtorFieldIds { fields: u32[] }
// 字段序号内部以一为基，零表示尚未绑定。构造字段保留求值顺序。
export struct ExprTypeTable { items: u32[], members: u32[], ctors: CtorFieldIds[] }
// 导入结构体字段的消费方规范类型：field 为 1 基声明序。
// 手工接口缺少字段签名时 type 为 0，调用方必须按未知失败关闭。
export struct ImportedFieldType { dep: u16, export_id: u32, field: u32, value_type_id: u32 }
export struct ImportedFieldTable { items: ImportedFieldType[] }
// 导入枚举变体：variant 为导出方声明序，payload 为消费方规范类型（0 表示无载荷）。
// known=false 表示接口缺少该变体签名，布局与 MIR 必须按未知拒绝。
export struct ImportedEnumVariant { dep: u16, export_id: u32, variant: u32, payload: u32, known: bool }
export struct ImportedEnumTable { items: ImportedEnumVariant[] }
export struct CopyFacts { items: u8[] }
export struct TypeCheckResult { types: TypeTable, funcs: FuncTable, def_types: DefTypeTable, fields: FieldTable, enums: EnumTable, expr_types: ExprTypeTable, consts: consteval::ConstTable, imported_fields: ImportedFieldTable, imported_enums: ImportedEnumTable, copy_facts: CopyFacts }

// 按依赖序和导出身份组成保持字典序的键。
// 按宿主类型确认拼写，结构体的同名字段仍走正常成员解析。
export function array_property(tt: &TypeTable:Read, object_type: u32, spelling: u8): u8 {
    if spelling == 0 || object_type == 0 || object_type > @len(tt.entries) as u32 { return 0; }
    var host: u32 = object_type;
    if tt.entries[host - 1].kind == TK_REF { host = tt.entries[host - 1].elem; }
    if host == 0 || host > @len(tt.entries) as u32 { return 0; }
    let kind: u8 = tt.entries[host - 1].kind;
    if (spelling == 1 && (kind == TK_SLICE || kind == TK_DYN_ARRAY)) || (spelling == 2 && kind == TK_DYN_ARRAY) {
        return spelling;
    }
    return 0;
}

export function expr_array_property(tt: &TypeTable:Read, expr_types: &ExprTypeTable:Read, pool: &ast::AstPool:Read, expr: u32): u8 {
    if expr >= @len(pool.exprs) as u32 || pool.exprs[expr].kind != 23 { return 0; }
    let idx: u32 = pool.exprs[expr].data as u32;
    if idx >= @len(pool.members) as u32 { return 0; }
    let member: ast::MemberExpr = pool.members[idx];
    if member.object >= @len(expr_types.items) as u32 { return 0; }
    return array_property(tt, expr_types.items[member.object], member.property);
}

export function emit(diags: &diag::DiagBuffer:ReadWrite, code: types::ErrorCode, span: types::Span): void!AllocError {
    diag::diagbuf_emit(diags, diag::Diag { code: code, severity: 0, span: span, unit: 0, refs: diag::diag_refs_none(), args: diag::diag_args_none() })?;
    return;
}
export function new_table(): TypeTable { return TypeTable { entries: [], members: [] }; }
export function intern_budget(limit: u32): InternBudget {
    return InternBudget { limited: limit != 0u32, remaining: limit, exhausted: false, index_local: false, local_types: [] };
}
// 仅用于从空规范类型表开始、且声明阶段所有本地名义类型均经同一工作区驻留的入口。
export function declaration_intern_budget(limit: u32): InternBudget {
    return InternBudget { limited: limit != 0u32, remaining: limit, exhausted: false, index_local: true, local_types: [] };
}
export function document_intern_budget(limit: u32): InternBudget {
    if limit == 0 { return intern_budget(0); }
    return declaration_intern_budget(limit);
}
export function release_intern_index(work: &InternBudget:ReadWrite): void {
    if work.index_local { work.local_types = []; work.index_local = false; }
    return;
}
function charge_intern(work: &InternBudget:ReadWrite, steps: u32): bool {
    if !work.limited { return true; }
    if work.exhausted { return false; }
    if steps > work.remaining { work.exhausted = true; return false; }
    work.remaining = work.remaining - steps;
    return true;
}
function push_type(tt: &TypeTable:ReadWrite, entry: TypeEntry): u32!AllocError {
    let id: u32 = @len(tt.entries) as u32 + 1;
    @push(tt.entries, entry)?;
    return id;
}
export function intern_builtin(tt: &TypeTable:ReadWrite, builtin: u16): u32!AllocError {
    var i: u32 = 0;
    if builtin == BUILTIN_VOID {
        while i < @len(tt.entries) as u32 {
            if tt.entries[i].kind == TK_VOID { return i + 1; }
            i = i + 1;
        }
        return push_type(tt, TypeEntry { kind: TK_VOID, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    }
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_BUILTIN && tt.entries[i].builtin == builtin { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_BUILTIN, builtin: builtin, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_builtin_limited(tt: &TypeTable:ReadWrite, builtin: u16, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_builtin(tt, builtin)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    if builtin == BUILTIN_VOID {
        while i < @len(tt.entries) as u32 {
            if work.limited && !charge_intern(work, 1u32) { return 0; }
            if tt.entries[i].kind == TK_VOID { return i + 1; }
            i = i + 1;
        }
        return push_type(tt, TypeEntry { kind: TK_VOID, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    }
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_BUILTIN && tt.entries[i].builtin == builtin { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_BUILTIN, builtin: builtin, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_local(tt: &TypeTable:ReadWrite, def: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_LOCAL && tt.entries[i].def == def { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_LOCAL, builtin: 0, def: def, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_local_limited(tt: &TypeTable:ReadWrite, def: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited && !work.index_local { return intern_local(tt, def)?; }
    if work.exhausted { return 0; }
    if work.index_local && def != 0u32 {
        if !charge_intern(work, 1u32) { return 0; }
        var slots: u32 = @len(work.local_types) as u32;
        if def > slots {
            if !charge_intern(work, def - slots) { return 0; }
            while slots < def {
                @push(work.local_types, 0u32)?;
                slots = slots + 1u32;
            }
        }
        let found: u32 = work.local_types[def - 1u32];
        if found != 0u32 { return found; }
        // 前向引用仍按首次遇到的顺序驻留；定义编号只用于定位索引槽。
        let id: u32 = push_type(tt, TypeEntry { kind: TK_LOCAL, builtin: 0, def: def, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
        work.local_types[def - 1u32] = id;
        return id;
    }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_LOCAL && tt.entries[i].def == def { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_LOCAL, builtin: 0, def: def, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_imported(tt: &TypeTable:ReadWrite, dep: u16, export_id: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_IMPORTED && tt.entries[i].dep == dep && tt.entries[i].export_id == export_id { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_IMPORTED, builtin: 0, def: 0, dep: dep, export_id: export_id, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_imported_limited(tt: &TypeTable:ReadWrite, dep: u16, export_id: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_imported(tt, dep, export_id)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_IMPORTED && tt.entries[i].dep == dep && tt.entries[i].export_id == export_id { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_IMPORTED, builtin: 0, def: 0, dep: dep, export_id: export_id, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_ref(tt: &TypeTable:ReadWrite, cap: u8, elem: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_REF && tt.entries[i].cap == cap && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_REF, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: cap, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_ref_limited(tt: &TypeTable:ReadWrite, cap: u8, elem: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_ref(tt, cap, elem)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_REF && tt.entries[i].cap == cap && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_REF, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: cap, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_slice(tt: &TypeTable:ReadWrite, cap: u8, elem: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_SLICE && tt.entries[i].cap == cap && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_SLICE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: cap, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_slice_limited(tt: &TypeTable:ReadWrite, cap: u8, elem: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_slice(tt, cap, elem)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_SLICE && tt.entries[i].cap == cap && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_SLICE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: cap, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_dyn_array(tt: &TypeTable:ReadWrite, elem: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_DYN_ARRAY && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_DYN_ARRAY, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_dyn_array_limited(tt: &TypeTable:ReadWrite, elem: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_dyn_array(tt, elem)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_DYN_ARRAY && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_DYN_ARRAY, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_fixed_array(tt: &TypeTable:ReadWrite, elem: u32, length: u64): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_FIXED_ARRAY && tt.entries[i].elem == elem && tt.entries[i].length == length { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_FIXED_ARRAY, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: length, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_fixed_array_limited(tt: &TypeTable:ReadWrite, elem: u32, length: u64, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_fixed_array(tt, elem, length)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_FIXED_ARRAY && tt.entries[i].elem == elem && tt.entries[i].length == length { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_FIXED_ARRAY, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: length, success: 0, members_start: 0, members_count: 0 })?;
}
export function intern_nullable(tt: &TypeTable:ReadWrite, elem: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_NULLABLE && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_NULLABLE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}

export function nullable_payload(tt: &TypeTable:Read, id: u32): u32 {
    if id == 0 || id > @len(tt.entries) as u32 || tt.entries[id - 1].kind != TK_NULLABLE { return 0; }
    return tt.entries[id - 1].elem;
}

export function nullable_payload_allowed(tt: &TypeTable:Read, id: u32): bool {
    if id == 0 || id > @len(tt.entries) as u32 { return false; }
    let kind: u8 = tt.entries[id - 1].kind;
    return kind == TK_BUILTIN || kind == TK_LOCAL || kind == TK_IMPORTED || kind == TK_DYN_ARRAY || kind == TK_FIXED_ARRAY || kind == TK_FALLIBLE || kind == TK_TEXT;
}

export function borrowed_text(tt: &TypeTable:Read, id: u32): bool {
    return id != 0 && id <= @len(tt.entries) as u32 && tt.entries[id - 1].kind == TK_TEXT_VIEW;
}

export function owned_text(tt: &TypeTable:Read, id: u32): bool {
    return id != 0 && id <= @len(tt.entries) as u32 && tt.entries[id - 1].kind == TK_TEXT;
}

export function intern_text(tt: &TypeTable:ReadWrite, borrowed: bool): u32!AllocError {
    var work: InternBudget = intern_budget(0);
    return intern_text_limited(tt, borrowed, &work:ReadWrite)?;
}

function intern_text_limited(tt: &TypeTable:ReadWrite, borrowed: bool, work: &InternBudget:ReadWrite): u32!AllocError {
    var kind: u8 = TK_TEXT;
    if borrowed { kind = TK_TEXT_VIEW; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if !charge_intern(work, 1) { return 0; }
        if tt.entries[i].kind == kind { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: kind, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}

export function plain_union_type(tt: &TypeTable:Read, id: u32): bool {
    return id != 0 && id <= @len(tt.entries) as u32 && tt.entries[id - 1].kind == TK_PLAIN_UNION;
}

export function plain_union_member(tt: &TypeTable:Read, id: u32, member: u32): bool {
    if !plain_union_type(tt, id) || member == 0 { return false; }
    let entry: TypeEntry = tt.entries[id - 1];
    var i: u32 = 0;
    while i < entry.members_count {
        if tt.members[entry.members_start + i] == member { return true; }
        i = i + 1;
    }
    return false;
}

struct UnionKey { type_id: u32, offset: u32, end: u32 }

// 按 TypeSig 的结构和小端字段编码比较单元内的具体类型；本地名义先用已解析 DefId。
// 发射公开签名时需要按目标导出编号与依赖表重新编码，不能把这些键写入接口。
function union_key(tt: &TypeTable:Read, bytes: &buf::ByteBuf:ReadWrite, id: u32, depth: u32, work: &InternBudget:ReadWrite): bool!AllocError {
    if id == 0 || id > @len(tt.entries) as u32 || depth > resolve_refs::signature_depth_limit() || !charge_intern(work, 1) { return false; }
    let entry: TypeEntry = tt.entries[id - 1];
    let kind: u8 = entry.kind;
    if kind == TK_VOID || kind == TK_BUILTIN {
        buf::buf_push_u8(bytes, 1)?;
        var builtin: u16 = entry.builtin;
        if kind == TK_VOID { builtin = BUILTIN_VOID; }
        buf::buf_push_u16(bytes, builtin)?;
        buf::buf_push_u16(bytes, 0)?;
    } elseif kind == TK_LOCAL || kind == TK_IMPORTED {
        buf::buf_push_u8(bytes, kind)?;
        if kind == TK_LOCAL { buf::buf_push_u32(bytes, entry.def)?; }
        else { buf::buf_push_u16(bytes, entry.dep)?; buf::buf_push_u32(bytes, entry.export_id)?; }
        buf::buf_push_u16(bytes, 0)?;
    } elseif kind == TK_FIXED_ARRAY || kind == TK_DYN_ARRAY || kind == TK_REF || kind == TK_SLICE || kind == TK_NULLABLE {
        var tag: u8 = 11;
        if kind == TK_FIXED_ARRAY { tag = 5; }
        elseif kind == TK_DYN_ARRAY { tag = 6; }
        elseif kind == TK_REF { tag = 7; }
        elseif kind == TK_SLICE { tag = 8; }
        buf::buf_push_u8(bytes, tag)?;
        if tag == 5 { buf::buf_push_u64(bytes, entry.length)?; }
        if tag == 7 || tag == 8 { buf::buf_push_u8(bytes, entry.cap)?; }
        if tag == 5 || tag == 6 {
            // 数组头有布局也不意味着元素可存储。静态函数引用仍可作为数组元素。
            if entry.elem == 0 || entry.elem > @len(tt.entries) as u32 { return false; }
            let element: u8 = tt.entries[entry.elem - 1].kind;
            if element == TK_VOID || element == TK_REF || element == TK_SLICE || element == TK_TEXT_VIEW ||
                element == TK_FALLIBLE || element == TK_ERROR_SET { return false; }
        }
        return union_key(tt, bytes, entry.elem, depth + 1, work)?;
    } elseif kind == TK_FN_REF || kind == TK_PLAIN_UNION || kind == TK_FALLIBLE {
        var members: TypeEntry = entry;
        if kind == TK_FN_REF {
            if entry.members_count > 65535 { return false; }
            buf::buf_push_u8(bytes, 9)?;
            buf::buf_push_u16(bytes, entry.members_count as u16)?;
        } elseif kind == TK_PLAIN_UNION {
            buf::buf_push_u8(bytes, 12)?;
            buf::buf_push_u32(bytes, entry.members_count)?;
        } else {
            if entry.elem == 0 || entry.elem > @len(tt.entries) as u32 { return false; }
            members = tt.entries[entry.elem - 1];
            if members.kind != TK_ERROR_SET { return false; }
            buf::buf_push_u8(bytes, 10)?;
            if !union_key(tt, bytes, entry.success, depth + 1, work)? { return false; }
            buf::buf_push_u32(bytes, members.members_count)?;
        }
        let total: u64 = @len(tt.members);
        if (members.members_start as u64) + (members.members_count as u64) > total { return false; }
        var i: u32 = 0;
        while i < members.members_count {
            if !union_key(tt, bytes, tt.members[members.members_start + i], depth + 1, work)? { return false; }
            i = i + 1;
        }
        if kind == TK_FN_REF { return union_key(tt, bytes, entry.elem, depth + 1, work)?; }
    } else { return false; }
    return true;
}

function compare_union_keys(bytes: &buf::ByteBuf:Read, left: UnionKey, right: UnionKey): i8 {
    var a: u32 = left.offset;
    var b: u32 = right.offset;
    while a < left.end && b < right.end {
        if bytes.data[a] < bytes.data[b] { return -1; }
        if bytes.data[a] > bytes.data[b] { return 1; }
        a = a + 1;
        b = b + 1;
    }
    if a < left.end { return 1; }
    if b < right.end { return -1; }
    return 0;
}

function sift_union_keys(keys: &UnionKey[]:ReadWrite, bytes: &buf::ByteBuf:Read, start: u32, end: u32, work: &InternBudget:ReadWrite): void {
    var parent: u32 = start;
    while parent < end / 2 {
        var child: u32 = parent * 2 + 1;
        if !charge_intern(work, 1) { return; }
        if child + 1 < end && compare_union_keys(bytes, (*keys)[child], (*keys)[child + 1]) < 0 { child = child + 1; }
        if compare_union_keys(bytes, (*keys)[parent], (*keys)[child]) >= 0 { return; }
        let prior: UnionKey = (*keys)[parent];
        (*keys)[parent] = (*keys)[child];
        (*keys)[child] = prior;
        parent = child;
    }
    return;
}

function add_union_key(tt: &TypeTable:Read, keys: &UnionKey[]:ReadWrite, bytes: &buf::ByteBuf:ReadWrite, id: u32, work: &InternBudget:ReadWrite): bool!AllocError {
    if id == 0 || id > @len(tt.entries) as u32 || @len(*keys) >= 65536 { return false; }
    let kind: u8 = tt.entries[id - 1].kind;
    if kind != TK_BUILTIN && kind != TK_LOCAL && kind != TK_IMPORTED && kind != TK_DYN_ARRAY && kind != TK_FIXED_ARRAY { return false; }
    let start: u32 = bytes.pos;
    if !union_key(tt, bytes, id, 1, work)? { return false; }
    @push(*keys, UnionKey { type_id: id, offset: start, end: bytes.pos })?;
    return true;
}

function intern_plain_union(tt: &TypeTable:ReadWrite, members: &[u32], work: &InternBudget:ReadWrite): u32!AllocError {
    var keys: UnionKey[] = [];
    var bytes: buf::ByteBuf = buf::buf_new();
    var i: u32 = 0;
    while i < @len(members) as u32 {
        let id: u32 = members[i];
        if plain_union_type(tt, id) {
            let nested: TypeEntry = tt.entries[id - 1];
            var j: u32 = 0;
            while j < nested.members_count {
                if !add_union_key(tt, &keys:ReadWrite, &bytes:ReadWrite, tt.members[nested.members_start + j], work)? { return 0; }
                j = j + 1;
            }
        } elseif !add_union_key(tt, &keys:ReadWrite, &bytes:ReadWrite, id, work)? { return 0; }
        i = i + 1;
    }
    var tail: u32 = @len(keys) as u32;
    if tail < 2 { return 0; }
    i = tail / 2;
    while i != 0 { i = i - 1; sift_union_keys(&keys:ReadWrite, &bytes:Read, i, tail, work); if work.exhausted { return 0; } }
    while tail > 1 {
        tail = tail - 1;
        let first: UnionKey = keys[0];
        keys[0] = keys[tail];
        keys[tail] = first;
        sift_union_keys(&keys:ReadWrite, &bytes:Read, 0, tail, work);
        if work.exhausted { return 0; }
    }
    var sorted: u32[] = [];
    i = 0;
    while i < @len(keys) as u32 {
        if i != 0 && compare_union_keys(&bytes:Read, keys[i - 1], keys[i]) == 0 { return 0; }
        @push(sorted, keys[i].type_id)?;
        i = i + 1;
    }
    i = 0;
    while i < @len(tt.entries) as u32 {
        if !charge_intern(work, 1) { return 0; }
        if tt.entries[i].kind == TK_PLAIN_UNION && same_members_limited(tt, i, &sorted[0..@len(sorted)]:Read, work) { return i + 1; }
        if work.exhausted { return 0; }
        i = i + 1;
    }
    let start: u32 = @len(tt.members) as u32;
    i = 0;
    while i < @len(sorted) as u32 { @push(tt.members, sorted[i])?; i = i + 1; }
    return push_type(tt, TypeEntry { kind: TK_PLAIN_UNION, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: start, members_count: i })?;
}
function intern_nullable_limited(tt: &TypeTable:ReadWrite, elem: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_nullable(tt, elem)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_NULLABLE && tt.entries[i].elem == elem { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_NULLABLE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: elem, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
}
// 只读切片入参：调用方的数组在循环中仍需继续使用，不能让出所有权。
function same_members(tt: &TypeTable:ReadWrite, index: u32, members: &[u32]:Read): bool {
    if tt.entries[index].members_count != @len(members) as u32 { return false; }
    var i: u32 = 0;
    while i < @len(members) as u32 {
        let value: u32 = tt.members[tt.entries[index].members_start + i];
        // MIR 重读导入签名时，已登记的错误集按 ABI 标签序存储；函数参数仍按位置比较。
        if members[i] != value {
            if tt.entries[index].kind != TK_ERROR_SET { return false; }
            var lo: u32 = 0;
            var hi: u32 = @len(members) as u32;
            while lo < hi {
                let mid: u32 = lo + (hi - lo) / 2;
                if members[mid] < value { lo = mid + 1; }
                else { hi = mid; }
            }
            if lo == @len(members) as u32 { return false; }
            if members[lo] != value { return false; }
        }
        i = i + 1;
    }
    return true;
}
function same_members_limited(tt: &TypeTable:ReadWrite, index: u32, members: &[u32]:Read, work: &InternBudget:ReadWrite): bool {
    if tt.entries[index].members_count != @len(members) as u32 { return false; }
    var i: u32 = 0;
    while i < @len(members) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return false; }
        let value: u32 = tt.members[tt.entries[index].members_start + i];
        // MIR 重读导入签名时，已登记的错误集按 ABI 标签序存储；函数参数仍按位置比较。
        if members[i] != value {
            if tt.entries[index].kind != TK_ERROR_SET { return false; }
            var lo: u32 = 0;
            var hi: u32 = @len(members) as u32;
            while lo < hi {
                if work.limited && !charge_intern(work, 1u32) { return false; }
                let mid: u32 = lo + (hi - lo) / 2;
                if members[mid] < value { lo = mid + 1; }
                else { hi = mid; }
            }
            if lo == @len(members) as u32 { return false; }
            if work.limited && !charge_intern(work, 1u32) { return false; }
            if members[lo] != value { return false; }
        }
        i = i + 1;
    }
    return true;
}
export function intern_error_set(tt: &TypeTable:ReadWrite, members: u32[]): u32!AllocError {
    var work: InternBudget = intern_budget(0);
    return intern_error_set_limited(tt, @move(members), &work:ReadWrite)?;
}

function unique_error_types(members: &[u32]:Read, sorted: &u32[]:ReadWrite, work: &InternBudget:ReadWrite): void!AllocError {
    if !work.limited && @len(members) > 16 {
        // 大集合先按完整类型编号排序，再线性去重；不能按源码操作数数量判上限。
        var keys: u64[] = [];
        var k: u32 = 0;
        while k < @len(members) as u32 { @push(keys, members[k] as u64)?; k = k + 1; }
        resolve_refs::sort_identity(&keys:ReadWrite);
        k = 0;
        while k < @len(keys) as u32 {
            if k == 0 || keys[k - 1] != keys[k] { @push(*sorted, keys[k] as u32)?; }
            k = k + 1;
        }
        return;
    }
    var i: u32 = 0;
    while i < @len(members) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return; }
        let value: u32 = members[i];
        var pos: u32 = 0;
        while pos < @len(*sorted) as u32 {
            if work.limited && !charge_intern(work, 1u32) { return; }
            if sorted[pos] >= value { break; }
            pos = pos + 1;
        }
        if pos < @len(*sorted) as u32 && sorted[pos] == value { i = i + 1; continue; }
        @push(*sorted, 0)?;
        var k: u32 = @len(*sorted) as u32 - 1;
        while k > pos {
            if work.limited && !charge_intern(work, 1u32) { return; }
            sorted[k] = sorted[k - 1];
            k = k - 1;
        }
        sorted[pos] = value;
        i = i + 1;
    }
    return;
}
function intern_error_set_limited(tt: &TypeTable:ReadWrite, members: u32[], work: &InternBudget:ReadWrite): u32!AllocError {
    if work.exhausted { return 0; }
    var sorted: u32[] = [];
    unique_error_types(&members[0..@len(members)]:Read, &sorted:ReadWrite, work)?;
    if work.exhausted { return 0; }
    var e: u32 = 0;
    while e < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[e].kind == TK_ERROR_SET {
            if work.limited {
                if same_members_limited(tt, e, &sorted[0..@len(sorted)]:Read, work) { return e + 1; }
            } elseif same_members(tt, e, &sorted[0..@len(sorted)]:Read) { return e + 1; }
        }
        if work.exhausted { return 0; }
        e = e + 1;
    }
    if work.limited && !charge_intern(work, @len(sorted) as u32) { return 0; }
    let start: u32 = @len(tt.members) as u32;
    var s: u32 = 0;
    while s < @len(sorted) as u32 { @push(tt.members, sorted[s])?; s = s + 1; }
    return push_type(tt, TypeEntry { kind: TK_ERROR_SET, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: start, members_count: @len(sorted) as u32 })?;
}
// 单成员错误集不需要调用方转交 owning 数组。
export function intern_single_error(tt: &TypeTable:ReadWrite, member: u32): u32!AllocError {
    var members: u32[] = [];
    @push(members, member)?;
    return intern_error_set(tt, @move(members))?;
}
export function intern_single_error_limited(tt: &TypeTable:ReadWrite, member: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_single_error(tt, member)?; }
    if work.exhausted { return 0; }
    var members: u32[] = [];
    @push(members, member)?;
    return intern_error_set_limited(tt, @move(members), work)?;
}
// 函数体的合成类型复用类型表驻留规则，不复制各类型的查找计费。
export function intern_body_type(tt: &TypeTable:ReadWrite, kind: u8, first: u32, second: u64, work: &InternBudget:ReadWrite): u32!AllocError {
    if kind == TK_BUILTIN { return intern_builtin_limited(tt, first as u16, work)?; }
    if kind == TK_LOCAL { return intern_local_limited(tt, first, work)?; }
    if kind == TK_IMPORTED { return intern_imported_limited(tt, first as u16, second as u32, work)?; }
    if kind == TK_REF { return intern_ref_limited(tt, first as u8, second as u32, work)?; }
    if kind == TK_SLICE { return intern_slice_limited(tt, first as u8, second as u32, work)?; }
    if kind == TK_DYN_ARRAY { return intern_dyn_array_limited(tt, first, work)?; }
    if kind == TK_FIXED_ARRAY { return intern_fixed_array_limited(tt, first, second, work)?; }
    if kind == TK_ERROR_SET { return intern_single_error_limited(tt, first, work)?; }
    if kind == TK_FALLIBLE { return intern_fallible_limited(tt, first, second as u32, work)?; }
    return 0;
}
// 错误集实习以类型编号判等；所有类型收集完成后再按声明身份给布局和 MIR 排标签。
function enum_identity_index(entry: &TypeEntry:Read, identities: &[resolve_refs::EnumIdentity]:Read): u32 {
    var dep: u16 = 0;
    var id: u32 = entry.def;
    if entry.kind == TK_IMPORTED { dep = entry.dep; id = entry.export_id; }
    elseif entry.kind != TK_LOCAL { return 0; }
    var lo: u32 = 0;
    var hi: u32 = @len(identities) as u32;
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2;
        if identities[mid].dep < dep || (identities[mid].dep == dep && identities[mid].id < id) { lo = mid + 1; }
        else { hi = mid; }
    }
    if lo < @len(identities) as u32 && identities[lo].dep == dep && identities[lo].id == id { return lo + 1; }
    return 0;
}
function error_member_less(tt: &TypeTable:Read, left: u32, right: u32, identities: &[resolve_refs::EnumIdentity]:Read, indices: &[u32]:Read): bool {
    if tt.entries[left - 1].kind == TK_BUILTIN && tt.entries[right - 1].kind != TK_BUILTIN { return true; }
    if tt.entries[right - 1].kind == TK_BUILTIN { return false; }
    let a: u32 = indices[left - 1];
    let b: u32 = indices[right - 1];
    if a == 0 || b == 0 { return a < b; }
    let ka: &[u8] = &identities[a - 1].key[0..@len(identities[a - 1].key)];
    let kb: &[u8] = &identities[b - 1].key[0..@len(identities[b - 1].key)];
    return resolve_refs::enum_key_less(ka, kb);
}

function merge_error_tags(tt: &TypeTable:ReadWrite, start: u32, count: u32, identities: &[resolve_refs::EnumIdentity]:Read, indices: &[u32]:Read): void!AllocError {
    // ABI 序按完整规范身份排序；同键保持输入顺序，便于调用方随后诊断。
    var scratch: u32[] = [];
    while @len(scratch) < count as u64 { @push(scratch, 0)?; }
    var width: u32 = 1;
    while width < count {
        var first: u32 = 0;
        while first < count {
            if width >= count - first {
                var tail: u32 = first;
                while tail < count { scratch[tail] = tt.members[start + tail]; tail = tail + 1; }
                break;
            }
            let mid: u32 = first + width;
            var end: u32 = count;
            if width < count - mid { end = mid + width; }
            var left: u32 = first;
            var right: u32 = mid;
            var write_pos: u32 = first;
            while write_pos < end {
                if right < end && (left == mid || error_member_less(tt, tt.members[start + right], tt.members[start + left], identities, indices)) {
                    scratch[write_pos] = tt.members[start + right];
                    right = right + 1;
                } else {
                    scratch[write_pos] = tt.members[start + left];
                    left = left + 1;
                }
                write_pos = write_pos + 1;
            }
            first = end;
        }
        var i: u32 = 0;
        while i < count { tt.members[start + i] = scratch[i]; i = i + 1; }
        if width >= count - width { break; }
        width = width * 2;
    }
    return;
}

export function canonicalize_error_sets(tt: &TypeTable:ReadWrite, identities: &[resolve_refs::EnumIdentity]:Read): void!AllocError {
    var indices: u32[] = [];
    var t: u32 = 0;
    while t < @len(tt.entries) as u32 {
        @push(indices, enum_identity_index(&tt.entries[t]:Read, identities))?;
        t = t + 1;
    }
    t = 0;
    while t < @len(tt.entries) as u32 {
        let entry: TypeEntry = tt.entries[t];
        if entry.kind == TK_ERROR_SET && entry.members_count > 16 {
            merge_error_tags(tt, entry.members_start, entry.members_count, identities, &indices[0..@len(indices)]:Read)?;
        } elseif entry.kind == TK_ERROR_SET {
            let start: u32 = entry.members_start;
            var i: u32 = 1;
            while i < entry.members_count {
                let id: u32 = tt.members[start + i];
                var j: u32 = i;
                while j > 0 && error_member_less(tt, id, tt.members[start + j - 1], identities, &indices[0..@len(indices)]:Read) {
                    tt.members[start + j] = tt.members[start + j - 1];
                    j = j - 1;
                }
                tt.members[start + j] = id;
                i = i + 1;
            }
        }
        t = t + 1;
    }
    return;
}
export function intern_fallible(tt: &TypeTable:ReadWrite, success: u32, errorset: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_FALLIBLE && tt.entries[i].success == success && tt.entries[i].elem == errorset { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_FALLIBLE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: errorset, cap: 0, length: 0, success: success, members_start: 0, members_count: 0 })?;
}
export function intern_fallible_limited(tt: &TypeTable:ReadWrite, success: u32, errorset: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_fallible(tt, success, errorset)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_FALLIBLE && tt.entries[i].success == success && tt.entries[i].elem == errorset { return i + 1; }
        i = i + 1;
    }
    return push_type(tt, TypeEntry { kind: TK_FALLIBLE, builtin: 0, def: 0, dep: 0, export_id: 0, elem: errorset, cap: 0, length: 0, success: success, members_start: 0, members_count: 0 })?;
}
export function intern_fn_ref(tt: &TypeTable:ReadWrite, params: u32[], ret: u32): u32!AllocError {
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if tt.entries[i].kind == TK_FN_REF && tt.entries[i].elem == ret && same_members(tt, i, &params[0..@len(params)]:Read) { return i + 1; }
        i = i + 1;
    }
    let start: u32 = @len(tt.members) as u32;
    var p: u32 = 0;
    while p < @len(params) as u32 { @push(tt.members, params[p])?; p = p + 1; }
    return push_type(tt, TypeEntry { kind: TK_FN_REF, builtin: 0, def: 0, dep: 0, export_id: 0, elem: ret, cap: 0, length: 0, success: 0, members_start: start, members_count: @len(params) as u32 })?;
}
export function intern_fn_ref_limited(tt: &TypeTable:ReadWrite, params: u32[], ret: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if !work.limited { return intern_fn_ref(tt, @move(params), ret)?; }
    if work.exhausted { return 0; }
    var i: u32 = 0;
    while i < @len(tt.entries) as u32 {
        if work.limited && !charge_intern(work, 1u32) { return 0; }
        if tt.entries[i].kind == TK_FN_REF && tt.entries[i].elem == ret && same_members_limited(tt, i, &params[0..@len(params)]:Read, work) { return i + 1; }
        if work.exhausted { return 0; }
        i = i + 1;
    }
    if work.limited && !charge_intern(work, @len(params) as u32) { return 0; }
    let start: u32 = @len(tt.members) as u32;
    var p: u32 = 0;
    while p < @len(params) as u32 { @push(tt.members, params[p])?; p = p + 1; }
    return push_type(tt, TypeEntry { kind: TK_FN_REF, builtin: 0, def: 0, dep: 0, export_id: 0, elem: ret, cap: 0, length: 0, success: 0, members_start: start, members_count: @len(params) as u32 })?;
}
export function ref_index(refs: &resolve_refs::RefTable:Read, node_kind: u8, node: u32): u32 {
    if node_kind == 0 && @len(refs.expr_index) != 0 {
        if node < @len(refs.expr_index) as u32 { return refs.expr_index[node]; }
        return 0;
    }
    if node_kind == 1 && @len(refs.type_index) != 0 {
        if node < @len(refs.type_index) as u32 { return refs.type_index[node]; }
        return 0;
    }
    if node_kind == 2 && @len(refs.pattern_index) != 0 {
        if node < @len(refs.pattern_index) as u32 { return refs.pattern_index[node]; }
        return 0;
    }
    var i: u32 = 0;
    while i < @len(refs.items) as u32 {
        if refs.items[i].node_kind == node_kind && refs.items[i].node == node { return i + 1; }
        i = i + 1;
    }
    return 0;
}
export function integer_suffix_builtin(suffix: u8): u16 {
    if suffix == 1 { return BUILTIN_U8; }
    if suffix == 2 { return BUILTIN_U16; }
    if suffix == 3 { return BUILTIN_U32; }
    if suffix == 4 { return BUILTIN_U64; }
    if suffix == 5 { return BUILTIN_I8; }
    if suffix == 6 { return BUILTIN_I16; }
    if suffix == 7 { return BUILTIN_I32; }
    if suffix == 8 { return BUILTIN_I64; }
    return 0;
}
export function is_integer_type(tt: &TypeTable:Read, id: u32): bool {
    if id == 0 || id > @len(tt.entries) as u32 { return false; }
    if tt.entries[id - 1].kind != TK_BUILTIN { return false; }
    let b: u16 = tt.entries[id - 1].builtin;
    return b >= BUILTIN_U8 && b <= BUILTIN_I64;
}
// 文档声明收集按递增 DefId 追加，允许在原表上二分；其他调用保留线性首个命中。
export function enum_row(enums: &EnumTable:Read, def: u32, ordered: bool): u32 {
    var right: u32 = @len(enums.items) as u32;
    var left: u32 = 0;
    while left < right {
        var at: u32 = left;
        if ordered { at = left + (right - left) / 2u32; }
        let candidate: u32 = enums.items[at].def;
        if candidate == def { return at + 1u32; }
        if ordered && candidate > def { right = at; }
        else { left = at + 1u32; }
    }
    return 0;
}
// 从规范 TypeId 取本地枚举行；非本地枚举返回 0。
export function enum_row_of(tt: &TypeTable:Read, enums: &EnumTable:Read, id: u32, ordered: bool): u32 {
    if id == 0 || id > @len(tt.entries) as u32 { return 0; }
    if tt.entries[id - 1].kind != TK_LOCAL { return 0; }
    return enum_row(enums, tt.entries[id - 1].def, ordered);
}
export function enum_host_of(tt: &TypeTable:ReadWrite, enums: &EnumTable:Read, id: u32): u32 {
    let row: u32 = enum_row_of(tt, enums, id, false);
    if row != 0 { return enums.items[row - 1].def; }
    return 0;
}
export function enum_variant_count(enums: &EnumTable:Read, host: u32): u32 {
    let row: u32 = enum_row(enums, host, false);
    if row != 0 { return @len(enums.items[row - 1].payloads) as u32; }
    return 0;
}
function is_char_type(tt: &TypeTable:Read, id: u32): bool {
    if id == 0 || id > @len(tt.entries) as u32 { return false; }
    return tt.entries[id - 1].kind == TK_BUILTIN && tt.entries[id - 1].builtin == BUILTIN_CHAR;
}
export function is_ordered_type(tt: &TypeTable:Read, id: u32): bool {
    return is_integer_type(tt, id) || is_char_type(tt, id);
}
// 显式转换白名单：整数之间互转；char 只能与 u32 互转；bool、enum 与载体均不在白名单内。
export function cast_allowed(tt: &TypeTable:Read, source: u32, target: u32): bool {
    if source == 0 || target == 0 || source > @len(tt.entries) as u32 || target > @len(tt.entries) as u32 { return false; }
    if source == target { return true; }
    if is_integer_type(tt, source) && is_integer_type(tt, target) { return true; }
    let source_u32: bool = tt.entries[source - 1].kind == TK_BUILTIN && tt.entries[source - 1].builtin == BUILTIN_U32;
    let target_u32: bool = tt.entries[target - 1].kind == TK_BUILTIN && tt.entries[target - 1].builtin == BUILTIN_U32;
    if is_char_type(tt, source) && target_u32 { return true; }
    if source_u32 && is_char_type(tt, target) {
        return true;
    }
    return false;
}
export function same_type(left: u32, right: u32): bool {
    return left == right;
}
export function type_is_bool(tt: &TypeTable:ReadWrite, id: u32): bool {
    if id == 0 || id > @len(tt.entries) as u32 { return false; }
    return tt.entries[id - 1].kind == TK_BUILTIN && tt.entries[id - 1].builtin == BUILTIN_BOOL;
}
export function type_is_void(tt: &TypeTable:ReadWrite, id: u32): bool {
    if id == 0 || id > @len(tt.entries) as u32 { return false; }
    return tt.entries[id - 1].kind == TK_VOID;
}
export function type_is_error_member(tt: &TypeTable:Read, errorset: u32, candidate: u32): bool {
    if errorset == 0 || errorset > @len(tt.entries) as u32 { return false; }
    var i: u32 = 0;
    while i < tt.entries[errorset - 1].members_count {
        if tt.members[tt.entries[errorset - 1].members_start + i] == candidate { return true; }
        i = i + 1;
    }
    return false;
}
export function resolve_type_ref(tt: &TypeTable:ReadWrite, refs: &resolve_refs::RefTable:Read, pool: &ast::AstPool:Read, type_id: u32): u32!AllocError {
    var work: InternBudget = intern_budget(0);
    return resolve_type_ref_limited(tt, refs, pool, type_id, &work:ReadWrite)?;
}
export function resolve_type_ref_limited(tt: &TypeTable:ReadWrite, refs: &resolve_refs::RefTable:Read, pool: &ast::AstPool:Read, type_id: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if work.exhausted { return 0; }
    if type_id >= @len(pool.types) as u32 { return 0; }
    let kind: u8 = pool.types[type_id].kind;
    let data: u32 = pool.types[type_id].data;
    if kind == 1 {
        let index: u32 = ref_index(refs, 1, type_id);
        if index == 0 { return 0; }
        let ref_kind: u8 = refs.items[index - 1].kind;
        if ref_kind == 0 {
            let def: u32 = refs.items[index - 1].x;
            return intern_local_limited(tt, def, work)?;
        }
        if ref_kind == 1 { return intern_builtin_limited(tt, refs.items[index - 1].x as u16, work)?; }
        if ref_kind == 2 { return intern_imported_limited(tt, refs.items[index - 1].x as u16, refs.items[index - 1].y, work)?; }
        return 0;
    }
    if kind == 2 {
        if data >= @len(pool.fixed_arrays) as u32 { return 0; }
        let elem: u32 = resolve_type_ref_limited(tt, refs, pool, pool.fixed_arrays[data].element, work)?;
        return intern_fixed_array_limited(tt, elem, pool.fixed_arrays[data].length, work)?;
    }
    if kind == 3 { return intern_dyn_array_limited(tt, resolve_type_ref_limited(tt, refs, pool, data, work)?, work)?; }
    if kind == 4 || kind == 5 {
        if data >= @len(pool.refs) as u32 { return 0; }
        let elem: u32 = resolve_type_ref_limited(tt, refs, pool, pool.refs[data].referent, work)?;
        let cap: u8 = pool.refs[data].capability as u8;
        if kind == 5 { return intern_slice_limited(tt, cap, elem, work)?; }
        return intern_ref_limited(tt, cap, elem, work)?;
    }
    if kind == 6 {
        if data >= @len(pool.fn_refs) as u32 { return 0; }
        var params: u32[] = [];
        var i: u32 = 0;
        while i < @len(pool.fn_refs[data].params) as u32 {
            let param: u32 = resolve_type_ref_limited(tt, refs, pool, pool.fn_refs[data].params[i], work)?;
            if work.exhausted { return 0; }
            @push(params, param)?;
            i = i + 1;
        }
        let ret: u32 = resolve_type_ref_limited(tt, refs, pool, pool.fn_refs[data].ret_type, work)?;
        return intern_fn_ref_limited(tt, @move(params), ret, work)?;
    }
    if kind == 7 {
        if data >= @len(pool.fallibles) as u32 { return 0; }
        let success: u32 = resolve_type_ref_limited(tt, refs, pool, pool.fallibles[data].success, work)?;
        if work.exhausted { return 0; }
        let set_id: u32 = pool.fallibles[data].error_set;
        var members: u32[] = [];
        if set_id < @len(pool.error_sets) as u32 {
            var i: u32 = 0;
            while i < @len(pool.error_sets[set_id].members) as u32 {
                let member: u32 = resolve_type_ref_limited(tt, refs, pool, pool.error_sets[set_id].members[i], work)?;
                if work.exhausted { return 0; }
                if member != 0 { @push(members, member)?; }
                i = i + 1;
            }
        }
        let errorset: u32 = intern_error_set_limited(tt, @move(members), work)?;
        return intern_fallible_limited(tt, success, errorset, work)?;
    }
    if kind == 8 { return intern_nullable_limited(tt, resolve_type_ref_limited(tt, refs, pool, data, work)?, work)?; }
    if kind == 9 { return resolve_plain_union(tt, refs, pool, data, work)?; }
    if kind == 10 || kind == 11 { return intern_text_limited(tt, kind == 11, work)?; }
    return 0;
}

function resolve_plain_union(tt: &TypeTable:ReadWrite, refs: &resolve_refs::RefTable:Read, pool: &ast::AstPool:Read, index: u32, work: &InternBudget:ReadWrite): u32!AllocError {
    if index >= @len(pool.plain_unions) as u32 { return 0; }
    var members: u32[] = [];
    var i: u32 = 0;
    while i < @len(pool.plain_unions[index].members) as u32 {
        let member: u32 = resolve_type_ref_limited(tt, refs, pool, pool.plain_unions[index].members[i], work)?;
        if member == 0 || work.exhausted { return 0; }
        @push(members, member)?;
        i = i + 1;
    }
    return intern_plain_union(tt, &members[0..@len(members)]:Read, work)?;
}
export function ensure_def_types(table: &DefTypeTable:ReadWrite, count: u32): void!AllocError {
    while (@len(table.items) as u32) < count { @push(table.items, 0)?; }
    return;
}
export function set_def_type(table: &DefTypeTable:ReadWrite, def: u32, type_id: u32): void {
    if def >= 1 && def <= @len(table.items) as u32 { table.items[def - 1] = type_id; }
    return;
}
export function def_type(table: &DefTypeTable:Read, def: u32): u32 {
    if def >= 1 && def <= @len(table.items) as u32 { return table.items[def - 1]; }
    return 0;
}
export function lookup_binding(tables: &resolve::ResolveTables:Read, scope: u32, name: u32): u32 {
    return resolve::lookup_binding(tables, scope, name);
}
export function function_scope(tables: &resolve::ResolveTables:Read, body: u32, def: u32): u32 {
    // 函数体与声明共用作用域，只检查预留阶段记录的候选。
    if def == 0 || body >= @len(tables.block_scope) as u32 { return 0; }
    let scope: u32 = tables.block_scope[body];
    if scope == 0 || scope > @len(tables.scopes) as u32 { return 0; }
    if tables.scopes[scope - 1].kind == 3 && tables.scopes[scope - 1].owner == def { return scope; }
    return 0;
}
// 文档索引按 1 基定义编号直查；空槽和越界均无签名。
export function index_func_sigs(table: &FuncTable:ReadWrite, def_count: u32): void!AllocError {
    var i: u32 = 0;
    while i < def_count { @push(table.by_def, 0)?; i = i + 1; }
    i = 0;
    while i < @len(table.items) as u32 {
        let def: u32 = table.items[i].def;
        if def != 0 && def <= def_count && table.by_def[def - 1] == 0 {
            table.by_def[def - 1] = i + 1;
        }
        i = i + 1;
    }
    return;
}
export function func_sig(table: &FuncTable:Read, def: u32): u32 {
    let slots: u32 = @len(table.by_def) as u32;
    if slots != 0 {
        if def == 0 || def > slots { return 0; }
        return table.by_def[def - 1];
    }
    var i: u32 = 0;
    while i < @len(table.items) as u32 {
        if table.items[i].def == def { return i + 1; }
        i = i + 1;
    }
    return 0;
}
// 展示缓冲按字节与类型边限额；任何未确认的子类型使整条展示失效。
export function add_field(table: &FieldTable:ReadWrite, def: u32, name: u32, type_id: u32): void!AllocError {
    @push(table.items, FieldType { def: def, name: name, type_id: type_id })?;
    return;
}
// 结构体声明的字段数量，用于校验构造表达式是否漏字段或多字段。
export function field_count(table: &FieldTable:Read, def: u32): u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    while i < @len(table.items) as u32 {
        if table.items[i].def == def { n = n + 1; }
        i = i + 1;
    }
    return n;
}
export function error_set_subset(tt: &TypeTable:Read, source: u32, target: u32): bool {
    if source == 0 || target == 0 || source > @len(tt.entries) as u32 || target > @len(tt.entries) as u32 { return false; }
    if tt.entries[source - 1].kind != TK_ERROR_SET || tt.entries[target - 1].kind != TK_ERROR_SET { return false; }
    var i: u32 = 0;
    while i < tt.entries[source - 1].members_count {
        let member: u32 = tt.members[tt.entries[source - 1].members_start + i];
        if !type_is_error_member(tt, target, member) { return false; }
        i = i + 1;
    }
    return true;
}
export function enum_payload_with_order(enums: &EnumTable:Read, def: u32, variant: u32, ordered: bool): u32 {
    let row: u32 = enum_row(enums, def, ordered);
    if row != 0 && variant < @len(enums.items[row - 1].payloads) as u32 { return enums.items[row - 1].payloads[variant]; }
    return 4294967295u32;
}
export function enum_payload_type(enums: &EnumTable:Read, def: u32, variant: u32): u32 {
    return enum_payload_with_order(enums, def, variant, false);
}
// 普通 Read 引用提供被借用值的类型上下文，不改写实参自身的类型。
export function read_ref_target(tt: &TypeTable:Read, id: u32): u32 {
    if id == 0 || tt.entries[id - 1].kind != TK_REF || tt.entries[id - 1].cap != 0 { return 0; }
    return tt.entries[id - 1].elem;
}
// 普通访问形参可以从目标类型的位置建立 Read 或 ReadWrite。
export function access_ref_target(tt: &TypeTable:Read, id: u32): u32 {
    if id == 0 || id > @len(tt.entries) as u32 || tt.entries[id - 1].kind != TK_REF || tt.entries[id - 1].cap >= 2 { return 0; }
    return tt.entries[id - 1].elem;
}
// Write 只作为 out 调用通道使用，不按普通引用匹配。
export function write_ref_target(tt: &TypeTable:Read, id: u32): u32 {
    if id == 0 || id > @len(tt.entries) as u32 || tt.entries[id - 1].kind != TK_REF || tt.entries[id - 1].cap != 2 { return 0; }
    return tt.entries[id - 1].elem;
}
