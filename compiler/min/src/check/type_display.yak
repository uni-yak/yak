// 将文档查询中的类型和函数签名渲染为可读文本。
import types;
import buf;
import typecheck;

const BUILTIN_ALLOC_ERROR: u16 = 4108;
const BUILTIN_BOOL: u16 = 4105;
const BUILTIN_CHAR: u16 = 4106;
const BUILTIN_I16: u16 = 4102;
const BUILTIN_I32: u16 = 4103;
const BUILTIN_I64: u16 = 4104;
const BUILTIN_I8: u16 = 4101;
const BUILTIN_U16: u16 = 4098;
const BUILTIN_U32: u16 = 4099;
const BUILTIN_U64: u16 = 4100;
const BUILTIN_U8: u16 = 4097;
const TK_BUILTIN: u8 = 1;
const TK_DYN_ARRAY: u8 = 6;
const TK_ERROR_SET: u8 = 11;
const TK_FALLIBLE: u8 = 9;
const TK_FIXED_ARRAY: u8 = 7;
const TK_FN_REF: u8 = 8;
const TK_LOCAL: u8 = 2;
const TK_REF: u8 = 4;
const TK_SLICE: u8 = 5;
const TK_VOID: u8 = 0;

function display_bytes(display: &buf::ByteBuf:ReadWrite, text: &[u8]): bool!AllocError {
    if @len(text) > (512u32 - display.pos) as u64 { return false; }
    buf::buf_push_bytes(display, text)?;
    return true;
}

function display_number(display: &buf::ByteBuf:ReadWrite, value: u64): bool!AllocError {
    var scale: u64 = 1;
    while value / scale >= 10u64 { scale = scale * 10u64; }
    while scale != 0u64 {
        if display.pos == 512u32 { return false; }
        buf::buf_push_u8(display, 48u8 + ((value / scale) % 10u64) as u8)?;
        scale = scale / 10u64;
    }
    return true;
}

function display_builtin(display: &buf::ByteBuf:ReadWrite, builtin: u16): bool!AllocError {
    if builtin == BUILTIN_U8 { return display_bytes(display, "u8")?; }
    if builtin == BUILTIN_U16 { return display_bytes(display, "u16")?; }
    if builtin == BUILTIN_U32 { return display_bytes(display, "u32")?; }
    if builtin == BUILTIN_U64 { return display_bytes(display, "u64")?; }
    if builtin == BUILTIN_I8 { return display_bytes(display, "i8")?; }
    if builtin == BUILTIN_I16 { return display_bytes(display, "i16")?; }
    if builtin == BUILTIN_I32 { return display_bytes(display, "i32")?; }
    if builtin == BUILTIN_I64 { return display_bytes(display, "i64")?; }
    if builtin == BUILTIN_BOOL { return display_bytes(display, "bool")?; }
    if builtin == BUILTIN_CHAR { return display_bytes(display, "char")?; }
    if builtin == BUILTIN_ALLOC_ERROR { return display_bytes(display, "AllocError")?; }
    return false;
}

function display_name(display: &buf::ByteBuf:ReadWrite, source: &[u8], names: &[types::Span], def: u32): bool!AllocError {
    if def == 0u32 || (def as u64) > @len(names) { return false; }
    let span: types::Span = names[def - 1u32];
    if span.length == 0u32 || (span.offset as u64) + (span.length as u64) > @len(source) { return false; }
    return display_bytes(display, &source[span.offset..span.offset + span.length]:Read)?;
}

function display_type_inner(display: &buf::ByteBuf:ReadWrite, table: &typecheck::TypeTable:Read, source: &[u8], names: &[types::Span], id: u32, depth: u32): bool!AllocError {
    if depth == 0u32 || id == 0u32 || (id as u64) > @len(table.entries) { return false; }
    let entry: typecheck::TypeEntry = table.entries[id - 1u32];
    let next: u32 = depth - 1u32;
    if entry.kind == TK_VOID { return display_bytes(display, "void")?; }
    if entry.kind == TK_BUILTIN { return display_builtin(display, entry.builtin)?; }
    if entry.kind == TK_LOCAL { return display_name(display, source, names, entry.def)?; }
    if entry.kind == TK_REF || entry.kind == TK_SLICE {
        if !display_bytes(display, "&")? { return false; }
        if entry.kind == TK_SLICE && !display_bytes(display, "[")? { return false; }
        if !display_type_inner(display, table, source, names, entry.elem, next)? { return false; }
        if entry.kind == TK_SLICE && !display_bytes(display, "]")? { return false; }
        if entry.cap == 0u8 { return true; }
        if entry.cap == 1u8 { return display_bytes(display, ":ReadWrite")?; }
        if entry.cap == 2u8 { return display_bytes(display, ":Write")?; }
        return false;
    }
    if entry.kind == TK_FIXED_ARRAY {
        return display_bytes(display, "[")? && display_type_inner(display, table, source, names, entry.elem, next)?
            && display_bytes(display, "; ")? && display_number(display, entry.length)? && display_bytes(display, "]")?;
    }
    if entry.kind == TK_DYN_ARRAY {
        return display_type_inner(display, table, source, names, entry.elem, next)? && display_bytes(display, "[]")?;
    }
    if entry.kind == TK_FALLIBLE {
        return display_type_inner(display, table, source, names, entry.success, next)? && display_bytes(display, "!")?
            && display_type_inner(display, table, source, names, entry.elem, next)?;
    }
    if entry.kind == TK_ERROR_SET || entry.kind == TK_FN_REF {
        let end: u64 = (entry.members_start as u64) + (entry.members_count as u64);
        if end > @len(table.members) { return false; }
        let callable: bool = entry.kind == TK_FN_REF;
        if callable {
            if !display_bytes(display, "&function(")? { return false; }
        } elseif entry.members_count == 0u32 { return false; }
        elseif entry.members_count > 1u32 && !display_bytes(display, "(")? { return false; }
        var i: u32 = 0;
        while i < entry.members_count {
            if i != 0u32 {
                if callable {
                    if !display_bytes(display, ", ")? { return false; }
                } elseif !display_bytes(display, " | ")? { return false; }
            }
            if !display_type_inner(display, table, source, names, table.members[entry.members_start + i], next)? { return false; }
            i = i + 1u32;
        }
        if callable {
            return display_bytes(display, "): ")? && display_type_inner(display, table, source, names, entry.elem, next)?;
        }
        if entry.members_count > 1u32 { return display_bytes(display, ")")?; }
        return true;
    }
    return false;
}

// 展示仅在严格文档分析成功后生成，不参与类型身份或后续编译。
export function display_binding(checked: &typecheck::TypeCheckResult:Read, source: &[u8], names: &[types::Span], def: u32, foreign_item: bool, display: &buf::ByteBuf:ReadWrite): bool!AllocError {
    let sig_id: u32 = typecheck::func_sig(&checked.funcs:Read, def);
    let table: &typecheck::TypeTable:Read = &checked.types:Read;
    if sig_id == 0u32 {
        return display_name(display, source, names, def)? && display_bytes(display, ": ")?
            && display_type_inner(display, table, source, names, typecheck::def_type(&checked.def_types:Read, def), 16u32)?;
    }
    if foreign_item {
        if !display_bytes(display, "foreign ")? { return false; }
    } elseif !display_bytes(display, "function ")? { return false; }
    if !display_name(display, source, names, def)? || !display_bytes(display, "(")? { return false; }
    let sig: &typecheck::FuncSig:Read = &checked.funcs.items[sig_id - 1u32]:Read;
    var i: u32 = 0;
    while i < @len(sig.params) as u32 {
        if i != 0u32 && !display_bytes(display, ", ")? { return false; }
        if !display_type_inner(display, table, source, names, sig.params[i], 16u32)? { return false; }
        i = i + 1u32;
    }
    return display_bytes(display, "): ")? && display_type_inner(display, table, source, names, sig.ret, 16u32)?;
}
