// diag_jsonl.yak —— --diag=jsonl 的单向 JSONL 文本（proc/diag.md 3.1-3.4）
// 依赖：buf（字节累积）、types（Span）、diag（Diag/DiagRef/DiagArg）。
// 输出协议：每行一个 JSON 对象，字段固定为 unit/code/severity/span/refs/args。
// 级别取自记录自身的 severity：静态错误码表没有级别列，无法从码位反推级别。

import buf;
import types;
import diag;

const SEVERITY_ERROR: u8 = 0u8;
const SEVERITY_WARNING: u8 = 1u8;
const SEVERITY_INFO: u8 = 2u8;

// 引用种类标签取自 proc/diag.md 3.3 的固定小写拼写。
// 六种合法种类在此穷举；写入前必须已校验种类范围，禁止静默写出空标签。
function write_ref_kind(dst: &buf::ByteBuf:ReadWrite, kind: u8): void!AllocError {
    if kind == 0u8 {
        buf::buf_push_bytes(dst, "def")?;
    } elseif kind == 1u8 {
        buf::buf_push_bytes(dst, "builtin")?;
    } elseif kind == 2u8 {
        buf::buf_push_bytes(dst, "import")?;
    } elseif kind == 3u8 {
        buf::buf_push_bytes(dst, "field")?;
    } elseif kind == 4u8 {
        buf::buf_push_bytes(dst, "variant")?;
    } else {
        buf::buf_push_bytes(dst, "local")?;
    }
    return;
}

function write_severity(dst: &buf::ByteBuf:ReadWrite, severity: u8): void!AllocError {
    if severity == SEVERITY_ERROR {
        buf::buf_push_bytes(dst, "error")?;
    } elseif severity == SEVERITY_WARNING {
        buf::buf_push_bytes(dst, "warning")?;
    } else {
        buf::buf_push_bytes(dst, "info")?;
    }
    return;
}

function write_u32_decimal(dst: &buf::ByteBuf:ReadWrite, val: u32): void!AllocError {
    if val == 0 {
        buf::buf_push_u8(dst, 48 as u8)?;
        return;
    }
    var digits: u8[] = [];
    var v: u32 = val;
    while v > 0 {
        @push(digits, (48 as u8) + ((v % 10) as u8))?;
        v = v / 10;
    }
    var i: u32 = @len(digits) as u32;
    while i > 0 {
        i = i - 1;
        buf::buf_push_u8(dst, digits[i])?;
    }
    return;
}

function write_u64_decimal(dst: &buf::ByteBuf:ReadWrite, val: u64): void!AllocError {
    if val == 0u64 {
        buf::buf_push_u8(dst, 48 as u8)?;
        return;
    }
    var digits: u8[] = [];
    var v: u64 = val;
    while v > 0u64 {
        @push(digits, (48 as u8) + ((v % 10u64) as u8))?;
        v = v / 10u64;
    }
    var i: u32 = @len(digits) as u32;
    while i > 0 {
        i = i - 1;
        buf::buf_push_u8(dst, digits[i])?;
    }
    return;
}

function hex_digit(v: u8): u8 {
    if v < 10u8 { return (48 as u8) + v; }
    return (97 as u8) + (v - 10u8);
}

// 最小 JSON 转义：只处理引号、反斜杠与控制字符；UTF-8 多字节原样透传。
function write_json_string(dst: &buf::ByteBuf:ReadWrite, text: &[u8]:Read): void!AllocError {
    var i: u32 = 0;
    while i < @len(text) as u32 {
        let b: u8 = text[i];
        if b == 34u8 {
            buf::buf_push_bytes(dst, "\\\"")?;
        } elseif b == 92u8 {
            buf::buf_push_bytes(dst, "\\\\")?;
        } elseif b == 8u8 {
            buf::buf_push_bytes(dst, "\\b")?;
        } elseif b == 12u8 {
            buf::buf_push_bytes(dst, "\\f")?;
        } elseif b == 10u8 {
            buf::buf_push_bytes(dst, "\\n")?;
        } elseif b == 13u8 {
            buf::buf_push_bytes(dst, "\\r")?;
        } elseif b == 9u8 {
            buf::buf_push_bytes(dst, "\\t")?;
        } elseif b < 32u8 {
            buf::buf_push_bytes(dst, "\\u00")?;
            buf::buf_push_u8(dst, hex_digit(b / 16u8))?;
            buf::buf_push_u8(dst, hex_digit(b % 16u8))?;
        } else {
            buf::buf_push_u8(dst, b)?;
        }
        i = i + 1;
    }
    return;
}

// 引用按种类输出：import 是 [依赖编号, 导出编号] 二元组，其余是单一 id 域数值。
function write_ref(dst: &buf::ByteBuf:ReadWrite, r: &diag::DiagRef:Read): void!AllocError {
    buf::buf_push_bytes(dst, "{\"kind\":\"")?;
    write_ref_kind(dst, r.kind)?;
    buf::buf_push_bytes(dst, "\",\"id\":")?;
    if r.kind == 2u8 {
        buf::buf_push_u8(dst, 91u8)?;
        write_u32_decimal(dst, r.dep as u32)?;
        buf::buf_push_u8(dst, 44u8)?;
        write_u32_decimal(dst, r.value)?;
        buf::buf_push_u8(dst, 93u8)?;
    } else {
        write_u32_decimal(dst, r.value)?;
    }
    buf::buf_push_u8(dst, 125u8)?;
    return;
}

function write_line(dst: &buf::ByteBuf:ReadWrite, d: &diag::Diag:Read, unit: &[u8]:Read): void!AllocError {
    buf::buf_push_bytes(dst, "{\"unit\":\"")?;
    write_json_string(dst, unit)?;
    buf::buf_push_bytes(dst, "\",\"code\":")?;
    let code: types::ErrorCode = d.code;
    write_u32_decimal(dst, code.raw as u32)?;
    buf::buf_push_bytes(dst, ",\"severity\":\"")?;
    write_severity(dst, d.severity)?;
    let span: types::Span = d.span;
    buf::buf_push_bytes(dst, "\",\"span\":{\"off\":")?;
    write_u32_decimal(dst, span.offset)?;
    buf::buf_push_bytes(dst, ",\"len\":")?;
    write_u32_decimal(dst, span.length)?;
    buf::buf_push_u8(dst, 125u8)?;
    buf::buf_push_bytes(dst, ",\"refs\":[")?;
    var i: u32 = 0;
    while i < d.refs.count as u32 {
        if i > 0 { buf::buf_push_u8(dst, 44u8)?; }
        write_ref(dst, &d.refs.items[i]:Read)?;
        i = i + 1;
    }
    buf::buf_push_bytes(dst, "],\"args\":{")?;
    // 参数键名尚未在 proc/diag.md 固定；非零参数整体拒绝，绝不静默丢弃重复项。
    buf::buf_push_bytes(dst, "}}\n")?;
    return;
}

// 先整体校验再逐条写入：任一条无法表示就返回 false 且不留下半条记录。
export function write_into(dst: &buf::ByteBuf:ReadWrite, buffer: &diag::DiagBuffer:Read, unit: &[u8]:Read): bool!AllocError {
    var i: u32 = 0;
    while i < buffer.count {
        let d: diag::Diag = buffer.diags[i];
        if d.severity > SEVERITY_INFO { return false; }
        if d.refs.count > 4u8 { return false; }
        if d.args.count != 0u8 { return false; }
        var r: u32 = 0;
        while r < d.refs.count as u32 {
            let kind: u8 = d.refs.items[r].kind;
            if kind > 5u8 { return false; }
            if kind == 2u8 {
                // ImportRef 必须带真实依赖编号，0 不是合法 DependencyId。
                if d.refs.items[r].dep == 0u16 { return false; }
            } elseif d.refs.items[r].dep != 0u16 {
                return false;
            }
            r = r + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < buffer.count {
        let d: diag::Diag = buffer.diags[i];
        write_line(dst, &d:Read, unit)?;
        i = i + 1;
    }
    return true;
}
