// YSM 指令流形态扫描与结构自校验。
// 与 ysm_write 的 encode_inst / encode_terminator 严格同构，游标必须逐字节精确推进，
// 任何长度不符、越界、块间空隙或形态未覆盖都按 Y-4（7026）拒绝。
import types;
import diag;
import mir;
import ysm;

const YSM_VERSION_TRAP_EDGES: u16 = 5;
const YSM_VERSION_TYPE_REFS: u16 = 6;
const E_Y4: u16 = 7026;

// 终结指令 opcode（mir.md 4.13）
const TERM_CARRIER_DISPATCH: u8 = 162;
const TERM_ENUM_DISPATCH: u8 = 177;
const TERM_BR: u8 = 192;
const TERM_BRANCH: u8 = 193;
const TERM_RET: u8 = 194;
const TERM_TRAP: u8 = 195;
const TERM_UNREACHABLE: u8 = 196;
const TERM_EXIT: u8 = 197;

const S_AGG: u8 = 10;
const S_CALL: u8 = 11;
const S_SLICE: u8 = 12;
const S_ENUM: u8 = 13;
// 聚合常量复制（mir.md 0x04）：result + static_index + byte_len，不编码 TypeSig，
// 结果类型由 locals 节承载、条目类型由 statics 记录的 type_sig_off 承载。
const S_CONST_AGG: u8 = 21;
const S_DYN_PUSH: u8 = 22;
const S_CLONE: u8 = 23;
const S_FUNCTION_ADDR: u8 = 24;

struct InstReader { pos: u32, bad: bool }

function need_bytes(r: &InstReader:Read, data_len: u32, count: u32): bool {
    if r.bad || r.pos > data_len { return false; }
    return count <= data_len - r.pos;
}
function fail_reader(r: &InstReader:ReadWrite): void {
    r.bad = true;
    return;
}
function take_u8(r: &InstReader:ReadWrite, data: &[u8]): u8 {
    if !need_bytes(r, @len(data) as u32, 1) { fail_reader(r); return 0; }
    let value: u8 = data[r.pos];
    r.pos = r.pos + 1;
    return value;
}
function take_u16(r: &InstReader:ReadWrite, data: &[u8]): u16 {
    if !need_bytes(r, @len(data) as u32, 2) { fail_reader(r); return 0; }
    let value: u16 = (data[r.pos] as u16) | ((data[r.pos + 1] as u16) << 8);
    r.pos = r.pos + 2;
    return value;
}
function take_u32(r: &InstReader:ReadWrite, data: &[u8]): u32 {
    if !need_bytes(r, @len(data) as u32, 4) { fail_reader(r); return 0; }
    let value: u32 = (data[r.pos] as u32) | ((data[r.pos + 1] as u32) << 8)
        | ((data[r.pos + 2] as u32) << 16) | ((data[r.pos + 3] as u32) << 24);
    r.pos = r.pos + 4;
    return value;
}
// 不读取值的定宽操作数只检查整个区间一次。
function skip_bytes(r: &InstReader:ReadWrite, data: &[u8], count: u32): bool {
    if !need_bytes(r, @len(data) as u32, count) { fail_reader(r); return false; }
    r.pos = r.pos + count;
    return true;
}
// 变长参数向量：count:u32 后随 count 个 LocalId；count 过大或字节不足置失败。
function skip_locals(r: &InstReader:ReadWrite, data: &[u8]): void {
    let count: u32 = take_u32(r, data);
    if count > 1073741823u32 { fail_reader(r); return; }
    if !need_bytes(r, @len(data) as u32, count * 4) { fail_reader(r); return; }
    r.pos = r.pos + count * 4;
    return;
}
function local_fn_ref(file: &ysm::YsmFile:Read, func: &ysm::YsmFunctionRecord:Read, local: u32): bool {
    if local == 0 || local > func.local_count || func.local_start as u64 + local as u64 > @len(file.locals) { return false; }
    let sig: u32 = file.locals[func.local_start + local - 1].type_sig_off;
    return sig < @len(file.type_sigs) as u32 && file.type_sigs[sig] == 9;
}

function scan_function_address(r: &InstReader:ReadWrite, data: &[u8], file: &ysm::YsmFile:Read, func: &ysm::YsmFunctionRecord:Read): bool {
    let result: u32 = take_u32(r, data);
    let dep: u32 = take_u16(r, data) as u32;
    let target: u32 = take_u32(r, data);
    if r.bad || target == 0 || !local_fn_ref(file, func, result) { return false; }
    if dep != 0 {
        return dep <= @len(file.dependencies) as u32 && file.dependencies[dep - 1].dependency_id as u32 == dep;
    }
    var i: u32 = 0;
    while i < @len(file.functions) as u32 {
        if file.functions[i].def_id == target { return true; }
        i = i + 1;
    }
    return false;
}
// 变长或有语义约束的普通指令：opcode 已由外层消费。
function scan_inst(r: &InstReader:ReadWrite, data: &[u8], file: &ysm::YsmFile:Read, func: &ysm::YsmFunctionRecord:Read, local_base: u32, pool_len: u32, op: u8, shape: u8): bool {
    if shape == S_FUNCTION_ADDR { return scan_function_address(r, data, file, func); }
    if shape == S_CLONE {
        let result: u32 = take_u32(r, data);
        let src: u32 = take_u32(r, data);
        return !r.bad && result != src && result != 0 && src != 0 &&
            result <= func.local_count && src <= func.local_count;
    }
    if shape == S_SLICE {
        var i: u32 = 0;
        while i < 4 {
            let local: u32 = take_u32(r, data);
            if r.bad || local == 0 || local > func.local_count { return false; }
            i = i + 1;
        }
        let closed: u8 = take_u8(r, data);
        return !r.bad && closed == 0;
    }
    if shape == S_DYN_PUSH {
        var i: u32 = 0;
        while i < 3 {
            let local: u32 = take_u32(r, data);
            if r.bad || local == 0 || local > func.local_count { return false; }
            i = i + 1;
        }
        let stride: u32 = take_u32(r, data);
        return !r.bad && stride != 0;
    }
    if shape == S_AGG {
        if !skip_bytes(r, data, 8) { return false; }
        skip_locals(r, data);
        return !r.bad;
    }
    if shape == S_CALL {
        let has_result: u8 = take_u8(r, data);
        if r.bad { return false; }
        if has_result > 1 { return false; }
        if has_result == 1 {
            let result: u32 = take_u32(r, data);
            if (mir::is_checked_call(op) || mir::is_indirect_call(op) || op == 149) && (result == 0 || result > func.local_count) { return false; }
        }
        // 调用目标宽度随 opcode 而异（mir.md 4.10）。
        if mir::is_far_call(op) {
            let dep: u32 = take_u16(r, data) as u32;
            let exported: u32 = take_u32(r, data);
            if r.bad || dep == 0 || dep > @len(file.dependencies) as u32 || exported == 0 { return false; }
            if file.dependencies[dep - 1].dependency_id as u32 != dep { return false; }
        } elseif op == 146 {
            take_u16(r, data);
        } elseif mir::is_indirect_call(op) || op == 149 {
            let target: u32 = take_u32(r, data);
            if r.bad || target == 0 || (mir::is_indirect_call(op) && !local_fn_ref(file, func, target)) { return false; }
            let count: u32 = take_u32(r, data);
            if r.bad || count > 1073741823u32 || !need_bytes(r, @len(data) as u32, count * 4) { return false; }
            var i: u32 = 0;
            while i < count {
                let arg: u32 = take_u32(r, data);
                if arg == 0 || arg > func.local_count { return false; }
                i = i + 1;
            }
            return !r.bad;
        } else {
            let target: u32 = take_u32(r, data);
            if mir::is_checked_call(op) && target == 0 { return false; }
        }
        skip_locals(r, data);
        return !r.bad;
    }
    if shape == S_ENUM {
        take_u32(r, data);
        take_u32(r, data);
        take_u16(r, data);
        let has_payload: u8 = take_u8(r, data);
        if r.bad { return false; }
        if has_payload > 1 { return false; }
        if has_payload == 1 { take_u32(r, data); }
        return !r.bad;
    }
    if shape == S_CONST_AGG {
        let result: u32 = take_u32(r, data);
        let index: u32 = take_u32(r, data);
        let byte_len: u32 = take_u32(r, data);
        if r.bad { return false; }
        // 聚合复制的四重合约：(1) 静态索引落在记录表内，(2) 条目完整落在字节池内，
        // (3) 结果局部与条目共用同一 TypeSig 偏移，(4) 指令 byte_len 等于条目长度。
        if index >= @len(file.statics) as u32 { return false; }
        let entry: ysm::YsmStaticRecord = file.statics[index];
        if entry.byte_off > pool_len { return false; }
        if entry.byte_len > pool_len - entry.byte_off { return false; }
        if byte_len != entry.byte_len { return false; }
        if result == 0 || result > func.local_count { return false; }
        if local_base + result - 1 >= @len(file.locals) as u32 { return false; }
        let local: ysm::YsmLocalRecord = file.locals[local_base + result - 1];
        return local.type_sig_off == entry.type_sig_off;
    }
    // 其余形态编码器本身不发射（如切片借用），出现在流里一律按 Y-4 拒绝。
    return false;
}
// 终结指令按 mir.md 4.13 与 4.11 编码消耗字节，必须与 encode_terminator 严格同构。
// 臂目标集合：ids 为函数内严格升序的 BlockId，flags 与之一一对应。
// 只有 162 的成功/错误臂与 177 的臂/默认臂可以携带臂载荷。
struct ArmSink { ids: u16[], flags: u8[] }
function arm_mark(sink: &ArmSink:ReadWrite, id: u16): bool {
    var lo: u32 = 0;
    var hi: u32 = @len(sink.ids) as u32;
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2;
        let value: u16 = sink.ids[mid];
        if value == id { sink.flags[mid] = 1; return true; }
        if value < id { lo = mid + 1; } else { hi = mid; }
    }
    return false;
}
// 私有陷阱清理块集合：ids 为函数内 BlockId 升序序列，pure 表示整块只含 drop 且以 trap 终结，
// used 表示该块已被某条陷阱边引用。
struct TrapSink { ids: u16[], pure: u8[], used: u8[] }
// 认领一条陷阱边的目标块：返回 0 表示目标不存在、不是纯清理块或已被其他边引用。
// 单源约束在此强制，避免两条边共享同一个清理块。
function trap_claim(sink: &TrapSink:ReadWrite, id: u16, kind: u8): u8 {
    var m: u32 = 0;
    while m < @len(sink.ids) as u32 {
        if sink.ids[m] == id {
            if sink.pure[m] != kind { return 0; }
            if sink.used[m] != 0 { return 0; }
            sink.used[m] = 1;
            return 1;
        }
        m = m + 1;
    }
    return 0;
}
function scan_terminator(r: &InstReader:ReadWrite, data: &[u8], op: u8, local_count: u32, arms: &ArmSink:ReadWrite): bool {
    if op == TERM_BR {
        take_u16(r, data);
        return !r.bad;
    }
    if op == TERM_BRANCH {
        take_u32(r, data);
        take_u16(r, data);
        take_u16(r, data);
        return !r.bad;
    }
    if op == TERM_RET {
        let has_value: u8 = take_u8(r, data);
        if r.bad || has_value > 1 { return false; }
        if has_value == 1 { take_u32(r, data); }
        return !r.bad;
    }
    if op == TERM_TRAP {
        let reason: u8 = take_u8(r, data);
        return !r.bad && reason <= 2;
    }
    if op == TERM_UNREACHABLE { return true; }
    if op == TERM_EXIT {
        let code: u32 = take_u32(r, data);
        return !r.bad && code != 0 && code <= local_count;
    }
    if op == TERM_CARRIER_DISPATCH {
        take_u32(r, data);
        let ok: u16 = take_u16(r, data);
        let err: u16 = take_u16(r, data);
        if r.bad { return false; }
        if !arm_mark(arms, ok) || !arm_mark(arms, err) { return false; }
        return true;
    }
    if op == TERM_ENUM_DISPATCH {
        take_u32(r, data);
        let count: u32 = take_u32(r, data);
        if r.bad { return false; }
        var i: u32 = 0;
        while i < count {
            take_u16(r, data);
            let block: u16 = take_u16(r, data);
            if r.bad || !arm_mark(arms, block) { return false; }
            i = i + 1;
        }
        let has_default: u8 = take_u8(r, data);
        if r.bad || has_default > 1 { return false; }
        if has_default == 1 {
            let fallback: u16 = take_u16(r, data);
            if r.bad || !arm_mark(arms, fallback) { return false; }
        }
        return !r.bad;
    }
    return false;
}
// 扫描入口：返回 0 表示通过，否则为拒绝码（指令形态与定义不符，一律 Y-4）。
export function validate_inst_stream(file: &ysm::YsmFile:Read, diags: &diag::DiagBuffer:ReadWrite): u16!AllocError {
    return validate_inst_bytes(file, &file.insts[0..@len(file.insts)]:Read, diags)?;
}
// 指令区只借用编码字节；解析出的其余节记录与原入口共用。
// 是否存在私有陷阱边/守卫由文件版本决定：格式 5 起有陷阱边，格式 6 起 drop 带守卫。
export function validate_inst_bytes(file: &ysm::YsmFile:Read, data: &[u8], diags: &diag::DiagBuffer:ReadWrite): u16!AllocError {
    return validate_inst_bytes_v6(file, data, file.header.version >= YSM_VERSION_TRAP_EDGES, file.header.version >= YSM_VERSION_TYPE_REFS, diags)?;
}
// 旧调用方显式给出陷阱边开关；不读取 drop 守卫。
export function validate_inst_bytes_for(file: &ysm::YsmFile:Read, data: &[u8], trap_edges: bool, diags: &diag::DiagBuffer:ReadWrite): u16!AllocError {
    return validate_inst_bytes_v6(file, data, trap_edges, false, diags)?;
}
// 单函数指令流与陷阱/载荷归属扫描；失败只返回 false，由外层统一发射 E_Y4。
function scan_function_insts(file: &ysm::YsmFile:Read, data: &[u8], data_len: u32, func: &ysm::YsmFunctionRecord:Read, pool_len: u32, trap_edges: bool, drop_guard: bool, scanner: &InstReader:ReadWrite): bool!AllocError {
    // 每个函数一份臂目标集合，用于校验臂载荷归属；陷阱清理块集合同趟建立。
    var arms: ArmSink = ArmSink { ids: [], flags: [] };
    var traps: TrapSink = TrapSink { ids: [], pure: [], used: [] };
    var m: u32 = 0;
    while m < func.block_count {
        let rec: ysm::YsmBlockRecord = file.blocks[func.block_start + m];
        @push(arms.ids, rec.block_id)?;
        @push(arms.flags, 0)?;
        @push(traps.ids, rec.block_id)?;
        @push(traps.pure, 0)?;
        @push(traps.used, 0)?;
        m = m + 1;
    }
    // 本函数所有非零陷阱边，待整函数扫描完再统一校验，允许前向引用。
    var edges: u32[] = [];
    var b: u32 = 0;
    while b < func.block_count {
        if func.block_start + b >= @len(file.blocks) as u32 { return false; }
        let blk: ysm::YsmBlockRecord = file.blocks[func.block_start + b];
        // 块必须首尾相接：起点与游标不符说明指令流存在空隙或重叠。
        if blk.inst_off != scanner.pos { return false; }
        // 纯清理块判定：整块普通指令全部为 drop，且以 trap 终结。
        var pure_block: bool = true;
        var k: u32 = 0;
        while k < blk.inst_count {
            if scanner.pos >= data_len { return false; }
            let op: u8 = data[scanner.pos];
            let info: u16 = ysm::op_info(op);
            let width: u32 = (info >> 5) as u32;
            scanner.pos = scanner.pos + 1;
            if width != 0 {
                if width > data_len - scanner.pos { return false; }
                scanner.pos = scanner.pos + width;
            } elseif !scan_inst(scanner, data, file, func, func.local_start, pool_len, op, (info & 31u16) as u8) {
                return false;
            }
            // 格式 6：drop 指令体之后追加 guard:u32；0 表示无守卫。
            if drop_guard && op == 115 {
                let guard: u32 = take_u32(scanner, data);
                if scanner.bad || guard > func.local_count { return false; }
            }
            if op != 115 { pure_block = false; }
            // 格式 5：每条可陷阱指令体之后都有一条边，零表示走函数级 trap_target。
            if trap_edges && mir::has_trap_edge(op) {
                let edge: u16 = take_u16(scanner, data);
                if scanner.bad { return false; }
                if edge != 0 {
                    let kind: u32 = mir::trap_reason(op) + 1;
                    @push(edges, (kind << 16u32) | edge as u32)?;
                }
            }
            k = k + 1;
        }
        let top: u8 = take_u8(scanner, data);
        if scanner.bad || top != blk.terminator { return false; }
        if !scan_terminator(scanner, data, top, func.local_count, &arms:ReadWrite) { return false; }
        // 私有清理块必须非空：空块即函数级 fallback，不能作为逐点边的目标。
        if blk.terminator == TERM_TRAP {
            let reason: u8 = data[scanner.pos - 1];
            if reason == 2 && (!pure_block || blk.inst_count == 0) { return false; }
            if pure_block && blk.inst_count != 0 { traps.pure[b] = reason + 1; }
        }
        b = b + 1;
    }
    // 每条非零陷阱边的目标必须是本函数内唯一的私有清理块：
    // 跨函数、共享目标、空块或指向函数级 fallback 一律按 Y-4 拒绝。
    let fallback: u16 = func.trap_target;
    m = 0;
    while m < @len(edges) as u32 {
        let target: u16 = (edges[m] as u16) - 1;
        let kind: u8 = (edges[m] >> 16u32) as u8;
        // 65535 是无 trap_target 的哨兵值（与写侧一致）。
        if fallback != 65535u16 && target == fallback { return false; }
        if trap_claim(&traps:ReadWrite, target, kind) == 0 { return false; }
        m = m + 1;
    }
    // 非零载荷必须落在 162/177 的臂目标上；其他块携带载荷为 Y-4。
    m = 0;
    while m < func.block_count {
        let rec: ysm::YsmBlockRecord = file.blocks[func.block_start + m];
        if traps.pure[m] == 3 && traps.used[m] == 0 { return false; }
        if rec.payload != 0 && arms.flags[m] == 0 { return false; }
        m = m + 1;
    }
    return true;
}

// 显式指定陷阱边/守卫开关的校验主体：写出侧自校验视图的版本字段恒为零，必须由调用方传入。
export function validate_inst_bytes_v6(file: &ysm::YsmFile:Read, data: &[u8], trap_edges: bool, drop_guard: bool, diags: &diag::DiagBuffer:ReadWrite): u16!AllocError {
    var pool_len: u32 = @len(file.static_bytes) as u32;
    var i: u32 = 0;
    while i < @len(file.statics) as u32 {
        let rec: ysm::YsmStaticRecord = file.statics[i];
        if rec.byte_off > pool_len || rec.byte_len > pool_len - rec.byte_off {
            ysm::emit_code(diags, types::error_code(E_Y4))?;
            return E_Y4;
        }
        i = i + 1;
    }
    let data_len: u32 = @len(data) as u32;
    var scanner: InstReader = InstReader { pos: 0, bad: false };
    i = 0;
    while i < @len(file.functions) as u32 {
        let func: &ysm::YsmFunctionRecord:Read = &file.functions[i]:Read;
        if !scan_function_insts(file, data, data_len, func, pool_len, trap_edges, drop_guard, &scanner:ReadWrite)? {
            ysm::emit_code(diags, types::error_code(E_Y4))?;
            return E_Y4;
        }
        i = i + 1;
    }
    if scanner.pos != data_len { ysm::emit_code(diags, types::error_code(E_Y4))?; return E_Y4; }
    return 0;
}
