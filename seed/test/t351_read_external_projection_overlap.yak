// expected_trap: eval: suspended or stale reference (OW-2)
function use(value: &u32, other: u32): u32 { return *value + other; }
function change(view: &[u32]:ReadWrite): u32 {
    var writable: &[u32]:ReadWrite = view;
    writable[0u32] = 2u32;
    return 0u32;
}
function main(): void {
    var data: u32[] = [1u32];
    let view: &[u32]:ReadWrite = &data[0u32..1u32]:ReadWrite;
    let result: u32 = use(@copy(view)[0u32], change(view));
}
