import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import copy_facts;
import typecheck_driver;
import layout;
import iface;
import iface_write;
import iface_load;
import mir;
import mir_lower;
import mir_verify;

foreign assert(cond: bool): void;

const TK_BUILTIN: u8 = 1;
const TK_IMPORTED: u8 = 3;
const BUILTIN_U32: u16 = 4099;

struct Loaded { parsed: parse::ParseResult, lexed: lex::LexResult }
// 直接依赖的载入接口与解析后的依赖集合必须同时保留：布局摘要只存在于前者。
struct Dep { loaded: iface::LoadedInterface, deps: resolve_refs::DependencySet }
struct Prep {
    input: Loaded,
    resolution: resolve_refs::Resolution,
    checked: typecheck::TypeCheckResult,
    layouts: layout::LayoutResult,
    imported_layouts: layout::ImportedLayoutTable,
    fields: layout::ImportedFieldLayoutTable,
}

function load(src: &[u8], file: u16): Loaded!AllocError {
    let r: lex::LexResult = lex::lex_scan(src, file)?;
    assert(@len(r.diagnostics) == 0);
    let p: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    assert(@len(p.diagnostics) == 0);
    return Loaded { parsed: p, lexed: r };
}

// 把依赖单元写成真实 .iface 再载入，得到可直接消费的摘要与字段签名。
function build_dep(src: &[u8], module_name: &[u8]): Dep!AllocError {
    let input: Loaded = load(src, 2100)?;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &input.lexed.names:Read, &empty:Read, module_name, &d:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &resolution:Read, &d:ReadWrite)?;
    let ly: layout::LayoutResult = layout::layout_unit(&tc.types:Read, &tc.fields:Read, &tc.enums:Read, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    var sizes: u64[] = [];
    var aligns: u8[] = [];
    var known: bool[] = [];
    var i: u32 = 0;
    while i < @len(ly.table.items) as u32 {
        @push(sizes, ly.table.items[i].size)?;
        @push(aligns, ly.table.items[i].align)?;
        @push(known, ly.table.items[i].known)?;
        i = i + 1;
    }
    let info: iface::LayoutData = iface::LayoutData { sizes: sizes, aligns: aligns, known: known };
    let built: iface::InterfaceResult = iface_write::write_interface(&input.parsed.file:Read, &input.parsed.pool:Read, &resolution:Read, &input.lexed.names:Read, &tc:Read, &info:Read, module_name, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    let loaded: iface::LoadedInterface = iface_load::load_interface(&built.data.bytes[0..@len(built.data.bytes)]:Read, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&deps:ReadWrite, &loaded:Read)?;
    return Dep { loaded: loaded, deps: deps };
}

// with_imports=false 模拟摘要缺失：布局与字段偏移都必须保持未知。
function prepare(user_src: &[u8], dep: &Dep:Read, with_imports: bool): Prep!AllocError {
    let input: Loaded = load(user_src, 2101)?;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &input.lexed.names:Read, &dep.deps:Read, "", &d:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &resolution:Read, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    var imported_layouts: layout::ImportedLayoutTable = layout::ImportedLayoutTable { items: [] };
    if with_imports {
        var si: u32 = 0;
        while si < @len(dep.loaded.summaries) as u32 {
            @push(imported_layouts.items, layout::ImportedLayout { dep: 1, export_id: dep.loaded.summaries[si].type_export_id, size: dep.loaded.summaries[si].size, align: dep.loaded.summaries[si].align })?;
            si = si + 1;
        }
    }
    let layouts: layout::LayoutResult = layout::layout_unit_with_imports(&checked.types:Read, &checked.fields:Read, &checked.enums:Read, &imported_layouts:Read, &checked.imported_enums:Read, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    let fields: layout::ImportedFieldLayoutTable = layout::imported_field_layouts(&checked.imported_fields:Read, &layouts.table:Read, &imported_layouts:Read)?;
    return Prep { input: input, resolution: resolution, checked: checked, layouts: layouts, imported_layouts: imported_layouts, fields: fields };
}

function find_kind(types: &typecheck::TypeTable:Read, kind: u8): u32 {
    var i: u32 = 0;
    while i < @len(types.entries) as u32 {
        if types.entries[i].kind == kind { return i + 1; }
        i = i + 1;
    }
    return 0;
}

function build(prep: &Prep:Read, drops: &u32[]:Read, layouts: &layout::ImportedLayoutTable:Read, fields: &layout::ImportedFieldLayoutTable:Read): mir::MirResult!AllocError {
    var d: diag::DiagBuffer = diag::diagbuf_new();
    return mir_lower::build_mir_with_drops(&prep.input.parsed.file:Read, &prep.input.parsed.pool:Read, &prep.resolution:Read, &prep.checked:Read, drops, layouts, fields, &prep.checked.imported_enums:Read, &d:ReadWrite)?;
}

// 正例：字段类型重映射、逐字段偏移、MIR 按值接受与字段访问。
function imported_struct_accepts(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32, c: u32 }\nexport function make(x: u32): Pair { return Pair { a: x, b: x + 1u32, c: x + 2u32 }; }\n", "dep")?;
    var prep: Prep = prepare("import dep; function take(p: dep::Pair): u32 { return p.a + p.b + p.c; }\n", &dep:Read, true)?;
    // 三个字段按 1 基声明序输出，消费方类型均为内建 u32。
    assert(@len(prep.checked.imported_fields.items) == 3);
    var i: u32 = 0;
    while i < 3 {
        let field: typecheck::ImportedFieldType = prep.checked.imported_fields.items[i];
        assert(field.dep == 1 && field.field == i + 1 && field.value_type_id != 0);
        let te: typecheck::TypeEntry = prep.checked.types.entries[field.value_type_id - 1];
        assert(te.kind == TK_BUILTIN && te.builtin == BUILTIN_U32);
        i = i + 1;
    }
    let pair: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(pair != 0);
    assert(prep.layouts.table.items[pair - 1].known);
    assert(prep.layouts.table.items[pair - 1].size == 12);
    assert(prep.layouts.table.items[pair - 1].align == 4);
    // 字段偏移按 yak64-v1 累加：0/4/8；整组均已确认。
    assert(@len(prep.fields.items) == 3);
    assert(prep.fields.items[0].offset == 0 && prep.fields.items[1].offset == 4 && prep.fields.items[2].offset == 8);
    assert(prep.fields.items[0].known && prep.fields.items[1].known && prep.fields.items[2].known);
    assert(@len(prep.checked.expr_types.members) == 3);
    i = 0;
    while i < 3 {
        assert(prep.checked.expr_types.members[i] == i + 1);
        prep.input.parsed.pool.members[i].name = 0;
        prep.resolution.refs.fields[i].name = 0;
        i = i + 1;
    }
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}

// 负例：字段表和接口保持不变，只有第二字段的投影偏移被改为第一字段。
function imported_field_projection_wrong_offset(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32 }\nexport struct Extra { c: u32 }\n", "dep")?;
    let prep: Prep = prepare("import dep; function take(p: dep::Pair, e: dep::Extra): u32 { return p.b + e.c; }\n", &dep:Read, true)?;
    let empty_drops: u32[] = [];
    var result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    assert(@len(result.module.imported_fields.items) == 3);
    assert(layout::imported_fields_ordered(&result.module.imported_fields:Read));
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 {
        let inst: mir::MirInst = result.module.functions[0].insts[i];
        if inst.op == 82 && mir::projection_field(inst) == 1 {
            assert(inst.c == 4);
            result.module.functions[0].insts[i].c = 0;
            assert(!mir_verify::verify_module(&result.module:Read)?);
            result.module.functions[0].insts[i].c = inst.c;
            assert(mir_verify::verify_module(&result.module:Read)?);
            return;
        }
        i = i + 1;
    }
    assert(false);
    return;
}

// 负例一：缺摘要（导入布局表为空）时字段偏移整组未知，MIR 拒绝。
function missing_summary_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32 }\nexport function make(x: u32): Pair { return Pair { a: x, b: x + 1u32 }; }\n", "dep")?;
    let prep: Prep = prepare("import dep; function take(p: dep::Pair): u32 { return p.a + p.b; }\n", &dep:Read, false)?;
    let pair: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(pair != 0);
    assert(!prep.layouts.table.items[pair - 1].known);
    assert(@len(prep.checked.imported_fields.items) == 2);
    assert(!prep.fields.items[0].known && !prep.fields.items[1].known);
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(!result.accepted);
    return;
}

// 负例二：传递依赖（类型指向非直接依赖编号 2，但仍只有 dep 1 的摘要）必须拒绝。
function transitive_dependency_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32 }\nexport function make(x: u32): Pair { return Pair { a: x, b: x + 1u32 }; }\n", "dep")?;
    var prep: Prep = prepare("import dep; function take(p: dep::Pair): u32 { return p.a + p.b; }\n", &dep:Read, true)?;
    let pair: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(pair != 0);
    // 把消费方导入身份改为依赖 2：直接依赖表中没有该编号的摘要。
    prep.checked.types.entries[pair - 1].dep = 2;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let layouts: layout::LayoutResult = layout::layout_unit_with_imports(&prep.checked.types:Read, &prep.checked.fields:Read, &prep.checked.enums:Read, &prep.imported_layouts:Read, &prep.checked.imported_enums:Read, &d:ReadWrite)?;
    assert(!diag::diagbuf_has_error(&d:Read));
    assert(!layouts.table.items[pair - 1].known);
    // 字段类型表也按依赖 2 重建：直接依赖表没有 dep 2 的摘要，整组偏移必须未知。
    var moved: typecheck::ImportedFieldTable = typecheck::ImportedFieldTable { items: [] };
    var fi: u32 = 0;
    while fi < @len(prep.checked.imported_fields.items) as u32 {
        let f: typecheck::ImportedFieldType = prep.checked.imported_fields.items[fi];
        @push(moved.items, typecheck::ImportedFieldType { dep: 2, export_id: f.export_id, field: f.field, value_type_id: f.value_type_id })?;
        fi = fi + 1;
    }
    let fields: layout::ImportedFieldLayoutTable = layout::imported_field_layouts(&moved:Read, &layouts.table:Read, &prep.imported_layouts:Read)?;
    assert(@len(fields.items) == 2);
    assert(!fields.items[0].known && !fields.items[1].known);
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &fields:Read)?;
    assert(!result.accepted);
    return;
}

// 负例三：缺字段偏移表（等价于手工接口无 struct_fields）时不得按值使用导入结构体。
function missing_offsets_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32 }\nexport function make(x: u32): Pair { return Pair { a: x, b: x + 1u32 }; }\n", "dep")?;
    var prep: Prep = prepare("import dep; function take(p: dep::Pair): u32 { return p.a + p.b; }\n", &dep:Read, true)?;
    assert(@len(prep.fields.items) == 2);
    // 清空字段类型表：布局摘要仍在，但字段偏移无从推导。
    prep.checked.imported_fields.items = [];
    let fields: layout::ImportedFieldLayoutTable = layout::imported_field_layouts(&prep.checked.imported_fields:Read, &prep.layouts.table:Read, &prep.imported_layouts:Read)?;
    assert(@len(fields.items) == 0);
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &fields:Read)?;
    assert(!result.accepted);
    return;
}

// 正例：消费方按字段名构造导入结构体，MIR 必须按导入字段表逐字段核验并接受构造指令。
function imported_struct_ctor_accepts(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u64, c: u32 }\n", "dep")?;
    var prep: Prep = prepare("import dep; function make(x: u32, y: u64): dep::Pair { return dep::Pair { b: y, c: x + 1u32, a: x }; }\n", &dep:Read, true)?;
    assert(@len(prep.checked.expr_types.ctors) == 1);
    assert(prep.checked.expr_types.ctors[0].fields[0] == 2 && prep.checked.expr_types.ctors[0].fields[1] == 3 && prep.checked.expr_types.ctors[0].fields[2] == 1);
    var clear: u32 = 0;
    while clear < 3 {
        prep.input.parsed.pool.ctors[0].fields[clear].name = 0;
        prep.resolution.refs.fields[clear].name = 0;
        clear = clear + 1;
    }
    let pair: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(pair != 0);
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    assert(mir_verify::verify_module(&result.module:Read)?);
    // 构造指令必须指向导入结构体类型，且实参个数等于字段总数。
    var found: bool = false;
    var i: u32 = 0;
    while i < @len(result.module.functions) as u32 {
        var j: u32 = 0;
        while j < @len(result.module.functions[i].insts) as u32 {
            if result.module.functions[i].insts[j].op == 96 {
                assert(result.module.functions[i].insts[j].value_type_id == pair);
                assert(result.module.functions[i].insts[j].args_count == 3);
                found = true;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert(found);
    return;
}

// 负例：导入字段表少一条时实参数目与字段总数不等，构造必须被拒绝。
function imported_struct_ctor_missing_field_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u64, c: u32 }\n", "dep")?;
    let prep: Prep = prepare("import dep; function make(x: u32, y: u64): dep::Pair { return dep::Pair { a: x, b: y, c: x + 1u32 }; }\n", &dep:Read, true)?;
    let empty_drops: u32[] = [];
    var result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    // 去掉声明序第二项：布局表缺项，但接口签名仍记录全部三个字段。
    var kept: layout::ImportedFieldLayout[] = [];
    var k: u32 = 0;
    while k < @len(result.module.imported_fields.items) as u32 {
        if k != 1 { @push(kept, result.module.imported_fields.items[k])?; }
        k = k + 1;
    }
    assert(@len(kept) == 2);
    result.module.imported_fields.items = kept;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    return;
}

// 负例：字段类型在消费方被换成另一已支持标量时，逐字段等值核验必须拒绝。
function imported_struct_ctor_wrong_type_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u64, c: u32 }\n", "dep")?;
    let prep: Prep = prepare("import dep; function make(x: u32, y: u64): dep::Pair { return dep::Pair { a: x, b: y, c: x + 1u32 }; }\n", &dep:Read, true)?;
    let empty_drops: u32[] = [];
    var result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    // 交换前两项的字段类型：它们都是消费方已支持标量，却与接口字段签名不符。
    let first: u32 = result.module.imported_fields.items[0].value_type_id;
    assert(first != result.module.imported_fields.items[1].value_type_id);
    result.module.imported_fields.items[0].value_type_id = result.module.imported_fields.items[1].value_type_id;
    result.module.imported_fields.items[1].value_type_id = first;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    return;
}

// 负例：字段仍已知，构造实参仍匹配，但布局事实不能与摘要、类型和声明序矛盾。
function imported_struct_ctor_wrong_layout_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u64, c: u32 }\n", "dep")?;
    let prep: Prep = prepare("import dep; function make(x: u32, y: u64): dep::Pair { return dep::Pair { c: x + 1u32, a: x, b: y }; }\n", &dep:Read, true)?;
    let empty_drops: u32[] = [];
    var result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    let first: layout::ImportedFieldLayout = result.module.imported_fields.items[0];
    let second: layout::ImportedFieldLayout = result.module.imported_fields.items[1];
    let third: layout::ImportedFieldLayout = result.module.imported_fields.items[2];
    assert(first.offset == 0 && second.offset == 8 && third.offset == 16);
    // 偏移仍对齐且在对象范围内，但会覆盖第一字段。
    result.module.imported_fields.items[1].offset = 0;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imported_fields.items[1] = second;
    // 独立更改字段存储宽度和对齐；实参仍具有原始类型。
    result.module.imported_fields.items[0].size = 2;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imported_fields.items[0] = first;
    result.module.imported_fields.items[0].align = 2;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imported_fields.items[0] = first;
    // 仅颠倒表项位置，不改字段编号，仍违反声明序存储。
    result.module.imported_fields.items[0] = third;
    result.module.imported_fields.items[2] = first;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imported_fields.items[0] = first;
    result.module.imported_fields.items[2] = third;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}

// 负例：同布局类型和构造实参一起调换，仍必须服从接口字段签名。
function imported_struct_ctor_swapped_same_layout_rejects(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { unsigned: u32, signed: i32 }\n", "dep")?;
    let prep: Prep = prepare("import dep; function make(x: u32, y: i32): dep::Pair { return dep::Pair { signed: y, unsigned: x }; }\n", &dep:Read, true)?;
    let empty_drops: u32[] = [];
    var result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let first: layout::ImportedFieldLayout = result.module.imported_fields.items[0];
    let second: layout::ImportedFieldLayout = result.module.imported_fields.items[1];
    assert(first.value_type_id != second.value_type_id && first.size == second.size && first.align == second.align);
    var i: u32 = 0;
    var found: bool = false;
    while i < @len(result.module.functions[0].insts) as u32 {
        let inst: mir::MirInst = result.module.functions[0].insts[i];
        if inst.op == 96 {
            assert(inst.args_count == 2);
            let at: u32 = inst.args_start;
            let x: u32 = result.module.functions[0].args[at];
            let y: u32 = result.module.functions[0].args[at + 1];
            result.module.functions[0].args[at] = y;
            result.module.functions[0].args[at + 1] = x;
            // 只交换实参时，原始接口与布局仍可信，必须由构造指令校验拒绝。
            assert(!mir_verify::verify_module(&result.module:Read)?);
            result.module.imported_fields.items[0].value_type_id = second.value_type_id;
            result.module.imported_fields.items[1].value_type_id = first.value_type_id;
            assert(!mir_verify::verify_module(&result.module:Read)?);
            result.module.functions[0].args[at] = x;
            result.module.functions[0].args[at + 1] = y;
            result.module.imported_fields.items[0] = first;
            result.module.imported_fields.items[1] = second;
            assert(mir_verify::verify_module(&result.module:Read)?);
            found = true;
            break;
        }
        i = i + 1;
    }
    assert(found);
    return;
}

// 正例：导入字段自身是定长数组时，构造分量不是标量，验证器必须按导入字段类型等值放行。
function imported_struct_ctor_nested_field_accepts(): void!AllocError {
    let dep: Dep = build_dep("export struct Wrap { a: u32, b: [u8; 4] }\n", "dep")?;
    let prep: Prep = prepare("import dep; function make(x: u32): dep::Wrap { return dep::Wrap { a: x, b: [1u8, 2u8, 3u8, 4u8] }; }\n", &dep:Read, true)?;
    let wrap: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(wrap != 0);
    // 字段 b 的消费方类型必须与构造分量同为定长数组，而不是标量。
    var nested: bool = false;
    var i: u32 = 0;
    while i < @len(prep.checked.imported_fields.items) as u32 {
        if prep.checked.imported_fields.items[i].field == 2 {
            let te: typecheck::TypeEntry = prep.checked.types.entries[prep.checked.imported_fields.items[i].value_type_id - 1];
            assert(te.kind == 7);
            nested = true;
        }
        i = i + 1;
    }
    assert(nested);
    let empty_drops: u32[] = [];
    let result: mir::MirResult = build(&prep:Read, &empty_drops:Read, &prep.imported_layouts:Read, &prep.fields:Read)?;
    assert(result.accepted);
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}

// 整组乱序仍保留 Copy 判定；组内序号或类型异常必须拒绝。
function imported_copy_field_order(): void!AllocError {
    let dep: Dep = build_dep("export struct Pair { a: u32, b: u32 }\nexport struct Extra { c: u32 }\n", "dep")?;
    var prep: Prep = prepare("import dep; function read_pair(p: dep::Pair): u32 { return p.b; }\n", &dep:Read, true)?;
    let pair: u32 = find_kind(&prep.checked.types:Read, TK_IMPORTED);
    assert(pair != 0 && @len(prep.checked.imported_fields.items) == 3);
    let first: typecheck::ImportedFieldType = prep.checked.imported_fields.items[0];
    let second: typecheck::ImportedFieldType = prep.checked.imported_fields.items[1];
    let third: typecheck::ImportedFieldType = prep.checked.imported_fields.items[2];
    let ordered: u8 = copy_facts::imported_copy_order(&prep.checked:Read);
    assert(ordered == 3 && copy_facts::is_copy_value_ordered(&prep.checked:Read, pair, ordered));
    assert(copy_facts::is_copy_value(&prep.checked:Read, pair));
    if first.export_id == second.export_id {
        prep.checked.imported_fields.items[0] = third;
        prep.checked.imported_fields.items[1] = first;
        prep.checked.imported_fields.items[2] = second;
    } else {
        prep.checked.imported_fields.items[0] = second;
        prep.checked.imported_fields.items[1] = third;
        prep.checked.imported_fields.items[2] = first;
    }
    let unordered: u8 = copy_facts::imported_copy_order(&prep.checked:Read);
    assert(unordered == 1 && copy_facts::is_copy_value_ordered(&prep.checked:Read, pair, unordered));
    prep.checked.imported_fields.items[0] = first;
    prep.checked.imported_fields.items[1] = second;
    prep.checked.imported_fields.items[2] = third;
    var i: u32 = 0;
    while prep.checked.imported_fields.items[i].export_id != prep.checked.types.entries[pair - 1].export_id { i = i + 1; }
    prep.checked.imported_fields.items[i].field = 2;
    assert(!copy_facts::is_copy_value_ordered(&prep.checked:Read, pair, ordered));
    assert(!copy_facts::is_copy_value(&prep.checked:Read, pair));
    prep.checked.imported_fields.items[i].field = 1;
    prep.checked.imported_fields.items[i].value_type_id = 0;
    assert(!copy_facts::is_copy_value_ordered(&prep.checked:Read, pair, ordered));
    return;
}

function main(): void {
    imported_copy_field_order()?;
    imported_struct_accepts()?;
    missing_summary_rejects()?;
    transitive_dependency_rejects()?;
    missing_offsets_rejects()?;
    imported_struct_ctor_accepts()?;
    imported_struct_ctor_missing_field_rejects()?;
    imported_struct_ctor_wrong_type_rejects()?;
    imported_struct_ctor_wrong_layout_rejects()?;
    imported_field_projection_wrong_offset()?;
    imported_struct_ctor_swapped_same_layout_rejects()?;
    imported_struct_ctor_nested_field_accepts()?;
    return;
}
