import lex;
import parse;
foreign assert(cond: bool): void;
function main(): void {
    let r: lex::LexResult = lex::lex_scan("import io::fs;\n", 7)?;
    let p: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, 7)?;
    assert(@len(p.diagnostics) == 0);
    assert(@len(p.file.items) == 1);
    assert(p.file.items[0].kind == 5);
    assert(@len(p.pool.imports[0].path) == 2);
    let f: lex::LexResult = lex::lex_scan("function add(x: i32): i32 { return; }\n", 8)?;
    let q: parse::ParseResult = parse::parse_file(&f.tokens[0..@len(f.tokens)]:Read, &f.names:Read, 8)?;
    assert(@len(q.diagnostics) == 0);
    assert(@len(q.pool.functions) == 1);
    assert(q.pool.functions[0].name == f.tokens[1].payload as u32);
    assert(@len(q.pool.functions[0].params) == 1);
    let e: lex::LexResult = lex::lex_scan("function calc(): i32 { return 1 + 2 * 3; }\n", 15)?;
    let eq: parse::ParseResult = parse::parse_file(&e.tokens[0..@len(e.tokens)]:Read, &e.names:Read, 15)?;
    assert(@len(eq.diagnostics) == 0);
    assert(@len(eq.pool.binaries) == 2);
    let ex: lex::LexResult = lex::lex_scan("function exprs(): void { var a: i32 = 1; a = -a; a.field[0] = foo::bar(1, 2).field[0]; let b: i32[] = [1, 2, 3]; let c: i32 = !a; let p: &i32:Read = &a:Read; let q: i32 = *p; }\n", 24)?;
    let exq: parse::ParseResult = parse::parse_file(&ex.tokens[0..@len(ex.tokens)]:Read, &ex.names:Read, 24)?;
    assert(@len(exq.diagnostics) == 0);
    assert(@len(exq.pool.assigns) == 2);
    assert(@len(exq.pool.unaries) == 4);
    assert(@len(exq.pool.calls) == 1);
    assert(@len(exq.pool.members) == 2);
    assert(@len(exq.pool.indices) == 2);
    assert(@len(exq.pool.arrays) == 1);
    assert(@len(exq.pool.arrays[0].elements) == 3);
    assert(exq.pool.unaries[2].op == 19);
    assert(exq.pool.unaries[2].capability == 0);
    let bad_assign: lex::LexResult = lex::lex_scan("function bad_assign(): void { (1 + 2) = 3; }\n", 25)?;
    let bad_assign_q: parse::ParseResult = parse::parse_file(&bad_assign.tokens[0..@len(bad_assign.tokens)]:Read, &bad_assign.names:Read, 25)?;
    assert(@len(bad_assign_q.diagnostics) > 0);
    assert(bad_assign_q.diagnostics[0].code.raw == 2006);
    assert(bad_assign_q.diagnostics[0].span.file == 25);
    assert(bad_assign_q.diagnostics[0].span.length == 1);
    let bad_array: lex::LexResult = lex::lex_scan("function bad_array(): void { let a: i32[] = [1,]; }\n", 26)?;
    let bad_array_q: parse::ParseResult = parse::parse_file(&bad_array.tokens[0..@len(bad_array.tokens)]:Read, &bad_array.names:Read, 26)?;
    assert(@len(bad_array_q.diagnostics) > 0);
    let ty: lex::LexResult = lex::lex_scan("function typed(a: &i32:Read, b: &[u8]:ReadWrite): &function(&i32): void { let xs: i32[] = [1, 2]; let ys: [u8; 2] = [1, 2]; return; }\n", 27)?;
    let tyq: parse::ParseResult = parse::parse_file(&ty.tokens[0..@len(ty.tokens)]:Read, &ty.names:Read, 27)?;
    assert(@len(tyq.diagnostics) == 0);
    assert(@len(tyq.pool.refs) == 3);
    assert(@len(tyq.pool.fn_refs) == 1);
    assert(@len(tyq.pool.fixed_arrays) == 1);
    let fall: lex::LexResult = lex::lex_scan("enum ErrA { A } enum ErrB { B } function fall_one(): i32!ErrA { return; } function fall_many(): i32!(ErrA | ErrB) { return; }\n", 34)?;
    let fallq: parse::ParseResult = parse::parse_file(&fall.tokens[0..@len(fall.tokens)]:Read, &fall.names:Read, 34)?;
    assert(@len(fallq.diagnostics) == 0);
    assert(@len(fallq.pool.fallibles) == 2);
    assert(@len(fallq.pool.error_sets) == 2);
    assert(@len(fallq.pool.error_sets[0].members) == 1);
    assert(@len(fallq.pool.error_sets[1].members) == 2);
    assert(fallq.pool.types[fallq.pool.functions[0].ret_type].kind == 7);
    assert(fallq.pool.types[fallq.pool.functions[1].ret_type].kind == 7);
    assert(tyq.pool.types[tyq.pool.functions[0].params[0].type_ref].kind == 4);
    assert(tyq.pool.types[tyq.pool.functions[0].params[1].type_ref].kind == 5);
    assert(tyq.pool.types[tyq.pool.functions[0].ret_type].kind == 6);
    assert(tyq.pool.types[tyq.pool.locals[0].type_ref].kind == 3);
    assert(tyq.pool.types[tyq.pool.locals[1].type_ref].kind == 2);
    let bad_out: lex::LexResult = lex::lex_scan("function bad_out(): void { out x: &i32; }\n", 28)?;
    let bad_out_q: parse::ParseResult = parse::parse_file(&bad_out.tokens[0..@len(bad_out.tokens)]:Read, &bad_out.names:Read, 28)?;
    assert(@len(bad_out_q.diagnostics) > 0);
    assert(bad_out_q.diagnostics[0].code.raw == 6104);
    let bad_out_init: lex::LexResult = lex::lex_scan("function bad_out_init(): void { out x: i32 = 1; }\n", 28)?;
    let bad_out_init_q: parse::ParseResult = parse::parse_file(&bad_out_init.tokens[0..@len(bad_out_init.tokens)]:Read, &bad_out_init.names:Read, 28)?;
    assert(@len(bad_out_init_q.diagnostics) > 0);
    assert(bad_out_init_q.diagnostics[0].code.raw == 2007);
    let bad_init: lex::LexResult = lex::lex_scan("function bad_init(): void { let x: i32; }\n", 28)?;
    let bad_init_q: parse::ParseResult = parse::parse_file(&bad_init.tokens[0..@len(bad_init.tokens)]:Read, &bad_init.names:Read, 28)?;
    assert(@len(bad_init_q.diagnostics) > 0);
    assert(bad_init_q.diagnostics[0].code.raw == 2008);
    let bad_eof: lex::LexResult = lex::lex_scan("function bad_eof(): void { let x: i32 = 1\n", 29)?;
    assert(@len(bad_eof.diagnostics) == 0);
    assert(@len(bad_eof.tokens) > 0);
    let bad_eof_q: parse::ParseResult = parse::parse_file(&bad_eof.tokens[0..@len(bad_eof.tokens)]:Read, &bad_eof.names:Read, 29)?;
    assert(@len(bad_eof_q.diagnostics) > 0);
    let bad_positions: lex::LexResult = lex::lex_scan("struct BadField { x: &i32 } enum BadEnum { X(&i32) } function bad_ret(): &i32 { return; }\n", 30)?;
    let bad_positions_q: parse::ParseResult = parse::parse_file(&bad_positions.tokens[0..@len(bad_positions.tokens)]:Read, &bad_positions.names:Read, 30)?;
    assert(@len(bad_positions_q.diagnostics) >= 3);
    let bad_union: lex::LexResult = lex::lex_scan("function bad_union(): void { let x: A | B = y; }\n", 31)?;
    let bad_union_q: parse::ParseResult = parse::parse_file(&bad_union.tokens[0..@len(bad_union.tokens)]:Read, &bad_union.names:Read, 31)?;
    assert(@len(bad_union_q.diagnostics) > 0);
    let bad_generic: lex::LexResult = lex::lex_scan("function bad_generic<T>(): void { return; }\n", 32)?;
    let bad_generic_q: parse::ParseResult = parse::parse_file(&bad_generic.tokens[0..@len(bad_generic.tokens)]:Read, &bad_generic.names:Read, 32)?;
    assert(@len(bad_generic_q.diagnostics) == 1 && bad_generic_q.diagnostics[0].code.raw == 5101);
    let bad_generic_arg: lex::LexResult = lex::lex_scan("function bad_generic_arg(x: Vec<i32>): void { return; }\n", 33)?;
    let bad_generic_arg_q: parse::ParseResult = parse::parse_file(&bad_generic_arg.tokens[0..@len(bad_generic_arg.tokens)]:Read, &bad_generic_arg.names:Read, 33)?;
    assert(@len(bad_generic_arg_q.diagnostics) == 1 && bad_generic_arg_q.diagnostics[0].code.raw == 5101);
    let bad_is: lex::LexResult = lex::lex_scan("function bad_is(x: i32): void { if x is i32 { return; } }\n", 33)?;
    assert(@len(bad_is.diagnostics) > 0);
    assert(@len(q.pool.blocks[0].stmts) == 1);
    assert(q.pool.stmts[q.pool.blocks[0].stmts[0]].kind == 10);
    let lv: lex::LexResult = lex::lex_scan("function locals(): void { let x: i32 = 1; var y: i32 = 2; out z: i32; return; }\n", 14)?;
    let lq: parse::ParseResult = parse::parse_file(&lv.tokens[0..@len(lv.tokens)]:Read, &lv.names:Read, 14)?;
    assert(@len(lq.diagnostics) == 0);
    assert(@len(lq.pool.locals) == 3);
    assert(!lq.pool.locals[0].is_var);
    assert(lq.pool.locals[1].is_var);
    assert(lq.pool.locals[2].is_out);
    assert(@len(lq.pool.blocks[0].stmts) == 4);
    let bad: lex::LexResult = lex::lex_scan("function nullable(): i32? { return; }\n", 9)?;
    let b: parse::ParseResult = parse::parse_file(&bad.tokens[0..@len(bad.tokens)]:Read, &bad.names:Read, 9)?;
    assert(@len(b.diagnostics) > 0);
    assert(b.diagnostics[0].code.raw == 3008);
    assert(b.diagnostics[0].span.file == 9);
    assert(b.diagnostics[0].span.offset == 24);
    assert(b.diagnostics[0].span.length == 1);
    let d: lex::LexResult = lex::lex_scan("export enum Color { Red, Green(u8), }\n", 10)?;
    let s: parse::ParseResult = parse::parse_file(&d.tokens[0..@len(d.tokens)]:Read, &d.names:Read, 10)?;
    assert(@len(s.diagnostics) == 0);
    assert(@len(s.pool.enums) == 1);
    assert(s.pool.enums[0].is_export);
    assert(@len(s.pool.enums[0].variants) == 2);
    let d2: lex::LexResult = lex::lex_scan("struct Pair { left: i32, right: i32 }\n", 11)?;
    let s2: parse::ParseResult = parse::parse_file(&d2.tokens[0..@len(d2.tokens)]:Read, &d2.names:Read, 11)?;
    assert(@len(s2.diagnostics) == 0);
    assert(@len(s2.pool.structs) == 1);
    let d3: lex::LexResult = lex::lex_scan("const answer: i32 = 42;\n", 12)?;
    let s3: parse::ParseResult = parse::parse_file(&d3.tokens[0..@len(d3.tokens)]:Read, &d3.names:Read, 12)?;
    assert(@len(s3.diagnostics) == 0);
    assert(@len(s3.pool.consts) == 1);
    let c: lex::LexResult = lex::lex_scan("function flow(x: i32): void { if x { return; } elseif x { return; } else { return; } while x { break loop1; } }\n", 17)?;
    let cq: parse::ParseResult = parse::parse_file(&c.tokens[0..@len(c.tokens)]:Read, &c.names:Read, 17)?;
    assert(@len(cq.diagnostics) == 0);
    assert(@len(cq.pool.ifs) == 1);
    assert(@len(cq.pool.ifs[0].branches) == 2);
    assert(cq.pool.ifs[0].else_body != 4294967295u32);
    assert(@len(cq.pool.whiles) == 1);
    assert(cq.pool.whiles[0].label == 0);
    assert(cq.pool.blocks[cq.pool.whiles[0].body].stmts[0] != 0);
    assert(cq.pool.stmts[cq.pool.blocks[cq.pool.whiles[0].body].stmts[0]].kind == 11);
    assert(cq.pool.stmts[cq.pool.blocks[cq.pool.whiles[0].body].stmts[0]].data != 0);
    let c2: lex::LexResult = lex::lex_scan("function labeled(): void { loop1: while true { continue loop1; } }\n", 18)?;
    let c2q: parse::ParseResult = parse::parse_file(&c2.tokens[0..@len(c2.tokens)]:Read, &c2.names:Read, 18)?;
    assert(@len(c2q.diagnostics) == 0);
    assert(@len(c2q.pool.whiles) == 1);
    assert(c2q.pool.whiles[0].label != 0);
    assert(@len(c2q.pool.blocks[c2q.pool.whiles[0].body].stmts) == 1);
    assert(c2q.pool.stmts[c2q.pool.blocks[c2q.pool.whiles[0].body].stmts[0]].kind == 12);
    assert(c2q.pool.stmts[c2q.pool.blocks[c2q.pool.whiles[0].body].stmts[0]].data == c2q.pool.whiles[0].label);
    let bad_else: lex::LexResult = lex::lex_scan("function bad(): void { if true { return; } else if false { return; } }\n", 19)?;
    let bad_else_q: parse::ParseResult = parse::parse_file(&bad_else.tokens[0..@len(bad_else.tokens)]:Read, &bad_else.names:Read, 19)?;
    assert(@len(bad_else_q.diagnostics) > 0);
    let d4: lex::LexResult = lex::lex_scan("foreign print(x: i32): void;\n", 13)?;
    let s4: parse::ParseResult = parse::parse_file(&d4.tokens[0..@len(d4.tokens)]:Read, &d4.names:Read, 13)?;
    assert(@len(s4.diagnostics) == 0);
    assert(@len(s4.pool.foreigns) == 1);
    let m: lex::LexResult = lex::lex_scan("enum Color { Red, Green(u8), } function choose(c: Color): void { match c { Color::Red => { return; }, Color::Green(value) => { return; }, _ => { return; } } }\n", 20)?;
    let mq: parse::ParseResult = parse::parse_file(&m.tokens[0..@len(m.tokens)]:Read, &m.names:Read, 20)?;
    assert(@len(mq.diagnostics) == 0);
    assert(@len(mq.pool.matches) == 1);
    assert(@len(mq.pool.matches[0].arms) == 3);
    assert(mq.pool.patterns[mq.pool.matches[0].arms[0].pattern].kind == 0);
    assert(@len(mq.pool.patterns[mq.pool.matches[0].arms[0].pattern].path) == 2);
    assert(mq.pool.patterns[mq.pool.matches[0].arms[1].pattern].binding != 0);
    assert(mq.pool.patterns[mq.pool.matches[0].arms[2].pattern].kind == 1);
    let bad_variant: lex::LexResult = lex::lex_scan("enum Bad { _, Good } function next(): void { return; }\n", 21)?;
    let bad_variant_q: parse::ParseResult = parse::parse_file(&bad_variant.tokens[0..@len(bad_variant.tokens)]:Read, &bad_variant.names:Read, 21)?;
    assert(@len(bad_variant_q.diagnostics) == 1 && bad_variant_q.diagnostics[0].code.raw == 5810);
    assert(bad_variant_q.diagnostics[0].span.offset == 11 && bad_variant_q.diagnostics[0].span.length == 1);
    assert(@len(bad_variant_q.pool.enums) == 1 && @len(bad_variant_q.pool.enums[0].variants) == 1);
    assert(@len(bad_variant_q.pool.functions) == 1);
    let bad_match: lex::LexResult = lex::lex_scan("function bad_match(x: i32): void { match x { _ { return; } } }\n", 22)?;
    let bad_match_q: parse::ParseResult = parse::parse_file(&bad_match.tokens[0..@len(bad_match.tokens)]:Read, &bad_match.names:Read, 22)?;
    assert(@len(bad_match_q.diagnostics) > 0);
    let bad_comma: lex::LexResult = lex::lex_scan("function bad_comma(x: i32): void { match x { _ => { return; } _ => { return; } } }\n", 23)?;
    let bad_comma_q: parse::ParseResult = parse::parse_file(&bad_comma.tokens[0..@len(bad_comma.tokens)]:Read, &bad_comma.names:Read, 23)?;
    assert(@len(bad_comma_q.diagnostics) > 0);
    return;
}
