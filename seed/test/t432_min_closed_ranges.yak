import lex;
import ast;
import parse;
import types;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
foreign assert(condition: bool): void;
foreign write(data: &[u8]): void;

function range_offset(source: &[u8]): u32 {
    var i: u32 = 0;
    while (i as u64) + 2 < @len(source) {
        if source[i] == 46 && source[i + 1] == 46 && source[i + 2] == 61 { return i; }
        i = i + 1;
    }
    return 4294967295u32;
}

function lower_and_reject(): void!AllocError {
    let source: &[u8] = "const upper: u8 = 255;\nfunction f(a: &[u8]): u64 { return @len(&a[0..=upper]); }\n";
    let file: u16 = 31;
    let offset: u32 = range_offset(source);
    let base: lex::LexResult = lex::lex_scan(source, file)?;
    assert(@len(base.tokens) == 0 && @len(base.diagnostics) == 1 && base.diagnostics[0].code.raw == 3008);
    assert(base.diagnostics[0].span.offset == offset && base.diagnostics[0].span.length == 3);
    let lexed: lex::LexResult = lex::lex_scan_closed_ranges(source, file)?;
    assert(@len(lexed.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, file)?;
    assert(@len(parsed.diagnostics) == 0 && @len(parsed.pool.slices) == 1);
    let range: ast::SliceExpr = parsed.pool.slices[0];
    let addition: ast::Expr = parsed.pool.exprs[range.high];
    assert(addition.kind == 20 && addition.span.offset == offset && addition.span.length == 3);
    let sum: ast::BinaryExpr = parsed.pool.binaries[addition.data as u32];
    assert(sum.op == 11 && sum.left == range.inclusive_upper);
    assert(parsed.pool.exprs[sum.right].kind == 2 && parsed.pool.exprs[sum.right].data == 1);

    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diagnostics:ReadWrite)?;
    assert(diag::diagbuf_count(&diagnostics:Read) == 0);
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &resolved:Read, &diagnostics:ReadWrite)?;
    // rejection_spec: E3005 spec/lang/sugar.md#SU-5
    assert(diag::diagbuf_count(&diagnostics:Read) == 1 && diagnostics.diags[0].code.raw == 3005);
    let span: types::Span = diagnostics.diags[0].span;
    assert(span.file == file && span.offset == offset && span.length == 3);
    let typ: u32 = checked.expr_types.items[range.high];
    assert(checked.types.entries[typ - 1].builtin == 4097);
    return;
}

function check(source: &[u8], code: u16): void!AllocError {
    let lexed: lex::LexResult = lex::lex_scan_closed_ranges(source, 33)?;
    assert(@len(lexed.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 33)?;
    assert(@len(parsed.diagnostics) == 0);
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diagnostics:ReadWrite)?;
    assert(diag::diagbuf_count(&diagnostics:Read) == 0);
    typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &resolved:Read, &diagnostics:ReadWrite)?;
    let count: u32 = diag::diagbuf_count(&diagnostics:Read);
    var expected: bool = count == 0 && code == 0;
    if count == 1 && code != 0 { expected = diagnostics.diags[0].code.raw == code; }
    if !expected { write(source); diag::diagbuf_print_terminal(&diagnostics:Read)?; }
    assert(expected);
    return;
}

function rejects_other_positions(): void!AllocError {
    let source: &[u8] = "function f(): u64 { return 0..=1; }\n";
    let lexed: lex::LexResult = lex::lex_scan_closed_ranges(source, 34)?;
    assert(@len(lexed.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 34)?;
    assert(@len(parsed.diagnostics) == 1 && parsed.diagnostics[0].code.raw == 1010);
    assert(parsed.diagnostics[0].span.offset == range_offset(source) && parsed.diagnostics[0].span.length == 3);
    return;
}

function main(): void {
    lower_and_reject()?;
    rejects_other_positions()?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=18446744073709551615]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=127i8]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=32767i16]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=(65534u16 + 1)]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=(255u16 as u8)]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=4294967295u32]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=2147483647i32]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=9223372036854775807i64]); }\n", 3005)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=(0x1ff as u8)]); }\n", 1004)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=126i8]); }\n", 0)?;
    check("function f(a: &[u8]): u64 { return @len(&a[0..=-1]); }\n", 0)?;
    check("function f(a: &[u8], b: u8): u64 { return @len(&a[0..=b]); }\n", 0)?;
    check("function f(): u64 { let a: [u8; 4] = [1, 2, 3, 4]; return @len(&a[0..=3]); }\n", 0)?;
    check("function f(): u64 { let a: [u8; 4] = [1, 2, 3, 4]; return @len(&a[0..=4]); }\n", 6002)?;
    return;
}
