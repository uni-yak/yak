import ast;
import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import owner_state;
import pipeline;
foreign assert(ok: bool): void;

// 逐表达式与旧回溯对照，并覆盖文档模式与批处理的完整检查。
function compare(source: &[u8], projected: bool): void!AllocError {
    let lexed: lex::LexResult = lex::lex_scan(source, 212u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 212u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    let pool: &ast::AstPool:Read = &parsed.pool:Read;
    assert(ast::expression_depth_within(pool, 64u32)?);
    var names: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, pool, &lexed.names:Read, &deps:Read, "", &names:ReadWrite)?;
    assert(names.count == 0u32);
    let refs: &resolve_refs::RefTable:Read = &res.refs:Read;
    let roots: u32[] = owner_state::build_place_roots(pool, refs)?;
    if projected {
        assert(@len(roots) == @len(pool.exprs));
        var kinds: u32 = 0u32;
        var missing: bool = false;
        var i: u32 = 0u32;
        while i < @len(roots) as u32 {
            let root: u32 = owner_state::place_root(pool, refs, i);
            assert(roots[i] == root);
            if root == 0 { missing = true; }
            elseif pool.exprs[i].kind == 23 { kinds = kinds | 1u32; }
            elseif pool.exprs[i].kind == 24 { kinds = kinds | 2u32; }
            elseif pool.exprs[i].kind == 27 { kinds = kinds | 4u32; }
            i = i + 1u32;
        }
        assert(kinds == 7u32 && missing);
    } else { assert(@len(roots) == 0); }
    let document: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 212u16)?;
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    assert(pipeline::run_frontend(source, 212u16, &batch:ReadWrite)?);
    assert(pipeline::analysis_checked(document.status) && document.diagnostics.count == 0 && batch.count == 0);
    return;
}

// 文档侧表逐表达式与批处理回溯核对，包括再切片和复制。
function compare_slice_sources(source: &[u8]): void!AllocError {
    let lexed: lex::LexResult = lex::lex_scan(source, 213u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 213u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    let pool: &ast::AstPool:Read = &parsed.pool:Read;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, pool, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, pool, &res:Read, &diags:ReadWrite)?;
    assert(diags.count == 0 && ast::expression_depth_within(pool, 64u32)?);
    let refs: &resolve_refs::RefTable:Read = &res.refs:Read;
    let sources: u32[] = owner_state::build_slice_sources(pool, refs, &checked:Read)?;
    assert(@len(sources) == @len(pool.exprs));
    var saw_copy: bool = false;
    var saw_reslice: bool = false;
    var i: u32 = 0u32;
    while i < @len(sources) as u32 {
        assert(sources[i] == owner_state::slice_source(pool, refs, &checked:Read, i));
        if sources[i] < i && pool.exprs[i].kind == 22 { saw_copy = true; }
        if sources[i] < i && pool.exprs[i].kind == 27 { saw_reslice = true; }
        i = i + 1u32;
    }
    assert(saw_copy && saw_reslice);
    let document: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 213u16)?;
    assert(pipeline::run_frontend(source, 213u16, &diags:ReadWrite)?);
    assert(pipeline::analysis_checked(document.status) && document.diagnostics.count == 0 && diags.count == 0);
    return;
}

function compare_escape(): void!AllocError {
    let source: &[u8] = "function f(): void { let a: [u8; 1] = [1u8]; var v: &[u8] = &a[0..1]:Read; if true { let b: [u8; 1] = [2u8]; v = &b[0..1]:Read; } let n: u64 = @len(v); @drop(n); }\n";
    let document: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 214u16)?;
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    assert(!pipeline::run_frontend(source, 214u16, &batch:ReadWrite)?);
    assert(document.status == 1u8 && document.diagnostics.count == 1u32 && batch.count == 1u32);
    let actual: diag::Diag = document.diagnostics.diags[0];
    let expected: diag::Diag = batch.diags[0];
    assert(actual.code.raw == 6005u16 && actual.code.raw == expected.code.raw && actual.severity == expected.severity && actual.unit == expected.unit);
    assert(actual.span.offset == expected.span.offset && actual.span.length == expected.span.length && actual.span.file == expected.span.file);
    return;
}

function main(): void {
    compare("struct S { data: [[u32; 2]; 1] } function f(s: S): u64 { let v: &[u32] = s.data[0][0..2]; return @len(v); }\n", true)?;
    compare("function f(n: u32): u32 { return n; }\n", false)?;
    compare_slice_sources("function f(): u64 { let a: u8[] = [1u8, 2u8]; let v: &[u8] = &a[0..2]:Read; let w: &[u8] = @copy(v[0..1]); return @len(v) + @len(w); }\n")?;
    compare_escape()?;
    return;
}
