// module: buf=../../compiler/min/lib/buf.yak
// module: hash=../../compiler/min/lib/hash.yak
// module: hashmap=../../compiler/min/lib/hashmap.yak
// module: types=../../compiler/min/lib/types.yak
// module: lextables=../../compiler/min/src/lex/lextables.yak
// module: lex=../../compiler/min/src/lex/lex.yak
import lex;
foreign assert(cond: bool): void;
function main(): void {
    let r: lex::LexResult = lex::lex_scan("\"\" \"ab\" \"cd\" \"A\\0B\" \"\\u{1F600}\" '中' '\\u{10FFFF}' '\\0'\n", 7)?;
    assert(@len(r.diagnostics) == 0);
    assert(@len(r.tokens) == 9);
    assert(@len(r.statics) == 5);
    assert(@len(r.static_bytes) == 11);
    assert(r.statics[0].offset == 0 && r.statics[0].length == 0);
    assert(r.statics[1].offset == 0 && r.statics[1].length == 2);
    assert(r.statics[2].offset == 2 && r.statics[2].length == 2);
    assert(r.tokens[1].payload == 1 && r.tokens[2].payload == 2);
    assert(r.static_bytes[0] == 97 && r.static_bytes[2] == 99);
    assert(r.static_bytes[4] == 65 && r.static_bytes[5] == 0 && r.static_bytes[6] == 66);
    assert(r.static_bytes[7] == 240 && r.static_bytes[8] == 159);
    assert(r.static_bytes[9] == 152 && r.static_bytes[10] == 128);
    assert(r.tokens[5].kind == 4 && r.tokens[5].payload == 20013);
    assert(r.tokens[6].payload == 1114111 && r.tokens[7].payload == 0);
    assert(r.tokens[0].span.file == 7 && r.tokens[0].span.length == 2);
    assert(r.tokens[8].kind == 9 && r.tokens[8].span.length == 0);

    // 覆盖纯原文、多个转义边界、末段和字符标量，不改变静态索引。
    let mixed: lex::LexResult = lex::lex_scan_limited("\"中😀\" \"汉\\n😀\\0x\\u{7FF}é\" '😀' '\\n'\n", 8, 4, 0)?;
    let expected: &[u8] = "中😀汉\n😀\0x\u{7FF}é";
    assert(@len(mixed.diagnostics) == 0 && @len(mixed.tokens) == 5);
    assert(@len(mixed.statics) == 2 && @len(mixed.static_bytes) == @len(expected));
    assert(mixed.statics[0].offset == 0 && mixed.statics[0].length == 7);
    assert(mixed.statics[1].offset == 7 && mixed.statics[1].length == 14);
    assert(mixed.tokens[0].payload == 0 && mixed.tokens[1].payload == 1);
    assert(mixed.tokens[2].kind == 4 && mixed.tokens[2].payload == 128512);
    assert(mixed.tokens[3].kind == 4 && mixed.tokens[3].payload == 10);
    var i: u32 = 0;
    while i < @len(expected) as u32 {
        assert(mixed.static_bytes[i] == expected[i]);
        i = i + 1;
    }
    // 第二个字面量已解码过一段，但坏转义不能提交它的字节或条目。
    let bad: lex::LexResult = lex::lex_scan("\"ok\" \"前\\n后\\q\"\n", 9)?;
    assert(@len(bad.tokens) == 0 && @len(bad.diagnostics) == 1);
    assert(bad.diagnostics[0].code.raw == 1006 && bad.diagnostics[0].span.offset == 14);
    assert(bad.diagnostics[0].span.file == 9 && bad.diagnostics[0].span.length == 1);
    assert(@len(bad.statics) == 1 && @len(bad.static_bytes) == 2);
    assert(bad.static_bytes[0] == 111 && bad.static_bytes[1] == 107);
    let bad_char: lex::LexResult = lex::lex_scan("'😀x'\n", 10)?;
    assert(@len(bad_char.tokens) == 0 && @len(bad_char.diagnostics) == 1);
    assert(bad_char.diagnostics[0].code.raw == 1022 && bad_char.diagnostics[0].span.offset == 0);
    assert(@len(bad_char.statics) == 0 && @len(bad_char.static_bytes) == 0);
}
