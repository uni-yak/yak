// module: desugar=../../compiler/min/src/desugar/desugar.yak
// module: pipeline_index=../../compiler/min/src/check/pipeline_index.yak
// module: pipeline=../../compiler/min/src/check/pipeline.yak
// module: pipeline_stages=../../compiler/min/src/check/pipeline_stages.yak
import lex;
import parse;
import resolve_refs;
import diag;
import typecheck;
import typecheck_body;
import typecheck_shape;
foreign assert(cond: bool): void;

function main(): void {
    let source: &[u8] = "function f(): void { let x: &[u8] = \"x\"; }\n";
    let lexed: lex::LexResult = lex::lex_scan(source, 117u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 117u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    let expr: u32 = parsed.pool.locals[0].init;
    let funcs: typecheck::FuncTable = typecheck::FuncTable { items: [], by_def: [] };
    let defs: typecheck::DefTypeTable = typecheck::DefTypeTable { items: [] };
    let fields: typecheck::FieldTable = typecheck::FieldTable { items: [] };
    let enums: typecheck::EnumTable = typecheck::EnumTable { items: [] };
    let refs: resolve_refs::RefTable = resolve_refs::RefTable { items: [], imports: [], variants: [], fields: [], structs: [], enums: [], expr_index: [], type_index: [], pattern_index: [], enum_names: [], pending_names: 0, contextual_enum_labels: false };
    // u8 在第二行，新切片需读完两行；重复查找在第三行命中。
    var limit: u32 = 0u32;
    while limit <= 4u32 {
        var budget: typecheck_shape::BodyInferenceBudget = typecheck_shape::body_inference_budget(0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);
        budget.intern = typecheck::intern_budget(limit);
        var tt: typecheck::TypeTable = typecheck::new_table();
        let prefix: u32 = typecheck::intern_local(&tt:ReadWrite, 14u32)?;
        let byte: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4097u16)?;
        assert(prefix == 1u32 && byte == 2u32);
        var expr_types: typecheck::ExprTypeTable = typecheck::ExprTypeTable { items: [], members: [], ctors: [] };
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        let first: u32 = typecheck_body::infer_expr(&budget:ReadWrite, &expr_types:ReadWrite, &tt:ReadWrite, &funcs:Read, &defs:Read, &fields:Read, &enums:Read, &refs:Read, &diags:ReadWrite, &parsed.pool:Read, 0u32, expr, 0u32)?;
        assert(diags.count == 0u32 && budget.intern.remaining == 0u32);
        if limit == 0u32 || limit == 4u32 {
            assert(first == 3u32 && @len(tt.entries) == 3 && tt.entries[2].elem == byte);
            assert(expr_types.items[expr] == first && !typecheck_shape::body_intern_exceeded(&budget:Read));
        } else {
            assert(first == 0u32 && @len(tt.entries) == 2 && expr_types.items[expr] == 0u32);
            assert(typecheck_shape::body_intern_exceeded(&budget:Read));
        }
        let again: u32 = typecheck_body::infer_expr(&budget:ReadWrite, &expr_types:ReadWrite, &tt:ReadWrite, &funcs:Read, &defs:Read, &fields:Read, &enums:Read, &refs:Read, &diags:ReadWrite, &parsed.pool:Read, 0u32, expr, 0u32)?;
        if limit == 0u32 { assert(again == first && !typecheck_shape::body_intern_exceeded(&budget:Read)); }
        else { assert(again == 0u32 && typecheck_shape::body_intern_exceeded(&budget:Read)); }
        limit = limit + 1u32;
    }
    return;
}
