import buf;
import lex;
import diag;
import pipeline;
import typecheck;
import ast;
import parse;
import resolve_refs;
import resolve_unit;
import typecheck_driver;
import typecheck_body;
import typecheck_shape;
import consteval;
foreign assert(cond: bool): void;

function type_name(text: &buf::ByteBuf:ReadWrite, index: u32): void!AllocError {
    buf::buf_push_u8(text, 84u8)?;
    buf::buf_push_u8(text, 48u8 + (index / 10u32) as u8)?;
    buf::buf_push_u8(text, 48u8 + (index % 10u32) as u8)?;
    return;
}

function decl_intern_source(length: u32): buf::ByteBuf!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&text:ReadWrite, "enum E { ")?;
    var i: u32 = 1u32;
    while i <= 88u32 {
        type_name(&text:ReadWrite, i)?;
        buf::buf_push_bytes(&text:ReadWrite, "([u32; ")?;
        if i >= 10u32 { buf::buf_push_u8(&text:ReadWrite, 48u8 + (i / 10u32) as u8)?; }
        buf::buf_push_u8(&text:ReadWrite, 48u8 + (i % 10u32) as u8)?;
        buf::buf_push_bytes(&text:ReadWrite, "]), ")?;
        i = i + 1u32;
    }
    buf::buf_push_bytes(&text:ReadWrite, "Tail([u32; ")?;
    buf::buf_push_u8(&text:ReadWrite, 48u8 + (length / 10u32) as u8)?;
    buf::buf_push_u8(&text:ReadWrite, 48u8 + (length % 10u32) as u8)?;
    buf::buf_push_bytes(&text:ReadWrite, "]) }\n")?;
    return text;
}

function decl_intern_limit(): void!AllocError {
    let exact: buf::ByteBuf = decl_intern_source(39u32)?;
    let complete: pipeline::DocumentAnalysis = pipeline::run_document_frontend(&exact.data[0..exact.pos]:Read, 94u16)?;
    assert(pipeline::analysis_checked(complete.status) && complete.diagnostics.count == 0u32);
    let over: buf::ByteBuf = decl_intern_source(40u32)?;
    let source: &[u8] = &over.data[0..over.pos]:Read;
    let stopped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 95u16)?;
    assert(pipeline::analysis_decl_intern_exceeded(stopped.status));
    assert(stopped.diagnostics.count == 0u32 && !stopped.diagnostics.truncated);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(source, 95u16, &batch:ReadWrite)?;
    assert(accepted && batch.count == 0u32);
    let bad: &[u8] = "function main(): void { let n: bool = 1u32; if n { return; } }\n";
    var joined: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&joined:ReadWrite, source)?;
    buf::buf_push_bytes(&joined:ReadWrite, bad)?;
    let combined: &[u8] = &joined.data[0..joined.pos]:Read;
    let skipped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(combined, 96u16)?;
    assert(pipeline::analysis_decl_intern_exceeded(skipped.status) && skipped.diagnostics.count == 0u32);
    var real: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: bool = pipeline::run_frontend(combined, 96u16, &real:ReadWrite)?;
    assert(!rejected && real.count == 1u32 && real.diags[0].code.raw == 5001u16);
    return;
}

// 同一函数引用先写入参数，再在第二个字段按位置读取相同参数。
function signature_steps(): void!AllocError {
    let source: &[u8] = "struct S { a: &function(&u32): void, b: &function(&u32): void }\n";
    let lexed: lex::LexResult = lex::lex_scan(source, 97u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 97u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    let refs: &resolve_refs::RefTable = &resolution.refs:Read;
    let pool: &ast::AstPool = &parsed.pool:Read;
    let first: u32 = pool.structs[0].fields[0].type_ref;
    let second: u32 = pool.structs[0].fields[1].type_ref;
    var limits: u32[] = [10u32, 11u32, 25u32, 26u32];
    var i: u32 = 0u32;
    while i < 4u32 {
        let limit: u32 = limits[i];
        var work: typecheck::InternBudget = typecheck::intern_budget(limit);
        var tt: typecheck::TypeTable = typecheck::new_table();
        let parent: u32 = typecheck::intern_local_limited(&tt:ReadWrite, 1u32, &work:ReadWrite)?;
        assert(parent == 1u32);
        let left: u32 = typecheck::resolve_type_ref_limited(&tt:ReadWrite, refs, pool, first, &work:ReadWrite)?;
        if limit == 10u32 {
            assert(work.exhausted && left == 0u32 && @len(tt.members) == 0 && @len(tt.entries) == 4);
        } else {
            assert(!work.exhausted && left == 5u32 && @len(tt.members) == 1 && @len(tt.entries) == 5);
            if limit == 11u32 { assert(work.remaining == 0u32); }
            else {
                let right: u32 = typecheck::resolve_type_ref_limited(&tt:ReadWrite, refs, pool, second, &work:ReadWrite)?;
                assert(@len(tt.members) == 1 && @len(tt.entries) == 5 && work.remaining == 0u32);
                if limit == 25u32 { assert(work.exhausted && right == 0u32); }
                else { assert(!work.exhausted && right == left); }
            }
        }
        i = i + 1u32;
    }
    return;
}

// 逆序成员触发移位，第二个签名以顺序成员命中同一错误集。
function error_set_steps(): void!AllocError {
    let source: &[u8] = "enum E1 { A } enum E2 { B } function f(): void!(E2 | E1) { return; } function g(): void!(E1 | E2) { return; }\n";
    let lexed: lex::LexResult = lex::lex_scan(source, 98u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 98u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    let refs: &resolve_refs::RefTable = &res.refs:Read;
    let pool: &ast::AstPool = &parsed.pool:Read;
    let first: u32 = pool.functions[0].ret_type;
    let second: u32 = pool.functions[1].ret_type;
    let limits: u32[] = [13u32, 14u32, 18u32, 37u32, 38u32];
    var i: u32 = 0u32;
    while i < 5u32 {
        let limit: u32 = limits[i];
        var tt: typecheck::TypeTable = typecheck::new_table();
        let a: u32 = typecheck::intern_local(&tt:ReadWrite, res.result.file.items[0].def_id)?;
        let b: u32 = typecheck::intern_local(&tt:ReadWrite, res.result.file.items[1].def_id)?;
        var work: typecheck::InternBudget = typecheck::intern_budget(limit);
        let left: u32 = typecheck::resolve_type_ref_limited(&tt:ReadWrite, refs, pool, first, &work:ReadWrite)?;
        if limit == 13u32 {
            assert(work.exhausted && left == 0u32 && work.remaining == 1u32);
            assert(@len(tt.entries) == 3 && @len(tt.members) == 0);
        } else {
            assert(@len(tt.members) == 2 && tt.members[0] == a && tt.members[1] == b);
            if limit == 14u32 {
                assert(work.exhausted && left == 0u32 && work.remaining == 0u32 && @len(tt.entries) == 4);
            } else {
                assert(!work.exhausted && left == 5u32 && @len(tt.entries) == 5);
                if limit == 18u32 { assert(work.remaining == 0u32); }
                else {
                    let right: u32 = typecheck::resolve_type_ref_limited(&tt:ReadWrite, refs, pool, second, &work:ReadWrite)?;
                    assert(work.remaining == 0u32 && @len(tt.entries) == 5 && @len(tt.members) == 2);
                    if limit == 37u32 { assert(work.exhausted && right == 0u32); }
                    else { assert(!work.exhausted && right == left); }
                }
            }
        }
        i = i + 1u32;
    }
    return;
}

// 稀疏前向定义先驻留，槽位按定义编号增长，规范编号仍按首次访问顺序分配。
function nominal_index_steps(): void!AllocError {
    var limit: u32 = 5u32;
    while limit <= 8u32 {
        var work: typecheck::InternBudget = typecheck::document_intern_budget(limit);
        var tt: typecheck::TypeTable = typecheck::new_table();
        let scalar: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4099u16)?;
        assert(scalar == 1u32);
        let forward: u32 = typecheck::intern_local_limited(&tt:ReadWrite, 5u32, &work:ReadWrite)?;
        if limit == 5u32 {
            assert(work.exhausted && work.remaining == 4u32);
            assert(forward == 0u32 && @len(tt.entries) == 1 && @len(work.local_types) == 0);
        } else {
            assert(!work.exhausted && forward == 2u32 && @len(work.local_types) == 5);
            assert(work.local_types[1] == 0u32 && work.local_types[4] == forward);
            let earlier: u32 = typecheck::intern_local_limited(&tt:ReadWrite, 2u32, &work:ReadWrite)?;
            if limit == 6u32 {
                assert(work.exhausted && earlier == 0u32 && @len(tt.entries) == 2 && work.local_types[1] == 0u32);
            } else {
                assert(!work.exhausted && earlier == 3u32 && work.local_types[1] == earlier);
                let again: u32 = typecheck::intern_local_limited(&tt:ReadWrite, 5u32, &work:ReadWrite)?;
                if limit == 7u32 { assert(work.exhausted && again == 0u32); }
                else { assert(!work.exhausted && again == forward); }
                assert(@len(tt.entries) == 3 && tt.entries[1].def == 5u32 && tt.entries[2].def == 2u32);
            }
            assert(work.remaining == 0u32);
        }
        let stopped: bool = work.exhausted;
        typecheck::release_intern_index(&work:ReadWrite);
        assert(!work.index_local && @len(work.local_types) == 0 && work.exhausted == stopped);
        limit = limit + 1u32;
    }
    return;
}

// 合法源码的字段与载荷复用已驻留的规范编号，文档结果与批处理逐项一致。
function nominal_source_parity(): void!AllocError {
    let source: &[u8] = "struct Head { value: u32 }\nstruct Tail { head: Head }\nenum Wrap { A(Tail) }\n";
    let lexed: lex::LexResult = lex::lex_scan(source, 114u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 114u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var names: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &names:ReadWrite)?;
    assert(names.count == 0u32);
    var batch_diags: diag::DiagBuffer = diag::diagbuf_new();
    let batch: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &res:Read, &batch_diags:ReadWrite)?;
    var doc_diags: diag::DiagBuffer = diag::diagbuf_new();
    var intern: typecheck::InternBudget = typecheck::document_intern_budget(100u32);
    var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
    var material: consteval::MaterialBudget = consteval::material_budget(0u32);
    var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
    var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
    var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
    var shape: typecheck_shape::BodyInferenceBudget = typecheck_shape::body_inference_budget(0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);
    let doc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_with_body_budget(&parsed.file:Read, &parsed.pool:Read, &res:Read, &doc_diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite, &shape:ReadWrite, true)?;
    assert(batch_diags.count == 0u32 && doc_diags.count == 0u32 && !intern.exhausted);
    assert(!intern.index_local && @len(intern.local_types) == 0);
    let head: u32 = res.result.file.items[0].def_id;
    let tail: u32 = res.result.file.items[1].def_id;
    let wrap: u32 = res.result.file.items[2].def_id;
    assert(head < tail && tail < wrap);
    assert(typecheck::def_type(&doc.def_types:Read, head) == 1u32);
    assert(typecheck::def_type(&doc.def_types:Read, tail) == 3u32);
    assert(typecheck::def_type(&doc.def_types:Read, wrap) == 4u32);
    assert(@len(doc.types.entries) == 4 && @len(doc.types.entries) == @len(batch.types.entries));
    var i: u32 = 0u32;
    while i < @len(doc.types.entries) as u32 {
        assert(doc.types.entries[i].kind == batch.types.entries[i].kind && doc.types.entries[i].def == batch.types.entries[i].def);
        assert(doc.types.entries[i].elem == batch.types.entries[i].elem && doc.types.entries[i].builtin == batch.types.entries[i].builtin);
        i = i + 1u32;
    }
    assert(doc.fields.items[1].type_id == 1u32 && doc.fields.items[1].type_id == batch.fields.items[1].type_id);
    assert(doc.enums.items[0].payloads[0] == 3u32 && doc.enums.items[0].payloads[0] == batch.enums.items[0].payloads[0]);
    return;
}

function main(): void {
    nominal_index_steps()?;
    nominal_source_parity()?;
    signature_steps()?;
    error_set_steps()?;
    decl_intern_limit()?;
    return;
}
