import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import typecheck_body;
import typecheck_shape;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;


// 转换访问三个节点，下标访问一个节点；不足时不得返回部分类型表。
function small_steps(): void!AllocError {
    let src: &[u8] = "function f(): u32 { let xs: [u32; 1] = [0u32]; return ((0 + 0) as u32) + xs[0]; }\n";
    let lexed: lex::LexResult = lex::lex_scan(src, 111u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 111u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var name_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &name_diags:ReadWrite)?;
    assert(name_diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 4u32 {
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        var shape: typecheck_shape::BodyInferenceBudget = typecheck_shape::body_inference_budget(limit, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_with_body_budget(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite, &shape:ReadWrite, false)?;
        assert(typecheck_shape::body_shape_exceeded(&shape:Read) == (limit < 4u32) && shape.shape_remaining == 0u32);
        assert(diags.count == 0u32);
        if limit < 4u32 { assert(@len(checked.expr_types.items) == 0); }
        else { assert(@len(checked.expr_types.items) == @len(parsed.pool.exprs)); }
        limit = limit + 1u32;
    }
    return;
}

function tree(text: &buf::ByteBuf:ReadWrite, count: u32): void!AllocError {
    if count == 1u32 { buf::buf_push_bytes(text, "0")?; return; }
    let half: u32 = count / 2u32;
    buf::buf_push_bytes(text, "(")?;
    tree(text, half)?;
    buf::buf_push_bytes(text, " + ")?;
    tree(text, count - half)?;
    buf::buf_push_bytes(text, ")")?;
    return;
}

function over_limit(bad: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    if bad { buf::buf_push_bytes(&text:ReadWrite, "function broken(): void { let n: bool = 1u32; if n { return; } }\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, "function f(): u32 { let xs: [u32; 1] = [0u32]; return (")?;
    tree(&text:ReadWrite, 256u32)?;
    buf::buf_push_bytes(&text:ReadWrite, " as u32) + xs[0] + (0 as u32); }\n")?;
    let src: &[u8] = &text.data[0..text.pos]:Read;
    let checked: pipeline::DocumentAnalysis = pipeline::run_document_frontend(src, 112u16)?;
    assert(pipeline::analysis_integer_shape_exceeded(checked.status) && checked.diagnostics.count == 0u32 && !checked.diagnostics.truncated);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(src, 112u16, &batch:ReadWrite)?;
    assert(accepted == !bad);
    if bad { assert(batch.count == 1u32 && batch.diags[0].code.raw == 5001u16); }
    else { assert(batch.count == 0u32); }
    return;
}

function main(): void {
    small_steps()?;
    over_limit(false)?;
    over_limit(true)?;
    return;
}
