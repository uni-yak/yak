import coff_code;
import coff;
import coff_state;

// 小端读 16 位与 32 位字段；符号表/字符串表断言只依赖原始字节。
function u16_at(data: &u8[]:Read, at: u32): u16 {
    return (data[at] as u16) | ((data[at + 1] as u16) << 8u16);
}
function u32_at(data: &u8[]:Read, at: u32): u32 {
    return (data[at] as u32) | ((data[at + 1] as u32) << 8u32)
        | ((data[at + 2] as u32) << 16u32) | ((data[at + 3] as u32) << 24u32);
}
function sample(): mir::MirResult!AllocError {
    let source: &[u8] = "function add(a: u32, b: u32): u32 { return a + b; } function f(): u32 { return add(17, 5); }\n";
    return runner::accepted(source, 1400)?;
}
// 长名符号表：DefId 1 为静态内部函数（STATIC），DefId 9 为未定义的外部服务（EXTERNAL、节号 0）。
function long_links(): coff_state::LinkTable!AllocError {
    var table: coff_state::LinkTable = coff_state::LinkTable { symbols: [] };
    var entry: u8[] = [];
    var e: u32 = 0;
    let entry_text: &[u8] = "yak$entry";
    while e < @len(entry_text) as u32 { @push(entry, entry_text[e])?; e = e + 1; }
    @push(table.symbols, coff_state::LinkSymbol { def: 1u32, kind: 0u8, name: @move(entry) })?;
    var service: u8[] = [];
    let service_text: &[u8] = "yak_rt_write";
    var s: u32 = 0;
    while s < @len(service_text) as u32 { @push(service, service_text[s])?; s = s + 1; }
    @push(table.symbols, coff_state::LinkSymbol { def: 9u32, kind: 1u8, name: @move(service) })?;
    return table;
}
// 超过 8 字节的名字以「4 字节零 + 4 字节相对偏移」写入符号名，正文进入紧随符号表的字符串表。
function long_name_string_table(): void!AllocError {
    let result: mir::MirResult = sample()?;
    let table: coff_state::LinkTable = long_links()?;
    let res: coff::EmitResult = coff::emit_object(&result.module:Read, &table:Read, coff::profile_win64_pe())?;
    assert(res.ok);
    let sym_ptr: u32 = u32_at(&res.bytes.data:Read, 8);
    let sym_count: u32 = u32_at(&res.bytes.data:Read, 12);
    assert(sym_count == 2);
    // 第一条符号：名字偏移 4、节号 1、类型 FUNCTION、存储类 STATIC。
    assert(u32_at(&res.bytes.data:Read, sym_ptr) == 0);
    assert(u32_at(&res.bytes.data:Read, sym_ptr + 4) == 4);
    assert(u16_at(&res.bytes.data:Read, sym_ptr + 12) == 1);
    assert(u16_at(&res.bytes.data:Read, sym_ptr + 14) == 32);
    assert(res.bytes.data[sym_ptr + 16] == 3);
    // 第二条符号：名字偏移 14（4 + 9 + 1）、节号 0、存储类 EXTERNAL。
    let second: u32 = sym_ptr + 18;
    assert(u32_at(&res.bytes.data:Read, second) == 0);
    assert(u32_at(&res.bytes.data:Read, second + 4) == 14);
    assert(u16_at(&res.bytes.data:Read, second + 12) == 0);
    assert(u16_at(&res.bytes.data:Read, second + 14) == 32);
    assert(res.bytes.data[second + 16] == 2);
    // 字符串表紧随符号表：首 4 字节总长 4 + 10 + 13 = 27，正文按符号次序拼接。
    let str_ptr: u32 = sym_ptr + sym_count * 18;
    assert(u32_at(&res.bytes.data:Read, str_ptr) == 27);
    let entry_text: &[u8] = "yak$entry";
    var i: u32 = 0;
    while i < @len(entry_text) as u32 { assert(res.bytes.data[str_ptr + 4 + i] == entry_text[i]); i = i + 1; }
    assert(res.bytes.data[str_ptr + 13] == 0);
    let service_text: &[u8] = "yak_rt_write";
    var k: u32 = 0;
    while k < @len(service_text) as u32 { assert(res.bytes.data[str_ptr + 14 + k] == service_text[k]); k = k + 1; }
    assert(res.bytes.data[str_ptr + 26] == 0);
    return;
}

function main(): void {
    long_name_string_table()?;
    return;
}
