foreign assert(cond: bool): void;
enum LowFailure { Bad, }
enum HighFailure { Bad, }
function lower(ok: bool): u32!LowFailure { if !ok { return LowFailure::Bad; } return 0; }
function upper(ok: bool): u32!HighFailure { if !ok { return HighFailure::Bad; } return 2; }
function forbidden(): u32 { assert(false); return 1; }
function length(data: &[u8]): u32 { return @len(data) as u32; }
function low(ok: bool): u32!(LowFailure | HighFailure) {
    let data: u8[] = [1, 2];
    if !ok { return length(&data[(lower(ok)?)..forbidden()]); }
    return length(&data[(lower(ok)?)..2]);
}
function high(ok: bool): u32!(LowFailure | HighFailure) {
    var data: u8[] = [1, 2];
    var view: &[u8]:ReadWrite = &data[0..upper(ok)?]:ReadWrite;
    view[1] = 3;
    return view[1] as u32;
}
function recover_low(e: &LowFailure): u32 { return 98; }
function recover_high(e: &HighFailure): u32 { return 99; }
function main(): void {
    assert(low(false).catch(LowFailure => &recover_low, HighFailure => &recover_high) == 98);
    assert(low(true).catch(LowFailure => &recover_low, HighFailure => &recover_high) == 2);
    assert(high(false).catch(LowFailure => &recover_low, HighFailure => &recover_high) == 99);
    assert(high(true).catch(LowFailure => &recover_low, HighFailure => &recover_high) == 3);
}
