// mem_limit: 500000
// module: fields=fixtures/field_names.yak
import fields;
foreign assert(cond: bool): void;
struct Item { len: u32, cap: u32, other: u32, data: u32[] }
function make(): Item { return Item { len: 4u32, cap: 5u32, other: 6u32, data: [1u32, 2u32] }; }
enum Failure { Bad }
function maybe(ok: bool): Item!Failure { if !ok { return Failure::Bad; } return make(); }
function number(ok: bool): u32!Failure { return (maybe(ok)?).other; }
function recover(e: &Failure): u32 { return 99u32; }
function main(): void {
    assert(number(false).catch(&recover) == 99u32);
    assert(number(true).catch(&recover) == 6u32);
    let held: u32[] = [7u32, 8u32];
    assert((&held).len == 2u64);
    assert(held.len == 2u64);
    var i: u32 = 0;
    while i < 1000 {
        assert(make().len == 4u32);
        assert(make().cap == 5u32);
        assert(make().other == 6u32);
        assert(fields::make().other == 30u32);
        i = i + 1u32;
    }
}
