foreign assert(cond: bool): void;
struct Item { data: u32[] }
function main(): void {
    var data: Item[] = [Item { data: [1u32] }];
    let ref: &Item[]:ReadWrite = &data:ReadWrite;
    assert((&(*ref)[0u32..1u32]:ReadWrite)[0u32].data[0u32] == 1u32);
    (*ref)[0u32].data[0u32] = 2u32;
    assert((*ref)[0u32].data[0u32] == 2u32);
}
