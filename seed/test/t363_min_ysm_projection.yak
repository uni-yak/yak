// module: runner=mir_runner.yak
import diag;
import iface;
import mir;
import ysm;
import ysm_write;
import runner;
foreign assert(cond: bool): void;

// 两级取址均保留访问能力，向内的写入还需回传到外层投影。
function check(): void!AllocError {
    let result: mir::MirResult = runner::accepted("const C: [[u32; 2]; 2] = [[1u32, 2u32], [3u32, 4u32]]; function read(): u32 { let a: [[u32; 2]; 2] = C; return a[0u64][1u64]; } function set(): void { var a: [[u32; 2]; 2] = C; a[0u64][1u64] = 7u32; return; }\n", 1286)?;
    let facts: ysm::YsmFacts = ysm::YsmFacts { target_profile: 7, statics: [], dependencies: [], candidate_digests: [], exports: iface::ExportMap { defs: [], exports: [] } };
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let data: ysm::YsmResult = ysm_write::write_module(&result.module:Read, &facts:Read, &diagnostics:ReadWrite)?;
    assert(data.accepted && diagnostics.count == 0);
    let loaded: ysm::YsmLoadResult = ysm::read_module(&data.data[0..@len(data.data) as u32]:Read, &diagnostics:ReadWrite)?;
    assert(loaded.accepted && diagnostics.count == 0);
    var function_id: u32 = 0;
    while function_id < 2 {
        let f: &mir::MirFunction:Read = &result.module.functions[function_id]:Read;
        let start: u32 = loaded.file.functions[function_id].local_start;
        var i: u32 = 0;
        var seen: u32 = 0;
        while i < @len(f.insts) as u32 {
            let inst: mir::MirInst = f.insts[i];
            if inst.op == 83 {
                let sig: u32 = loaded.file.locals[start + inst.a - 1].type_sig_off;
                assert(loaded.file.type_sigs[sig] == 7);
                assert(loaded.file.type_sigs[sig + 1] == function_id as u8);
                seen = seen + 1;
            }
            i = i + 1;
        }
        assert(seen == 2);
        function_id = function_id + 1;
    }
    return;
}
// 两个函数共享同一字段布局；篡改第二个偏移不能绕过缓存校验。
function check_field(): void!AllocError {
    var result: mir::MirResult = runner::accepted("struct Pair { tag: u8, value: u32 } function first(p: Pair): u32 { return p.value; } function second(p: Pair): u32 { return p.value; }\n", 1287)?;
    var defs: u32[] = [];
    var exports: u32[] = [];
    var i: u32 = 0;
    while i < @len(result.module.types.entries) as u32 {
        if result.module.types.entries[i].kind == 2 {
            @push(defs, result.module.types.entries[i].def)?;
            @push(exports, 1)?;
        }
        i = i + 1;
    }
    assert(@len(defs) == 1);
    let facts: ysm::YsmFacts = ysm::YsmFacts { target_profile: 7, statics: [], dependencies: [], candidate_digests: [], exports: iface::ExportMap { defs: @move(defs), exports: @move(exports) } };
    var ok: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(&result.module:Read, &facts:Read, &ok:ReadWrite)?;
    assert(written.accepted && ok.count == 0);
    i = 0;
    while i < @len(result.module.functions[1].insts) as u32 && result.module.functions[1].insts[i].op != 82 { i = i + 1; }
    assert(i < @len(result.module.functions[1].insts) as u32);
    assert(result.module.functions[1].insts[i].c == 4);
    result.module.functions[1].insts[i].c = 1;
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: ysm::YsmResult = ysm_write::write_module(&result.module:Read, &facts:Read, &bad:ReadWrite)?;
    assert(!rejected.accepted && rejected.code.raw == 7026 && @len(rejected.data) == 0 && bad.count == 1);
    return;
}
function main(): void { check()?; check_field()?; }
