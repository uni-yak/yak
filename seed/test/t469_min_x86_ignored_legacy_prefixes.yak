// module: pe=../../compiler/min/src/emit/pe.yak
// module: x86_validate=../../compiler/min/src/emit/x86_validate.yak
import pe;
import x86_validate;
foreign assert(condition: bool): void;
foreign exit(code: u8): void;

function encoding(bytes: &[u8], expected: u16): void!AllocError {
    var code: pe::Code = pe::code_new();
    pe::code_bytes(&code:ReadWrite, bytes)?;
    assert(x86_validate::validate(&code:Read, 0)? == expected);
    return;
}

function verify(): void!AllocError {
    // 地址宽度前缀不改变寄存器、隐式栈或相对分支的操作数。
    let direct: [u8; 27] = [0x67, 0x49, 0x89, 0xc8, 0x67, 0x44, 0x0f, 0xb6, 0xc1,
        0x67, 0x41, 0x50, 0x67, 0x41, 0x58, 0x67, 0xc3,
        0x67, 0x74, 0x00, 0x67, 0x48, 0xf7, 0xd0, 0x67, 0x8b, 0xc1];
    encoding(&direct[0..4]:Read, 7103)?;
    encoding(&direct[4..9]:Read, 7103)?;
    encoding(&direct[9..12]:Read, 7103)?;
    encoding(&direct[12..15]:Read, 7103)?;
    encoding(&direct[15..17]:Read, 7103)?;
    encoding(&direct[17..20]:Read, 7103)?;
    encoding(&direct[20..24]:Read, 7103)?;
    // 能缩短时优先于寄存器方向的等长替代。
    encoding(&direct[24..27]:Read, 7103)?;
    encoding(&direct[25..27]:Read, 7102)?;
    encoding(&direct[4..8]:Read, 7101)?;

    // 四种旧段覆盖均可省；SS 与 DS 的默认基址判定仍取自操作数。
    let memory: [u8; 24] = [0x26, 0x48, 0x8b, 0x01, 0x2e, 0x48, 0x89, 0x45, 0x08,
        0x36, 0x8b, 0x01, 0x3e, 0x48, 0x8b, 0x45, 0x08,
        0x3e, 0x67, 0xa1, 0x00, 0x00, 0x00, 0x90];
    encoding(&memory[0..4]:Read, 7103)?;
    encoding(&memory[4..9]:Read, 7103)?;
    encoding(&memory[9..12]:Read, 7103)?;
    encoding(&memory[12..17]:Read, 7103)?;
    encoding(&memory[17..23]:Read, 7101)?;
    encoding(&memory[17..24]:Read, 7103)?;
    encoding(&memory[18..24]:Read, 0)?;
    // 地址宽度仍影响显式基址，FS／GS 和控制转移的特殊前缀不作为段覆盖剥除。
    let outside: [u8; 18] = [0x67, 0x48, 0x8b, 0x01, 0x64, 0x48, 0x8b, 0x01,
        0x65, 0x48, 0x8b, 0x01, 0x3e, 0xff, 0xe0, 0x2e, 0x74, 0x00];
    encoding(&outside[0..4]:Read, 7101)?;
    encoding(&outside[4..8]:Read, 7101)?;
    encoding(&outside[8..12]:Read, 7101)?;
    encoding(&outside[12..15]:Read, 7101)?;
    encoding(&outside[15..18]:Read, 7101)?;
    exit(0);
    return;
}

function main(): void {
    let status: void!AllocError = verify();
    @drop(status);
    assert(false);
    return;
}
