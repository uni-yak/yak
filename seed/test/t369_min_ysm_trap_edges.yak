import diag;
import mir;
import iface;
import ysm;
import ysm_validate;
import ysm_write;
import runner;
foreign assert(cond: bool): void;

// 有堆分配局部、且在 @drop 之前出错的一处加法：产生一条私有清理块边。
const TRAP_SOURCE: &[u8] = "function f(a: u32, b: u32, x: u8[]): u32 { let s: u32 = a + b; @drop(x); return s; }\n";
// 同一形态下有两处可陷阱运算，用于验证两条边指向同一清理块时被拒绝。
const DUAL_SOURCE: &[u8] = "function f(a: u32, b: u32, x: u8[]): u32 { let s: u32 = a + b; let t: u32 = s * 3u32; @drop(x); return t; }\n";
// 无堆分配局部：可陷阱指令仍存在，但没有任何私有清理块，必须写格式 4。
const PLAIN_SOURCE: &[u8] = "function g(a: u32): u32 { return a + 1u32; }\n";

// 空事实：无静态池、无依赖、无导出。
function facts(): ysm::YsmFacts {
    return ysm::YsmFacts { target_profile: 7, statics: [], dependencies: [], candidate_digests: [], exports: iface::ExportMap { defs: [], exports: [] } };
}
function u16_at(data: &[u8], offset: u32): u16 {
    return (data[offset] as u16) | ((data[offset + 1] as u16) << 8);
}
// 统计模块中带陷阱边的指令条数。
function count_edges(m: &mir::MirModule:Read): u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    while i < @len(m.functions) as u32 {
        var k: u32 = 0;
        while k < @len(m.functions[i].insts) as u32 {
            if mir::has_trap_edge(m.functions[i].insts[k].op) { n = n + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    return n;
}
// 返回第 skip 条可陷阱指令的下标；不存在时返回 4294967295。
function edge_index(m: &mir::MirModule:Read, f: u32, skip: u32): u32 {
    var seen: u32 = 0;
    var k: u32 = 0;
    while k < @len(m.functions[f].insts) as u32 {
        if mir::has_trap_edge(m.functions[f].insts[k].op) {
            if seen == skip { return k; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    return 4294967295u32;
}
function copy_bytes(src: &[u8]): u8[]!AllocError {
    var dst: u8[] = [];
    var i: u32 = 0;
    while i < @len(src) as u32 { @push(dst, src[i])?; i = i + 1; }
    return dst;
}
// 序列化并返回副本；要求接受且无诊断。
function encode(m: &mir::MirModule:Read): u8[]!AllocError {
    let fx: ysm::YsmFacts = facts();
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(m, &fx:Read, &diags:ReadWrite)?;
    assert(written.accepted && !diags.has_error);
    return copy_bytes(&written.data[0..@len(written.data)]:Read)?;
}
// 序列化必须被拒绝，且不留下任何产物。
function encode_rejected(m: &mir::MirModule:Read, code: u16): void!AllocError {
    let fx: ysm::YsmFacts = facts();
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(m, &fx:Read, &diags:ReadWrite)?;
    assert(!written.accepted && written.code.raw == code && @len(written.data) == 0);
    assert(diag::diagbuf_count(&diags:Read) >= 1);
    return;
}
// 重新计算并回填头部摘要，使容器层校验通过，只暴露指令流扫描的判定。
function resign(src: &[u8]): u8[]!AllocError {
    var masked: u8[] = [];
    var i: u32 = 0;
    while i < @len(src) as u32 {
        if i >= 28 && i < 60 { @push(masked, 0)?; }
        else { @push(masked, src[i])?; }
        i = i + 1;
    }
    let digest: u8[] = iface::sha256(&masked[0..@len(masked) as u32]:Read)?;
    var buf: u8[] = copy_bytes(src)?;
    i = 0;
    while i < 32 {
        buf[28 + i] = digest[i];
        i = i + 1;
    }
    return @move(buf);
}
// 只改写版本字段并重新签名。
function relabel(data: &[u8], version: u16): u8[]!AllocError {
    var copy: u8[] = copy_bytes(data)?;
    copy[4] = (version & 255u16) as u8;
    copy[5] = ((version >> 8) & 255u16) as u8;
    return resign(&copy[0..@len(copy)]:Read)?;
}
// 反序列化后按文件版本扫描指令流，返回扫描结论（0 表示通过）。
function scan(data: &[u8]): u16!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(data, &diags:ReadWrite)?;
    assert(loaded.accepted && !diags.has_error);
    return ysm_validate::validate_inst_stream(&loaded.file:Read, &diags:ReadWrite)?;
}

// 有边必须写格式 5，无边必须写格式 4；两者字节数之差恰为边字段总长。
function version_follows_edges(): void!AllocError {
    var r: mir::MirResult = runner::accepted(TRAP_SOURCE, 2100)?;
    let edges: u32 = count_edges(&r.module:Read);
    assert(edges >= 1);
    let v5: u8[] = encode(&r.module:Read)?;
    assert(u16_at(&v5[0..@len(v5)]:Read, 4) == 5);
    assert(scan(&v5[0..@len(v5)]:Read)? == 0);
    // 同模块清零全部边后必须降级为格式 4，且字节数恰好少 2 字节乘以边数。
    var i: u32 = 0;
    while i < @len(r.module.functions) as u32 {
        var k: u32 = 0;
        while k < @len(r.module.functions[i].insts) as u32 {
            r.module.functions[i].insts[k].trap = 0;
            k = k + 1;
        }
        i = i + 1;
    }
    let v4: u8[] = encode(&r.module:Read)?;
    assert(u16_at(&v4[0..@len(v4)]:Read, 4) == 4);
    assert(@len(v5) as u32 == @len(v4) as u32 + 2 * edges);
    assert(scan(&v4[0..@len(v4)]:Read)? == 0);
    // 仅存在可陷阱指令但无清理块：仍写格式 4。
    let plain: mir::MirResult = runner::accepted(PLAIN_SOURCE, 2101)?;
    assert(count_edges(&plain.module:Read) >= 1);
    let plain_bytes: u8[] = encode(&plain.module:Read)?;
    assert(u16_at(&plain_bytes[0..@len(plain_bytes)]:Read, 4) == 4);
    assert(scan(&plain_bytes[0..@len(plain_bytes)]:Read)? == 0);
    // 格式 5 读回后版本与边数一致，指令流仍按形态扫描通过。
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(&v5[0..@len(v5)]:Read, &diags:ReadWrite)?;
    assert(loaded.accepted && !diags.has_error);
    assert(loaded.file.header.version == 5);
    assert(ysm_validate::validate_inst_stream(&loaded.file:Read, &diags:ReadWrite)? == 0);
    return;
}

// 读取方不得静默丢弃边：把格式 5 谎称格式 4 必须被显式扫描拒绝；未知版本按 Y-2 拒绝。
function reader_must_read_edges(): void!AllocError {
    let r: mir::MirResult = runner::accepted(TRAP_SOURCE, 2102)?;
    let v5: u8[] = encode(&r.module:Read)?;
    assert(u16_at(&v5[0..@len(v5)]:Read, 4) == 5);
    let as4: u8[] = relabel(&v5[0..@len(v5)]:Read, 4)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let loose: ysm::YsmLoadResult = ysm::read_module(&as4[0..@len(as4)]:Read, &diags:ReadWrite)?;
    // 容器层接受格式 4，但边字段无人读取，扫描必须拒绝而不是把边当作操作数吞掉。
    assert(loose.accepted && !diags.has_error);
    assert(ysm_validate::validate_inst_stream(&loose.file:Read, &diags:ReadWrite)? == 7026);
    assert(diag::diagbuf_count(&diags:Read) == 1);
    // 未知版本 6 在读取阶段即按 Y-2 拒绝，不会进入扫描。
    let as6: u8[] = relabel(&v5[0..@len(v5)]:Read, 6)?;
    var newer: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: ysm::YsmLoadResult = ysm::read_module(&as6[0..@len(as6)]:Read, &newer:ReadWrite)?;
    assert(!rejected.accepted && rejected.code.raw == 7024);
    return;
}

// 边目标必须是本函数内唯一的私有清理块：入口、函数级 fallback、越界与共享目标一律拒绝。
function writer_rejects(): void!AllocError {
    var r: mir::MirResult = runner::accepted(TRAP_SOURCE, 2103)?;
    let site: u32 = edge_index(&r.module:Read, 0, 0);
    assert(site != 4294967295u32);
    let saved: u32 = r.module.functions[0].insts[site].trap;
    assert(saved != 0);
    // 指向函数入口：入口不是清理块。
    r.module.functions[0].insts[site].trap = (r.module.functions[0].entry as u32) + 1;
    encode_rejected(&r.module:Read, 7026)?;
    // 指向函数级 fallback：逐点边不得退化为函数级目标。
    r.module.functions[0].insts[site].trap = (r.module.functions[0].trap_target as u32) + 1;
    encode_rejected(&r.module:Read, 7026)?;
    // 指向不存在的块。
    r.module.functions[0].insts[site].trap = 60000;
    encode_rejected(&r.module:Read, 7026)?;
    // 超出 u16 序列化域宽：必须显式拒绝而不是截断。
    r.module.functions[0].insts[site].trap = 70000;
    encode_rejected(&r.module:Read, 7026)?;
    // 恢复后必须重新可写。
    r.module.functions[0].insts[site].trap = saved;
    let ok: u8[] = encode(&r.module:Read)?;
    assert(scan(&ok[0..@len(ok)]:Read)? == 0);
    // 两条边共享同一清理块：单源约束要求拒绝。
    var dual: mir::MirResult = runner::accepted(DUAL_SOURCE, 2104)?;
    let first: u32 = edge_index(&dual.module:Read, 0, 0);
    let second: u32 = edge_index(&dual.module:Read, 0, 1);
    assert(first != 4294967295u32 && second != 4294967295u32 && first != second);
    assert(dual.module.functions[0].insts[first].trap != dual.module.functions[0].insts[second].trap);
    let keep: u32 = dual.module.functions[0].insts[second].trap;
    dual.module.functions[0].insts[second].trap = dual.module.functions[0].insts[first].trap;
    encode_rejected(&dual.module:Read, 7026)?;
    dual.module.functions[0].insts[second].trap = keep;
    let both: u8[] = encode(&dual.module:Read)?;
    assert(count_edges(&dual.module:Read) >= 2);
    assert(scan(&both[0..@len(both)]:Read)? == 0);
    return;
}

// 逐点边参与序列化后仍必须逐字节确定。
function edges_deterministic(): void!AllocError {
    let r: mir::MirResult = runner::accepted(TRAP_SOURCE, 2105)?;
    let a: u8[] = encode(&r.module:Read)?;
    let b: u8[] = encode(&r.module:Read)?;
    assert(@len(a) == @len(b));
    var i: u32 = 0;
    while i < @len(a) as u32 {
        assert(a[i] == b[i]);
        i = i + 1;
    }
    return;
}

function run(): void!AllocError {
    version_follows_edges()?;
    reader_must_read_edges()?;
    writer_rejects()?;
    edges_deterministic()?;
    return;
}

function main(): void { run()?; return; }
