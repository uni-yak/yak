    return;
}
// 空返回类型已缓存时，同一个类型仍不能充当值形参。
function void_type_cache(): void!AllocError {
    let loaded: runner::Loaded = runner::load("function clear(): void { return; } function use(x: u32): u32 { return x; }\n", 1285)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    var checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    let normal: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &checked:Read, &diags:ReadWrite)?;
    assert(normal.accepted && @len(normal.module.functions) == 2);
    let first: u32 = normal.module.functions[0].signature - 1;
    let second: u32 = normal.module.functions[1].signature - 1;
    let empty: u32 = checked.funcs.items[first].ret;
    checked.funcs.items[second].params[0] = empty;
    let invalid: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &checked:Read, &diags:ReadWrite)?;
    assert(!invalid.accepted && invalid.rejection.kind == 3 && @len(invalid.module.functions) == 0);
    assert(invalid.rejection.span.offset == loaded.parsed.pool.functions[1].params[0].span.offset);
    return;
}
// 绑定表命中名称时，仍需检查记录是否属于正在降低的声明。
function binding_decl_identity(): void!AllocError {
