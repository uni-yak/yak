    let third: u32 = result.module.functions[0].args[start + 2];
    result.module.functions[0].args[start] = third; result.module.functions[0].args[start + 2] = first;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].args[start] = first; result.module.functions[0].args[start + 2] = third;
    assert(mir_verify::verify_module(&result.module:Read)?);
