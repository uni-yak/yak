// module: runner=mir_runner.yak
import runner;
function scalar_arithmetic(): void!AllocError {
    let source: &[u8] = "function add(a: u32, b: u32): u32 { return a + b; } function f(): u32 { return add(17, 5) * 3 - 7 / 2 + 7 % 2; }\n";
    let a_result: mir::MirResult = runner::accepted(source, 1200)?;
    let a: &mir::MirModule:Read = &a_result.module:Read;
    let b_result: mir::MirResult = runner::accepted(source, 1200)?;
    let b: &mir::MirModule:Read = &b_result.module:Read;
    runner::same_module(a, b);
    assert(@len(a.functions) == 2 && a.functions[0].def == 1 && a.functions[1].def == 4);
    let value: runner::Value = runner::run0(a, 1)?; assert(value.tag == 0 && value.bits == 64);
    return;
}
// 保持操作数、结果及签名类型一致，验证运算自身的整数类型约束。
function arithmetic_type_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(a: u32, b: u32): u32 { return a + b; }\n", 1282)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 16 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    let value_type_id: u32 = result.module.functions[0].insts[i].value_type_id;
    let right: u32 = result.module.functions[0].insts[i].c;
    var op: u8 = 16;
    while op <= 36 {
        if op <= 24 || op >= 32 {
            result.module.functions[0].insts[i].op = op;
            if op == 21 { result.module.functions[0].insts[i].c = 0; } else { result.module.functions[0].insts[i].c = right; }
            assert(mir_verify::verify_module(&result.module:Read)?);
            result.module.types.entries[value_type_id - 1].builtin = 4105;
            assert(!mir_verify::verify_module(&result.module:Read)?);
            result.module.types.entries[value_type_id - 1].builtin = 4106;
            assert(!mir_verify::verify_module(&result.module:Read)?);
            result.module.types.entries[value_type_id - 1].builtin = 4099;
        }
        op = op + 1;
    }
    result.module.functions[0].insts[i].op = 16;
    result.module.functions[0].insts[i].c = right;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
function scalar_casts(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function narrow(): u8 { let x: u32 = 258u32; return x as u8; } function signed(): i32 { let x: i8 = -7i8; return x as i32; } function letter(): u32 { let c: char = '界'; return c as u32; } function bits(): u32 { return ((6u32 & 3u32) | (1u32 << 3u32)) ^ (16u32 >> 2u32); } function unary(): bool { return !(-2i32 < -1i32); }\n", 1201)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    runner::expect0(m, 0, 2)?; runner::expect0(m, 1, 4294967289)?;
    runner::expect0(m, 2, 30028)?; runner::expect0(m, 3, 14)?; runner::expect0(m, 4, 0)?;
    return;
}
// 保持其余 MIR 结构不变，单独验证转换源与目标的白名单。
function cast_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(a: u32, b: bool, c: u8, d: char): u16 { b; c; d; return a as u16; } function g(a: u32, b: u8): char { b; return a as char; }\n", 1280)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 64 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    var original: u32 = result.module.functions[0].insts[i].b;
    result.module.functions[0].insts[i].b = result.module.functions[0].params[1];
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].b = result.module.functions[0].params[3];
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].b = result.module.functions[0].params[2];
    assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].b = original;
    assert(mir_verify::verify_module(&result.module:Read)?);
    i = 0;
    while i < @len(result.module.functions[1].insts) as u32 && result.module.functions[1].insts[i].op != 64 { i = i + 1; }
    assert(i < @len(result.module.functions[1].insts) as u32);
    original = result.module.functions[1].insts[i].b;
    result.module.functions[1].insts[i].b = result.module.functions[1].params[1];
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[1].insts[i].b = original;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
// 字符常量必须是 Unicode 标量，边界之外不能进入后端。
function char_constant_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(): char { return 'a'; }\n", 1281)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 1 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    result.module.functions[0].insts[i].value = 55295; assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 55296; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 57343; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 57344; assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 1114111; assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 1114112; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 4294967296u64; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].value = 0; assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
// 改变比较指令而保留操作数和结果，单独验证布尔顺序比较。
function bool_comparison_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(a: bool, b: bool): bool { return a == b; }\n", 1283)?;
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 48 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    var op: u8 = 48;
    while op <= 53 {
        result.module.functions[0].insts[i].op = op;
        if op <= 49 { assert(mir_verify::verify_module(&result.module:Read)?); }
        else { assert(!mir_verify::verify_module(&result.module:Read)?); }
        op = op + 1;
    }
    result.module.functions[0].insts[i].op = 48;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
// 只替换操作数，确保切片比较本身由验证器拒绝。
function slice_comparison_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("foreign write(data: &[u8]): void; function f(a: u32, b: u32): bool { write(\"a\"); write(\"b\"); return a == b; }\n", 1284)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 48 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    let left: u32 = result.module.functions[0].insts[i].b;
    let right: u32 = result.module.functions[0].insts[i].c;
    var s: u32 = 0;
    while s < i && result.module.functions[0].insts[s].op != 3 { s = s + 1; }
    assert(s < i);
    let slice: u32 = result.module.functions[0].insts[s].a;
    result.module.functions[0].insts[i].b = slice;
    result.module.functions[0].insts[i].c = slice;
    var compare: u8 = 48;
    while compare <= 53 {
        result.module.functions[0].insts[i].op = compare;
        assert(!mir_verify::verify_module(&result.module:Read)?);
        compare = compare + 1;
    }
    result.module.functions[0].insts[i].op = 48;
    result.module.functions[0].insts[i].b = left;
    result.module.functions[0].insts[i].c = right;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
