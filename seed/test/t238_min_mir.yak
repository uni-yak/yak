}
// 验证器独立入口区分普通引用和函数引用的比较规则。
function reference_comparison_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(a: u32, b: u32): bool { return a == b; }\n", 1286)?;
    var i: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 48 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    let ty: u32 = result.module.functions[0].locals[result.module.functions[0].params[0] - 1].value_type_id;
    assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.types.entries[ty - 1].kind = 4;
    var op: u8 = 48;
    while op <= 53 {
        result.module.functions[0].insts[i].op = op;
        assert(!mir_verify::verify_module(&result.module:Read)?);
        op = op + 1;
    }
    result.module.types.entries[ty - 1].kind = 8;
    op = 48;
    while op <= 53 {
        result.module.functions[0].insts[i].op = op;
        if op <= 49 { assert(mir_verify::verify_module(&result.module:Read)?); }
        else { assert(!mir_verify::verify_module(&result.module:Read)?); }
        op = op + 1;
    }
    result.module.types.entries[ty - 1].kind = 1;
    result.module.functions[0].insts[i].op = 48;
    assert(mir_verify::verify_module(&result.module:Read)?);
    // 保持操作数和签名一致，区分内建整数的顺序比较与内置枚举的相等比较。
    let builtin: u16 = result.module.types.entries[ty - 1].builtin;
    op = 48;
    while op <= 53 {
        result.module.functions[0].insts[i].op = op;
        assert(mir_verify::verify_module(&result.module:Read)?);
        op = op + 1;
    }
    result.module.types.entries[ty - 1].builtin = 4108;
    op = 48;
    while op <= 53 {
        result.module.functions[0].insts[i].op = op;
        if op <= 49 { assert(mir_verify::verify_module(&result.module:Read)?); }
        else { assert(!mir_verify::verify_module(&result.module:Read)?); }
        op = op + 1;
    }
    result.module.types.entries[ty - 1].builtin = builtin;
    result.module.functions[0].insts[i].op = 48;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
function scalar_comparisons(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function less(x: u32): bool { return 1 < x; } function compare(x: i32): bool { return x != -1i32 && x >= -2i32 && x <= 3i32 && x > -3i32 && x == 2i32; }\n", 1202)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    runner::expect1(m, 0, 0, 0)?; runner::expect1(m, 0, 2, 1)?;
    runner::expect1(m, 1, 2, 1)?; runner::expect1(m, 1, 3, 0)?;
    return;
}
function scalar_branches(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function both(x: bool): u32 { if x { return 11; } else { return 22; } } function chain(x: u32): u32 { var n: u32 = 5; if x == 0 { n = 10; } elseif x == 1 { n = 20; } else { n = 30; } return n + 1; } function mixed(x: u32): u32 { if x == 0 { return 7; } if x == 1 { return 8; } return 9; }\n", 1203)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    assert(@len(m.functions[0].blocks) == 3);
    runner::expect1(m, 0, 0, 22)?; runner::expect1(m, 0, 1, 11)?;
    runner::expect1(m, 1, 0, 11)?; runner::expect1(m, 1, 1, 21)?; runner::expect1(m, 1, 9, 31)?;
    runner::expect1(m, 2, 0, 7)?; runner::expect1(m, 2, 1, 8)?; runner::expect1(m, 2, 2, 9)?;
    return;
}
function scalar_loops(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function spin(x: u32): u32 { var n: u32 = 0; var total: u32 = 0; while n < x { n = n + 1; if n == 2 { continue; } if n == 5 { break; } total = total + n; } return total; } function labels(): u32 { var i: u32 = 0; var n: u32 = 0; outer: while i < 4 { i = i + 1; var j: u32 = 0; inner: while j < 4 { j = j + 1; if i == 2 { continue outer; } if i == 4 { break outer; } if j == 2 { continue inner; } if j == 4 { break inner; } n = n + 1; } } return n; }\n", 1204)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    runner::expect1(m, 0, 0, 0)?; runner::expect1(m, 0, 3, 4)?; runner::expect1(m, 0, 8, 8)?;
    runner::expect0(m, 1, 4)?;
    assert(runner::op_count(&m.functions[0]:Read, 80) > 0 && runner::op_count(&m.functions[0]:Read, 81) > 0);
    return;
}
function scalar_short_circuit(): void!AllocError {
    // 右支含整除零：短路若失效，执行器会在该处陷入，测试随即失败。
    let m_result: mir::MirResult = runner::accepted("function zero(): bool { return false && 1u32 / 0u32 == 0u32; } function one(): bool { return true || 1u32 / 0u32 == 0u32; } function guarded(a: bool): bool { return a && 1u32 / 0u32 == 0u32; } function fallback(a: bool): bool { return a || 1u32 / 0u32 == 0u32; }\n", 1205)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    runner::expect0(m, 0, 0)?; runner::expect0(m, 1, 1)?;
    runner::expect1(m, 2, 0, 0)?; runner::expect1(m, 3, 1, 1)?;
    // 每条短路表达式至少有一个条件分支终止符，且结果只经单一 place 汇合。
    assert(runner::term_count(&m.functions[0]:Read, 193) >= 1 && runner::term_count(&m.functions[1]:Read, 193) >= 1);
    assert(runner::op_count(&m.functions[2]:Read, 81) >= 1 && runner::op_count(&m.functions[3]:Read, 81) >= 1);
    return;
}
function scalar_calls(): void!AllocError {
    // 嵌套调用须先完成内层求值，且内外层实参区间互不掺杂；void 调用不产生结果局部。
    let m_result: mir::MirResult = runner::accepted("foreign assert(cond: bool): void; function pair(a: u32, b: u32): u32 { return a * 10 + b; } function note(): void { assert(true); } function f(): u32 { note(); return pair(1, pair(2, 3)); }\n", 1206)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    let args: runner::Value[] = []; var state: runner::Execution = runner::execution_new();
    let result: runner::Value = runner::execute(m, 2, &args[0..0]:Read, &state:ReadWrite, 0)?;
    assert(result.bits == 33 && state.foreign_calls == 1);
    // 外来声明不生成 MIR 函数：0 为 pair，1 为 note，2 为 f。
    // call_foreign 的结果局部在 a（void 为 0），DefId 在 b，实参经 args 区给出。
    var foreign_calls: u32 = 0; var foreign_def: u32 = 0; var foreign_args: u32 = 0;
    var i: u32 = 0;
    while i < @len(m.functions[1].insts) as u32 {
        if mir::is_foreign_call(m.functions[1].insts[i].op) {
            foreign_calls = foreign_calls + 1;
            foreign_def = m.functions[1].insts[i].b;
            foreign_args = m.functions[1].insts[i].args_count;
        }
        i = i + 1;
    }
    assert(foreign_calls == 1 && foreign_args == 1 && foreign_def != 0);
    var j: u32 = 0; var matched: bool = false;
    while j < @len(m.signatures.items) as u32 {
        if m.signatures.items[j].def == foreign_def { assert(m.signatures.items[j].service == 2); matched = true; }
        j = j + 1;
    }
    assert(matched);
    assert(runner::op_count(&m.functions[2]:Read, 150) == 3);
    return;
}
function scalar_recursion(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function #sum(n: u32): u32 { if n == 0 { return 0; } return n + sum(n - 1); } function even(n: u32): bool { if n == 0 { return true; } return odd(n - 1); } function odd(n: u32): bool { if n == 0 { return false; } return even(n - 1); }\n", 1207)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
    assert(m.functions[0].declared_no_alloc && m.functions[0].no_alloc);
    assert(!m.functions[1].declared_no_alloc && m.functions[1].no_alloc && m.functions[2].no_alloc);
    runner::expect1(m, 0, 4, 10)?; runner::expect1(m, 1, 4, 1)?; runner::expect1(m, 2, 4, 0)?;
    return;
}
function missing_signature(): void!AllocError {
    // 未登记 foreign 是 F-1 拒绝形态，在名称解析阶段即被拒绝，不会到达 MIR；
    // 后端不得为无签名外来目标伪造签名表条目。
    let loaded: runner::Loaded = runner::load("foreign target(x: u32): u32; function entry(): u32 { return target(9); }\n", 1211)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 8001);
    var service_index: u32 = 0;
    var known_service: bool = false;
    while service_index < @len(resolution.services) as u32 {
        if resolution.services[service_index].kind != 0 { known_service = true; }
        service_index = service_index + 1;
    }
    assert(!known_service);
    return;
}
function scalar_wrap(): void!AllocError {
    let m_result: mir::MirResult = runner::accepted("function add(): u8 { return @wrap_add(255u8, 2u8); } function sub(): u16 { return @wrap_sub(0u16, 2u16); } function mul(): u8 { return @wrap_mul(128u8, 3u8); }\n", 1212)?;
    let m: &mir::MirModule:Read = &m_result.module:Read;
