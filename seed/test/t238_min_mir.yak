    while other <= @len(result.module.types.entries) as u32 && (other == saved_ret || result.module.types.entries[other - 1].kind != 1) { other = other + 1; }
    assert(other <= @len(result.module.types.entries) as u32);
    result.module.imports[0].ret = other; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imports[0].ret = saved_ret; assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call].b = 0; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call].b = 4294967295u32; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call].b = original.b;
    result.module.functions[0].insts[call].c = 65535; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call].c = 0; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call].c = 65536; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call] = original;
    result.module.functions[0].insts[call].value = 1; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call] = original;
    result.module.functions[0].insts[call].a = 0; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call] = original;
    result.module.functions[0].insts[call].args_count = 1; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[call] = original;
    // 即使实参局部真实存在并支配调用，也不能绕过接口形参数量。
    @push(result.module.functions[0].args, result.module.functions[0].insts[0].a)?;
    result.module.functions[0].insts[call].args_start = @len(result.module.functions[0].args) as u32 - 1;
    result.module.functions[0].insts[call].args_count = 1;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    // 人工扩展第一条签名时，下一条空签名也必须紧随形参池；恢复时清空临时池。
    assert(@len(result.module.imports) == 2 && @len(result.module.import_params) == 0);
    result.module.import_params = [result.module.functions[0].locals[result.module.functions[0].insts[0].a - 1].value_type_id];
    result.module.imports[0].param_count = 1;
    result.module.imports[1].param_start = 1;
    assert(mir_verify::verify_module(&result.module:Read)?);
    result.module.import_params = [];
    result.module.imports[0].param_count = 0;
    result.module.imports[1].param_start = 0;
    result.module.functions[0].insts[call] = original; assert(mir_verify::verify_module(&result.module:Read)?);
    resolution.refs.imports[0].param_count = 1; assert(mir_verify::verify_module(&result.module:Read)?);
    resolution.refs.imports[0].param_count = 0;
    assert(result.module.functions[0].no_alloc && !result.module.functions[1].no_alloc);
    assert(result.module.functions[2].no_alloc && !result.module.functions[3].no_alloc);
    // 分别覆盖前向链、指向已完成分量的边，以及返回后仍在 Tarjan 栈内的目标。
    let graph: runner::Loaded = runner::load("import safe; import risky; function first(): u32 { return second(); } function second(): u32 { return third(); } function third(): u32 { return risky::f(); } function cycle_a(n: u32): u32 { if n == 0 { return first(); } return cycle_b(n - 1) + cycle_c(n - 1); } function cycle_b(n: u32): u32 { if n == 0 { return good_a(0); } return cycle_a(n - 1); } function cycle_c(n: u32): u32 { return cycle_b(n); } function good_a(n: u32): u32 { if n == 0 { return safe::f(); } return good_b(n - 1) + good_c(n - 1); } function good_b(n: u32): u32 { return good_a(n); } function good_c(n: u32): u32 { return good_b(n); } function last(): u32 { return cycle_a(0); }\n", 1225)?;
    var graph_diags: diag::DiagBuffer = diag::diagbuf_new();
    var graph_refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&graph.parsed.file:Read, &graph.parsed.pool:Read, &graph.lexed.names:Read, &deps:Read, "user", &graph_diags:ReadWrite)?;
    var graph_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&graph.parsed.file:Read, &graph.parsed.pool:Read, &graph_refs:Read, &graph_diags:ReadWrite)?;
    let graph_mir: mir::MirResult = mir_lower::build_mir(&graph.parsed.file:Read, &graph.parsed.pool:Read, &graph_refs:Read, &graph_types:Read, &graph_diags:ReadWrite)?;
    assert(graph_mir.accepted && !graph_diags.has_error && @len(graph_mir.module.functions) == 10);
    assert(!graph_mir.module.functions[0].no_alloc && !graph_mir.module.functions[1].no_alloc && !graph_mir.module.functions[2].no_alloc);
    assert(!graph_mir.module.functions[3].no_alloc && !graph_mir.module.functions[4].no_alloc && !graph_mir.module.functions[5].no_alloc);
    assert(graph_mir.module.functions[6].no_alloc && graph_mir.module.functions[7].no_alloc && graph_mir.module.functions[8].no_alloc);
    assert(!graph_mir.module.functions[9].no_alloc);
    // 签名虽存在，越界 DefId 也不能进入私有调用索引。
    let invalid: u32 = @len(graph_refs.result.tables.defs) as u32 + 1;
    let last_item: u32 = @len(graph_refs.result.file.items) as u32 - 1;
    graph_refs.result.file.items[last_item].def_id = invalid;
    graph_types.funcs.items[graph_mir.module.functions[9].signature - 1].def = invalid;
    let malformed: mir::MirResult = mir_lower::build_mir(&graph.parsed.file:Read, &graph.parsed.pool:Read, &graph_refs:Read, &graph_types:Read, &graph_diags:ReadWrite)?;
    assert(!malformed.accepted && malformed.rejection.kind == 7 && malformed.rejection.span.offset == graph.parsed.file.items[last_item].span.offset);
    // 不安全事实跨多层前向调用后必须拒绝显式无增契约。
    let chain: runner::Loaded = runner::load("import risky; function #first(): u32 { return second(); } function second(): u32 { return third(); } function third(): u32 { return risky::f(); }\n", 1226)?;
    var chain_diags: diag::DiagBuffer = diag::diagbuf_new();
    let chain_refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&chain.parsed.file:Read, &chain.parsed.pool:Read, &chain.lexed.names:Read, &deps:Read, "user", &chain_diags:ReadWrite)?;
    let chain_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&chain.parsed.file:Read, &chain.parsed.pool:Read, &chain_refs:Read, &chain_diags:ReadWrite)?;
    let chain_mir: mir::MirResult = mir_lower::build_mir(&chain.parsed.file:Read, &chain.parsed.pool:Read, &chain_refs:Read, &chain_types:Read, &chain_diags:ReadWrite)?;
    assert(!chain_mir.accepted && chain_diags.has_error && chain_diags.diags[0].code.raw == 7020);
    assert(@len(chain_diags.diags) == 1 && chain_diags.diags[0].span.file == 1226 && chain_diags.diags[0].span.offset == 132 && chain_diags.diags[0].span.length == 10);
    assert(chain_mir.rejection.span.offset == chain_diags.diags[0].span.offset);
    // 同一身份的冲突标志不能凭借首条记录放行。
    let duplicate: resolve_refs::BridgeRecord = resolution.bridges.items[0];
    @push(resolution.bridges.items, resolve_refs::BridgeRecord { import_def: duplicate.import_def, name: duplicate.name, dependency: duplicate.dependency, export_id: duplicate.export_id, kind: duplicate.kind, flags: 0 })?;
    let conflict: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &tc:Read, &diags:ReadWrite)?;
    assert(conflict.accepted && !conflict.module.functions[0].no_alloc && !conflict.module.functions[2].no_alloc);
    // 缺失桥接事实时不得将未知导入目标误认为安全。
    resolution.bridges.items[0].dependency = 0;
    resolution.bridges.items[@len(resolution.bridges.items) - 1].dependency = 0;
    let unknown: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &tc:Read, &diags:ReadWrite)?;
    assert(unknown.accepted && !unknown.module.functions[0].no_alloc && !unknown.module.functions[2].no_alloc);
    let declared: runner::Loaded = runner::load("import safe; function #checked(): u32 { return safe::f(); }\n", 1222)?;
    var check_diags: diag::DiagBuffer = diag::diagbuf_new();
    let check_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&declared.parsed.file:Read, &declared.parsed.pool:Read, &declared.lexed.names:Read, &deps:Read, "user", &check_diags:ReadWrite)?;
    let check_tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&declared.parsed.file:Read, &declared.parsed.pool:Read, &check_resolution:Read, &check_diags:ReadWrite)?;
    let checked: mir::MirResult = mir_lower::build_mir(&declared.parsed.file:Read, &declared.parsed.pool:Read, &check_resolution:Read, &check_tc:Read, &check_diags:ReadWrite)?;
    assert(checked.accepted && !check_diags.has_error && checked.module.functions[0].no_alloc);
    // 使用真实解析签名模拟链接键编号的规格上限。
    var boundary: resolve_refs::Resolution = resolve_unit::resolve_unit(&declared.parsed.file:Read, &declared.parsed.pool:Read, &declared.lexed.names:Read, &deps:Read, "user", &check_diags:ReadWrite)?;
    var bi: u32 = 0;
    while bi < @len(boundary.refs.items) as u32 {
        if boundary.refs.items[bi].kind == 2 {
            boundary.refs.items[bi].x = 65535;
            boundary.refs.items[bi].y = 4294967295u32;
        }
        bi = bi + 1;
    }
    boundary.refs.imports[0].dep = 65535;
    boundary.refs.imports[0].export_id = 4294967295u32;
    boundary.bridges.items[0].dependency = 65535;
    boundary.bridges.items[0].export_id = 4294967295u32;
    let boundary_ok: mir::MirResult = mir_lower::build_mir(&declared.parsed.file:Read, &declared.parsed.pool:Read, &boundary:Read, &check_tc:Read, &check_diags:ReadWrite)?;
    assert(boundary_ok.accepted && !check_diags.has_error && boundary_ok.module.functions[0].no_alloc);
    assert(mir_verify::verify_module(&boundary_ok.module:Read)?);
    assert(boundary_ok.module.imports[0].dep == 65535 && boundary_ok.module.imports[0].export_id == 4294967295u32);
    bi = 0;
    while bi < @len(boundary.refs.items) as u32 { if boundary.refs.items[bi].kind == 2 { boundary.refs.items[bi].x = 65536; } bi = bi + 1; }
    let boundary_bad: mir::MirResult = mir_lower::build_mir(&declared.parsed.file:Read, &declared.parsed.pool:Read, &boundary:Read, &check_tc:Read, &check_diags:ReadWrite)?;
    assert(!boundary_bad.accepted && check_diags.has_error && check_diags.diags[0].code.raw == 9001);
    assert(check_diags.diags[0].span.offset > 0 && check_diags.diags[0].span.length > 0);
    let rejected: runner::Loaded = runner::load("import risky; function #checked(): u32 { return risky::f(); }\n", 1223)?;
    var reject_diags: diag::DiagBuffer = diag::diagbuf_new();
    let reject_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&rejected.parsed.file:Read, &rejected.parsed.pool:Read, &rejected.lexed.names:Read, &deps:Read, "user", &reject_diags:ReadWrite)?;
    let reject_tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&rejected.parsed.file:Read, &rejected.parsed.pool:Read, &reject_resolution:Read, &reject_diags:ReadWrite)?;
    let denied: mir::MirResult = mir_lower::build_mir(&rejected.parsed.file:Read, &rejected.parsed.pool:Read, &reject_resolution:Read, &reject_tc:Read, &reject_diags:ReadWrite)?;
    assert(!denied.accepted && reject_diags.has_error && reject_diags.diags[0].code.raw == 7020);
    assert(@len(reject_diags.diags) == 1 && reject_diags.diags[0].span.file == 1223 && reject_diags.diags[0].span.offset == 48 && reject_diags.diags[0].span.length == 10);
    assert(denied.rejection.span.offset == reject_diags.diags[0].span.offset);
    // 非无增导入经本地函数传播时，同样不能满足无增契约。
    let transit: runner::Loaded = runner::load("import risky; function helper(): u32 { return risky::f(); } function #checked(): u32 { return helper(); }\n", 1224)?;
    var transit_diags: diag::DiagBuffer = diag::diagbuf_new();
    let transit_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&transit.parsed.file:Read, &transit.parsed.pool:Read, &transit.lexed.names:Read, &deps:Read, "user", &transit_diags:ReadWrite)?;
    let transit_tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&transit.parsed.file:Read, &transit.parsed.pool:Read, &transit_resolution:Read, &transit_diags:ReadWrite)?;
    let transit_result: mir::MirResult = mir_lower::build_mir(&transit.parsed.file:Read, &transit.parsed.pool:Read, &transit_resolution:Read, &transit_tc:Read, &transit_diags:ReadWrite)?;
    assert(!transit_result.accepted && transit_diags.has_error && transit_diags.diags[0].code.raw == 7020);
    assert(@len(transit_diags.diags) == 1 && transit_diags.diags[0].span.file == 1224 && transit_diags.diags[0].span.offset == 46 && transit_diags.diags[0].span.length == 10);
    assert(transit_result.rejection.span.offset == transit_diags.diags[0].span.offset);
    return;
}
function expect_no_alloc_cause(deps: &resolve_refs::DependencySet:Read, source: &[u8], offset: u32, length: u32): void!AllocError {
    let unit: runner::Loaded = runner::load(source, 1230)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &unit.lexed.names:Read, deps, "user", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    assert(!diags.has_error);
    let result: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &checked:Read, &diags:ReadWrite)?;
    assert(!result.accepted && @len(diags.diags) == 1 && diags.diags[0].code.raw == 7020);
    assert(diags.diags[0].span.file == 1230 && diags.diags[0].span.offset == offset && diags.diags[0].span.length == length);
    return;
}
function no_alloc_cause_order(): void!AllocError {
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    add_dependency(&deps:ReadWrite, "risky", 0, "export function f(): u32 { return 1; }\n")?;
    add_dependency(&deps:ReadWrite, "other", 0, "export function f(x: u32): u32 { return x; } export function z(x: u32): u32 { return x; }\n")?;
    // 分别钉住本地目标顺序、递归回边、导入身份、完整调用位置和块内顺序。
    expect_no_alloc_cause(&deps:Read, "import risky; function earlier(): u32 { return risky::f(); } function later(): u32 { return risky::f(); } function #checked(): u32 { return later() + earlier(); }\n", 47, 10)?;
    expect_no_alloc_cause(&deps:Read, "import risky; function helper(): u32 { return risky::f(); } function #checked(): u32 { return risky::f() + helper(); }\n", 46, 10)?;
    expect_no_alloc_cause(&deps:Read, "import risky; function #checked(n: u32): u32 { return cycle(n); } function cycle(n: u32): u32 { if n == 0 { return checked(1); } return risky::f(); }\n", 136, 10)?;
    expect_no_alloc_cause(&deps:Read, "import risky; import other; function #checked(): u32 { return other::f(7) + risky::f(); }\n", 76, 10)?;
    expect_no_alloc_cause(&deps:Read, "import other; function #checked(): u32 { return other::f(7); }\n", 48, 11)?;
    // if 的合流块编号较小，即使其中的调用写在分支之后。
    expect_no_alloc_cause(&deps:Read, "import risky; function #checked(n: u32): u32 { if n == 0 { return risky::f(); } return risky::f(); }\n", 87, 10)?;
    expect_no_alloc_cause(&deps:Read, "import other; function #checked(): u32 { return other::z(7) + other::f(8); }\n", 62, 11)?;
    expect_no_alloc_cause(&deps:Read, "import risky; function identity(n: u32): u32 { return n; } function #checked(n: u32): u32 { return identity(n) + risky::f(); }\n", 113, 10)?;
    // 双分支已终结，死合流块中的不安全导入不进入无增调用图。
    let dead: runner::Loaded = runner::load("import risky; function #checked(n: u32): u32 { if n == 0 { return 1; } else { return 2; } return risky::f(); }\n", 1231)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&dead.parsed.file:Read, &dead.parsed.pool:Read, &dead.lexed.names:Read, &deps:Read, "user", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&dead.parsed.file:Read, &dead.parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    let result: mir::MirResult = mir_lower::build_mir(&dead.parsed.file:Read, &dead.parsed.pool:Read, &resolution:Read, &checked:Read, &diags:ReadWrite)?;
    assert(result.accepted && !diags.has_error && result.module.functions[0].no_alloc);
    return;
}
// 同时篡改借用指令和结果类型，仍不能把只读投影伪装成可写地址。
function reference_projection_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("struct Cell { value: u64 } struct Box { cell: Cell } function read(src: &Box:Read): u64 { let view: &u64:Read = &src.cell.value:Read; return *view; }\n", 1285)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0;
    var projections: u32 = 0;
    while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 128 {
        if result.module.functions[0].insts[i].op == 82 { projections = projections + 1; }
        i = i + 1;
    }
    assert(i < @len(result.module.functions[0].insts) as u32 && projections == 2);
    let ty: u32 = result.module.functions[0].insts[i].value_type_id;
    result.module.functions[0].insts[i].op = 129;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.types.entries[ty - 1].cap = 1;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[i].op = 128;
    result.module.types.entries[ty - 1].cap = 0;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
// 保持操作数类型一致，只改变它的定义位置。
function use_before_definition_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(a: u32, b: u32): u32 { let first: u32 = a + b; return first + b; }\n", 1289)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var first: u32 = 0;
    while first < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[first].op != 16 { first = first + 1; }
    var later: u32 = first + 1;
    while later < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[later].op != 16 { later = later + 1; }
    assert(later < @len(result.module.functions[0].insts) as u32);
    let original: u32 = result.module.functions[0].insts[first].b;
    result.module.functions[0].insts[first].b = result.module.functions[0].insts[later].a;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[first].b = original;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
// 分支内同类型的值不能用作汇合块的返回操作数。
function non_dominating_branch_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(flag: bool, a: u32, b: u32): u32 { if flag { let first: u32 = a + b; @drop(first); } return a + b; }\n", 1290)?;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var block: u32 = 0;
    var branch_value: u32 = 0;
    var returning: u32 = 4294967295u32;
    while block < @len(result.module.functions[0].blocks) as u32 {
        let entry: mir::MirBlock = result.module.functions[0].blocks[block];
        if entry.terminator.op == 194 { returning = block; }
        else {
            var j: u32 = 0;
            while j < entry.inst_count {
                let inst: mir::MirInst = result.module.functions[0].insts[entry.inst_start + j];
                if inst.op == 16 { branch_value = inst.a; }
                j = j + 1;
            }
        }
        block = block + 1;
    }
    assert(branch_value != 0 && returning != 4294967295u32);
    let original: u32 = result.module.functions[0].blocks[returning].terminator.a;
    result.module.functions[0].blocks[returning].terminator.a = branch_value;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].blocks[returning].terminator.a = original;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
function unreachable_block_validation(): void!AllocError {
    var mir_result: mir::MirResult = runner::accepted("function f(): void { return; }\n", 1290)?;
    let next: u32 = @len(mir_result.module.functions[0].blocks) as u32;
    let inst_end: u32 = @len(mir_result.module.functions[0].insts) as u32;
    let entry: u16 = mir_result.module.functions[0].entry;
    let term: mir::MirTerminator = mir_result.module.functions[0].blocks[entry].terminator;
    @push(mir_result.module.functions[0].blocks, mir::MirBlock { id: next as u16, inst_start: inst_end, inst_count: 0, terminator: term, payload: 0, entry_view_ends: 0 })?;
    let checked: mir_verify::Validation = mir_verify::validate_module(&mir_result.module:Read)?;
    // rejection_spec: E7034 spec/ir/mir.md#M-4
    assert(!checked.ok && checked.code.raw == 7034);
    return;
}
function dispatch_validation(): void!AllocError {
    var enum_result: mir::MirResult = runner::accepted("enum Choice { Empty, Small(u32) } function f(c: Choice): u32 { match c { Empty => { return 0u32; }, Small(v) => { return v; } } }\n", 1291)?;
    let entry: u16 = enum_result.module.functions[0].entry;
    let saved: mir::MirTerminator = enum_result.module.functions[0].blocks[entry].terminator;
    assert(saved.op == 177 && saved.c == 2);
    enum_result.module.functions[0].blocks[entry].terminator.c = 1;
    let missing: mir_verify::Validation = mir_verify::validate_module(&enum_result.module:Read)?;
    // rejection_spec: E7035 spec/ir/mir.md#M-5
    assert(!missing.ok && missing.code.raw == 7035);
    enum_result.module.functions[0].blocks[entry].terminator = saved;
    enum_result.module.functions[0].arms[saved.b + 1].variant = 0;
    let duplicated: mir_verify::Validation = mir_verify::validate_module(&enum_result.module:Read)?;
    assert(!duplicated.ok && duplicated.code.raw == 7035);
    enum_result.module.functions[0].arms[saved.b].variant = 1;
    let unordered: mir_verify::Validation = mir_verify::validate_module(&enum_result.module:Read)?;
    assert(!unordered.ok && unordered.code.raw == 0);

    var carrier_result: mir::MirResult = runner::accepted("enum Fault { Failed } function g(): u32!Fault { return 1u32; } function f(): u32!Fault { return g()?; }\n", 1292)?;
    let count: u32 = @len(carrier_result.module.functions[1].blocks) as u32;
    var i: u32 = 0;
    while i < count && carrier_result.module.functions[1].blocks[i].terminator.op != 162 { i = i + 1; }
    assert(i < count);
    let err_arm: u32 = carrier_result.module.functions[1].blocks[i].terminator.c;
    assert(carrier_result.module.functions[1].blocks[err_arm].payload != 0);
    carrier_result.module.functions[1].blocks[err_arm].payload = 0;
    let carrier: mir_verify::Validation = mir_verify::validate_module(&carrier_result.module:Read)?;
    assert(!carrier.ok && carrier.code.raw == 7035);
    return;
}
function out_slot_validation(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var mir_result: mir::MirResult = runner::compile("function f(p: &u64:Write): void { *p = 1u64; }\n", 1293, &diags:ReadWrite)?;
    assert(mir_result.accepted && !diags.has_error && @len(mir_result.module.functions[0].blocks) == 1);
    let inst_end: u32 = @len(mir_result.module.functions[0].insts) as u32;
    let write_slot: mir::MirInst = mir_result.module.functions[0].insts[inst_end - 1];
    assert(write_slot.op == 209);
    @push(mir_result.module.functions[0].insts, write_slot)?;
    mir_result.module.functions[0].blocks[0].inst_count = inst_end + 1;
    let checked: mir_verify::Validation = mir_verify::validate_module(&mir_result.module:Read)?;
    // rejection_spec: E7036 spec/ir/mir.md#M-6
    assert(!checked.ok && checked.code.raw == 7036);
    return;
}
function consumed_place_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("function f(x: u32): u32 { let y: u32 = @move(x); return y; }\n", 1294)?;
    let entry: u16 = result.module.functions[0].entry;
    assert(result.module.functions[0].blocks[entry].terminator.op == 194);
    result.module.functions[0].blocks[entry].terminator.a = result.module.functions[0].params[0];
    let checked: mir_verify::Validation = mir_verify::validate_module(&result.module:Read)?;
    // rejection_spec: E7031 spec/ir/mir.md#M-1
    assert(!checked.ok && checked.code.raw == 7031);

    var branch: mir::MirResult = runner::accepted("function f(p: bool, x: u32, y: u32): u32 { if p { @drop(x); } return y; }\n", 1295)?;
    var i: u32 = 0;
    while i < @len(branch.module.functions[0].blocks) as u32 && branch.module.functions[0].blocks[i].terminator.op != 194 { i = i + 1; }
    assert(i < @len(branch.module.functions[0].blocks) as u32);
    branch.module.functions[0].blocks[i].terminator.a = branch.module.functions[0].params[1];
    let merged: mir_verify::Validation = mir_verify::validate_module(&branch.module:Read)?;
    assert(!merged.ok && merged.code.raw == 7031);

    var view_case: mir::MirResult = runner::accepted("function f(n: u32): u32 { var x: u32 = n; let view: &u32 = &x; let v: u32 = *view; @drop(x); return v; }\n", 1296)?;
    let count: u32 = @len(view_case.module.functions[0].insts) as u32;
    var read_at: u32 = count;
    var drop_at: u32 = count;
    i = 0;
    while i < count {
        let op: u8 = view_case.module.functions[0].insts[i].op;
        if op == 80 { read_at = i; }
        if op == 115 { drop_at = i; }
        i = i + 1;
    }
    assert(read_at < drop_at && drop_at < count);
    let drop_inst: mir::MirInst = view_case.module.functions[0].insts[drop_at];
    i = drop_at;
    while i > read_at {
        view_case.module.functions[0].insts[i] = view_case.module.functions[0].insts[i - 1];
        i = i - 1;
    }
    view_case.module.functions[0].insts[read_at] = drop_inst;
    let via_view: mir_verify::Validation = mir_verify::validate_module(&view_case.module:Read)?;
    assert(!via_view.ok && via_view.code.raw == 7031);

    let reassigned: mir::MirResult = runner::accepted("function f(): u32 { var x: u32 = 1u32; @drop(x); x = 7u32; return x; }\n", 1296)?;
    runner::expect0(&reassigned.module:Read, 0, 7)?;
    return;
}
function owning_handoff_validation(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var call: mir::MirResult = runner::compile("function use(arg: u32[]): void { @drop(arg); } function f(a: u32[], keep: u32[]): u64 { use(@move(a)); return @len(keep); }\n", 1297, &diags:ReadWrite)?;
    assert(call.accepted && !diags.has_error);
    var i: u32 = 0;
    while i < @len(call.module.functions[1].insts) as u32 && call.module.functions[1].insts[i].op != 150 { i = i + 1; }
    assert(i < @len(call.module.functions[1].insts) as u32);
    let handoff: mir::MirInst = call.module.functions[1].insts[i];
    assert(handoff.args_count == 1 && handoff.trap != 0);
    let drop_index: u32 = call.module.functions[1].blocks[handoff.trap - 1].inst_start;
    assert(call.module.functions[1].blocks[handoff.trap - 1].inst_count > 0 && call.module.functions[1].insts[drop_index].op == 115);
    let saved: u32 = call.module.functions[1].insts[drop_index].b;
    call.module.functions[1].insts[drop_index].b = call.module.functions[1].args[handoff.args_start];
    let wrong_cleanup: mir_verify::Validation = mir_verify::validate_module(&call.module:Read)?;
    assert(!wrong_cleanup.ok && wrong_cleanup.code.raw == 7031);
    call.module.functions[1].insts[drop_index].b = saved;
    assert(mir_verify::verify_module(&call.module:Read)?);

    var aggregate: mir::MirResult = runner::compile("struct Wrap { items: u32[] } function pack(value: u32[]): void { let boxed: Wrap = Wrap { items: @move(value) }; @drop(boxed); }\n", 1298, &diags:ReadWrite)?;
    assert(aggregate.accepted && !diags.has_error);
    var element: u32 = 0;
    i = 0;
    while i < @len(aggregate.module.functions[0].insts) as u32 {
        let ins: mir::MirInst = aggregate.module.functions[0].insts[i];
        if ins.op == 96 {
            assert(ins.args_count == 1);
            element = aggregate.module.functions[0].args[ins.args_start];
        }
        if ins.op == 115 { break; }
        i = i + 1;
    }
    assert(element != 0 && i < @len(aggregate.module.functions[0].insts) as u32);
    aggregate.module.functions[0].insts[i].b = element;
    let wrong_drop: mir_verify::Validation = mir_verify::validate_module(&aggregate.module:Read)?;
    assert(!wrong_drop.ok && wrong_drop.code.raw == 7031);

    let copy_case: mir::MirResult = runner::compile("struct Pair { a: u32, b: u32 } function peek(p: Pair): u32 { return p.a; } function f(p: Pair): u32 { let x: u32 = peek(p); return x + p.b; }\n", 1299, &diags:ReadWrite)?;
    assert(copy_case.accepted && !diags.has_error);
    return;
}
function exclusive_borrow_validation(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var branched: mir::MirResult = runner::compile("function f(flag: bool): u32 { var x: u32 = 1u32; var other: u32 = 2u32; let r: &u32:ReadWrite = &x:ReadWrite; if flag { other = 3u32; } return @wrap_add(*r, other); }\n", 1300, &diags:ReadWrite)?;
    assert(branched.accepted && !diags.has_error);
    let count: u32 = @len(branched.module.functions[0].insts) as u32;
    var i: u32 = 0;
    while i < count && branched.module.functions[0].insts[i].op != 129 { i = i + 1; }
    assert(i < count);
    let borrowed: u32 = branched.module.functions[0].insts[i].b;
    i = i + 1;
    while i < count && branched.module.functions[0].insts[i].op != 81 { i = i + 1; }
    assert(i < count && branched.module.functions[0].insts[i].b != borrowed);
    branched.module.functions[0].insts[i].b = borrowed;
    let checked: mir_verify::Validation = mir_verify::validate_module(&branched.module:Read)?;
    // rejection_spec: E7032 spec/ir/mir.md#M-2
    assert(!checked.ok && checked.code.raw == 7032);

    var scoped: mir::MirResult = runner::compile("function f(): u32 { var x: u32 = 1u32; var other: u32 = 2u32; let r: &u32:ReadWrite = &x:ReadWrite; var saved: u32 = 0u32; if true { let child: &u32 = &*r; other = 3u32; saved = *child; } *r = 4u32; return @wrap_add(@wrap_add(saved, *r), other); }\n", 1301, &diags:ReadWrite)?;
    assert(scoped.accepted && !diags.has_error);
    let scoped_count: u32 = @len(scoped.module.functions[0].insts) as u32;
    i = 0;
    while i < scoped_count && scoped.module.functions[0].insts[i].op != 128 { i = i + 1; }
    assert(i < scoped_count);
    let parent: u32 = scoped.module.functions[0].insts[i].b;
    i = i + 1;
    while i < scoped_count && scoped.module.functions[0].insts[i].op != 81 { i = i + 1; }
    assert(i < scoped_count && scoped.module.functions[0].insts[i].b != parent);
    scoped.module.functions[0].insts[i].b = parent;
    let overlapping: mir_verify::Validation = mir_verify::validate_module(&scoped.module:Read)?;
    assert(!overlapping.ok && overlapping.code.raw == 7032);

    var parameter: mir::MirResult = runner::compile("function f(r: &u32:ReadWrite): u32 { var other: u32 = 1u32; let child: &u32 = &*r; other = 3u32; return @wrap_add(*child, other); }\n", 1302, &diags:ReadWrite)?;
    assert(parameter.accepted && !diags.has_error);
    let limit: u32 = @len(parameter.module.functions[0].insts) as u32;
    i = 0;
    while i < limit && parameter.module.functions[0].insts[i].op != 128 { i = i + 1; }
    assert(i < limit);
    i = i + 1;
    while i < limit && parameter.module.functions[0].insts[i].op != 81 { i = i + 1; }
    assert(i < limit);
    parameter.module.functions[0].insts[i].b = parameter.module.functions[0].params[0];
    let parameter_overlap: mir_verify::Validation = mir_verify::validate_module(&parameter.module:Read)?;
    assert(!parameter_overlap.ok && parameter_overlap.code.raw == 7032);
    return;
}
// 以标志常量定位两个同型的真实 store，仅改待测写入的目的槽。
function redirect_borrow_write(func: &mir::MirFunction:ReadWrite, root_value: u64): void {
    var root: u32 = 0;
    var conflict: u32 = 0;
    var host: u32 = 0;
    var i: u32 = 0;
    while i < @len(func.insts) as u32 {
        let ins: mir::MirInst = func.insts[i];
        if ins.op == 1 && ins.value == root_value { root = ins.a; }
        if ins.op == 1 && ins.value == 31 { conflict = ins.a; }
        if ins.op == 81 && root != 0 && ins.c == root { host = ins.b; }
        if ins.op == 81 && conflict != 0 && ins.c == conflict {
            assert(host != 0 && ins.b != host);
            func.insts[i].b = host;
            return;
        }
        i = i + 1;
    }
    assert(false);
    return;
}

function mutable_view_join_validation(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var joined: mir::MirResult = runner::compile("function f(flag: bool): u32 { var x: u32 = 1; var y: u32 = 2; var z: u32 = 3; var r: &u32:ReadWrite = &y:ReadWrite; if flag { r = &x:ReadWrite; } z = 31u32; return @wrap_add(*r, z); }\n", 1305, &diags:ReadWrite)?;
    assert(joined.accepted && !diags.has_error);
    redirect_borrow_write(&joined.module.functions[0]:ReadWrite, 1);
    let overlap: mir_verify::Validation = mir_verify::validate_module(&joined.module:Read)?;
    assert(!overlap.ok && overlap.code.raw == 7032);

    // 合流后复制视图并经两个绑定读取时，两条来路都允许访问其所选位置。
    let rebound: mir::MirResult = runner::compile("function f(flag: bool): u32 { var x: u32 = 1; var y: u32 = 2; var r: &u32:ReadWrite = &x:ReadWrite; let alt: &u32:ReadWrite = &y:ReadWrite; if flag { r = @copy(alt); } let copied: &u32:ReadWrite = @copy(r); return @wrap_add(*copied, *r); }\n", 1306, &diags:ReadWrite)?;
    assert(rebound.accepted && !diags.has_error);

    // 重新写槽不会结束先前已经复制到另一 SSA 绑定的视图。
    var copied: mir::MirResult = runner::compile("function f(flag: bool): u32 { var x: u32 = 1; var y: u32 = 2; var z: u32 = 3; var r: &u32:ReadWrite = &x:ReadWrite; let alias: &u32:ReadWrite = @copy(r); if flag { r = &y:ReadWrite; z = 31u32; } return @wrap_add(*alias, @wrap_add(*r, z)); }\n", 1307, &diags:ReadWrite)?;
    assert(copied.accepted && !diags.has_error);
    redirect_borrow_write(&copied.module.functions[0]:ReadWrite, 1);
    let still_borrowed: mir_verify::Validation = mir_verify::validate_module(&copied.module:Read)?;
    assert(!still_borrowed.ok && still_borrowed.code.raw == 7032);

    var looped: mir::MirResult = runner::compile("function f(flag: bool): u32 { var x: u32 = 1; var y: u32 = 2; var z: u32 = 3; var r: &u32:ReadWrite = &x:ReadWrite; var test: bool = flag; while test { r = &y:ReadWrite; test = false; } z = 31u32; return @wrap_add(*r, z); }\n", 1308, &diags:ReadWrite)?;
    assert(looped.accepted && !diags.has_error);
    redirect_borrow_write(&looped.module.functions[0]:ReadWrite, 2);
    let back_edge: mir_verify::Validation = mir_verify::validate_module(&looped.module:Read)?;
    assert(!back_edge.ok && back_edge.code.raw == 7032);
    return;
}

function redirect_expression_read(func: &mir::MirFunction:ReadWrite): void {
    var borrowed: u32 = 0;
    var tagged: u32 = 0;
    var other: u32 = 0;
    var i: u32 = 0;
    while i < @len(func.insts) as u32 {
        let ins: mir::MirInst = func.insts[i];
        if ins.op == 129 { borrowed = ins.b; }
        if ins.op == 1 && ins.value == 31 { tagged = ins.a; }
        if ins.op == 81 && tagged != 0 && ins.c == tagged { other = ins.b; }
        if ins.op == 80 && other != 0 && ins.b == other {
            assert(borrowed != 0 && other != borrowed);
            func.insts[i].b = borrowed;
            return;
        }
        i = i + 1;
    }
    assert(false);
    return;
}

function lexical_view_end_validation(): void!AllocError {
    var inside: mir::MirResult = runner::accepted("function f(flag: bool): u32 { var x: u32 = 1; var other: u32 = 2; var saved: u32 = 0; if flag { let r: &u32:ReadWrite = &x:ReadWrite; saved = *r; other = 31u32; } return saved; }\n", 1309)?;
    redirect_borrow_write(&inside.module.functions[0]:ReadWrite, 1);
    let bound: mir_verify::Validation = mir_verify::validate_module(&inside.module:Read)?;
    assert(!bound.ok && bound.code.raw == 7032);

    var outside: mir::MirResult = runner::accepted("function f(flag: bool): u32 { var x: u32 = 1; var other: u32 = 2; var saved: u32 = 0; if flag { let r: &u32:ReadWrite = &x:ReadWrite; saved = *r; } other = 31u32; return saved; }\n", 1310)?;
    redirect_borrow_write(&outside.module.functions[0]:ReadWrite, 1);
    assert(mir_verify::verify_module(&outside.module:Read)?);

    var same: mir::MirResult = runner::accepted("function f(): u32 { var x: u32 = 1; var other: u32 = 31; return @wrap_add(*(&x:ReadWrite), other); }\n", 1311)?;
    redirect_expression_read(&same.module.functions[0]:ReadWrite);
    let temporary: mir_verify::Validation = mir_verify::validate_module(&same.module:Read)?;
    assert(!temporary.ok && temporary.code.raw == 7032);

    var next: mir::MirResult = runner::accepted("function f(): u32 { var x: u32 = 1; var other: u32 = 31; let saved: u32 = *(&x:ReadWrite); return @wrap_add(saved, other); }\n", 1312)?;
    redirect_expression_read(&next.module.functions[0]:ReadWrite);
    assert(mir_verify::verify_module(&next.module:Read)?);

    // 可变绑定重绑后，旧视图的区域仍以绑定块为限；控制流离块才结束借用。
    var reassigned: mir::MirResult = runner::accepted("function f(flag: bool): u32 { var x: u32 = 1; var y: u32 = 2; var other: u32 = 3; var saved: u32 = 0; if flag { var r: &u32:ReadWrite = &x:ReadWrite; r = &y:ReadWrite; other = 31u32; saved = *r; } return saved; }\n", 1313)?;
    redirect_borrow_write(&reassigned.module.functions[0]:ReadWrite, 1);
    let retained: mir_verify::Validation = mir_verify::validate_module(&reassigned.module:Read)?;
    assert(!retained.ok && retained.code.raw == 7032);

    var looped: mir::MirResult = runner::accepted("function f(flag: bool): u32 { var x: u32 = 1; var other: u32 = 2; var test: bool = flag; while test { if flag { let r: &u32:ReadWrite = &x:ReadWrite; other = *r; other = 31u32; break; } test = false; } return other; }\n", 1314)?;
    redirect_borrow_write(&looped.module.functions[0]:ReadWrite, 1);
    let jumped: mir_verify::Validation = mir_verify::validate_module(&looped.module:Read)?;
    assert(!jumped.ok && jumped.code.raw == 7032);

    // 在循环条件的短路右支产生的临时重借用不能沿回边进入下一次迭代。
    let short_condition: mir::MirResult = runner::accepted("function allowed(r: &u32): bool { return *r == 1u32; } function f(r: &u32:ReadWrite, count: u32): void { var i: u32 = count; while i != 0u32 && allowed(&*r) { *r = 2u32; i = 0u32; } }\n", 1315)?;
    assert(short_condition.accepted);
    return;
}

function pending_name_validation(): void!AllocError {
    let loaded: runner::Loaded = runner::load("function f(x: u32): u32 { return x; }\n", 1303)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &diags:ReadWrite)?;
    let good: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(good.accepted && !diags.has_error && refs.refs.pending_names == 0);
    var at: u32 = 0;
    while at < @len(refs.refs.items) as u32 {
        let candidate: resolve_refs::ResolvedRef = refs.refs.items[at];
        if candidate.kind == 0 && candidate.node_kind == 0 { break; }
        at = at + 1;
    }
    assert(at < @len(refs.refs.items) as u32);
    let expected_offset: u32 = refs.refs.items[at].span.offset;
    let local_def: u32 = refs.refs.items[at].x;
    refs.refs.items[at].x = refs.result.tables.defs[local_def - 1].name;
    refs.refs.items[at].kind = resolve_refs::pending_value_name();
    let rejected: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    // rejection_spec: E7018 spec/lang/symbol.md#S-18
    assert(!rejected.accepted && @len(rejected.module.functions) == 0 && diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7018);
    assert(diags.diags[0].span.offset == expected_offset);
    return;
}
function lowered_field_ids(): void!AllocError {
    var loaded: runner::Loaded = runner::load("struct Pair { first: u32, second: u32 } function f(): u32 { let p: Pair = Pair { second: 9u32, first: 4u32 }; return p.second; }\n", 1304)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    var tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &diags:ReadWrite)?;
    assert(!diags.has_error && @len(tc.expr_types.members) == 1 && @len(tc.expr_types.ctors) == 1);
    assert(tc.expr_types.members[0] == 2 && tc.expr_types.ctors[0].fields[0] == 2 && tc.expr_types.ctors[0].fields[1] == 1);
    loaded.parsed.pool.members[0].name = 0;
    loaded.parsed.pool.ctors[0].fields[0].name = 0;
    loaded.parsed.pool.ctors[0].fields[1].name = 0;
    let emitted: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(emitted.accepted && !diags.has_error);
    runner::expect0(&emitted.module:Read, 0, 9)?;
    tc.expr_types.members[0] = 0;
    let missing_projection: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(!missing_projection.accepted && @len(missing_projection.module.functions) == 0 && diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7018);
    tc.expr_types.members[0] = 2;
    tc.expr_types.ctors[0].fields[1] = 2;
    diags = diag::diagbuf_new();
    let duplicate_field: mir::MirResult = mir_lower::build_mir(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(!duplicate_field.accepted && @len(duplicate_field.module.functions) == 0 && diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7018);
    return;
}
function field_identifier_validation(): void!AllocError {
    var result: mir::MirResult = runner::accepted("struct Pair { first: u32, second: u32 } function f(p: Pair): u32 { return p.second; }\n", 1294)?;
    assert(@len(result.module.fields.items) == 2);
    assert(result.module.fields.items[0].name == 0 && result.module.fields.items[1].name == 0);
    result.module.fields.items[1].name = 3;
    let checked: mir_verify::Validation = mir_verify::validate_module(&result.module:Read)?;
    // rejection_spec: E7033 spec/ir/mir.md#M-3
    assert(!checked.ok && checked.code.raw == 7033);
    return;
}
function main(): void {
    consumed_place_validation()?;
    owning_handoff_validation()?;
    exclusive_borrow_validation()?;
    mutable_view_join_validation()?;
    lexical_view_end_validation()?;
    pending_name_validation()?;
    lowered_field_ids()?;
    field_identifier_validation()?;
    unreachable_block_validation()?; dispatch_validation()?; out_slot_validation()?;
    reference_projection_validation()?;
    use_before_definition_validation()?;
    non_dominating_branch_validation()?;
    imported_params()?; imported_arrays()?; imported_identity()?; imported_no_alloc()?; no_alloc_cause_order()?;
    scalar_arithmetic()?; arithmetic_type_validation()?; scalar_casts()?; cast_validation()?; char_constant_validation()?; bool_comparison_validation()?; slice_comparison_validation()?; array_comparison_validation()?; struct_comparison_validation()?; reference_comparison_validation()?; scalar_comparisons()?;
    scalar_branches()?; scalar_loops()?; scalar_short_circuit()?;
    scalar_calls()?; scalar_recursion()?; scalar_wrap()?;
    missing_signature()?; rejection_cases()?; void_type_cache()?; binding_decl_identity()?;
    return;
}
