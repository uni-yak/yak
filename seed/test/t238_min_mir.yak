function rejection_cases(): void!AllocError {
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: mir::MirResult = runner::compile("function f(x: bool): u32 { if x { return 1; } }\n", 1208, &d1:ReadWrite)?;
    assert(!r1.accepted && r1.rejection.kind == 7 && @len(r1.module.functions) == 0);
    assert(diag::diagbuf_count(&d1:Read) > 0 && d1.diags[0].code.raw == 2005);
    // 聚合值已纳入 MIR：结构体构造与字段读取必须真实取值，而不是一律拒绝。
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: mir::MirResult = runner::compile("struct P { x: u32, y: u32 } function f(): u32 { let p: P = P { x: 7, y: 9 }; return p.x + p.y * 2; }\n", 1209, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    assert(r2.accepted && r2.rejection.kind == 0 && @len(r2.module.functions) == 1);
    runner::expect0(&r2.module:Read, 0, 25)?;
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: mir::MirResult = runner::compile("function good(): u32 { return 1; } function bad(): u32 { return @clone(1u32); }\n", 1210, &d3:ReadWrite)?;
    assert(!r3.accepted && r3.rejection.kind != 0 && @len(r3.module.functions) == 0);
    // 隐式 Read 实参经临时位置取址，并以引用类型进入调用。
    var read_diags: diag::DiagBuffer = diag::diagbuf_new();
    let read: mir::MirResult = runner::compile("function f(): u8 { return peek(7); } function peek(x: &u8): u8 { return *x; }\n", 1284, &read_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&read_diags:Read) == 0);
    assert(read.accepted && @len(read.module.functions) == 2);
    assert(mir_verify::verify_module(&read.module:Read)?);
    let function_body: &mir::MirFunction:Read = &read.module.functions[0]:Read;
    var i: u32 = 0;
    while i < @len(function_body.insts) as u32 && function_body.insts[i].op != 150 { i = i + 1; }
    assert(i < @len(function_body.insts) as u32);
    let call: mir::MirInst = function_body.insts[i];
    assert(call.args_count == 1);
    let id: u32 = mir::local_type(function_body, function_body.args[call.args_start]);
    assert(id != 0 && read.module.types.entries[id - 1].kind == 4);
    return;
}
// 从真实写出的接口构造已验证的标志，避免把测试建立在手工桥接事实之上。
function add_dependency(deps: &resolve_refs::DependencySet:ReadWrite, name: &[u8], flag: u8, source: &[u8]): void!AllocError {
    let dep: runner::Loaded = runner::load(source, 1220)?;
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep.lexed.names:Read, &empty:Read, name, &diags:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    let layouts: iface::LayoutData = iface::LayoutData { sizes: [], aligns: [], known: [] };
    let result: iface::InterfaceResult = iface_write::write_interface(&dep.parsed.file:Read, &dep.parsed.pool:Read, &resolution:Read, &dep.lexed.names:Read, &tc:Read, &layouts:Read, name, &diags:ReadWrite)?;
    assert(!diags.has_error && result.export_count > 0);
    var bytes: u8[] = [];
    var i: u32 = 0; while i < @len(result.data.bytes) as u32 { @push(bytes, result.data.bytes[i])?; i = i + 1; }
    let off: u32 = bytes[108] as u32 | (bytes[109] as u32 << 8) | (bytes[110] as u32 << 16) | (bytes[111] as u32 << 24);
    i = 0; while i < result.export_count { bytes[off + i * 32 + 7] = flag; i = i + 1; }
    i = 24; while i < 56 { bytes[i] = 0; i = i + 1; }
    let digest: u8[] = iface::sha256(&bytes[0..@len(bytes)]:Read)?;
    i = 0; while i < 32 { bytes[24 + i] = digest[i]; i = i + 1; }
    let loaded: iface::LoadedInterface = iface_load::load_interface(&bytes[0..@len(bytes)]:Read, &diags:ReadWrite)?;
    assert(!diags.has_error && @len(loaded.exports) == result.export_count as u64);
    i = 0; while i < result.export_count { assert(loaded.exports[i].flags == flag); i = i + 1; }
    iface_load::add_binary_dependency(deps, &loaded:Read)?;
    return;
}
function imported_params(): void!AllocError {
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    add_dependency(&deps:ReadWrite, "typed", 0, "export function f(x: u32, y: bool): u32 { if y { return x; } return 0; }\n")?;
    let unit: runner::Loaded = runner::load("import typed; function f(x: u32, y: bool): u32 { return typed::f(x, y); }\n", 1228)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &unit.lexed.names:Read, &deps:Read, "user", &diags:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &refs:Read, &diags:ReadWrite)?;
    var result: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(result.accepted && !diags.has_error && mir_verify::verify_module(&result.module:Read)?);
    var i: u32 = 0; while i < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[i].op != 151 { i = i + 1; }
    assert(i < @len(result.module.functions[0].insts) as u32);
    let start: u32 = result.module.functions[0].insts[i].args_start;
    let first: u32 = result.module.functions[0].args[start];
    let second: u32 = result.module.functions[0].args[start + 1];
    result.module.functions[0].args[start] = second; result.module.functions[0].args[start + 1] = first;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].args[start] = first; result.module.functions[0].args[start + 1] = second;
    result.module.functions[0].args[start] = 0; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].args[start] = @len(result.module.functions[0].locals) as u32 + 1; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].args[start] = first;
    let ps: u32 = result.module.imports[0].param_start;
    let saved: u32 = result.module.import_params[ps];
    result.module.import_params[ps] = 0; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.import_params[ps] = saved;
    result.module.imports[0].param_start = @len(result.module.import_params) as u32; assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.imports[0].param_start = ps;
    refs.refs.imports[0].types[refs.refs.imports[0].param_start].a = 0;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
