    add_dependency(&deps:ReadWrite, "flags", 0, "export function f(x: bool): u32 { if x { return 1; } return 0; }\n")?;
    let unit: runner::Loaded = runner::load("import numbers; import flags; function f(x: u32, y: bool): u32 { return numbers::f(x) + flags::f(y); }\n", 1229)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &unit.lexed.names:Read, &deps:Read, "user", &diags:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &refs:Read, &diags:ReadWrite)?;
    var result: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &refs:Read, &tc:Read, &diags:ReadWrite)?;
    assert(result.accepted && !diags.has_error && mir_verify::verify_module(&result.module:Read)?);
    var first: u32 = 0; while first < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[first].op != 151 { first = first + 1; }
    var second: u32 = first + 1; while second < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[second].op != 151 { second = second + 1; }
    assert(second < @len(result.module.functions[0].insts) as u32);
    assert(result.module.functions[0].insts[first].b == result.module.functions[0].insts[second].b);
    let dep: u32 = result.module.functions[0].insts[first].c;
    assert(dep != result.module.functions[0].insts[second].c);
    result.module.functions[0].insts[first].c = result.module.functions[0].insts[second].c;
    assert(!mir_verify::verify_module(&result.module:Read)?);
    result.module.functions[0].insts[first].c = dep;
    assert(mir_verify::verify_module(&result.module:Read)?);
    return;
}
function imported_no_alloc(): void!AllocError {
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    add_dependency(&deps:ReadWrite, "safe", 1, "export function f(): u32 { return 1; }\n")?;
    add_dependency(&deps:ReadWrite, "risky", 0, "export function f(): u32 { return 1; }\n")?;
    let unit: runner::Loaded = runner::load("import safe; import risky; function a(): u32 { let x: u32 = 1; return safe::f() + x; } function b(): u32 { return risky::f(); } function c(): u32 { return a(); } function d(): u32 { return b(); }\n", 1221)?;
