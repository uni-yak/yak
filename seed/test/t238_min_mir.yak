    assert(i < @len(result.module.functions[0].insts) as u32);
    let left: u32 = result.module.functions[0].insts[i].b;
    let right: u32 = result.module.functions[0].insts[i].c;
    let value: u32 = result.module.functions[0].params[2];
    result.module.functions[0].insts[i].b = value;
    result.module.functions[0].insts[i].c = value;
    var compare: u8 = 48;
    while compare <= 53 {
        result.module.functions[0].insts[i].op = compare;
        assert(!mir_verify::verify_module(&result.module:Read)?);
        compare = compare + 1;
    }
    result.module.functions[0].insts[i].op = 48;
    result.module.functions[0].insts[i].b = left;
    result.module.functions[0].insts[i].c = right;
    assert(mir_verify::verify_module(&result.module:Read)?);
    var enums: mir::MirResult = runner::accepted("struct P { x: u32 } enum E { A, B(u32) } function f(a: E, b: E): bool { return a == b; } function g(a: E, b: E): bool { return a != b; }\n", 1288)?;
    assert(mir_verify::verify_module(&enums.module:Read)?);
    i = 0;
    while i < @len(enums.module.functions[0].insts) as u32 && enums.module.functions[0].insts[i].op != 48 { i = i + 1; }
    assert(i < @len(enums.module.functions[0].insts) as u32);
    // 在有效枚举操作数上逐个验证四种顺序比较。
    var op: u8 = 50;
    while op <= 53 {
        enums.module.functions[0].insts[i].op = op;
        assert(!mir_verify::verify_module(&enums.module:Read)?);
        op = op + 1;
    }
    enums.module.functions[0].insts[i].op = 48;
    assert(mir_verify::verify_module(&enums.module:Read)?);
