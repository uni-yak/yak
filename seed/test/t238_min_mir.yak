    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    assert(!diags.has_error && @len(resolution.bridges.items) == 2);
    var result: mir::MirResult = mir_lower::build_mir(&unit.parsed.file:Read, &unit.parsed.pool:Read, &resolution:Read, &tc:Read, &diags:ReadWrite)?;
    assert(result.accepted && !diags.has_error && @len(result.module.functions) == 4);
    // 对真实接口生成的远程调用逐项变异，只验证模块实际持有的结构信息。
    var call: u32 = 0;
    while call < @len(result.module.functions[0].insts) as u32 && result.module.functions[0].insts[call].op != 151 { call = call + 1; }
    assert(call < @len(result.module.functions[0].insts) as u32 && mir_verify::verify_module(&result.module:Read)?);
    let original: mir::MirInst = result.module.functions[0].insts[call];
