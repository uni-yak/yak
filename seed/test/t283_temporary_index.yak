// mem_limit: 500000
foreign assert(cond: bool): void;
enum Failure { Bad }
function values(ok: bool, calls: &u32:ReadWrite): u32[]!Failure {
    *calls = *calls + 1u32;
    if !ok { return Failure::Bad; }
    return [11u32, 22u32];
}
function index(ok: bool, calls: &u32:ReadWrite): u32!Failure {
    *calls = *calls + 1u32;
    if !ok { return Failure::Bad; }
    return 1u32;
}
function read(base_ok: bool, index_ok: bool, calls: &u32:ReadWrite): u32!Failure {
    return (values(base_ok, calls)?)[index(index_ok, calls)?];
}
function recover(e: &Failure): u32 { return 99u32; }
function fixed(): [u32; 2] { return [7u32, 8u32]; }
function ordered(calls: &u32:ReadWrite): u32 { assert(*calls == 1u32); return 0u32; }
function ordered_read(calls: &u32:ReadWrite): u32!Failure { return (values(true, calls)?)[ordered(calls)]; }
function main(): void {
    assert(fixed()[1u32] == 8u32);
    var order: u32 = 0;
    assert(ordered_read(&order:ReadWrite).catch(&recover) == 11u32);
    var calls: u32 = 0;
    assert(read(false, true, &calls:ReadWrite).catch(&recover) == 99u32);
    assert(calls == 1u32);
    var i: u32 = 0;
    while i < 1000 {
        assert(read(true, false, &calls:ReadWrite).catch(&recover) == 99u32);
        assert(read(true, true, &calls:ReadWrite).catch(&recover) == 22u32);
        i = i + 1u32;
    }
    assert(calls == 4001u32);
}
