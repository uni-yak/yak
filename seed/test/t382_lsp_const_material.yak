import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

function source(extra: bool, bad: bool): buf::ByteBuf!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    if bad { buf::buf_push_bytes(&text:ReadWrite, "const Number: u32 = 1 / 0;\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "const Number: u32 = 1;\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, "enum M0 { Zero, A(u32), B(u32) }\nenum M1 { Zero, A(M0), B(M0) }\nenum M2 { Zero, A(M1), B(M1) }\nenum M3 { Zero, A(M2), B(M2) }\nenum M4 { Zero, A(M3), B(M3) }\nenum M5 { Zero, A(M4), B(M4) }\nenum M6 { Zero, A(M5), B(M5), C(M2), D(M2), E(M1), F(M1), Pad0, Pad1")?;
    if extra { buf::buf_push_bytes(&text:ReadWrite, ", Pad2")?; }
    buf::buf_push_bytes(&text:ReadWrite, " }\nconst Value: M6 = M6::Zero;\nfunction f(): M6 { let n: u32 = Number; @drop(n); return Value; }\n")?;
    return text;
}

function pipeline_steps(): void!AllocError {
    let exact: buf::ByteBuf = source(false, false)?;
    let finished: pipeline::DocumentAnalysis = pipeline::run_document_frontend(&exact.data[0..exact.pos]:Read, 103u16)?;
    assert(pipeline::analysis_checked(finished.status) && finished.diagnostics.count == 0u32);
    let over: buf::ByteBuf = source(true, false)?;
    let clean: &[u8] = &over.data[0..over.pos]:Read;
    let stopped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(clean, 103u16)?;
    assert(pipeline::analysis_const_material_exceeded(stopped.status) && stopped.diagnostics.count == 0u32);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(clean, 103u16, &batch:ReadWrite)?;
    assert(accepted && batch.count == 0u32);
    let bad: buf::ByteBuf = source(true, true)?;
    let negative: &[u8] = &bad.data[0..bad.pos]:Read;
    let partial: pipeline::DocumentAnalysis = pipeline::run_document_frontend(negative, 103u16)?;
    assert(pipeline::analysis_const_material_exceeded(partial.status) && partial.diagnostics.count == 0u32 && !partial.diagnostics.truncated);
    let rejected: bool = !pipeline::run_frontend(negative, 103u16, &batch:ReadWrite)?;
    assert(rejected && batch.count == 1u32 && batch.diags[0].code.raw == 5008u16);
    let rejected_type: &[u8] = "struct Record { x: u32 } enum E { Empty, Value(Record) } const C: E = E::Empty; function f(): E { return C; }\n";
    let checked: pipeline::DocumentAnalysis = pipeline::run_document_frontend(rejected_type, 103u16)?;
    assert(checked.diagnostics.count == 1u32 && checked.diagnostics.diags[0].code.raw == 5006u16);
    return;
}

// 字节切片及其元素 2 步；枚举及命中行 2 步，两个槽和数组与元素 4 步。
function small_steps(): void!AllocError {
    let small: &[u8] = "const S: &[u8] = \"hi\"; enum E { Empty, Value([u32; 2]) } const C: E = E::Empty; function get_text_length(): u64 { return @len(S); } function get_value(): E { return C; }\n";
    let lexed: lex::LexResult = lex::lex_scan(small, 104u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 104u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 8u32 {
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(limit);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe_work: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe_work:ReadWrite, &scan:ReadWrite)?;
        assert(material.exhausted == (limit < 8u32) && material.remaining == 0u32 && diags.count == 0u32);
        if limit < 8u32 { assert(@len(checked.consts.bindings) == 0 && @len(checked.consts.values) == 0); }
        else {
            assert(@len(checked.consts.bindings) == 2);
            let bytes: u32 = checked.consts.bindings[0].value;
            let tag: u32 = checked.consts.bindings[1].value;
            assert(checked.consts.values[bytes - 1u32].kind == 4u8 && checked.consts.values[tag - 1u32].kind == 5u8);
            assert(checked.consts.values[tag - 1u32].variant == 0u32);
        }
        limit = limit + 1u32;
    }
    return;
}

function main(): void {
    small_steps()?;
    pipeline_steps()?;
    return;
}
