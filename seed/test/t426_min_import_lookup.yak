// module: buf=../../compiler/min/lib/buf.yak
// module: hash=../../compiler/min/lib/hash.yak
// module: hashmap=../../compiler/min/lib/hashmap.yak
// module: types=../../compiler/min/lib/types.yak
// module: lextables=../../compiler/min/src/lex/lextables.yak
// module: lex=../../compiler/min/src/lex/lex.yak
// module: ast=../../compiler/min/src/parse/ast.yak
// module: diag=../../compiler/min/src/diag/diag.yak
// module: resolve=../../compiler/min/src/check/resolve.yak
// module: resolve_refs=../../compiler/min/src/check/resolve_refs.yak
// module: consteval=../../compiler/min/src/check/consteval.yak
// module: typecheck=../../compiler/min/src/check/typecheck.yak
// module: type_import=../../compiler/min/src/check/type_import.yak
import resolve_refs;
import type_import;
foreign assert(cond: bool): void;

function main(): void {
    var refs: resolve_refs::RefTable = resolve_refs::RefTable { items: [], imports: [], variants: [], fields: [], structs: [], enums: [], expr_index: [], type_index: [], pattern_index: [], enum_names: [], pending_names: 0, contextual_enum_labels: false };
    assert(type_import::import_signature(&refs:Read, 1, 19) == 0);
    assert(type_import::import_field(&refs:Read, 1, 9, 2) == 0);

    // 只要求依赖编号递增；同组导出编号可逆序，重复条目保留首个匹配。
    @push(refs.imports, resolve_refs::ImportSignature { dep: 1, export_id: 19, param_count: 0, ret_slot: 0, param_start: 0, types: [] })?;
    @push(refs.imports, resolve_refs::ImportSignature { dep: 4, export_id: 27, param_count: 0, ret_slot: 0, param_start: 0, types: [] })?;
    @push(refs.imports, resolve_refs::ImportSignature { dep: 4, export_id: 19, param_count: 0, ret_slot: 0, param_start: 0, types: [] })?;
    @push(refs.imports, resolve_refs::ImportSignature { dep: 4, export_id: 19, param_count: 0, ret_slot: 0, param_start: 0, types: [] })?;
    @push(refs.imports, resolve_refs::ImportSignature { dep: 65535, export_id: 4294967295u32, param_count: 0, ret_slot: 0, param_start: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 1, export_id: 9, field: 0, name: 2, root: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 4, export_id: 11, field: 0, name: 8, root: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 4, export_id: 9, field: 0, name: 2, root: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 4, export_id: 9, field: 1, name: 2, root: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 4, export_id: 9, field: 2, name: 0, root: 0, types: [] })?;
    @push(refs.fields, resolve_refs::ImportField { dep: 65535, export_id: 4294967295u32, field: 0, name: 2, root: 0, types: [] })?;

    assert(type_import::import_signature(&refs:Read, 0, 19) == 0);
    assert(type_import::import_signature(&refs:Read, 1, 19) == 1);
    assert(type_import::import_signature(&refs:Read, 3, 19) == 0);
    assert(type_import::import_signature(&refs:Read, 4, 19) == 3);
    assert(type_import::import_signature(&refs:Read, 4, 27) == 2);
    assert(type_import::import_signature(&refs:Read, 4, 20) == 0);
    assert(type_import::import_signature(&refs:Read, 65535, 4294967295u32) == 5);
    assert(type_import::import_field(&refs:Read, 0, 9, 2) == 0);
    assert(type_import::import_field(&refs:Read, 1, 9, 2) == 1);
    assert(type_import::import_field(&refs:Read, 3, 9, 2) == 0);
    assert(type_import::import_field(&refs:Read, 4, 9, 2) == 3);
    assert(type_import::import_field(&refs:Read, 4, 11, 8) == 2);
    assert(type_import::import_field(&refs:Read, 4, 9, 0) == 0);
    assert(type_import::import_field(&refs:Read, 4, 9, 8) == 0);
    assert(type_import::import_field(&refs:Read, 65535, 4294967295u32, 2) == 6);
    assert(type_import::import_field(&refs:Read, 65535, 9, 2) == 0);
}
