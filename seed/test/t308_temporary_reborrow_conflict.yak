// expected_trap: suspended or stale reference
foreign assert(cond: bool): void;
struct Item { data: u32[] }
function index(data: &Item[]:ReadWrite): u32 { return 0u32; }
function main(): void {
    var data: Item[] = [Item { data: [1u32] }];
    let ref: &Item[]:ReadWrite = &data:ReadWrite;
    assert((&(*ref)[0u32..1u32]:ReadWrite)[0u32].data[0u32] == 1u32);
    let value: u32 = (&(*ref)[0u32..1u32]:ReadWrite)[0u32].data[index(&*ref:ReadWrite)];
    @drop(value);
}
