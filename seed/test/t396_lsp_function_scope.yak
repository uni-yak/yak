import lex;
import parse;
import ast;
import diag;
import resolve;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import pipeline;
foreign assert(cond: bool): void;

// 对照旧扫描与新下标，兼查形参直接寻址、遮蔽和类型归属。
function check_scopes(source: &[u8]): void!AllocError {
    let scanned: lex::LexResult = lex::lex_scan(source, 122u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&scanned:Read, 122u16)?;
    assert(@len(scanned.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &scanned.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    let tables: &resolve::ResolveTables = &resolution.result.tables:Read;
    let first_def: u32 = resolution.result.file.items[0].def_id;
    var i: u32 = 0;
    var functions: u32 = 0;
    while i < @len(parsed.file.items) as u32 {
        let item: ast::AstItem = parsed.file.items[i];
        if item.kind == 0u8 {
            let def: u32 = resolution.result.file.items[i].def_id;
            let body: u32 = parsed.pool.functions[item.data].body;
            let scope: u32 = typecheck::function_scope(tables, body, def);
            var old: u32 = 0;
            var s: u32 = 0;
            while s < @len(tables.scopes) as u32 {
                if tables.scopes[s].kind == 3u8 && tables.scopes[s].owner == def { old = s + 1u32; break; }
                s = s + 1u32;
            }
            assert(scope != 0u32 && scope == old);
            assert(typecheck::function_scope(tables, 4294967295u32, def) == 0u32);
            assert(typecheck::function_scope(tables, body, 0u32) == 0u32);
            if functions != 0u32 { assert(typecheck::function_scope(tables, body, first_def) == 0u32); }
            let first_stmt: u32 = parsed.pool.blocks[body].stmts[0];
            let child: u32 = parsed.pool.ifs[parsed.pool.stmts[first_stmt].data].branches[0].body;
            assert(tables.block_scope[child] != 0u32 && tables.block_scope[child] != scope);
            assert(typecheck::function_scope(tables, child, def) == 0u32);
            let sig: u32 = typecheck::func_sig(&checked.funcs:Read, def);
            var p: u32 = 0;
            while p < @len(parsed.pool.functions[item.data].params) as u32 {
                let name: u32 = parsed.pool.functions[item.data].params[p].name;
                let param: u32 = resolve::binding_in_scope(tables, scope, name);
                assert(resolve::function_param_def(tables, def, scope, p, name) == param);
                assert(resolve::function_param_def(tables, def, tables.block_scope[child], p, name) == 0u32);
                assert(resolve::function_param_def(tables, def, scope, p, 0u32) == 0u32);
                assert(resolve::function_param_def(tables, def, scope, 4294967295u32, name) == 0u32);
                assert(resolve::function_param_def(tables, 0u32, scope, p, name) == 0u32);
                if p != 0u32 { assert(resolve::function_param_def(tables, def + p, scope, 0u32, name) == 0u32); }
                let ty: u32 = typecheck::def_type(&checked.def_types:Read, param);
                assert(param != 0u32 && ty != 0u32 && ty == checked.funcs.items[sig - 1u32].params[p]);
                p = p + 1u32;
            }
            if functions != 0u32 {
                let local_stmt: u32 = parsed.pool.blocks[child].stmts[0];
                let local_name: u32 = parsed.pool.locals[parsed.pool.stmts[local_stmt].data].name;
                let shadow: u32 = resolve::binding_in_scope(tables, tables.block_scope[child], local_name);
                assert(shadow != 0u32 && shadow != resolve::binding_in_scope(tables, scope, local_name));
                assert(resolve::function_param_def(tables, def, tables.block_scope[child], p, local_name) == 0u32);
            }
            functions = functions + 1u32;
        }
        i = i + 1u32;
    }
    assert(functions == 2u32);
    return;
}

// 两个前端应报告同一条重复释放诊断，范围覆盖第二个原语。
function check_document(source: &[u8], repeated: bool): void!AllocError {
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let ok: bool = pipeline::run_frontend(source, 123u16, &batch:ReadWrite)?;
    let document: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 123u16)?;
    if !repeated {
        assert(ok && pipeline::analysis_checked(document.status));
        assert(batch.count == 0u32 && document.diagnostics.count == 0u32);
        return;
    }
    assert(!ok && pipeline::analysis_rejected(document.status));
    assert(batch.count == 1u32 && document.diagnostics.count == 1u32);
    let expected: diag::Diag = batch.diags[0];
    let actual: diag::Diag = document.diagnostics.diags[0];
    assert(actual.code.raw == 6003u16 && actual.code.raw == expected.code.raw && actual.severity == expected.severity && actual.unit == expected.unit);
    assert(actual.span.file == 123u16 && actual.span.file == expected.span.file);
    assert(actual.span.offset == expected.span.offset && actual.span.offset == @len(source) as u32 - 12u32);
    assert(actual.span.length == 5u32 && actual.span.length == expected.span.length);
    return;
}

function main(): void {
    let good: &[u8] = "function first(x: bool): bool { if x { return true; } return false; }\nstruct Gap { value: u32 }\nfunction last(x: u32[], z: bool): void { if z { let x: bool = z; if x {} } let n: u64 = @len(x); @drop(n); @drop(x); }\n";
    let bad: &[u8] = "function first(x: bool): bool { if x { return true; } return false; }\nstruct Gap { value: u32 }\nfunction last(x: u32[], z: bool): void { if z { let x: bool = z; if x {} } let n: u64 = @len(x); @drop(n); @drop(x); @drop(x); }\n";
    check_scopes(good)?;
    check_document(good, false)?;
    check_document(bad, true)?;
    return;
}
