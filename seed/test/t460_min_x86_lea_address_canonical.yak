// module: pe=../../compiler/min/src/emit/pe.yak
// module: x86_validate=../../compiler/min/src/emit/x86_validate.yak
import pe;
import x86_validate;
foreign assert(condition: bool): void;

function encoding(bytes: &[u8], expected: u16): void!AllocError {
    var code: pe::Code = pe::code_new();
    pe::code_bytes(&code:ReadWrite, bytes)?;
    assert(x86_validate::validate(&code:Read, 0)? == expected);
    return;
}

function main(): void {
    // 窄目的 LEA 只取地址低位。普通基址、扩展目的 SIB 和绝对 SIB 可省 67 前缀。
    let forms: [u8; 22] = [0x67, 0x66, 0x8d, 0x01, 0x66, 0x67, 0x44, 0x8d, 0x44, 0x91, 0x80,
        0x67, 0x8d, 0x04, 0x25, 0x80, 0, 0, 0, 0x67, 0x8d, 0x01];
    encoding(&forms[0..4]:Read, 7103)?;
    encoding(&forms[4..11]:Read, 7103)?;
    encoding(&forms[11..19]:Read, 7103)?;
    encoding(&forms[19..22]:Read, 7103)?;
    encoding(&forms[4..10]:Read, 7101)?;
    encoding(&forms[11..18]:Read, 7101)?;

    let canonical: [u8; 16] = [0x66, 0x89, 0xc8, 0x66, 0x44, 0x8d, 0x44, 0x91, 0x80,
        0xb8, 0x80, 0, 0, 0, 0x89, 0xc8];
    encoding(&canonical[0..16]:Read, 0)?;
    // RIP 相对寻址也可去掉前缀。位移按下一条指令修正，目的仍只取低位。
    let relative: [u8; 23] = [0x67, 0x8d, 0x05, 0, 0, 0, 0,
        0x67, 0x66, 0x8d, 0x05, 0xff, 0xff, 0xff, 0x7f,
        0x66, 0x67, 0x8d, 0x05, 0, 0, 0, 0x80];
    encoding(&relative[0..7]:Read, 7103)?;
    encoding(&relative[7..15]:Read, 7103)?;
    encoding(&relative[15..23]:Read, 7103)?;
    encoding(&relative[15..22]:Read, 7101)?;
    let canonical_relative: [u8; 13] = [0x8d, 0x05, 1, 0, 0, 0, 0x66, 0x8d, 0x05, 0, 0, 0, 0];
    encoding(&canonical_relative[0..13]:Read, 0)?;

    // 宽目的 32 位取址也可缩短；真正的 32 位访存和保留形态继续拒绝。
    let mixed: [u8; 18] = [0x67, 0x48, 0x8d, 0x01, 0x67, 0x48, 0x8d, 0x05, 0, 0, 0, 0, 0x67, 0x8b, 0x01,
        0x67, 0x8d, 0xc0];
    encoding(&mixed[0..4]:Read, 7103)?;
    encoding(&mixed[4..12]:Read, 7103)?;
    encoding(&mixed[12..15]:Read, 7101)?;
    encoding(&mixed[15..18]:Read, 7101)?;
    // 寄存器 ADD 不计算有效地址；前缀可省。
    let reg: [u8; 4] = [0x67, 0x48, 0x01, 0xc8];
    encoding(&reg[0..4]:Read, 7103)?;
    return;
}
