// t105: .then 恢复糖 —— Ok 时 h(&T) 映射为 U，Err 穿透（result.md full）
foreign assert(cond: bool): void;
enum E { Bad, }
function f(x: u32): u32!E {
    if x == 0 { return E::Bad; }
    return x;
}
function double(v: &u32): u32 {
    return *v * 2;
}
function main(): void {
    let a: u32 = f(5).then(&double)?;
    assert(a == 10);
    return;
}
