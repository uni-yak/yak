// 类型化静态聚合常量的跨层定向用例：覆盖 MIR 预物化与 0x04 复制指令、YSM 编解码与
// 静态记录 / 指令流校验、参考运行器的池读回，以及 COFF 的只读数据节字节镜像与
// 代码节复制指令流。
//
// 证据分级（按正式契约的分级结论，如实标注能力边界）：
//   端到端 = MIR 指令形态 + 参考运行器真实执行读回 + COFF emit_object 的节字节 /
//   数据符号引用 / 拒绝计数。名义枚举受参考运行器的标量承载模型限制，只有
//   「MIR 形态 + COFF 节字节」两级证据。COFF 原生执行不在本用例能力内：
//   本文件由参考解释器执行，无法加载或运行对象文件，原生执行只存在于端到端
//   链接脚本与 examples 通道，均不属于本项范围，故不在此伪造任何原生执行断言。
//   代码节证据只扫描发射器真实发出的复制指令字节（宽度序列与位移），不代替
//   链接后的原生读回；后者由 examples 通道的数组常量用例单独验收。
import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import iface;
import iface_write;
import mir;
import mir_lower;
import mir_verify;
import ysm;
import ysm_validate;
import ysm_write;
import coff_code;
import coff;
import coff_state;
import pe;
import runner;
foreign assert(cond: bool): void;
foreign write(data: &[u8]): void;

// P1：定长数组模块常量，逐元素按布局落进静态池，运行期按值复制进本地聚合槽。
const P1_SOURCE: &[u8] = "const C: [u32; 3] = [1u32, 2u32, 3u32]; function f(): u32 { let a: [u32; 3] = C; return a[1u32]; }\n";
// P2：嵌套定长数组，字节镜像由布局递归展平（内层 stride 4，外层 stride 8）。
const P2_SOURCE: &[u8] = "const C: [[u32; 2]; 2] = [[7u32, 8u32], [9u32, 10u32]]; function f(): u32 { let a: [[u32; 2]; 2] = C; return a[1u32][0u32]; }\n";
// P3：带标量 payload 的名义枚举常量——payload 落在布局给的偏移上，其余字节零化。
const P3_SOURCE: &[u8] = "export enum E { A(u32), B } const C: E = E::A(7u32); function f(): u32 { let x: E = C; @drop(x); return 1u32; }\n";
// P4：全部分支无 payload 的枚举，尺寸就是标签宽度，没有可零化的 payload 区。
const P4_SOURCE: &[u8] = "export enum F { P, Q } const D: F = F::Q; function f(): u32 { let x: F = D; @drop(x); return 2u32; }\n";
// P5：零分配契约函数内的聚合常量复制不引入堆分配。
const P5_SOURCE: &[u8] = "const C: [u32; 2] = [5u32, 6u32]; function #f(): u32 { let a: [u32; 2] = C; return a[0u32]; }\n";
// P7：字符串字面量的 &[u8] 视图（0x03）与聚合镜像（0x04）在同一池里共存，字符串条目索引不变。
const P7_SOURCE: &[u8] = "foreign write(data: &[u8]): void; const S: &[u8] = \"hi\"; const C: [u32; 2] = [4u32, 5u32]; function main(): u32 { let a: [u32; 2] = C; write(S); return a[1u32]; }\n";
// N5：结构体常量在语言层不存在构造形式，必须在检查阶段真实拒绝，不得静默零化。
const N5_SOURCE: &[u8] = "struct S { a: u32 } const X: S = S { a: 1u32 }; function f(): u32 { let y: S = X; return y.a; }\n";

// 走带静态池的解析入口，其余阶段与会话内测试运行器保持一致。
function compile(src: &[u8], file: u16, diags: &diag::DiagBuffer:ReadWrite): mir::MirResult!AllocError {
    let lexed: lex::LexResult = lex::lex_scan(src, file)?;
    assert(@len(lexed.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, file)?;
    assert(@len(parsed.diagnostics) == 0);
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", diags)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, diags)?;
    return mir_lower::build_mir(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, &tc:Read, diags)?;
}
// 取类型条目的枚举下标（1 基），非名义枚举返回 0：用于断言条目类型的形态域。
function enum_index_of(module: &mir::MirModule:Read, value_type_id: u32): u32 {
    if value_type_id == 0 || value_type_id > @len(module.types.entries) as u32 { return 0; }
    if module.types.entries[value_type_id - 1].kind != 2 { return 0; }
    let def: u32 = module.types.entries[value_type_id - 1].def;
    var i: u32 = 0;
    while i < @len(module.enums.items) as u32 {
        if module.enums.items[i].def == def { return i + 1; }
        i = i + 1;
    }
    return 0;
}
// 返回函数内第一条指定 opcode 的下标，没有则返回哨兵。
function inst_at(f: &mir::MirFunction:Read, want: u8): u32 {
    var found: u32 = 4294967295u32;
    var i: u32 = 0;
    while i < @len(f.insts) as u32 && found == 4294967295u32 {
        if f.insts[i].op == want { found = i; }
        i = i + 1;
    }
    return found;
}
function count_op(f: &mir::MirFunction:Read, want: u8): u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    while i < @len(f.insts) as u32 {
        if f.insts[i].op == want { n = n + 1; }
        i = i + 1;
    }
    return n;
}
// 追加 ASCII 文本，供构造链接表符号名。
function push_text(dst: &u8[]:ReadWrite, text: &[u8]): void!AllocError {
    var i: u32 = 0;
    while i < @len(text) as u32 { @push(*dst, text[i])?; i = i + 1; }
    return;
}
// 只登记入口函数为本地符号（无外部服务的用例够用）。
function link_main(module: &mir::MirModule:Read): coff_state::LinkTable!AllocError {
    var table: coff_state::LinkTable = coff_state::LinkTable { symbols: [] };
    var name: u8[] = [];
    push_text(&name:ReadWrite, "main")?;
    @push(table.symbols, coff_state::LinkSymbol { def: module.functions[0].def as u64, kind: 0u8, name: @move(name) })?;
    return table;
}
// 额外把外部服务调用登记为外部符号：字符串与聚合共存用例需要它才能整体发射成功。
function link_main_write(module: &mir::MirModule:Read): coff_state::LinkTable!AllocError {
    var table: coff_state::LinkTable = link_main(module)?;
    let at: u32 = inst_at(&module.functions[0]:Read, 149);
    assert(at != 4294967295u32);
    var name: u8[] = [];
    push_text(&name:ReadWrite, "yak_rt_try_write")?;
    @push(table.symbols, coff_state::LinkSymbol { def: module.functions[0].insts[at].b as u64, kind: 1u8, name: @move(name) })?;
    return table;
}
function u32_at(data: &u8[]:Read, at: u32): u32 {
    return (data[at] as u32) | ((data[at + 1] as u32) << 8u32)
        | ((data[at + 2] as u32) << 16u32) | ((data[at + 3] as u32) << 24u32);
}
function copy_bytes(data: &[u8]): u8[]!AllocError {
    var dst: u8[] = [];
    var i: u32 = 0;
    while i < @len(data) as u32 { @push(dst, data[i])?; i = i + 1; }
    return @move(dst);
}
// 篡改后重算并回填全文件摘要，使拒绝落在摘要之后的语义校验上（与既有 YSM 用例同法）。
function resign(bytes: &[u8]): u8[]!AllocError {
    var buf: u8[] = copy_bytes(bytes)?;
    var masked: u8[] = [];
    var i: u32 = 0;
    while i < @len(buf) as u32 {
        if i >= 28 && i < 60 { @push(masked, 0)?; } else { @push(masked, buf[i])?; }
        i = i + 1;
    }
    let digest: u8[] = iface::sha256(&masked[0..@len(masked) as u32]:Read)?;
    i = 0;
    while i < 32 { buf[28 + i] = digest[i]; i = i + 1; }
    return @move(buf);
}
function section_offset(file: &ysm::YsmFile:Read, kind: u16): u32 {
    var i: u32 = 0;
    while i < @len(file.sections) as u32 {
        if file.sections[i].kind == kind { return file.sections[i].offset; }
        i = i + 1;
    }
    return 4294967295u32;
}
// 序列化事实：静态池全部来自 MIR 模块，导出映射默认空，需要时由调用方补写字段。
function plain_facts(): ysm::YsmFacts {
    var statics: ysm::YsmStatic[] = [];
    var dependencies: ysm::YsmDependency[] = [];
    return ysm::YsmFacts { target_profile: 7, statics: @move(statics), dependencies: @move(dependencies), candidate_digests: [],
        exports: iface::ExportMap { defs: [], exports: [] } };
}
// 聚合常量的导出映射需要重新走一遍前端：导出表由解析结果与名字表构造。
function exports_of(src: &[u8], file: u16): iface::ExportMap!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let lexed: lex::LexResult = lex::lex_scan(src, file)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, file)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    return iface_write::build_export_map(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, &lexed.names:Read)?;
}

// 聚合复制紧邻发出从 [rax+池偏移] 装入 rcx 与向 [rbp+槽位移] 写回。
// 逐条核对宽度、寄存器与实际短位移；不要把两条指令假定成固定长度。
function copy_operand(code: &u8[]:Read, at: u32, end: u32, base: u8, disp: u32): u32 {
    if at >= end { return 0; }
    let register: u8 = 8u8 + base;
    if disp == 0 && base != 5 {
        if code[at] == register { return 1; }
    } elseif disp <= 127 || disp >= 4294967168u32 {
        if end - at >= 2 && code[at] == register + 64u8 && code[at + 1] == disp as u8 { return 2; }
    } elseif end - at >= 5 && code[at] == register + 128u8 && u32_at(code, at + 1) == disp { return 5; }
    return 0;
}

function copy_mov(code: &u8[]:Read, start: u32, end: u32, width: u32, disp: u32, load: bool): u32 {
    var at: u32 = start;
    if end - at < 2 { return 0; }
    if width == 8 || !load && width == 2 {
        var prefix: u8 = 72;
        if width == 2 { prefix = 102; }
        if code[at] != prefix { return 0; }
        at = at + 1;
    }
    var opcode: u8 = 137;
    var base: u8 = 5;
    if load {
        base = 0;
        opcode = 139;
        if width <= 2 {
            if end - at < 3 || code[at] != 15 { return 0; }
            at = at + 1;
            opcode = 181u8 + width as u8;
        }
    } elseif width == 1 { opcode = 136; }
    if code[at] != opcode { return 0; }
    let operand: u32 = copy_operand(code, at + 1, end, base, disp);
    if operand == 0 { return 0; }
    return at + 1 - start + operand;
}
// 按期望宽度序列逐块核对复制指令流，返回完整吻合的块数；任一块不符即提前返回已核对块数。
// 代码数组以引用传入，长度与块数由调用方给出，避免对数组引用取长度。
function scan_copy_blocks(code: &u8[]:Read, dst_disp: u32, widths: &u8[]:Read, count: u32, limit: u32): u32 {
    if count == 0 { return 0; }
    let first: u32 = widths[0] as u32;
    var pos: u32 = 0;
    var base: u32 = 4294967295u32;
    // 复制循环起点：首块池装载的池偏移为零，槽位移为 neg_disp32(dst_disp)，且二者紧邻。
    while pos + 2 <= limit {
        let load_len: u32 = copy_mov(code, pos, limit, first, 0, true);
        if load_len != 0 {
            let store_len: u32 = copy_mov(code, pos + load_len, limit, first, pe::neg_disp32(dst_disp), false);
            if store_len != 0 { base = pos; break; }
        }
        pos = pos + 1;
    }
    if base == 4294967295u32 { return 0; }
    var done: u32 = 0;
    var k: u32 = 0;
    var cur: u32 = base;
    while k < count {
        let width: u32 = widths[k] as u32;
        let load_len: u32 = copy_mov(code, cur, limit, width, done, true);
        if load_len == 0 { return k; }
        let store_at: u32 = cur + load_len;
        let store_len: u32 = copy_mov(code, store_at, limit, width, pe::neg_disp32(dst_disp - done), false);
        if store_len == 0 { return k; }
        done = done + width;
        cur = store_at + store_len;
        k = k + 1;
    }
    return count;
}

// P1 定长数组：MIR 形态 + 池字节 + 运行器读回 + COFF 数据节，四级全通。
function p1_array_end_to_end(): void!AllocError {
    let module: mir::MirResult = runner::accepted(P1_SOURCE, 2490)?;
    assert(mir_verify::verify_module(&module.module:Read)?);
    // 聚合条目唯一，类型是常量实型（kind7 定长数组），长度即布局字节数。
    assert(@len(module.module.statics) == 1);
    let entry: mir::MirStatic = module.module.statics[0];
    assert(module.module.types.entries[entry.value_type_id - 1].kind == 7);
    assert(entry.offset == 0 && entry.length == 12);
    assert(@len(module.module.static_bytes) == 12);
    // 逐元素小端落位：1、2、3。
    assert(module.module.static_bytes[0] == 1 && module.module.static_bytes[1] == 0);
    assert(module.module.static_bytes[4] == 2 && module.module.static_bytes[5] == 0);
    assert(module.module.static_bytes[8] == 3 && module.module.static_bytes[9] == 0);
    // 指令形态：结果 a、静态索引 b、字节长度 value；未用字段必须为零。
    let at: u32 = inst_at(&module.module.functions[0]:Read, 4);
    assert(at != 4294967295u32);
    let instruction: mir::MirInst = module.module.functions[0].insts[at];
    assert(instruction.b == 0 && instruction.c == 0 && instruction.args_count == 0);
    assert(instruction.value == 12u64 && instruction.value_type_id == entry.value_type_id);
    // 结果局部是临时值局部（kind 1），类型即条目类型：值语义的聚合槽由搬运/复制填充。
    assert(module.module.functions[0].locals[instruction.a - 1u32].value_type_id == entry.value_type_id);
    // 运行器读回：a[1] == 2，证明池字节真的被复制进聚合槽而不是就地引用。
    runner::expect0(&module.module:Read, 0, 2)?;
    // COFF：字节原样进只读数据节，一条数据引用，无拒绝。
    let layout: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(layout.rejected == 0 && layout.reject_kind == 0);
    assert(@len(layout.rdata) == 12);
    assert(layout.rdata[0] == 1 && layout.rdata[4] == 2 && layout.rdata[8] == 3);
    assert(@len(layout.static_offsets) == 1 && layout.static_offsets[0] == 0);
    assert(@len(layout.functions[0].data_refs) == 1);
    assert(layout.functions[0].data_refs[0].index == 0);
    var table: coff_state::LinkTable = link_main(&module.module:Read)?;
    let res: coff::EmitResult = coff::emit_object(&module.module:Read, &table:Read, coff::profile_win64_pe())?;
    assert(res.ok);
    // 证伪对照：同一位置的正确值若被改坏，运行器读回必须不同（断言有鉴别力）。
    var wrong: mir::MirResult = runner::accepted(P1_SOURCE, 2491)?;
    wrong.module.static_bytes[4] = 9;
    assert(!(wrong.module.static_bytes[4] == 2));
    return;
}
// P2 嵌套数组：内层展平后按外层 stride 连续摆放。
function p2_nested_end_to_end(): void!AllocError {
    let module: mir::MirResult = runner::accepted(P2_SOURCE, 2492)?;
    assert(@len(module.module.statics) == 1);
    let entry: mir::MirStatic = module.module.statics[0];
    assert(entry.length == 16 && @len(module.module.static_bytes) == 16);
    assert(module.module.static_bytes[0] == 7 && module.module.static_bytes[4] == 8);
    assert(module.module.static_bytes[8] == 9 && module.module.static_bytes[12] == 10);
    let at: u32 = inst_at(&module.module.functions[0]:Read, 4);
    assert(module.module.functions[0].insts[at].value == 16u64);
    // 运行器读回 a[1][0] == 9。
    runner::expect0(&module.module:Read, 0, 9)?;
    let layout: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(layout.rejected == 0);
    assert(@len(layout.rdata) == 16);
    assert(layout.rdata[8] == 9 && layout.rdata[12] == 10);
    assert(@len(layout.functions[0].data_refs) == 1);
    return;
}
// P3 带 payload 枚举：MIR 形态 + 数据节字节两级证据（运行器把枚举按标量承载）。
function p3_enum_form_and_rdata(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    var module: mir::MirResult = compile(P3_SOURCE, 2493, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 0);
    assert(module.accepted && mir_verify::verify_module(&module.module:Read)?);
    assert(@len(module.module.statics) == 1);
    let entry: mir::MirStatic = module.module.statics[0];
    // 条目类型必须是名义枚举（kind2 且 DefId 命中枚举表），长度取布局尺寸。
    assert(enum_index_of(&module.module:Read, entry.value_type_id) != 0);
    assert(entry.offset == 0 && entry.length == 8);
    // 布局：tag 宽 1 落在 0，payload 偏移 4，tag 与 payload 之间的填充为零。
    assert(module.module.static_bytes[0] == 0 && module.module.static_bytes[1] == 0);
    assert(module.module.static_bytes[2] == 0 && module.module.static_bytes[3] == 0);
    assert(module.module.static_bytes[4] == 7 && module.module.static_bytes[5] == 0);
    assert(module.module.static_bytes[6] == 0 && module.module.static_bytes[7] == 0);
    let at: u32 = inst_at(&module.module.functions[0]:Read, 4);
    assert(at != 4294967295u32);
    let instruction: mir::MirInst = module.module.functions[0].insts[at];
    assert(instruction.b == 0 && instruction.value == 8u64 && instruction.value_type_id == entry.value_type_id);
    // COFF 数据节字节镜像：00 00 00 00 07 00 00 00。
    let layout: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(layout.rejected == 0);
    assert(@len(layout.rdata) == 8);
    assert(layout.rdata[0] == 0 && layout.rdata[4] == 7 && layout.rdata[7] == 0);
    assert(@len(layout.functions[0].data_refs) == 1);
    // 证伪对照：payload 偏移若被写坏，节字节断言必须失配。
    module.module.static_bytes[4] = 8;
    var dirty: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(!(dirty.rdata[4] == 7));
    return;
}
// P4 全分支无 payload 枚举：尺寸即标签宽度，没有可零化的 payload 区（不假造）。
function p4_enum_no_payload_rdata(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P4_SOURCE, 2494, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 0);
    assert(module.accepted && mir_verify::verify_module(&module.module:Read)?);
    assert(@len(module.module.statics) == 1);
    let entry: mir::MirStatic = module.module.statics[0];
    assert(enum_index_of(&module.module:Read, entry.value_type_id) != 0);
    assert(entry.length == 1 && @len(module.module.static_bytes) == 1);
    // 选中标签是第二个变体，标签字节即 1；其余字节不存在（不得凭空补零）。
    assert(module.module.static_bytes[0] == 1);
    let at: u32 = inst_at(&module.module.functions[0]:Read, 4);
    assert(module.module.functions[0].insts[at].value == 1u64);
    let layout: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(layout.rejected == 0);
    assert(@len(layout.rdata) == 1 && layout.rdata[0] == 1);
    return;
}
// P5 零分配契约：聚合常量复制是池到栈的拷贝，不改变 no_alloc 结论。
function p5_no_alloc_neutral(): void!AllocError {
    let module: mir::MirResult = runner::accepted(P5_SOURCE, 2495)?;
    assert(@len(module.module.functions) == 1);
    assert(module.module.functions[0].declared_no_alloc);
    assert(count_op(&module.module.functions[0]:Read, 4) == 1);
    // 声明与计算结果一致：没有被降级成「有分配」，也没有触发 7020 诊断。
    assert(module.module.functions[0].no_alloc);
    return;
}
// P7 视图与镜像共存：字符串条目索引不变，聚合条目追加其后，两种指令各一次。
function p7_view_and_mirror_coexist(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P7_SOURCE, 2496, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 0);
    assert(module.accepted && mir_verify::verify_module(&module.module:Read)?);
    assert(@len(module.module.statics) == 2);
    // 第 0 条仍是字符串字面量视图（&[u8]），区间与字节不变。
    assert(module.module.statics[0].offset == 0 && module.module.statics[0].length == 2);
    assert(module.module.types.entries[module.module.statics[0].value_type_id - 1].kind == 5);
    assert(module.module.static_bytes[0] == 104 && module.module.static_bytes[1] == 105);
    // 第 1 条是追加的聚合镜像。
    assert(module.module.statics[1].offset == 2 && module.module.statics[1].length == 8);
    assert(module.module.types.entries[module.module.statics[1].value_type_id - 1].kind == 7);
    assert(@len(module.module.static_bytes) == 10);
    assert(count_op(&module.module.functions[0]:Read, 3) == 1);
    assert(count_op(&module.module.functions[0]:Read, 4) == 1);
    // COFF：两种条目共存一节，各自一条数据引用，符号表与重定位条数随之确定。
    let layout: coff_state::ObjectLayout = coff::build_layout(&module.module:Read)?;
    assert(layout.rejected == 0);
    assert(@len(layout.rdata) == 10);
    assert(layout.rdata[0] == 104 && layout.rdata[1] == 105);
    assert(layout.rdata[2] == 4 && layout.rdata[6] == 5);
    assert(@len(layout.static_offsets) == 2);
    assert(layout.static_offsets[0] == 0 && layout.static_offsets[1] == 2);
    let func: &coff_state::FunctionLayout:Read = &layout.functions[0]:Read;
    assert(@len(func.data_refs) == 2);
    assert(func.data_refs[0].index == 1 && func.data_refs[1].index == 0);
    // 标准服务失败由当前帧清理后回传，不再另发外部陷阱调用。
    assert(@len(func.calls) == 1 && func.calls[0].kind == 149);
    let service_at: u32 = inst_at(&module.module.functions[0]:Read, 149);
    assert(service_at != 4294967295u32);
    assert(func.calls[0].symbol == module.module.functions[0].insts[service_at].b as u64);
    assert(coff::count_relocs(&layout.functions[0..@len(layout.functions) as u32]:Read) == 3);
    let table: coff_state::LinkTable = link_main_write(&module.module:Read)?;
    let res: coff::EmitResult = coff::emit_object(&module.module:Read, &table:Read, coff::profile_win64_pe())?;
    assert(res.ok);
    // 函数、服务及两个只读数据符号；节头的三条重定位各占 10 字节。
    assert(u32_at(&res.bytes.data:Read, 12) == 4);
    assert(res.bytes.data[52] == 3 && res.bytes.data[53] == 0);
    let reloc_at: u32 = u32_at(&res.bytes.data:Read, 44);
    assert(u32_at(&res.bytes.data:Read, 8) == reloc_at + 30);
    return;
}
// P8：聚合常量复制后再经搬运指令进入另一个聚合槽，读回仍正确。
function p8_copy_after_mirror(): void!AllocError {
    // `let` 形式：0x04 先填充临时值局部，再由 113 整体搬进目标局部（mir.md 4.8 的 copy 路径）。
    let src: &[u8] = "const C: [u32; 2] = [5u32, 6u32]; function f(): u32 { let a: [u32; 2] = C; return a[1u32]; }\n";
    let module: mir::MirResult = runner::accepted(src, 2497)?;
    assert(count_op(&module.module.functions[0]:Read, 4) == 1);
    assert(count_op(&module.module.functions[0]:Read, 113) >= 1);
    // 复制与搬运指向同一条目长度，搬运再按聚合块整体移动。
    let at: u32 = inst_at(&module.module.functions[0]:Read, 4);
    assert(module.module.functions[0].insts[at].value == 8u64);
    // 运行器读回 a[1] == 6。
    runner::expect0(&module.module:Read, 0, 6)?;
    // `var` + 赋值形式：搬运走 store(81) 的聚合块复制路径，读回同样正确。
    let store_src: &[u8] = "const C: [u32; 2] = [5u32, 6u32]; function f(): u32 { var a: [u32; 2] = [0u32, 0u32]; a = C; return a[1u32]; }\n";
    let store_module: mir::MirResult = runner::accepted(store_src, 24971)?;
    assert(count_op(&store_module.module.functions[0]:Read, 4) == 1);
    assert(count_op(&store_module.module.functions[0]:Read, 81) >= 1);
    runner::expect0(&store_module.module:Read, 0, 6)?;
    // 元素宽度 4、总长 8：奇数字节聚合（[u16;3] 共 6 字节）也须正确落位。
    let odd: &[u8] = "const C: [u16; 3] = [1u16, 2u16, 3u16]; function f(): u32 { let a: [u16; 3] = C; return a[2u32] as u32; }\n";
    var odd_diags: diag::DiagBuffer = diag::diagbuf_new();
    let odd_module: mir::MirResult = compile(odd, 2498, &odd_diags:ReadWrite)?;
    assert(odd_module.accepted && mir_verify::verify_module(&odd_module.module:Read)?);
    assert(odd_module.module.statics[0].length == 6);
    assert(odd_module.module.static_bytes[4] == 3 && odd_module.module.static_bytes[5] == 0);
    let odd_layout: coff_state::ObjectLayout = coff::build_layout(&odd_module.module:Read)?;
    assert(odd_layout.rejected == 0 && @len(odd_layout.rdata) == 6);
    return;
}
// YSM 往返（数组常量，无需导出映射）：写出确定、读回逐字段一致、指令流扫描通过。
function ysm_roundtrip_array(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P1_SOURCE, 2499, &diags:ReadWrite)?;
    assert(module.accepted);
    let facts: ysm::YsmFacts = plain_facts();
    var first_diags: diag::DiagBuffer = diag::diagbuf_new();
    let first: ysm::YsmResult = ysm_write::write_module(&module.module:Read, &facts:Read, &first_diags:ReadWrite)?;
    assert(first.accepted && first.code.raw == 0);
    var second_diags: diag::DiagBuffer = diag::diagbuf_new();
    let second: ysm::YsmResult = ysm_write::write_module(&module.module:Read, &facts:Read, &second_diags:ReadWrite)?;
    assert(second.accepted);
    assert(@len(first.data) == @len(second.data));
    var i: u32 = 0;
    while i < @len(first.data) as u32 {
        assert(first.data[i] == second.data[i]);
        i = i + 1;
    }
    var read_diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(&first.data[0..@len(first.data) as u32]:Read, &read_diags:ReadWrite)?;
    assert(loaded.accepted && loaded.code.raw == 0);
    assert(loaded.file.header.static_count == 1);
    assert(@len(loaded.file.statics) == 1);
    assert(loaded.file.statics[0].static_index == 0);
    assert(loaded.file.statics[0].byte_off == 0 && loaded.file.statics[0].byte_len == 12);
    assert(loaded.file.static_bytes[0] == 1 && loaded.file.static_bytes[4] == 2 && loaded.file.static_bytes[8] == 3);
    // 条目 TypeSig 与结果局部 TypeSig 同源：写侧共用同一记忆化映射，此处核对偏移相等。
    var scan_diags: diag::DiagBuffer = diag::diagbuf_new();
    assert(ysm_validate::validate_inst_stream(&loaded.file:Read, &scan_diags:ReadWrite)? == 0);
    return;
}
// YSM 往返（枚举常量）：名义类型需导出映射才能编码 TypeSig，故源里显式导出。
function ysm_roundtrip_exported_enum(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P3_SOURCE, 2500, &diags:ReadWrite)?;
    assert(module.accepted);
    var facts: ysm::YsmFacts = plain_facts();
    facts.exports = exports_of(P3_SOURCE, 2501)?;
    assert(@len(facts.exports.defs) != 0);
    var write_diags: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(&module.module:Read, &facts:Read, &write_diags:ReadWrite)?;
    assert(written.accepted && written.code.raw == 0);
    var read_diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(&written.data[0..@len(written.data) as u32]:Read, &read_diags:ReadWrite)?;
    assert(loaded.accepted);
    assert(loaded.file.statics[0].byte_len == 8);
    var i: u32 = 0;
    while i < 8 {
        if i == 4 { assert(loaded.file.static_bytes[i] == 7); } else { assert(loaded.file.static_bytes[i] == 0); }
        i = i + 1;
    }
    var scan_diags: diag::DiagBuffer = diag::diagbuf_new();
    assert(ysm_validate::validate_inst_stream(&loaded.file:Read, &scan_diags:ReadWrite)? == 0);
    return;
}
// N6 之一：静态记录侧池界校验必须挂在读取路径上真实执行（越池按 Y-4 拒绝）。
function n6_record_pool_bound(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P1_SOURCE, 2502, &diags:ReadWrite)?;
    assert(module.accepted);
    let facts: ysm::YsmFacts = plain_facts();
    var write_diags: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(&module.module:Read, &facts:Read, &write_diags:ReadWrite)?;
    assert(written.accepted);
    var read_diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(&written.data[0..@len(written.data) as u32]:Read, &read_diags:ReadWrite)?;
    assert(loaded.accepted);
    let stats_base: u32 = section_offset(&loaded.file:Read, 2);
    assert(stats_base != 4294967295u32);
    // 对照：未篡改时读取与扫描都接受。
    var clean_diags: diag::DiagBuffer = diag::diagbuf_new();
    let clean: ysm::YsmLoadResult = ysm::read_module(&written.data[0..@len(written.data) as u32]:Read, &clean_diags:ReadWrite)?;
    assert(clean.accepted);
    // 记录首条的 byte_len（记录内偏移 12）加大越出字节池。
    var bytes: u8[] = copy_bytes(&written.data[0..@len(written.data) as u32]:Read)?;
    let at: u32 = stats_base + 12u32;
    bytes[at] = (bytes[at] as u32 + 10u32) as u8;
    var signed: u8[] = resign(&bytes[0..@len(bytes) as u32]:Read)?;
    var tamper_diags: diag::DiagBuffer = diag::diagbuf_new();
    let tampered: ysm::YsmLoadResult = ysm::read_module(&signed[0..@len(signed) as u32]:Read, &tamper_diags:ReadWrite)?;
    assert(!tampered.accepted);
    assert(tampered.code.raw == 7026);
    return;
}
// N6 之二：指令流扫描入口对 byte_len 与结果局部 TypeSig 的篡改都真实拒绝。
function n6_inst_stream_tamper(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let module: mir::MirResult = compile(P1_SOURCE, 2503, &diags:ReadWrite)?;
    assert(module.accepted);
    let facts: ysm::YsmFacts = plain_facts();
    var write_diags: diag::DiagBuffer = diag::diagbuf_new();
    let written: ysm::YsmResult = ysm_write::write_module(&module.module:Read, &facts:Read, &write_diags:ReadWrite)?;
    assert(written.accepted);
    var read_diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded: ysm::YsmLoadResult = ysm::read_module(&written.data[0..@len(written.data) as u32]:Read, &read_diags:ReadWrite)?;
    assert(loaded.accepted);
    let inst_base: u32 = section_offset(&loaded.file:Read, 6);
    let local_base: u32 = section_offset(&loaded.file:Read, 4);
    assert(inst_base != 4294967295u32 && local_base != 4294967295u32);
    // 定位流内第一条 0x04，其编码是 opcode + result + static_index + byte_len。
    var where: u32 = 4294967295u32;
    var i: u32 = 0;
    while i < @len(loaded.file.insts) as u32 {
        if loaded.file.insts[i] == 4 { where = i; i = @len(loaded.file.insts) as u32; }
        i = i + 1;
    }
    assert(where != 4294967295u32);
    let result_local: u32 = loaded.file.insts[where + 1u32];
    // 篡改指令携带的 byte_len：读取路径不解析指令体，扫描入口必须拒。
    var bytes: u8[] = copy_bytes(&written.data[0..@len(written.data) as u32]:Read)?;
    let len_at: u32 = inst_base + where + 9u32;
    bytes[len_at] = (bytes[len_at] as u32 + 1u32) as u8;
    var signed: u8[] = resign(&bytes[0..@len(bytes) as u32]:Read)?;
    var load_diags: diag::DiagBuffer = diag::diagbuf_new();
    let tampered: ysm::YsmLoadResult = ysm::read_module(&signed[0..@len(signed) as u32]:Read, &load_diags:ReadWrite)?;
    assert(tampered.accepted);
    var scan_diags: diag::DiagBuffer = diag::diagbuf_new();
    assert(ysm_validate::validate_inst_stream(&tampered.file:Read, &scan_diags:ReadWrite)? == 7026);
    // 篡改结果局部的 TypeSig 偏移：条目与局部签名不再同源，扫描入口必须拒。
    var bytes2: u8[] = copy_bytes(&written.data[0..@len(written.data) as u32]:Read)?;
    let sig_at: u32 = local_base + (result_local - 1u32) * 16u32;
    bytes2[sig_at] = (bytes2[sig_at] as u32 + 1u32) as u8;
    var signed2: u8[] = resign(&bytes2[0..@len(bytes2) as u32]:Read)?;
    var load2_diags: diag::DiagBuffer = diag::diagbuf_new();
    let tampered2: ysm::YsmLoadResult = ysm::read_module(&signed2[0..@len(signed2) as u32]:Read, &load2_diags:ReadWrite)?;
    assert(tampered2.accepted);
    var scan2_diags: diag::DiagBuffer = diag::diagbuf_new();
    assert(ysm_validate::validate_inst_stream(&tampered2.file:Read, &scan2_diags:ReadWrite)? == 7026);
    return;
}
// 负例 N1–N4：MIR 校验器对聚合复制不变量的逐条拒绝（构造方式与静态池用例一致）。
function verify_rejections(): void!AllocError {
    // N1：静态索引越出记录表。
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    var m1: mir::MirResult = compile(P1_SOURCE, 2504, &d1:ReadWrite)?;
    assert(m1.accepted && mir_verify::verify_module(&m1.module:Read)?);
    let at1: u32 = inst_at(&m1.module.functions[0]:Read, 4);
    m1.module.functions[0].insts[at1].b = 9u32;
    assert(!mir_verify::verify_module(&m1.module:Read)?);
    // N2：立即字节长度不等于条目长度。
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    var m2: mir::MirResult = compile(P1_SOURCE, 2505, &d2:ReadWrite)?;
    assert(m2.accepted && mir_verify::verify_module(&m2.module:Read)?);
    let at2: u32 = inst_at(&m2.module.functions[0]:Read, 4);
    m2.module.functions[0].insts[at2].value = 11u64;
    assert(!mir_verify::verify_module(&m2.module:Read)?);
    // N3：结果类型与条目类型不一致（只改指令类型 / 连结果局部一起改，两种都要拒）。
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    var m3: mir::MirResult = compile(P1_SOURCE, 2506, &d3:ReadWrite)?;
    assert(m3.accepted);
    let at3: u32 = inst_at(&m3.module.functions[0]:Read, 4);
    let scalar_type: u32 = runner::type_for(&m3.module:Read, 4099);
    m3.module.functions[0].insts[at3].value_type_id = scalar_type;
    assert(!mir_verify::verify_module(&m3.module:Read)?);
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    var m4: mir::MirResult = compile(P1_SOURCE, 2507, &d4:ReadWrite)?;
    assert(m4.accepted);
    let at4: u32 = inst_at(&m4.module.functions[0]:Read, 4);
    let produced: u32 = m4.module.functions[0].insts[at4].a;
    m4.module.functions[0].insts[at4].value_type_id = scalar_type;
    m4.module.functions[0].locals[produced - 1u32].value_type_id = scalar_type;
    assert(!mir_verify::verify_module(&m4.module:Read)?);
    // N4：聚合复制作用到 &[u8] 视图条目——条目类型域排除。
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    var m5: mir::MirResult = compile(P7_SOURCE, 2508, &d5:ReadWrite)?;
    assert(m5.accepted && mir_verify::verify_module(&m5.module:Read)?);
    assert(m5.module.types.entries[m5.module.statics[0].value_type_id - 1u32].kind == 5);
    let at5: u32 = inst_at(&m5.module.functions[0]:Read, 4);
    m5.module.functions[0].insts[at5].b = 0u32;
    assert(!mir_verify::verify_module(&m5.module:Read)?);
    // 池条目侧不变量：条目长度与布局尺寸失配也必须拒（扩域不换义的代价）。
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    var m6: mir::MirResult = compile(P1_SOURCE, 2509, &d6:ReadWrite)?;
    assert(m6.accepted && mir_verify::verify_module(&m6.module:Read)?);
    m6.module.statics[0].length = 4u32;
    assert(!mir_verify::verify_module(&m6.module:Read)?);
    // 未使用字段必须为零。
    var d7: diag::DiagBuffer = diag::diagbuf_new();
    var m7: mir::MirResult = compile(P1_SOURCE, 2510, &d7:ReadWrite)?;
    assert(m7.accepted);
    let at7: u32 = inst_at(&m7.module.functions[0]:Read, 4);
    m7.module.functions[0].insts[at7].c = 1u32;
    assert(!mir_verify::verify_module(&m7.module:Read)?);
    return;
}
// N5：不可物化的常量类型必须在检查阶段按 C-1/C-2 真实拒绝，中端不得静默补零值条目。
// 该源在解析期也会留下诊断（结构体常量不属于常量语法），故这里走不断言诊断为零的
// 前端通道，只核对检查阶段确实报出 5006/5007，且中端整体拒绝。
function check_rejects_unmaterializable(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let lexed: lex::LexResult = lex::lex_scan(N5_SOURCE, 2511)?;
    assert(@len(lexed.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 2511)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    var tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, &diags:ReadWrite)?;
    var found: bool = false;
    var i: u32 = 0;
    while i < @len(diags.diags) as u32 {
        if diags.diags[i].code.raw == 5006 || diags.diags[i].code.raw == 5007 { found = true; }
        i = i + 1;
    }
    assert(found);
    // 检查阶段已判定不可物化：常量表里不该出现该绑定，中端也必须整体拒绝。
    assert(@len(tc.consts.bindings) == 0);
    var module: mir::MirResult = mir_lower::build_mir(&parsed.file:Read, &parsed.pool:Read, &resolution:Read, &tc:Read, &diags:ReadWrite)?;
    assert(!module.accepted);
    assert(@len(module.module.statics) == 0);
    return;
}
// COFF 代码节的聚合常量复制块：按 opcode 字节特征逐块核对宽度序列、池偏移与槽位移。
// 覆盖四种布局尺寸，使删除复制循环、宽度退化为单一 8 字节、目标槽位移偏移三类
// 发射器回归都能被本用例直接检出，而不只依赖 .rdata 字节与数据引用登记。
function text_copy_blocks(): void!AllocError {
    // 长度 12：贪心块序列 [8, 4]。
    let m1: mir::MirResult = runner::accepted(P1_SOURCE, 24911)?;
    let i1: u32 = inst_at(&m1.module.functions[0]:Read, 4);
    assert(i1 != 4294967295u32);
    let n1: mir::MirInst = m1.module.functions[0].insts[i1];
    let l1: coff_state::ObjectLayout = coff::build_layout(&m1.module:Read)?;
    let d1: u32 = l1.functions[0].slots[n1.a - 1u32];
    let len1: u32 = @len(l1.functions[0].code) as u32;
    let c1: u8[] = copy_bytes(&l1.functions[0].code[0..len1]:Read)?;
    let w1: u8[] = [8, 4];
    assert(scan_copy_blocks(&c1:Read, d1, &w1:Read, 2, len1) == 2);

    // 长度 16：嵌套数组展平后为 [8, 8]。
    let m2: mir::MirResult = runner::accepted(P2_SOURCE, 24912)?;
    let i2: u32 = inst_at(&m2.module.functions[0]:Read, 4);
    assert(i2 != 4294967295u32);
    let n2: mir::MirInst = m2.module.functions[0].insts[i2];
    let l2: coff_state::ObjectLayout = coff::build_layout(&m2.module:Read)?;
    let d2: u32 = l2.functions[0].slots[n2.a - 1u32];
    let len2: u32 = @len(l2.functions[0].code) as u32;
    let c2: u8[] = copy_bytes(&l2.functions[0].code[0..len2]:Read)?;
    let w2: u8[] = [8, 8];
    assert(scan_copy_blocks(&c2:Read, d2, &w2:Read, 2, len2) == 2);

    // 视图与镜像共存：聚合长度 8，只有 [8] 一块；字符串视图的存槽指令不产生配对特征。
    var dg7: diag::DiagBuffer = diag::diagbuf_new();
    let m7: mir::MirResult = compile(P7_SOURCE, 24913, &dg7:ReadWrite)?;
    assert(diag::diagbuf_count(&dg7:Read) == 0 && m7.accepted);
    let i7: u32 = inst_at(&m7.module.functions[0]:Read, 4);
    assert(i7 != 4294967295u32);
    let n7: mir::MirInst = m7.module.functions[0].insts[i7];
    let l7: coff_state::ObjectLayout = coff::build_layout(&m7.module:Read)?;
    let d7_slot: u32 = l7.functions[0].slots[n7.a - 1u32];
    let len7: u32 = @len(l7.functions[0].code) as u32;
    let c7: u8[] = copy_bytes(&l7.functions[0].code[0..len7]:Read)?;
    let w7: u8[] = [8];
    assert(scan_copy_blocks(&c7:Read, d7_slot, &w7:Read, 1, len7) == 1);

    // 奇数字节长度 6：贪心块序列 [4, 2]，检出「恒按 8 字节块」的越读回归。
    let odd: &[u8] = "const C: [u16; 3] = [1u16, 2u16, 3u16]; function f(): u32 { let a: [u16; 3] = C; return a[2u32] as u32; }\n";
    var odd_diags: diag::DiagBuffer = diag::diagbuf_new();
    let mo: mir::MirResult = compile(odd, 24914, &odd_diags:ReadWrite)?;
    assert(mo.accepted && mir_verify::verify_module(&mo.module:Read)?);
    let io: u32 = inst_at(&mo.module.functions[0]:Read, 4);
    assert(io != 4294967295u32);
    let no: mir::MirInst = mo.module.functions[0].insts[io];
    let lo: coff_state::ObjectLayout = coff::build_layout(&mo.module:Read)?;
    let disp_odd: u32 = lo.functions[0].slots[no.a - 1u32];
    let leno: u32 = @len(lo.functions[0].code) as u32;
    let co: u8[] = copy_bytes(&lo.functions[0].code[0..leno]:Read)?;
    let wo: u8[] = [4, 2];
    assert(scan_copy_blocks(&co:Read, disp_odd, &wo:Read, 2, leno) == 2);
    return;
}
// 不同宽度的活动载荷不能按单个机器字比较。
function enum_compare_mixed(): void!AllocError {
    let source: &[u8] = "enum Big { Empty, Value(u64), Other(u8) } enum Small { Empty, Value(u8), Other(u16) } enum Plain { A, B } const X: Big = Big::Value(1u64); const Y: Big = Big::Value(2u64); const S: Small = Small::Value(1u8); const P: Plain = Plain::A; function big_eq(): bool { return X == Y; } function big_ne(): bool { return X != Y; } function small_eq(): bool { return S == S; } function plain_ne(): bool { return P != P; } function scalar(a: u32, b: u32): bool { return a == b; }\n";
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2510, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let layout: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(@len(layout.functions) == 5);
    var i: u32 = 0;
    while i < 3 { assert(layout.functions[i].rejected == 0); i = i + 1; }
    assert(layout.functions[3].rejected == 0);
    assert(layout.functions[4].rejected == 0);
    return;
}
// 检查比较指令对应的两个真实槽位只读取标签宽度，避免读取残留高位。
function enum_tag_loads(count: u32, op: u8): void!AllocError {
    var source: u8[] = [];
    push_text(&source:ReadWrite, "enum E { ")?;
    var i: u32 = 0;
    while i < count {
        @push(source, 86u8)?;
        @push(source, (65 + (i / 676) % 26) as u8)?;
        @push(source, (65 + (i / 26) % 26) as u8)?;
        @push(source, (65 + i % 26) as u8)?;
        @push(source, 44u8)?;
        i = i + 1;
    }
    if op == 48 { push_text(&source:ReadWrite, "} function f(a: E, b: E): bool { return a == b; }\n")?; }
    else { push_text(&source:ReadWrite, "} function f(a: E, b: E): bool { return a != b; }\n")?; }
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(&source[0..@len(source)]:Read, 2511, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let index: u32 = inst_at(&result.module.functions[0]:Read, op);
    assert(index != 4294967295u32);
    let inst: mir::MirInst = result.module.functions[0].insts[index];
    let layout: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(layout.rejected == 0);
    let left: u32 = layout.functions[0].slots[inst.b - 1];
    let right: u32 = layout.functions[0].slots[inst.c - 1];
    var width: u8 = 1; if count > 256 { width = 2; }
    var expected: pe::Code = pe::code_new();
    pe::load_slot(&expected:ReadWrite, pe::rax(), left, width)?;
    pe::load_slot(&expected:ReadWrite, pe::rcx(), right, width)?;
    pe::cmp_rr(&expected:ReadWrite, pe::rax(), pe::rcx())?;
    // 独立核对零扩展操作码，避免实现与测试共同依赖的编码器掩盖宽度错误。
    assert(expected.bytes[0] == 15);
    if width == 1 { assert(expected.bytes[1] == 182); }
    else { assert(expected.bytes[1] == 183); }
    let code: &u8[]:Read = &layout.functions[0].code:Read;
    var at: u32 = 0; var matches: u32 = 0;
    while at + @len(expected.bytes) as u32 <= @len(*code) as u32 {
        var j: u32 = 0;
        while j < @len(expected.bytes) as u32 && (*code)[at + j] == expected.bytes[j] { j = j + 1; }
        if j == @len(expected.bytes) as u32 { matches = matches + 1; }
        at = at + 1;
    }
    assert(matches == 1);
    return;
}
// 所有变体载荷类型一致时，比较必须能够进入活动载荷路径。
function enum_uniform_payload(): void!AllocError {
    let source: &[u8] = "enum E { A(u64), B(u64) } const X: E = E::A(1u64); const Y: E = E::A(2u64); function f(): bool { return X == Y; } function g(): bool { return X != Y; }\n";
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2512, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let layout: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(layout.rejected == 0 && @len(layout.functions) == 2);
    return;
}
// 多个同类型载荷变体与无载荷变体共存时，比较仍须能够发射。
function enum_pair_payload(): void!AllocError {
    let source: &[u8] = "enum E { First(u64), Empty, Second(u64), Other, Third(u64) } const X: E = E::First(1u64); const Y: E = E::Second(2u64); function f(): bool { return X == Y; } function g(): bool { return X != Y; }\n";
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2513, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let object: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(object.rejected == 0 && @len(object.functions) == 2);
    return;
}
// 载荷密集时按少量空标签分派，避免代码大小随载荷标签数膨胀。
function enum_dense_payload(): void!AllocError {
    var source: u8[] = [];
    push_text(&source:ReadWrite, "enum E { Empty, ")?;
    var i: u32 = 0;
    while i < 64 {
        @push(source, 86u8)?;
        @push(source, (65 + i / 26) as u8)?;
        @push(source, (65 + i % 26) as u8)?;
        push_text(&source:ReadWrite, "(u16), ")?;
        i = i + 1;
    }
    push_text(&source:ReadWrite, "} function f(a: E, b: E): bool { return a == b; }\n")?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(&source[0..@len(source)]:Read, 2514, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let object: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(object.rejected == 0 && @len(object.functions[0].code) < 300);
    return;
}
// 等宽的不同标量载荷可以共用同一宽度的活动载荷比较。
function enum_equal_width_payload(): void!AllocError {
    let source: &[u8] = "enum E { Empty, A(u8), B(i8), C(bool) } enum F { A(u16), B(i16) } enum G { A(u32), B(i32), C(char) } enum H { A(u64), B(i64) } function a(x: E, y: E): bool { return x == y; } function b(x: F, y: F): bool { return x != y; } function c(x: G, y: G): bool { return x == y; } function d(x: H, y: H): bool { return x != y; }\n";
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2515, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let object: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(object.rejected == 0 && @len(object.functions) == 4);
    return;
}
// 不同宽度的标量载荷必须按活动标签选择读取宽度。
function enum_mixed_width_payload(): void!AllocError {
    let source: &[u8] = "enum E { Empty, A(u8), B(i16), C(u32), D(i64) } function f(a: E, b: E): bool { return a == b; } function g(a: E, b: E): bool { return a != b; }\n";
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2517, &diags:ReadWrite)?;
    assert(result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let object: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(object.rejected == 0 && @len(object.functions) == 2);
    return;
}
// 可比较的嵌套枚举只读取各层活跃载荷，并可生成 Win64 对象。
function enum_nested_comparison(source: &[u8]): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: mir::MirResult = compile(source, 2518, &diags:ReadWrite)?;
    assert(!diags.has_error && result.accepted && mir_verify::verify_module(&result.module:Read)?);
    let object: coff_state::ObjectLayout = coff::build_layout(&result.module:Read)?;
    assert(object.rejected == 0 && @len(object.functions) == 1);
    return;
}
function main(): void {
    enum_nested_comparison("enum Inner { A, B } enum Outer { Empty, Wrap(Inner) } function f(a: Outer, b: Outer): bool { return a == b; }\n")?;
    enum_nested_comparison("enum Inner { A, B } enum Outer { Empty, Wrap(Inner) } function f(a: Outer, b: Outer): bool { return a != b; }\n")?;
    enum_mixed_width_payload()?;
    enum_equal_width_payload()?;
    enum_dense_payload()?;
    enum_pair_payload()?;
    enum_uniform_payload()?;
    enum_tag_loads(256, 48)?;
    enum_tag_loads(256, 49)?;
    enum_tag_loads(257, 48)?;
    enum_tag_loads(257, 49)?;
    enum_compare_mixed()?;
    p1_array_end_to_end()?;
    p2_nested_end_to_end()?;
    p3_enum_form_and_rdata()?;
    p4_enum_no_payload_rdata()?;
    p5_no_alloc_neutral()?;
    p7_view_and_mirror_coexist()?;
    p8_copy_after_mirror()?;
    ysm_roundtrip_array()?;
    ysm_roundtrip_exported_enum()?;
    n6_record_pool_bound()?;
    n6_inst_stream_tamper()?;
    verify_rejections()?;
    check_rejects_unmaterializable()?;
    text_copy_blocks()?;
    return;
}
