import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import iface;
foreign assert(cond: bool): void;
struct Loaded { parsed: parse::ParseResult, lexed: lex::LexResult }
function load(src: &[u8], file: u16): Loaded!AllocError {
    let r: lex::LexResult = lex::lex_scan(src, file)?;
    assert(@len(r.diagnostics) == 0);
    let p: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    assert(@len(p.diagnostics) == 0);
    return Loaded { parsed: p, lexed: r };
}
function hex_digit(value: u8): u8 {
    if value >= 48 && value <= 57 { return value - 48; }
    if value >= 97 && value <= 102 { return value - 87; }
    if value >= 65 && value <= 70 { return value - 55; }
    return 255;
}
function sha_equals(digest: &[u8], expected: &[u8]): bool {
    if @len(digest) as u32 != 32 || @len(expected) as u32 != 64 { return false; }
    var i: u32 = 0;
    while i < 32 {
        let high: u8 = hex_digit(expected[i * 2]);
        let low: u8 = hex_digit(expected[i * 2 + 1]);
        if high == 255 || low == 255 { return false; }
        if digest[i] != ((high << 4) | low) { return false; }
        i = i + 1;
    }
    return true;
}
function bytes_equal(actual: &[u8], expected: &[u8]): bool {
    if @len(actual) as u32 != @len(expected) as u32 { return false; }
    var i: u32 = 0;
    while i < @len(expected) as u32 {
        if actual[i] != expected[i] { return false; }
        i = i + 1;
    }
    return true;
}
function find_builtin(types: &typecheck::TypeTable:Read, builtin: u16): u32 {
    var i: u32 = 0;
    while i < @len(types.entries) as u32 {
        if types.entries[i].kind == 1 && types.entries[i].builtin == builtin { return i + 1; }
        i = i + 1;
    }
    return 0;
}
function find_local(types: &typecheck::TypeTable:Read): u32 {
    var i: u32 = 0;
    while i < @len(types.entries) as u32 {
        if types.entries[i].kind == 2 { return i + 1; }
        i = i + 1;
    }
    return 0;
}
// 公开编码入口不得把畸形错误集编码成可使用的类型签名。
function check_error_set_bounds(): void!AllocError {
    var entries: typecheck::TypeEntry[] = [];
    @push(entries, typecheck::TypeEntry { kind: 1, builtin: 4099, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(entries, typecheck::TypeEntry { kind: 11, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(entries, typecheck::TypeEntry { kind: 9, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 2, cap: 0, length: 0, success: 1, members_start: 0, members_count: 0 })?;
    var table: typecheck::TypeTable = typecheck::TypeTable { entries: @move(entries), members: [] };
    let map: iface::ExportMap = iface::ExportMap { defs: [], exports: [] };
    var i: u32 = 0;
    while i < 5 {
        if i == 1 { table.entries[1].members_count = 65537; }
        if i == 2 { table.entries[1].members_count = 1; }
        if i == 3 { table.entries[1].members_start = 4294967295u32; }
        if i == 4 { table.entries[1].members_start = 0; table.entries[2].elem = 1; }
        var sink: iface::ByteSink = iface::ByteSink { bytes: [] };
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        iface::encode_type(&table:Read, &map:Read, 3, &sink:ReadWrite, &diags:ReadWrite, 0)?;
        assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7012);
        i = i + 1;
    }
    table.entries[2].elem = 2;
    table.entries[1].members_start = 0;
    @push(table.entries, typecheck::TypeEntry { kind: 1, builtin: 4108, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(table.members, 4)?;
    var valid_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    var valid_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &map:Read, 3, &valid_sink:ReadWrite, &valid_diags:ReadWrite, 0)?;
    assert(!valid_diags.has_error && @len(valid_sink.bytes) == 15);
    // 错误成员不得是普通固有类型、复合类型或无效的类型编号。
    @push(table.entries, typecheck::TypeEntry { kind: 6, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 1, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    let invalid: u32[] = [0u32, 1u32, 5u32, 99u32];
    i = 0;
    while i < @len(invalid) as u32 {
        table.members[0] = invalid[i];
        var bad_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
        var bad_diags: diag::DiagBuffer = diag::diagbuf_new();
        iface::encode_type(&table:Read, &map:Read, 3, &bad_sink:ReadWrite, &bad_diags:ReadWrite, 0)?;
        assert(bad_diags.has_error && bad_diags.diags[0].code.raw == 7012);
        i = i + 1;
    }
    table.members[0] = 4;
    table.entries[2].success = 4;
    var overlap_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    var overlap_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &map:Read, 3, &overlap_sink:ReadWrite, &overlap_diags:ReadWrite, 0)?;
    assert(overlap_diags.has_error && overlap_diags.diags[0].code.raw == 7012);
    // 不同类型槽可能代表相同身份，导入身份还必须区分依赖编号。
    @push(table.entries, typecheck::TypeEntry { kind: 2, builtin: 0, def: 7, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(table.entries, typecheck::TypeEntry { kind: 2, builtin: 0, def: 7, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(table.entries, typecheck::TypeEntry { kind: 3, builtin: 0, def: 0, dep: 1, export_id: 2, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(table.entries, typecheck::TypeEntry { kind: 3, builtin: 0, def: 0, dep: 1, export_id: 2, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(table.entries, typecheck::TypeEntry { kind: 3, builtin: 0, def: 0, dep: 2, export_id: 2, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    let identity_map: iface::ExportMap = iface::ExportMap { defs: [7u32], exports: [1u32] };
    table.entries[2].success = 6; table.members[0] = 7;
    var local_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var local_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &local_sink:ReadWrite, &local_diags:ReadWrite, 2)?;
    assert(local_diags.has_error && local_diags.diags[0].code.raw == 7012);
    table.entries[2].success = 8; table.members[0] = 9;
    var import_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var import_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &import_sink:ReadWrite, &import_diags:ReadWrite, 2)?;
    assert(import_diags.has_error && import_diags.diags[0].code.raw == 7012);
    table.members[0] = 10;
    var different_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var different_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &different_sink:ReadWrite, &different_diags:ReadWrite, 2)?;
    assert(!different_diags.has_error && @len(different_sink.bytes) > 0);
    // 相同身份的不同槽位以及非相邻重复均不得写出；不同依赖的同号导出保持独立。
    table.entries[2].success = 1;
    table.members[0] = 6; @push(table.members, 8)?; @push(table.members, 7)?;
    table.entries[1].members_count = 3;
    var dup_local_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var dup_local_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &dup_local_sink:ReadWrite, &dup_local_diags:ReadWrite, 2)?;
    assert(dup_local_diags.has_error && dup_local_diags.diags[0].code.raw == 7012);
    table.members[0] = 8; table.members[1] = 10; table.members[2] = 9;
    var dup_import_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var dup_import_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &dup_import_sink:ReadWrite, &dup_import_diags:ReadWrite, 2)?;
    assert(dup_import_diags.has_error && dup_import_diags.diags[0].code.raw == 7012);
    table.members[0] = 4; table.members[1] = 10; table.members[2] = 4;
    var dup_builtin_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var dup_builtin_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &dup_builtin_sink:ReadWrite, &dup_builtin_diags:ReadWrite, 2)?;
    assert(dup_builtin_diags.has_error && dup_builtin_diags.diags[0].code.raw == 7012);
    table.members[0] = 8; table.members[1] = 10; table.entries[1].members_count = 2;
    var distinct_sink: iface::ByteSink = iface::ByteSink { bytes: [] }; var distinct_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &identity_map:Read, 3, &distinct_sink:ReadWrite, &distinct_diags:ReadWrite, 2)?;
    assert(!distinct_diags.has_error && @len(distinct_sink.bytes) > 0);
    return;
}
// 函数引用成员区间无效时，编码入口必须给出诊断而非越界。
function check_ref_bounds(): void!AllocError {
    var entries: typecheck::TypeEntry[] = [];
    @push(entries, typecheck::TypeEntry { kind: 1, builtin: 4099, def: 0, dep: 0, export_id: 0, elem: 0, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
    @push(entries, typecheck::TypeEntry { kind: 8, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 1, cap: 0, length: 0, success: 0, members_start: 4294967295u32, members_count: 1 })?;
    let table: typecheck::TypeTable = typecheck::TypeTable { entries: @move(entries), members: [] };
    let map: iface::ExportMap = iface::ExportMap { defs: [], exports: [] };
    var sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&table:Read, &map:Read, 2, &sink:ReadWrite, &diags:ReadWrite, 0)?;
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7012);
    return;
}
// 查重不应修改调用方顺序，也不依赖重复成员相邻。
function check_identity_set(): void!AllocError {
    var keys: u64[] = [];
    var i: u32 = 0;
    while i < 4096 { @push(keys, (4095 - i) as u64)?; i = i + 1; }
    assert(resolve_refs::unique_identity(&keys[0..@len(keys)]:Read)?);
    assert(keys[0] == 4095 && keys[4095] == 0);
    keys[4095] = keys[2048];
    assert(!resolve_refs::unique_identity(&keys[0..@len(keys)]:Read)?);
    assert(keys[0] == 4095 && keys[4095] == keys[2048]);
    return;
}
// 55/56 字节跨过填充边界，64/256 字节覆盖完整输入分块。
function sha_padding(): void!AllocError {
    var input: u8[] = [];
    while @len(input) < 256 { @push(input, 97u8)?; }
    let h55: u8[] = iface::sha256(&input[0..55]:Read)?;
    let h56: u8[] = iface::sha256(&input[0..56]:Read)?;
    let h64: u8[] = iface::sha256(&input[0..64]:Read)?;
    let h256: u8[] = iface::sha256(&input[0..256]:Read)?;
    // 首块摘要字段置零，不得漏掉相邻字节或后续消息块。
    var varied: u8[] = [];
    var sample: u32 = 0;
    while sample < 256 { @push(varied, sample as u8)?; sample = sample + 1; }
    let masked24: u8[] = iface::sha256_zero_header_digest(&varied[0..256]:Read, 24)?;
    assert(sha_equals(&masked24[0..32]:Read, "ba2e993df422fde156599c85ab71fcbfc28ac5ee6eec95c4e50aa7a5e2e69efb"));
    let masked28: u8[] = iface::sha256_zero_header_digest(&varied[0..256]:Read, 28)?;
    assert(sha_equals(&masked28[0..32]:Read, "6d81953a0c1b48120b99a47087dc9aec0ab6ee3bd122d4adc8d0ca85d08aff8f"));
    assert(sha_equals(&h55[0..32]:Read, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"));
    assert(sha_equals(&h56[0..32]:Read, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"));
    assert(sha_equals(&h64[0..32]:Read, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"));
    assert(sha_equals(&h256[0..32]:Read, "02d7160d77e18c6447be80c2e355c7ed4388545271702c50253b0914c65ce5fe"));
    return;
}
function main(): void {
    sha_padding()?;
    check_identity_set()?;
    check_ref_bounds()?;
    check_error_set_bounds()?;
    // ── SHA-256 已知向量 ──
    let empty_input: u8[] = [];
    let empty_hash: u8[] = iface::sha256(&empty_input[0..0]:Read)?;
    assert(sha_equals(&empty_hash[0..32]:Read, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"));
    let abc_input: u8[] = [97, 98, 99];
    let abc_hash: u8[] = iface::sha256(&abc_input[0..3]:Read)?;
    assert(sha_equals(&abc_hash[0..32]:Read, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"));

    // ── type_signatures：内建、本地名义、函数签名 ──
    let loaded: Loaded = load("enum E { A } function f(a: u32): E { if a == 0 { return E::A; } return E::A; }\n", 700)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &d:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &d:ReadWrite)?;
    assert(diag::diagbuf_count(&d:Read) == 0);
    let u32_type: u32 = find_builtin(&tc.types:Read, 4099);
    let enum_type: u32 = find_local(&tc.types:Read);
    assert(u32_type != 0 && enum_type != 0);
    let enum_def: u32 = tc.types.entries[enum_type - 1].def;
    var map_defs: u32[] = [];
    var map_exports: u32[] = [];
    @push(map_defs, enum_def)?;
    @push(map_exports, 7)?;
    let map: iface::ExportMap = iface::ExportMap { defs: map_defs, exports: map_exports };
    var sink1: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_type(&tc.types:Read, &map:Read, u32_type, &sink1:ReadWrite, &d:ReadWrite, 0)?;
    let expected1: u8[] = [1, 3, 16, 0, 0];
    assert(bytes_equal(&sink1.bytes[0..@len(sink1.bytes)]:Read, &expected1[0..5]:Read));
    var sink2: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_type(&tc.types:Read, &map:Read, enum_type, &sink2:ReadWrite, &d:ReadWrite, 0)?;
    let expected2: u8[] = [2, 7, 0, 0, 0, 0, 0];
    assert(bytes_equal(&sink2.bytes[0..@len(sink2.bytes)]:Read, &expected2[0..7]:Read));
    let fn_def: u32 = tc.funcs.items[0].def;
    var sink3: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_function_signature(&tc.types:Read, &tc.funcs:Read, &map:Read, fn_def, &sink3:ReadWrite, &d:ReadWrite, 0)?;
    let expected3: u8[] = [0, 0, 1, 0, 1, 3, 16, 0, 0, 2, 7, 0, 0, 0, 0, 0];
    assert(bytes_equal(&sink3.bytes[0..@len(sink3.bytes)]:Read, &expected3[0..16]:Read));
    assert(diag::diagbuf_count(&d:Read) == 0);
    // 写出和载入对同一类型签名应用相同的深度上限。
    var entries: typecheck::TypeEntry[] = [];
    @push(entries, tc.types.entries[u32_type - 1])?;
    var depth: u32 = 1;
    while depth < 65 {
        @push(entries, typecheck::TypeEntry { kind: 6, builtin: 0, def: 0, dep: 0, export_id: 0, elem: depth, cap: 0, length: 0, success: 0, members_start: 0, members_count: 0 })?;
        depth = depth + 1;
    }
    let nested_types: typecheck::TypeTable = typecheck::TypeTable { entries: @move(entries), members: [] };
    var ok_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    var ok_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&nested_types:Read, &map:Read, 64, &ok_sink:ReadWrite, &ok_diags:ReadWrite, 0)?;
    assert(diag::diagbuf_count(&ok_diags:Read) == 0);
    let empty_exports: resolve_refs::IfaceExport[] = [];
    assert(resolve_refs::valid_member_signature(&ok_sink.bytes[0..@len(ok_sink.bytes)]:Read, &empty_exports[0..@len(empty_exports)]:Read, &ok_diags:ReadWrite)?);
    var bad_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    var bad_diags: diag::DiagBuffer = diag::diagbuf_new();
    iface::encode_type(&nested_types:Read, &map:Read, 65, &bad_sink:ReadWrite, &bad_diags:ReadWrite, 0)?;
    assert(diag::diagbuf_count(&bad_diags:Read) == 1 && bad_diags.diags[0].code.raw == 9001);
    // 参数计数超出 u16 时不得截断并写出不一致签名。
    var many_params: u32[] = [];
    var many_members: u32[] = [];
    var n: u32 = 0;
    while n < 65536 { @push(many_params, 1)?; @push(many_members, 1)?; n = n + 1; }
    var many_entries: typecheck::TypeEntry[] = [];
    @push(many_entries, tc.types.entries[u32_type - 1])?;
    @push(many_entries, typecheck::TypeEntry { kind: 8, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 1, cap: 0, length: 0, success: 0, members_start: 0, members_count: 65536 })?;
    let many_types: typecheck::TypeTable = typecheck::TypeTable { entries: @move(many_entries), members: @move(many_members) };
    var many_funcs: typecheck::FuncSig[] = [];
    @push(many_funcs, typecheck::FuncSig { def: 1, params: @move(many_params), ret: 1, service: 0 })?;
    let table: typecheck::FuncTable = typecheck::FuncTable { items: @move(many_funcs), by_def: [] };
    var count_diags: diag::DiagBuffer = diag::diagbuf_new();
    var count_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_function_signature(&many_types:Read, &table:Read, &map:Read, 1, &count_sink:ReadWrite, &count_diags:ReadWrite, 0)?;
    assert(diag::diagbuf_count(&count_diags:Read) == 1 && count_diags.diags[0].code.raw == 9001);
    assert(@len(count_sink.bytes) == 0);
    var ref_diags: diag::DiagBuffer = diag::diagbuf_new();
    var ref_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_type(&many_types:Read, &map:Read, 2, &ref_sink:ReadWrite, &ref_diags:ReadWrite, 0)?;
    assert(diag::diagbuf_count(&ref_diags:Read) == 1 && ref_diags.diags[0].code.raw == 9001);
    assert(@len(ref_sink.bytes) == 0);
    var max_params: u32[] = [];
    var max_members: u32[] = [];
    n = 0;
    while n < 65535 { @push(max_params, 1)?; @push(max_members, 1)?; n = n + 1; }
    var max_funcs: typecheck::FuncSig[] = [];
    @push(max_funcs, typecheck::FuncSig { def: 1, params: @move(max_params), ret: 1, service: 0 })?;
    let max_table: typecheck::FuncTable = typecheck::FuncTable { items: @move(max_funcs), by_def: [] };
    var max_entries: typecheck::TypeEntry[] = [];
    @push(max_entries, tc.types.entries[u32_type - 1])?;
    @push(max_entries, typecheck::TypeEntry { kind: 8, builtin: 0, def: 0, dep: 0, export_id: 0, elem: 1, cap: 0, length: 0, success: 0, members_start: 0, members_count: 65535 })?;
    let max_types: typecheck::TypeTable = typecheck::TypeTable { entries: @move(max_entries), members: @move(max_members) };
    var max_diags: diag::DiagBuffer = diag::diagbuf_new();
    var max_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_function_signature(&max_types:Read, &max_table:Read, &map:Read, 1, &max_sink:ReadWrite, &max_diags:ReadWrite, 0)?;
    assert(!max_diags.has_error && @len(max_sink.bytes) == 327684 && max_sink.bytes[2] == 255 && max_sink.bytes[3] == 255);
    var max_ref_sink: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_type(&max_types:Read, &map:Read, 2, &max_ref_sink:ReadWrite, &max_diags:ReadWrite, 0)?;
    assert(!max_diags.has_error && @len(max_ref_sink.bytes) == 327683 && max_ref_sink.bytes[1] == 255 && max_ref_sink.bytes[2] == 255);
    return;
}
