// t25: 深层嵌套作用域 + assert验证各层绑定
foreign assert(cond: bool): void;

function main(): void {
    let a: u32 = 1;
    if a > 0 {
        let b: u32 = 2;
        if b > 0 {
            let c: u32 = 3;
            if c > 0 {
                let d: u32 = 4;
                assert(d == 4);
            }
            assert(c == 3);
        }
        assert(b == 2);
    }
    assert(a == 1);
    return;
}
