// mem_limit: 500000
foreign assert(cond: bool): void;
struct Leaf { value: u32, owned: u32[] }
struct Item { data: Leaf[] }
enum Failure { Bad }
function step(count: &u32:ReadWrite, expected: u32, ok: bool): u32!Failure {
    assert(*count == expected);
    *count = *count + 1u32;
    if !ok { return Failure::Bad; }
    return 0u32;
}
function items(ok: bool, count: &u32:ReadWrite): Item[]!Failure {
    let start: u32 = step(count, 0u32, ok)?;
    return [Item { data: [Leaf { value: 42u32 + start, owned: [5u32] }] }];
}
function read(root: bool, outer: bool, inner: bool, count: &u32:ReadWrite): u32!Failure {
    return (items(root, count)?)[step(count, 1u32, outer)?].data[step(count, 2u32, inner)?].value;
}
function recover(e: &Failure): u32 { return 99u32; }
function main(): void {
    var count: u32 = 0u32;
    assert(read(true, true, true, &count:ReadWrite).catch(&recover) == 42u32);
    assert(count == 3u32);
    count = 0u32;
    assert(read(false, false, false, &count:ReadWrite).catch(&recover) == 99u32);
    assert(count == 1u32);
    var i: u32 = 0u32;
    while i < 500u32 {
        count = 0u32;
        assert(read(true, false, false, &count:ReadWrite).catch(&recover) == 99u32);
        assert(count == 2u32);
        count = 0u32;
        assert(read(true, true, false, &count:ReadWrite).catch(&recover) == 99u32);
        assert(count == 3u32);
        i = i + 1u32;
    }
}
