foreign assert(cond: bool): void;
function read(first: &u32, second: &u32): u32 { return *first + *second; }
function main(): void {
    var data: u32[] = [2u32, 3u32];
    let ref: &u32[]:ReadWrite = &data:ReadWrite;
    {
        let view: &[u32] = &(*ref)[0u32..2u32];
        assert(read(@copy(view)[0u32], @copy(view)[1u32]) == 5u32);
        assert(read(view[0u32], view[1u32]) == 5u32);
        assert(view.len == 2u64);
    }
    (*ref)[0u32] = 7u32;
    assert((*ref)[0u32] == 7u32);
}
