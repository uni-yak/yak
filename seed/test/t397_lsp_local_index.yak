import lex;
import parse;
import ast;
import diag;
import resolve;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import pipeline;
foreign assert(cond: bool): void;

// 源码先遇到内层声明，之后继续外层；按局部节点而非函数序号寻址。
function check_index(source: &[u8]): void!AllocError {
    let scanned: lex::LexResult = lex::lex_scan(source, 124u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&scanned:Read, 124u16)?;
    assert(@len(scanned.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var batch_diags: diag::DiagBuffer = diag::diagbuf_new();
    var doc_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let batch: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &scanned.names:Read, &deps:Read, "", &batch_diags:ReadWrite)?;
    var lookup: resolve::LookupBudget = resolve::lookup_budget(0u32, 0u32);
    var work: resolve::ReservationBudget = resolve::reservation_budget(4096u32);
    work.index_locals = true;
    var outputs: resolve_unit::ReferenceOutputBudget = resolve_unit::reference_output_budget(8192u64);
    let doc: resolve_refs::Resolution = resolve_unit::resolve_unit_limited(&parsed.file:Read, &parsed.pool:Read, &scanned.names:Read, &deps:Read, 0u32, "", &doc_diags:ReadWrite, &lookup:ReadWrite, &work:ReadWrite, &outputs:ReadWrite)?;
    assert(!work.exhausted && !outputs.exhausted && batch_diags.count == 0u32 && doc_diags.count == 0u32);
    let a: &resolve::ResolveTables = &batch.result.tables:Read;
    let b: &resolve::ResolveTables = &doc.result.tables:Read;
    assert(!a.index_locals && @len(a.local_defs) == 0);
    assert(b.index_locals && @len(b.local_defs) == @len(parsed.pool.locals) && @len(b.local_defs) == 6);
    let batch_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &batch:Read, &batch_diags:ReadWrite)?;
    let indexed_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &doc:Read, &doc_diags:ReadWrite)?;
    var found: u32 = 0;
    var block: u32 = 0;
    while block < @len(parsed.pool.blocks) as u32 {
        let scope: u32 = b.block_scope[block];
        var s: u32 = 0;
        while s < @len(parsed.pool.blocks[block].stmts) as u32 {
            let stmt: ast::Stmt = parsed.pool.stmts[parsed.pool.blocks[block].stmts[s]];
            if stmt.kind == 1u8 {
                let local: ast::LocalDecl = parsed.pool.locals[stmt.data];
                let def: u32 = resolve::local_decl_def(b, stmt.data, scope, local);
                assert(def != 0u32 && def == resolve::lookup_binding(a, scope, local.name));
                assert(resolve::local_decl_def(b, stmt.data, 1u32, local) == 0u32);
                assert(resolve::local_decl_def(b, 4294967295u32, scope, local) == 0u32);
                assert(resolve::local_decl_def(b, (stmt.data + 1u32) % 6u32, scope, local) == 0u32);
                let ty: u32 = typecheck::def_type(&indexed_types.def_types:Read, def);
                assert(ty != 0u32 && ty == typecheck::def_type(&batch_types.def_types:Read, def));
                found = found + 1u32;
            }
            s = s + 1u32;
        }
        block = block + 1u32;
    }
    assert(found == 6u32 && batch_diags.count == 0u32 && doc_diags.count == 0u32);
    assert(b.local_defs[0] != b.local_defs[2]);
    assert(b.defs[b.local_defs[0] - 1u32].name == b.defs[b.local_defs[2] - 1u32].name);
    return;
}

function main(): void {
    let source: &[u8] = "function fill(dst: &u32:Write): void { *dst = 9u32; }\nfunction locals(flag: bool): void { let x: bool = flag; if x { const c: u32 = 7u32; var x: u32 = c; x = x + 1u32; @drop(x); } out x2: u32; fill(out x2); let value: u32 = @move(x2); @drop(value); let after: bool = x; if after {} }\n";
    check_index(source)?;
    let doc: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, 124u16)?;
    assert(pipeline::analysis_checked(doc.status) && doc.diagnostics.count == 0u32);
    return;
}
