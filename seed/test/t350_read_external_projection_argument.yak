foreign assert(cond: bool): void;
struct Item { data: u32[] }
function first(data: &u32[], other: &u32[]): u32 { return data[0u32] + other[0u32]; }
function main(): void {
    var items: Item[] = [Item { data: [3u32] }, Item { data: [4u32] }];
    let ref: &Item[]:ReadWrite = &items:ReadWrite;
    var view: &[Item]:ReadWrite = &(*ref)[0u32..2u32]:ReadWrite;
    let indirect: &function(&u32[], &u32[]): u32 = &first;
    assert(indirect(@copy(view)[0u32].data, @copy(view)[1u32].data) == 7u32);
    view[0u32].data[0u32] = 5u32;
    assert(view[0u32].data[0u32] == 5u32);
}
