import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

function source(extra: bool, bad: bool): buf::ByteBuf!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    if bad { buf::buf_push_bytes(&text:ReadWrite, "const K0: u32 = 55296;\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "const K0: u32 = 1;\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, "const K1: u32 = 1;\nconst K2: u32 = 1;\nconst K3: u32 = 1;\nconst K4: u32 = 1;\nconst K5: u32 = 1;\nconst K6: u32 = 1;\nconst K7: u32 = 1;\nconst K8: u32 = 1;\nconst K9: u32 = 1;\nconst K10: u32 = 1;\nconst K11: u32 = 1;\nconst K12: u32 = 1;\nconst K13: u32 = 1;\nconst K14: u32 = 1;\nconst K15: u32 = 1;\nconst K16: u32 = 1;\nconst K17: u32 = 1;\nconst K18: u32 = 1;\nconst K19: u32 = 1;\nconst K20: u32 = 1;\nconst K21: u32 = 1;\nconst K22: u32 = 1;\nconst K23: u32 = 1;\nconst K24: u32 = 1;\nconst K25: u32 = 1;\nconst K26: u32 = 1;\nconst K27: u32 = 1;\nconst K28: u32 = 1;\nconst K29: u32 = 1;\nconst K30: u32 = 1;\nconst K31: u32 = 1;\nconst K32: u32 = 1;\nconst K33: u32 = 1;\nconst K34: u32 = 1;\nconst K35: u32 = 1;\nconst K36: u32 = 1;\nconst K37: u32 = 1;\nconst K38: u32 = 1;\nconst K39: u32 = 1;\nfunction take(x: char): void { @drop(x); }\nfunction f(): u32 {\ntake(K0 as char);\ntake(K1 as char);\ntake(K2 as char);\ntake(K3 as char);\ntake(K4 as char);\ntake(K5 as char);\ntake(K6 as char);\ntake(K7 as char);\ntake(K8 as char);\ntake(K9 as char);\ntake(K10 as char);\ntake(K11 as char);\ntake(K12 as char);\ntake(K13 as char);\ntake(K14 as char);\ntake(K15 as char);\ntake(K16 as char);\ntake(K17 as char);\ntake(K18 as char);\ntake(K19 as char);\ntake(K20 as char);\ntake(K21 as char);\ntake(K22 as char);\ntake(K23 as char);\ntake(K24 as char);\ntake(K25 as char);\ntake(K26 as char);\ntake(K27 as char);\ntake(K28 as char);\ntake(K29 as char);\ntake(K30 as char);\ntake(K31 as char);\ntake(K32 as char);\ntake(K33 as char);\ntake(K34 as char);\ntake(K35 as char);\ntake(K36 as char);\ntake(K37 as char);\ntake(K38 as char);\ntake(K39 as char);\ntake(K38 as char);\nlet a: [u32; 2] = [0u32, 1u32];\n")?;
    if extra { buf::buf_push_bytes(&text:ReadWrite, "return a[K39];\n}\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "return a[K38];\n}\n")?; }
    return text;
}

function pipeline_steps(): void!AllocError {
    let exact: buf::ByteBuf = source(false, false)?;
    let finished: pipeline::DocumentAnalysis = pipeline::run_document_frontend(&exact.data[0..exact.pos]:Read, 107u16)?;
    assert(pipeline::analysis_checked(finished.status) && finished.diagnostics.count == 0u32);
    let over: buf::ByteBuf = source(true, false)?;
    let clean: &[u8] = &over.data[0..over.pos]:Read;
    let stopped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(clean, 107u16)?;
    assert(pipeline::analysis_integer_probe_exceeded(stopped.status) && stopped.diagnostics.count == 0u32);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(clean, 107u16, &batch:ReadWrite)?;
    assert(accepted && batch.count == 0u32);
    let bad: buf::ByteBuf = source(true, true)?;
    let negative: &[u8] = &bad.data[0..bad.pos]:Read;
    let partial: pipeline::DocumentAnalysis = pipeline::run_document_frontend(negative, 107u16)?;
    assert(pipeline::analysis_integer_probe_exceeded(partial.status) && partial.diagnostics.count == 0u32 && !partial.diagnostics.truncated);
    let rejected: bool = !pipeline::run_frontend(negative, 107u16, &batch:ReadWrite)?;
    assert(rejected && batch.count == 1u32 && batch.diags[0].code.raw == 5001u16);
    return;
}

// 窄化先试算字面量两步，外层沿转换链命中缓存再回写五步，除零未知占四步。
function small_steps(): void!AllocError {
    let small: &[u8] = "function f(): void { @drop((7u32 as u8 as u32) as char); @drop((1u32 / 0u32) as char); }\n";
    let lexed: lex::LexResult = lex::lex_scan(small, 108u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 108u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 11u32 {
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var work: consteval::FoldBudget = consteval::fold_budget(limit);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &work:ReadWrite, &scan:ReadWrite)?;
        assert(work.exhausted == (limit < 11u32) && work.remaining == 0u32 && diags.count == 0u32);
        if limit < 11u32 { assert(@len(checked.types.entries) == 0 && @len(checked.consts.values) == 0); }
        else { assert(@len(checked.types.entries) != 0 && @len(checked.consts.values) == 3); }
        limit = limit + 1u32;
    }
    return;
}

// 每种试算输入分别判定，并与批处理逐字段核对输出。
function snapshot_case(source: &[u8], has_constant: bool, needed: bool, code: u16): void!AllocError {
    let file: u16 = 109u16;
    let lexed: lex::LexResult = lex::lex_scan(source, file)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, file)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var resolved_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &resolved_diags:ReadWrite)?;
    assert(resolved_diags.count == 0u32 && res.result.tables.has_constants == has_constant);
    assert(typecheck_driver::needs_const_input(&parsed.pool:Read, &res.result.tables:Read) == needed);
    let doc: pipeline::DocumentAnalysis = pipeline::run_document_frontend(source, file)?;
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(source, file, &batch:ReadWrite)?;
    if code == 0u16 { assert(doc.status == 0u8 && accepted); }
    else { assert(doc.status == 1u8 && !accepted); }
    assert(!doc.diagnostics.truncated && doc.diagnostics.count == batch.count && doc.diagnostics.has_error == batch.has_error);
    if code == 0u16 { assert(batch.count == 0u32); }
    else {
        assert(batch.count == 1u32 && batch.diags[0].code.raw == code);
        let a: diag::Diag = batch.diags[0];
        let b: diag::Diag = doc.diagnostics.diags[0];
        assert(a.code.raw == b.code.raw && a.severity == b.severity && a.unit == b.unit);
        assert(a.span.file == b.span.file && a.span.offset == b.span.offset && a.span.length == b.span.length);
    }
    return;
}

// 每个类型、定义类型、枚举行和载荷槽各占一条，空载荷槽也收费。
function snapshot_budget_steps(): void!AllocError {
    var types: typecheck::TypeTable = typecheck::new_table();
    let first: u32 = typecheck::intern_builtin(&types:ReadWrite, 4099u16)?;
    let second: u32 = typecheck::intern_local(&types:ReadWrite, 2u32)?;
    let enums: typecheck::EnumTable = typecheck::EnumTable {
        items: [typecheck::EnumType { def: 2u32, payloads: [0u32, first, second] },
                typecheck::EnumType { def: 3u32, payloads: [] }]
    };
    let defs: typecheck::DefTypeTable = typecheck::DefTypeTable { items: [first, second, 0u32] };
    var limit: u64 = 0u64;
    while limit <= 11u64 {
        var work: typecheck_driver::ConstSnapshotBudget = typecheck_driver::const_snapshot_budget(limit);
        let input: consteval::ConstInput = typecheck_driver::const_input_limited(&types:Read, &enums:Read, &defs:Read, true, &work:ReadWrite)?;
        assert(work.exhausted == (limit != 0u64 && limit < 10u64));
        if work.exhausted {
            assert(@len(input.types) == 0 && @len(input.enums) == 0 && @len(input.def_types) == 0);
        } else {
            assert(@len(input.types) == 2 && @len(input.enums) == 2 && @len(input.def_types) == 3);
            assert(input.types[0].builtin == 4099u16 && input.types[1].def == 2u32);
            assert(input.enums[0].def == 2u32 && input.enums[1].def == 3u32);
            assert(@len(input.enums[0].payloads) == 3 && @len(input.enums[1].payloads) == 0);
            assert(input.enums[0].payloads[0] == 0u32 && input.enums[0].payloads[1] == first && input.enums[0].payloads[2] == second);
            assert(input.def_types[0] == first && input.def_types[1] == second && input.def_types[2] == 0u32);
            if limit >= 10u64 { assert(work.remaining == limit - 10u64); }
        }
        limit = limit + 1u64;
    }
    var skipped: typecheck_driver::ConstSnapshotBudget = typecheck_driver::const_snapshot_budget(1u64);
    let empty: consteval::ConstInput = typecheck_driver::const_input_limited(&types:Read, &enums:Read, &defs:Read, false, &skipped:ReadWrite)?;
    assert(!skipped.exhausted && skipped.remaining == 1u64);
    assert(@len(empty.types) == 0 && @len(empty.enums) == 0 && @len(empty.def_types) == 0);
    return;
}

function main(): void {
    snapshot_budget_steps()?;
    small_steps()?;
    pipeline_steps()?;
    snapshot_case("enum E { Full(u32), Empty } function f(): E { return E::Full(1u32); }\n", false, false, 0u16)?;
    snapshot_case("const C: u32 = 1u32 / 0u32; function f(): u32 { return C; }\n", true, true, 5008u16)?;
    snapshot_case("function f(): u32 { const c: u32 = 1u32 / 0u32; return c; }\n", true, true, 5008u16)?;
    snapshot_case("function f(): char { return (55295u32 + 1u32) as char; }\n", false, true, 5001u16)?;
    snapshot_case("function f(a: [u32; 2]): u32 { return a[1u32 + 1u32]; }\n", false, true, 6002u16)?;
    snapshot_case("function f(a: [u32; 2]): u64 { return @len(&a[0u32..2u32 + 1u32]:Read); }\n", false, true, 6002u16)?;
    return;
}
