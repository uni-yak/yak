// module: pipeline_stages=../../compiler/min/src/check/pipeline_stages.yak
import pipeline;
import types;
foreign assert(ok: bool): void;

function unique_link(index: &types::DocumentDefinitions:Read, use_at: u32, use_length: u32, target_at: u32, target_length: u32): void {
    let result: types::DefinitionLink = types::definition_at(index, use_at + 1u32);
    assert(result.use_offset == use_at && result.use_length == use_length);
    assert(result.target_offset == target_at && result.target_length == target_length);
}

function expect_hover(index: &types::DocumentDefinitions:Read, at: u32, text: &[u8]): void {
    let link: types::HoverLink = types::hover_at(index, at);
    assert((link.text_length as u64) == @len(text));
    var i: u32 = 0;
    while i < link.text_length {
        assert(index.hover_text[link.text_at + i] == text[i]);
        i = i + 1u32;
    }
    return;
}

function check(): void!AllocError {
    let source: &[u8] = "const BASE: u32 = 7;\nfunction add(left: u32, right: u32): u32 { return left + right + BASE; }\nfunction use(arg: u32): u32 {\n    let outer: u32 = arg;\n    if arg > 0 {\n        let outer: u32 = add(arg, BASE);\n        return outer;\n    }\n    return outer;\n}\n";
    let indexed: pipeline::DocumentWithDefinitions = pipeline::run_document_with_definitions(source, 3u16)?;
    assert(pipeline::analysis_checked(indexed.analysis.status));
    let index: &types::DocumentDefinitions:Read = &indexed.definitions:Read;
    unique_link(index, 71u32, 4u32, 34u32, 4u32);
    unique_link(index, 78u32, 5u32, 45u32, 5u32);
    unique_link(index, 86u32, 4u32, 6u32, 4u32);
    unique_link(index, 145u32, 3u32, 107u32, 3u32);
    unique_link(index, 192u32, 3u32, 30u32, 3u32);
    unique_link(index, 201u32, 4u32, 6u32, 4u32);
    unique_link(index, 223u32, 5u32, 179u32, 5u32);
    unique_link(index, 247u32, 5u32, 132u32, 5u32);
    assert(types::definition_at(index, 228u32).target_length == 0u32);
    assert(types::definition_at(index, 179u32).target_length == 0u32);
    expect_hover(index, 6u32, "BASE: u32");
    expect_hover(index, 71u32, "left: u32");
    expect_hover(index, 192u32, "function add(u32, u32): u32");
    expect_hover(index, 179u32, "outer: u32");
    expect_hover(index, 228u32, "");
    assert(types::hover_at(index, 179u32).text_at == types::hover_at(index, 223u32).text_at);
    assert(types::hover_at(index, 223u32).text_at != types::hover_at(index, 247u32).text_at);
    let bad: &[u8] = "function bad(arg: u32): u32 { return arg + missing; }\n";
    let rejected: pipeline::DocumentWithDefinitions = pipeline::run_document_with_definitions(bad, 3u16)?;
    assert(pipeline::analysis_rejected(rejected.analysis.status));
    assert(@len(rejected.definitions.links) == 0u64);
    assert(rejected.definitions.semantic_ready && @len(rejected.definitions.semantic_tokens) != 0u64);
    var current: types::DocumentDefinitions = types::empty_definitions();
    let initial: pipeline::DocumentAnalysis = pipeline::run_document_indexed(source, 3u16, true, &current:ReadWrite)?;
    assert(pipeline::analysis_checked(initial.status));
    assert(@len(current.links) != 0u64);
    let imported: &[u8] = "import helpers;\nfunction f(arg: u32): u32 { return arg; }\n";
    let pending: pipeline::DocumentAnalysis = pipeline::run_document_indexed(imported, 3u16, true, &current:ReadWrite)?;
    assert(pipeline::analysis_needs_dependencies(pending.status));
    assert(@len(current.links) == 0u64 && @len(current.hovers) == 0u64 && @len(current.hover_text) == 0u64);
    assert(current.semantic_ready && @len(current.semantic_tokens) != 0u64);
    let disabled: pipeline::DocumentAnalysis = pipeline::run_document_indexed(source, 3u16, false, &current:ReadWrite)?;
    assert(pipeline::analysis_checked(disabled.status));
    assert(!current.semantic_ready && @len(current.semantic_tokens) == 0u64);
    let lexical: pipeline::DocumentWithDefinitions = pipeline::run_document_with_definitions("const X: u32 = 1;", 3u16)?;
    assert(pipeline::analysis_rejected(lexical.analysis.status));
    assert(!lexical.definitions.semantic_ready && @len(lexical.definitions.semantic_tokens) == 0u64);
    return;
}

function main(): void {
    check()?;
}
