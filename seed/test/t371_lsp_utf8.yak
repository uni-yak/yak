// module: utf8=../../compiler/lsp/utf8.yak
import utf8;
foreign assert(cond: bool): void;

function check(src: &[u8], at: u32, value: u32, width: u32): void {
    let scalar: utf8::Scalar = utf8::decode(src, at);
    assert(scalar.width == width);
    assert(scalar.value == value);
}

function main(): void {
    check("Aé汉😀", 0, 65, 1);
    check("Aé汉😀", 1, 233, 2);
    check("Aé汉😀", 3, 27721, 3);
    check("Aé汉😀", 6, 128512, 4);
    check("Aé汉😀", 7, 0, 0);
    check("Aé汉😀", 10, 0, 0);
    check("Aé汉😀", 4294967295u32, 0, 0);
    let bytes: [u8; 23] = [0u8, 194u8, 128u8, 224u8, 160u8, 128u8, 244u8, 143u8, 191u8, 191u8,
        192u8, 128u8, 224u8, 159u8, 191u8, 237u8, 160u8, 128u8, 244u8, 144u8, 128u8, 128u8, 240u8];
    check(&bytes[0..23]:Read, 0, 0, 1);
    check(&bytes[0..23]:Read, 1, 128, 2);
    check(&bytes[0..23]:Read, 3, 2048, 3);
    check(&bytes[0..23]:Read, 6, 1114111, 4);
    check(&bytes[0..23]:Read, 10, 0, 0);
    check(&bytes[0..23]:Read, 12, 0, 0);
    check(&bytes[0..23]:Read, 15, 0, 0);
    check(&bytes[0..23]:Read, 18, 0, 0);
    check(&bytes[0..23]:Read, 22, 0, 0);
    check(&bytes[0..23]:Read, 2, 0, 0);
    let bad_continuation: [u8; 2] = [194u8, 65u8];
    check(&bad_continuation[0..2]:Read, 0, 0, 0);
}
