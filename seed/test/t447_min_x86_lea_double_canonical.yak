// module: pe=../../compiler/min/src/emit/pe.yak
// module: x86_validate=../../compiler/min/src/emit/x86_validate.yak
import pe;
import x86_validate;
foreign assert(condition: bool): void;
foreign exit(code: u8): void;

function encoding(bytes: &[u8], expected: u16): void!AllocError {
    var code: pe::Code = pe::code_new();
    pe::code_bytes(&code:ReadWrite, bytes)?;
    assert(x86_validate::validate(&code:Read, 0)? == expected);
    return;
}

function verify(): void!AllocError {
    // 拆分后的基址与索引相同，R12 同时需要 REX.X 和 REX.B。
    let canonical: [u8; 35] = [0x48, 0x8d, 0x44, 0x2d, 0x7f,
        0x4f, 0x8d, 0x44, 0x2d, 0x80,
        0x4b, 0x8d, 0x04, 0x24,
        0x4b, 0x8d, 0x84, 0x24, 0x80, 0x00, 0x00, 0x00,
        0x48, 0x8d, 0x84, 0x2d, 0x7f, 0xff, 0xff, 0xff,
        0x66, 0x43, 0x8d, 0x04, 0x24];
    encoding(&canonical[0..35]:Read, 0)?;
    // 保留 RBP 访存、无索引的绝对地址与真实 ×4 缩放。R12 两个角色可合用。
    let controls: [u8; 40] = [0x48, 0x8b, 0x04, 0x6d, 0x00, 0x00, 0x00, 0x00,
        0x4a, 0x8b, 0x04, 0x65, 0x80, 0x00, 0x00, 0x00,
        0x48, 0x8d, 0x04, 0x65, 0x00, 0x00, 0x00, 0x00,
        0x48, 0x8d, 0x04, 0xad, 0x00, 0x00, 0x00, 0x00,
        0x4a, 0x8d, 0x04, 0xa5, 0x00, 0x00, 0x00, 0x00];
    encoding(&controls[0..8]:Read, 0)?;
    encoding(&controls[8..16]:Read, 7102)?;
    encoding(&controls[16..24]:Read, 7102)?;
    encoding(&controls[24..40]:Read, 0)?;
    // 有符号 disp8 内可缩短，两侧越界为等长别名；截断仍拒绝。
    let forms: [u8; 49] = [0x48, 0x8d, 0x04, 0x6d, 0x7f, 0x00, 0x00, 0x00,
        0x4e, 0x8d, 0x04, 0x6d, 0x80, 0xff, 0xff, 0xff,
        0x4a, 0x8d, 0x04, 0x65, 0x00, 0x00, 0x00, 0x00,
        0x4a, 0x8d, 0x04, 0x65, 0x80, 0x00, 0x00, 0x00,
        0x48, 0x8d, 0x04, 0x6d, 0x7f, 0xff, 0xff, 0xff,
        0x66, 0x42, 0x8d, 0x04, 0x65, 0x00, 0x00, 0x00, 0x00];
    encoding(&forms[0..7]:Read, 7101)?;
    encoding(&forms[0..8]:Read, 7103)?;
    encoding(&forms[8..16]:Read, 7103)?;
    encoding(&forms[16..24]:Read, 7103)?;
    encoding(&forms[24..32]:Read, 7102)?;
    encoding(&forms[32..40]:Read, 7102)?;
    encoding(&forms[40..49]:Read, 7103)?;
    exit(0);
    return;
}

function main(): void {
    let result: void!AllocError = verify();
    @drop(result);
    assert(false);
    return;
}
