import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

function source(extra: bool, bad: bool): buf::ByteBuf!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&text:ReadWrite, "const C0: u32 = 1;\nconst C1: u32 = C0;\nconst C2: u32 = C1;\nconst C3: u32 = C2;\nconst C4: u32 = C3;\nconst C5: u32 = C4;\nconst C6: u32 = C5;\nconst C7: u32 = C6;\nconst C8: u32 = C7;\nconst C9: u32 = C8;\nconst C10: u32 = C9;\nconst C11: u32 = C10;\nconst C12: u32 = C11;\nconst C13: u32 = C12;\nconst C14: u32 = C13;\nconst C15: u32 = C14;\nconst C16: u32 = C15;\nconst C17: u32 = C16;\nconst C18: u32 = C17;\nconst C19: u32 = C18;\nconst C20: u32 = C19;\nconst C21: u32 = C20;\nconst C22: u32 = C21;\nconst C23: u32 = C22;\nconst C24: u32 = C23;\nconst C25: u32 = C24;\nconst C26: u32 = C25;\nconst C27: u32 = C26;\nconst C28: u32 = C27;\nconst C29: u32 = C28;\nconst C30: u32 = C29;\nconst C31: u32 = C30;\nconst C32: u32 = C31;\nconst C33: u32 = C32;\nconst C34: u32 = C33;\nconst C35: u32 = C34;\nconst C36: u32 = C35;\nconst C37: u32 = C36;\nconst C38: u32 = C37;\nconst C39: u32 = C38;\nconst C40: u32 = C39;\nconst C41: u32 = C40;\nconst C42: u32 = C41;\n")?;
    if bad { buf::buf_push_bytes(&text:ReadWrite, "const Number: u32 = 1 / 0;\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "const Number: u32 = 1 + 0;\n")?; }
    if extra { buf::buf_push_bytes(&text:ReadWrite, "const Last: u32 = C31;\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "const Last: u32 = C30;\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, "function f(): u32 { return C42 + Number + Last; }\n")?;
    return text;
}

function pipeline_steps(): void!AllocError {
    let exact: buf::ByteBuf = source(false, false)?;
    let finished: pipeline::DocumentAnalysis = pipeline::run_document_frontend(&exact.data[0..exact.pos]:Read, 105u16)?;
    assert(pipeline::analysis_checked(finished.status) && finished.diagnostics.count == 0u32);
    let over: buf::ByteBuf = source(true, false)?;
    let clean: &[u8] = &over.data[0..over.pos]:Read;
    let stopped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(clean, 105u16)?;
    assert(pipeline::analysis_const_fold_exceeded(stopped.status) && stopped.diagnostics.count == 0u32);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(clean, 105u16, &batch:ReadWrite)?;
    assert(accepted && batch.count == 0u32);
    let bad: buf::ByteBuf = source(true, true)?;
    let negative: &[u8] = &bad.data[0..bad.pos]:Read;
    let partial: pipeline::DocumentAnalysis = pipeline::run_document_frontend(negative, 105u16)?;
    assert(pipeline::analysis_const_fold_exceeded(partial.status) && partial.diagnostics.count == 0u32 && !partial.diagnostics.truncated);
    let rejected: bool = !pipeline::run_frontend(negative, 105u16, &batch:ReadWrite)?;
    assert(rejected && batch.count == 1u32 && batch.diags[0].code.raw == 5008u16);
    return;
}

// 数组 8 步（表达式 4、元素读取 2、子值复制 2）；枚举调用含负载荷共 6 步。
function small_steps(): void!AllocError {
    let small: &[u8] = "const Arr: [i32; 2] = [-2, 3]; enum E { Empty, Value(i32) } const C: E = E::Value(-4); function first(): i32 { return Arr[0]; } function get(): E { return C; }\n";
    let lexed: lex::LexResult = lex::lex_scan(small, 106u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 106u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 14u32 {
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(limit);
        var probe_work: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe_work:ReadWrite, &scan:ReadWrite)?;
        assert(fold.exhausted == (limit < 14u32) && fold.remaining == 0u32 && diags.count == 0u32);
        if limit < 14u32 { assert(@len(checked.consts.bindings) == 0 && @len(checked.consts.values) == 0 && @len(checked.consts.children) == 0); }
        else {
            assert(@len(checked.consts.bindings) == 2);
            let array: consteval::ConstValue = checked.consts.values[checked.consts.bindings[0].value - 1u32];
            let tag: consteval::ConstValue = checked.consts.values[checked.consts.bindings[1].value - 1u32];
            assert(array.kind == 6u8 && array.children_count == 2u32);
            assert(tag.kind == 5u8 && tag.variant == 1u32 && tag.children_count == 1u32);
            assert(checked.consts.values[checked.consts.children[array.children_start] - 1u32].bits == 4294967294u64);
            assert(checked.consts.values[checked.consts.children[tag.children_start] - 1u32].bits == 4294967292u64);
        }
        limit = limit + 1u32;
    }
    return;
}

function main(): void {
    small_steps()?;
    pipeline_steps()?;
    return;
}
