// t11: 比较运算 + 布尔逻辑 + assert
foreign assert(cond: bool): void;

function main(): void {
    let a: u32 = 10;
    let b: u32 = 20;
    let eq: bool = a == b;
    let ne: bool = a != b;
    let lt: bool = a < b;
    let le: bool = a <= b;
    let gt: bool = a > b;
    let ge: bool = a >= b;
    assert(eq == false);
    assert(ne == true);
    assert(lt == true);
    assert(le == true);
    assert(gt == false);
    assert(ge == false);
    return;
}
