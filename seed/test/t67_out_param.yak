// t67: out 参数（by-ref 写回）
// expected_stdout: out ok
foreign write(data: &[u8]): void;

function divide(a: u32, b: u32, out result: u32): void {
    result = a / b;
    return;
}

function main(): void {
    out r: u32;
    divide(20, 4, out r);
    let value: u32 = @move(r);
    if value == 5 {
        write("out ok\n");
    }
    return;
}
