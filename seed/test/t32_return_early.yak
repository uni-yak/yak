// t32: 多返回路径 + assert
foreign assert(cond: bool): void;

function classify(n: u32): u32 {
    if n == 0 {
        return 0;
    }
    if n < 10 {
        return 1;
    }
    return 2;
}

function main(): void {
    let a: u32 = classify(0);
    let b: u32 = classify(5);
    let c: u32 = classify(100);
    assert(a == 0);
    assert(b == 1);
    assert(c == 2);
    return;
}
