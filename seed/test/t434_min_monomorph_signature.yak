// module: buf=../../compiler/min/lib/buf.yak
// module: hash=../../compiler/min/lib/hash.yak
// module: hashmap=../../compiler/min/lib/hashmap.yak
// module: types=../../compiler/min/lib/types.yak
// module: lextables=../../compiler/min/src/lex/lextables.yak
// module: lex=../../compiler/min/src/lex/lex.yak
// module: ast=../../compiler/min/src/parse/ast.yak
// module: diag=../../compiler/min/src/diag/diag.yak
// module: resolve=../../compiler/min/src/check/resolve.yak
// module: resolve_refs=../../compiler/min/src/check/resolve_refs.yak
// module: consteval=../../compiler/min/src/check/consteval.yak
// module: typecheck=../../compiler/min/src/check/typecheck.yak
// module: type_import=../../compiler/min/src/check/type_import.yak
// module: monomorph=../../compiler/min/src/check/monomorph.yak
import diag;
import monomorph;
import resolve_refs;
import typecheck;
import types;
foreign assert(condition: bool): void;

function empty_constraints(): monomorph::Constraints { return monomorph::Constraints { required: [], checked: [] }; }

function check_inference(): void!AllocError {
    // 签名为 `<T>(T[], &T): T`。实参和目标类型同时约束一个参数槽。
    let bytes: [u8; 16] = [1, 0, 2, 0, 6, 4, 0, 0, 7, 0, 4, 0, 0, 4, 0, 0];
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let sig: resolve_refs::FunctionTemplate = resolve_refs::read_generic_signature(&bytes[0..16]:Read, &deps:Read, 0, &diagnostics:ReadWrite)?;
    assert(sig.valid && sig.arity == 1 && sig.param_count == 2 && diag::diagbuf_count(&diagnostics:Read) == 0);
    var tt: typecheck::TypeTable = typecheck::new_table();
    let octet: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4097)?;
    let number: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4099)?;
    let array: u32 = typecheck::intern_dyn_array(&tt:ReadWrite, octet)?;
    let pointee: u32 = typecheck::intern_ref(&tt:ReadWrite, 0, octet)?;
    let other: u32 = typecheck::intern_ref(&tt:ReadWrite, 0, number)?;
    let args: [u32; 2] = [array, pointee];
    let conflicts: [u32; 2] = [array, other];
    let constraints: monomorph::Constraints = empty_constraints();
    let call: types::Span = types::Span { file: 19, offset: 23, length: 7 };

    let ok: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[0..0]:Read, &args[0..2]:Read, octet, &constraints:Read, call, &diagnostics:ReadWrite)?;
    assert(ok.ok && @len(ok.arguments) == 1 && @len(ok.params) == 2);
    assert(ok.arguments[0] == octet && ok.params[0] == array && ok.params[1] == pointee && ok.result == octet);

    let bad: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[0..0]:Read, &conflicts[0..2]:Read, 0, &constraints:Read, call, &diagnostics:ReadWrite)?;
    // rejection_spec: E3007 spec/lang/sugar.md#SU-7
    assert(!bad.ok && @len(bad.arguments) == 0 && @len(bad.params) == 0 && bad.result == 0 && diag::diagbuf_count(&diagnostics:Read) == 1 && diagnostics.diags[0].code.raw == 3007);
    assert(diagnostics.diags[0].span.file == 19 && diagnostics.diags[0].span.offset == 23 && diagnostics.diags[0].span.length == 7);
    return;
}

function check_context_and_constraints(): void!AllocError {
    // 目标类型可以独立求解；未定型的实参在实例化成功后由调用方获得具体形参类型。
    let bytes: [u8; 10] = [1, 0, 1, 0, 4, 0, 0, 4, 0, 0];
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let sig: resolve_refs::FunctionTemplate = resolve_refs::read_generic_signature(&bytes[0..10]:Read, &deps:Read, 0, &diagnostics:ReadWrite)?;
    assert(sig.valid && diag::diagbuf_count(&diagnostics:Read) == 0);
    var tt: typecheck::TypeTable = typecheck::new_table();
    let octet: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4097)?;
    let number: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4099)?;
    let view: u32 = typecheck::intern_slice(&tt:ReadWrite, 0, octet)?;
    let args: [u32; 4] = [0, octet, number, view];
    let no_constraints: monomorph::Constraints = empty_constraints();
    let constraints: monomorph::Constraints = monomorph::Constraints {
        required: [monomorph::Requirement { parameter: 0, interface_def: 42 }],
        checked: [monomorph::Implementation { type_id: octet, interface_def: 42 }],
    };
    let call: types::Span = types::Span { file: 21, offset: 27, length: 4 };
    let implicit: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[0..0]:Read, &args[0..1]:Read, octet, &constraints:Read, call, &diagnostics:ReadWrite)?;
    let explicit: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[1..2]:Read, &args[0..1]:Read, 0, &constraints:Read, call, &diagnostics:ReadWrite)?;
    assert(implicit.ok && explicit.ok && implicit.result == explicit.result && explicit.result == octet);
    assert(explicit.arguments[0] == octet && explicit.params[0] == octet && diag::diagbuf_count(&diagnostics:Read) == 0);
    let missing: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[0..0]:Read, &args[0..1]:Read, 0, &no_constraints:Read, call, &diagnostics:ReadWrite)?;
    let wrong: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[2..3]:Read, &args[0..1]:Read, 0, &constraints:Read, call, &diagnostics:ReadWrite)?;
    let forbidden: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[3..4]:Read, &args[3..4]:Read, 0, &no_constraints:Read, call, &diagnostics:ReadWrite)?;
    let arity: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[1..3]:Read, &args[0..1]:Read, 0, &no_constraints:Read, call, &diagnostics:ReadWrite)?;
    assert(!missing.ok && !wrong.ok && !forbidden.ok && !arity.ok && diag::diagbuf_count(&diagnostics:Read) == 4);
    var i: u32 = 0;
    while i < 4 { assert(diagnostics.diags[i].code.raw == 3007); i = i + 1; }
    return;
}

function check_invalid_signature(): void!AllocError {
    let bytes: [u8; 7] = [1, 0, 0, 0, 4, 1, 0];
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let invalid: resolve_refs::FunctionTemplate = resolve_refs::read_generic_signature(&bytes[0..7]:Read, &deps:Read, 0, &diagnostics:ReadWrite)?;
    assert(!invalid.valid && @len(invalid.types) == 0 && diag::diagbuf_count(&diagnostics:Read) == 1 && diagnostics.diags[0].code.raw == 7012);
    return;
}

function check_nested_type_parameters(): void!AllocError {
    // <T,U>([T;4], &function(&U):T): U。
    let bytes: [u8; 30] = [2, 0, 2, 0, 5, 4, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0,
        9, 1, 0, 7, 0, 4, 1, 0, 4, 0, 0, 4, 1, 0];
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var diagnostics: diag::DiagBuffer = diag::diagbuf_new();
    let sig: resolve_refs::FunctionTemplate = resolve_refs::read_generic_signature(&bytes[0..30]:Read, &deps:Read, 0, &diagnostics:ReadWrite)?;
    assert(sig.valid && sig.arity == 2 && sig.param_count == 2);
    var tt: typecheck::TypeTable = typecheck::new_table();
    let octet: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4097)?;
    let number: u32 = typecheck::intern_builtin(&tt:ReadWrite, 4099)?;
    let array: u32 = typecheck::intern_fixed_array(&tt:ReadWrite, octet, 4)?;
    let access: u32 = typecheck::intern_ref(&tt:ReadWrite, 0, number)?;
    let parameters: u32[] = [access];
    let callback: u32 = typecheck::intern_fn_ref(&tt:ReadWrite, @move(parameters), octet)?;
    let args: [u32; 2] = [array, callback];
    let constraints: monomorph::Constraints = empty_constraints();
    let call: types::Span = types::Span { file: 22, offset: 37, length: 2 };
    let instance: monomorph::InstanceSignature = monomorph::instantiate_signature(&tt:ReadWrite, &sig:Read, &args[0..0]:Read, &args[0..2]:Read, 0, &constraints:Read, call, &diagnostics:ReadWrite)?;
    assert(instance.ok && @len(instance.arguments) == 2 && instance.arguments[0] == octet && instance.arguments[1] == number);
    assert(instance.params[0] == array && instance.params[1] == callback && instance.result == number);
    assert(diag::diagbuf_count(&diagnostics:Read) == 0);
    return;
}

function main(): void {
    check_inference()?;
    check_context_and_constraints()?;
    check_invalid_signature()?;
    check_nested_type_parameters()?;
    return;
}
