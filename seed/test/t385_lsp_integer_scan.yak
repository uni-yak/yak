import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

// 折叠先报告越界；整数范围检查须付费扫描已有诊断，不得重复报告。
function small_steps(): void!AllocError {
    let src: &[u8] = "const A: u8 = 300; function f(): u8 { return A; }\n";
    let lexed: lex::LexResult = lex::lex_scan(src, 109u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 109u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    assert(@len(parsed.pool.exprs) == 2 && @len(parsed.pool.unaries) == 0);
    var name_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &name_diags:ReadWrite)?;
    assert(name_diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 11u32 {
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(limit);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite)?;
        // 两个侧表均整表预扣；额度不足时不消耗未付的表。
        var left: u32 = 0u32;
        if limit == 1u32 || limit == 6u32 { left = 1u32; }
        assert(scan.exhausted == (limit < 11u32) && scan.remaining == left);
        assert(diags.count == 1u32 && diags.diags[0].code.raw == 1004u16);
        if limit < 11u32 { assert(@len(checked.expr_types.items) == 0); }
        else { assert(@len(checked.expr_types.items) == 2); }
        limit = limit + 1u32;
    }
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(src, 109u16, &batch:ReadWrite)?;
    assert(!accepted && batch.count == 1u32 && batch.diags[0].code.raw == 1004u16);
    return;
}

// 固定 819 个表达式节点，保留试算入口或改为四个负号。
function tree(text: &buf::ByteBuf:ReadWrite, at: u32, count: u32, probes: bool, bad: bool): void!AllocError {
    if count == 1u32 {
        if at < 2u32 || (at < 4u32 && !probes) { buf::buf_push_bytes(text, "-0i32")?; }
        elseif at < 4u32 { buf::buf_push_bytes(text, "0i32 as i32")?; }
        elseif at == 4u32 && bad { buf::buf_push_bytes(text, "2147483648i32")?; }
        else { buf::buf_push_bytes(text, "0i32")?; }
        return;
    }
    let mid: u32 = count / 2u32;
    buf::buf_push_bytes(text, "(")?;
    tree(text, at, mid, probes, bad)?;
    buf::buf_push_bytes(text, " + ")?;
    tree(text, at + mid, count - mid, probes, bad)?;
    buf::buf_push_bytes(text, ")")?;
    return;
}

function check_document(probes: bool, bad: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&text:ReadWrite, "function f(): i32 {\nreturn ")?;
    tree(&text:ReadWrite, 0u32, 408u32, probes, bad)?;
    buf::buf_push_bytes(&text:ReadWrite, ";\n}\n")?;
    let src: &[u8] = &text.data[0..text.pos]:Read;
    let checked: pipeline::DocumentAnalysis = pipeline::run_document_frontend(src, 110u16)?;
    if probes { assert(pipeline::analysis_integer_scan_exceeded(checked.status) && checked.diagnostics.count == 0u32 && !checked.diagnostics.truncated); }
    else {
        assert(pipeline::analysis_rejected(checked.status) == bad);
        assert(pipeline::analysis_checked(checked.status) == !bad);
        if bad { assert(checked.diagnostics.count == 1u32 && checked.diagnostics.diags[0].code.raw == 1004u16); }
        else { assert(checked.diagnostics.count == 0u32); }
    }
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(src, 110u16, &batch:ReadWrite)?;
    assert(accepted == !bad);
    if bad { assert(batch.count == 1u32 && batch.diags[0].code.raw == 1004u16); }
    else { assert(batch.count == 0u32); }
    return;
}

function main(): void {
    small_steps()?;
    check_document(true, false)?;
    check_document(true, true)?;
    check_document(false, false)?;
    check_document(false, true)?;
    return;
}
