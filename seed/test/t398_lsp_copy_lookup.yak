import typecheck;
import copy_facts;
import consteval;
foreign assert(cond: bool): void;

function checked_types(): typecheck::TypeCheckResult {
    return typecheck::TypeCheckResult {
        types: typecheck::TypeTable { entries: [], members: [] },
        funcs: typecheck::FuncTable { items: [], by_def: [] },
        def_types: typecheck::DefTypeTable { items: [] },
        fields: typecheck::FieldTable { items: [] }, enums: typecheck::EnumTable { items: [] },
        expr_types: typecheck::ExprTypeTable { items: [], members: [], ctors: [] }, consts: consteval::new_table(),
        imported_fields: typecheck::ImportedFieldTable { items: [] },
        imported_enums: typecheck::ImportedEnumTable { items: [] },
        copy_facts: typecheck::CopyFacts { items: [] }
    };
}

function ordered_rows(): void!AllocError {
    var checked: typecheck::TypeCheckResult = checked_types();
    let scalar: u32 = typecheck::intern_builtin(&checked.types:ReadWrite, 4099u16)?;
    let array: u32 = typecheck::intern_dyn_array(&checked.types:ReadWrite, scalar)?;
    let before: u32 = typecheck::intern_local(&checked.types:ReadWrite, 10u32)?;
    let mixed: u32 = typecheck::intern_local(&checked.types:ReadWrite, 20u32)?;
    let enum_copy: u32 = typecheck::intern_local(&checked.types:ReadWrite, 30u32)?;
    let enum_owning: u32 = typecheck::intern_local(&checked.types:ReadWrite, 45u32)?;
    let enum_empty: u32 = typecheck::intern_local(&checked.types:ReadWrite, 60u32)?;
    let after: u32 = typecheck::intern_local(&checked.types:ReadWrite, 80u32)?;
    typecheck::add_field(&checked.fields:ReadWrite, 10u32, 1u32, scalar)?;
    typecheck::add_field(&checked.fields:ReadWrite, 20u32, 1u32, scalar)?;
    typecheck::add_field(&checked.fields:ReadWrite, 20u32, 2u32, array)?;
    typecheck::add_field(&checked.fields:ReadWrite, 80u32, 1u32, scalar)?;
    @push(checked.enums.items, typecheck::EnumType { def: 30u32, payloads: [0u32, before] })?;
    @push(checked.enums.items, typecheck::EnumType { def: 45u32, payloads: [0u32, mixed] })?;
    @push(checked.enums.items, typecheck::EnumType { def: 60u32, payloads: [0u32] })?;
    // 键在另一张表的开头、间隙或末尾缺失，都不能借到邻居的成员。
    assert(copy_facts::is_copy_value(&checked:Read, before));
    assert(!copy_facts::is_copy_value(&checked:Read, mixed));
    assert(copy_facts::is_copy_value(&checked:Read, enum_copy));
    assert(!copy_facts::is_copy_value(&checked:Read, enum_owning));
    assert(copy_facts::is_copy_value(&checked:Read, enum_empty));
    assert(copy_facts::is_copy_value(&checked:Read, after));
    // 最大子图是枚举、两个字段的结构体、两个叶子，空载荷不计入。
    let limited: bool = copy_facts::prepare_local_copy(&checked:ReadWrite, 3u32, true)?;
    assert(!limited && @len(checked.copy_facts.items) == 0u64);
    let ordered: bool = copy_facts::prepare_local_copy(&checked:ReadWrite, 4u32, true)?;
    assert(ordered);
    var indexed: u8[] = [];
    var i: u32 = 0;
    while i < @len(checked.copy_facts.items) as u32 {
        @push(indexed, checked.copy_facts.items[i])?;
        i = i + 1u32;
    }
    checked.copy_facts = typecheck::CopyFacts { items: [] };
    let legacy: bool = copy_facts::prepare_local_copy(&checked:ReadWrite, 4u32, false)?;
    assert(legacy && @len(indexed) == @len(checked.types.entries));
    i = 0;
    while i < @len(indexed) as u32 {
        assert(indexed[i] == checked.copy_facts.items[i]);
        i = i + 1u32;
    }
    assert(checked.copy_facts.items[before - 1u32] == 1u8);
    assert(checked.copy_facts.items[mixed - 1u32] == 2u8);
    assert(checked.copy_facts.items[enum_copy - 1u32] == 1u8);
    assert(checked.copy_facts.items[enum_owning - 1u32] == 2u8);
    assert(checked.copy_facts.items[enum_empty - 1u32] == 1u8);
    assert(checked.copy_facts.items[after - 1u32] == 1u8);
    return;
}

// 手工结果仍能遍历分散的字段或重复枚举行，不能以首个命中代替全扫。
function unordered_rows(): void!AllocError {
    var checked: typecheck::TypeCheckResult = checked_types();
    let scalar: u32 = typecheck::intern_builtin(&checked.types:ReadWrite, 4099u16)?;
    let array: u32 = typecheck::intern_dyn_array(&checked.types:ReadWrite, scalar)?;
    let structure: u32 = typecheck::intern_local(&checked.types:ReadWrite, 10u32)?;
    let choice: u32 = typecheck::intern_local(&checked.types:ReadWrite, 20u32)?;
    let other: u32 = typecheck::intern_local(&checked.types:ReadWrite, 30u32)?;
    typecheck::add_field(&checked.fields:ReadWrite, 10u32, 1u32, scalar)?;
    typecheck::add_field(&checked.fields:ReadWrite, 30u32, 1u32, scalar)?;
    typecheck::add_field(&checked.fields:ReadWrite, 10u32, 2u32, array)?;
    @push(checked.enums.items, typecheck::EnumType { def: 20u32, payloads: [scalar] })?;
    @push(checked.enums.items, typecheck::EnumType { def: 30u32, payloads: [0u32] })?;
    @push(checked.enums.items, typecheck::EnumType { def: 20u32, payloads: [array] })?;
    assert(!copy_facts::is_copy_value(&checked:Read, structure));
    assert(!copy_facts::is_copy_value(&checked:Read, choice));
    assert(copy_facts::is_copy_value(&checked:Read, other));
    let limited: bool = copy_facts::prepare_local_copy(&checked:ReadWrite, 2u32, false)?;
    assert(!limited && @len(checked.copy_facts.items) == 0u64);
    let completed: bool = copy_facts::prepare_local_copy(&checked:ReadWrite, 3u32, false)?;
    assert(completed);
    assert(checked.copy_facts.items[structure - 1u32] == 2u8);
    assert(checked.copy_facts.items[choice - 1u32] == 2u8);
    assert(checked.copy_facts.items[other - 1u32] == 1u8);
    return;
}

function main(): void {
    ordered_rows()?;
    unordered_rows()?;
    return;
}
