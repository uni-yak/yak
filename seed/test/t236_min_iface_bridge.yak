function sort_candidate(name: u8, digest_prefix: u8): iface::LoadedInterface!AllocError {
    var digest: u8[] = [digest_prefix];
    while @len(digest) < 32 { @push(digest, 0u8)?; }
    return iface::LoadedInterface { module_name: [name], name_bytes: [], dependencies: [], sig_bytes: [], exports: [], digest: digest, summaries: [], enum_descriptors: [], enum_members: [], enum_name_index: [], struct_descriptors: [], struct_fields: [], struct_field_name_index: [], privates: [] };
}
function check_dependency_order(): void!AllocError {
    var loaded: iface::LoadedInterface[] = [];
    var order: u32[] = [];
    iface_load::sort_dependencies(&loaded[0..0]:Read, &order:ReadWrite, 0)?;

    @push(loaded, sort_candidate(98u8, 2u8)?)?;
    @push(order, 0u32)?;
    iface_load::sort_dependencies(&loaded[0..1]:Read, &order:ReadWrite, 1)?;
    assert(order[0] == 0);

    // 摘要优先；摘要相同时按模块名排序，三个索引覆盖两轮归并。
    @push(loaded, sort_candidate(97u8, 2u8)?)?;
    @push(loaded, sort_candidate(122u8, 1u8)?)?;
    @push(order, 1u32)?;
    @push(order, 2u32)?;
    iface_load::sort_dependencies(&loaded[0..3]:Read, &order:ReadWrite, 3)?;
    assert(order[0] == 2 && order[1] == 1 && order[2] == 0);

    // 只排序已填充的索引前缀，尾部哨兵不能参与比较。
    order[0] = 0;
    order[1] = 1;
    order[2] = 4294967295u32;
    iface_load::sort_dependencies(&loaded[0..3]:Read, &order:ReadWrite, 2)?;
    assert(order[0] == 1 && order[1] == 0 && order[2] == 4294967295u32);
    return;
}
// 生产方的依赖编号 1 必须在消费方改写为 2。
function check_dependency_nominal(target_bytes: &[u8]:Read): void!AllocError {
    var d: diag::DiagBuffer = diag::diagbuf_new();
    var inputs: iface::LoadedInterface[] = [];
    @push(inputs, iface_load::load_interface(target_bytes, &d:ReadWrite)?)?;
    let target: &iface::LoadedInterface:Read = &inputs[0]:Read;
    let order: u32[] = [0u32];
    let layouts: iface::LayoutData = iface::LayoutData { sizes: [], aligns: [], known: [] };
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&deps:ReadWrite, target)?;
    let producer: Loaded = load("import dep;\nexport function pass(x: dep::P): dep::P { return x; }\n", 1700)?;
    let pr: resolve_refs::Resolution = resolve_unit::resolve_unit(&producer.parsed.file:Read, &producer.parsed.pool:Read, &producer.lexed.names:Read, &deps:Read, "producer", &d:ReadWrite)?;
    let pt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&producer.parsed.file:Read, &producer.parsed.pool:Read, &pr:Read, &d:ReadWrite)?;
    // 此用例只验证签名，为该函数提供保守的分配事实。
    var facts: u8[] = [];
    while @len(facts) < pt.funcs.items[0].def as u64 { @push(facts, 1u8)?; }
    var built: iface::InterfaceResult = iface_write::write_interface_with_dependencies(&producer.parsed.file:Read, &producer.parsed.pool:Read, &pr:Read, &producer.lexed.names:Read, &pt:Read, &layouts:Read, &facts[0..@len(facts)]:Read, "producer", &inputs[0..1]:Read, &order[0..1]:Read, &d:ReadWrite)?;
    assert(!d.has_error);
    let loaded: iface::LoadedInterface = iface_load::load_interface(&built.data.bytes[0..@len(built.data.bytes)]:Read, &d:ReadWrite)?;
    assert(!d.has_error && @len(loaded.dependencies) == 1 && @len(loaded.exports) == 1);
    let start: u32 = loaded.exports[0].sig_off;
    assert(loaded.sig_bytes[start + 4] == 3 && loaded.sig_bytes[start + 5] == 1);

    // 每次保持接口摘要合法，只改一个 TypeSig 字节，覆盖依赖编号上下界和非零实参数量。
    let directory: u32 = 56 + 4 * 16 + 4;
    var section: u32 = 0;
    var i: u32 = 0;
    while i < 4 { section = section | ((built.data.bytes[directory + i] as u32) << (i * 8)); i = i + 1; }
    let offsets: u32[] = [5u32, 5u32, 11u32];
    let bytes: u8[] = [0u8, 2u8, 1u8];
    var probe: u32 = 0;
    while probe < @len(offsets) as u32 {
        let off: u32 = section + start + offsets[probe];
        let saved: u8 = built.data.bytes[off];
        assert(saved != bytes[probe]);
        built.data.bytes[off] = bytes[probe];
        i = 24;
        while i < 56 { built.data.bytes[i] = 0u8; i = i + 1; }
        let digest: u8[] = iface::sha256(&built.data.bytes[0..@len(built.data.bytes)]:Read)?;
        i = 0;
        while i < 32 { built.data.bytes[24 + i] = digest[i]; i = i + 1; }
        var invalid_sig: diag::DiagBuffer = diag::diagbuf_new();
        let rejected: iface::LoadedInterface = iface_load::load_interface(&built.data.bytes[0..@len(built.data.bytes)]:Read, &invalid_sig:ReadWrite)?;
        assert(@len(rejected.exports) == 0 && diag::diagbuf_count(&invalid_sig:Read) == 1 && invalid_sig.diags[0].code.raw == 7012);
        built.data.bytes[off] = saved;
        probe = probe + 1;
    }

    // 保留同名导出和相同摘要，但改用不同模块名，检验完整的身份键。
    var consumer_deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&consumer_deps:ReadWrite, target)?;
    consumer_deps.ifaces[0].module = [111u8, 116u8, 104u8, 101u8, 114u8];
    iface_load::add_binary_dependency(&consumer_deps:ReadWrite, target)?;
    iface_load::add_binary_dependency(&consumer_deps:ReadWrite, &loaded:Read)?;
    let consumer: Loaded = load("import dep;\nimport producer;\nfunction get(): dep::P { return producer::pass(dep::P { a: 1 }); }\n", 1701)?;
    let cr: resolve_refs::Resolution = resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &consumer_deps:Read, "consumer", &d:ReadWrite)?;
    assert(!d.has_error && @len(cr.refs.imports) > 0);
    let sig: &resolve_refs::ImportSignature:Read = &cr.refs.imports[@len(cr.refs.imports) - 1]:Read;
    assert(sig.dep == 3 && sig.param_count == 1 && sig.types[sig.param_start].kind == 3 && sig.types[sig.param_start].a == 2);
    assert(sig.types[sig.ret_slot].kind == 3 && sig.types[sig.ret_slot].a == 2);
    typecheck_driver::typecheck_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &cr:Read, &d:ReadWrite)?;
    assert(!d.has_error);

    consumer_deps.ifaces[1].digest[0] = consumer_deps.ifaces[1].digest[0] ^ 1u8;
    var missing: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &consumer_deps:Read, "consumer", &missing:ReadWrite)?;
    assert(diag::diagbuf_count(&missing:Read) == 1 && missing.diags[0].code.raw == 7012);
    consumer_deps.ifaces[1].digest[0] = consumer_deps.ifaces[1].digest[0] ^ 1u8;
    // 依赖身份正确，但签名中的导出编号不存在。
    consumer_deps.ifaces[2].sigs[start + 9] = 255u8;
    var invalid: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &consumer_deps:Read, "consumer", &invalid:ReadWrite)?;
    assert(diag::diagbuf_count(&invalid:Read) == 1 && invalid.diags[0].code.raw == 7012);

    // 该依赖有真实函数导出：编号存在，但不是名义类型。
    i = 0;
    while target.exports[i].kind != 1 { i = i + 1; }
    assert(target.exports[i].export_id as u64 < 256);
    consumer_deps.ifaces[2].sigs[start + 9] = loaded.sig_bytes[start + 9];
    consumer_deps.ifaces[2].sigs[start + 7] = target.exports[i].export_id as u8;
    var wrong_kind: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &consumer_deps:Read, "consumer", &wrong_kind:ReadWrite)?;
    assert(diag::diagbuf_count(&wrong_kind:Read) == 1 && wrong_kind.diags[0].code.raw == 7012);

    // 零参数函数返回 void 与一个依赖枚举构成的载体；独立装载只核对编号范围，绑定时才核对声明身份。
    i = 0;
    while target.exports[i].kind != 2 { i = i + 1; }
    assert(target.exports[i].export_id as u64 < 256);
    let errors: u8[] = [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 3u8, 1u8, 0u8, target.exports[i].export_id as u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let exports: resolve_refs::IfaceExport[] = [];
    var allowed_errors: diag::DiagBuffer = diag::diagbuf_new();
    assert(resolve_refs::valid_interface_function_signature(&errors[0..@len(errors)]:Read, &exports[0..0]:Read, &errors[0..0]:Read, &allowed_errors:ReadWrite, 1)?);
    assert(diag::diagbuf_count(&allowed_errors:Read) == 0);
    var unsupported_errors: diag::DiagBuffer = diag::diagbuf_new();
    assert(!resolve_refs::valid_interface_function_signature(&errors[0..@len(errors)]:Read, &exports[0..0]:Read, &errors[0..0]:Read, &unsupported_errors:ReadWrite, 0)?);
    assert(diag::diagbuf_count(&unsupported_errors:Read) == 1 && unsupported_errors.diags[0].code.raw == 7012);
    let error_producer: Loaded = load("import dep;\nexport enum Local { Bad }\nexport function probe(): void!(Local | dep::E | AllocError) { return; }\n", 1702)?;
    var xd: diag::DiagBuffer = diag::diagbuf_new();
    let xr: resolve_refs::Resolution = resolve_unit::resolve_unit(&error_producer.parsed.file:Read, &error_producer.parsed.pool:Read, &error_producer.lexed.names:Read, &deps:Read, "producer", &xd:ReadWrite)?;
    let xt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&error_producer.parsed.file:Read, &error_producer.parsed.pool:Read, &xr:Read, &xd:ReadWrite)?;
    let xl: layout::LayoutResult = layout::layout_unit(&xt.types:Read, &xt.fields:Read, &xt.enums:Read, &xd:ReadWrite)?;
    let xlayouts: iface::LayoutData = collect_layout_data(&xl:Read)?;
    let xfacts: u8[] = [1u8, 1u8, 1u8, 1u8];
    let xw: iface::InterfaceResult = iface_write::write_interface_with_dependencies(&error_producer.parsed.file:Read, &error_producer.parsed.pool:Read, &xr:Read, &error_producer.lexed.names:Read, &xt:Read, &xlayouts:Read, &xfacts[0..4]:Read, "producer", &inputs[0..1]:Read, &order[0..1]:Read, &xd:ReadWrite)?;
    assert(diag::diagbuf_count(&xd:Read) == 0);
    let xi: iface::LoadedInterface = iface_load::load_interface(&xw.data.bytes[0..@len(xw.data.bytes)]:Read, &xd:ReadWrite)?;
    assert(diag::diagbuf_count(&xd:Read) == 0);
    var remapped: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&remapped:ReadWrite, &xi:Read)?;
    iface_load::add_binary_dependency(&remapped:ReadWrite, target)?;
    let xc: Loaded = load("import producer;\nfunction use_probe(): void { producer::probe(); return; }\n", 1703)?;
    let mapped: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&xc.parsed.file:Read, &xc.parsed.pool:Read, &xc.lexed.names:Read, &remapped:Read, 1, "consumer", &xd:ReadWrite)?;
    assert(diag::diagbuf_count(&xd:Read) == 0 && @len(mapped.refs.imports) == 1);
    let xs: &resolve_refs::ImportSignature:Read = &mapped.refs.imports[0]:Read;
    let carrier: resolve_refs::ImportType = xs.types[xs.ret_slot];
    assert(carrier.kind == 9 && carrier.c == 3);
    assert(xs.types[carrier.b].kind == 1 && xs.types[carrier.b].a == 4108);
    assert(xs.types[carrier.b + 1].kind == 3 && xs.types[carrier.b + 1].a == 2);
    assert(xs.types[carrier.b + 2].kind == 2);
    var fi: u32 = 0;
    while remapped.ifaces[0].exports[fi].kind != 1 { fi = fi + 1; }
    let xoff: u32 = remapped.ifaces[0].exports[fi].sig_off;
    // 交换两个合法用户枚举的位置：单独装载可保留，绑定后必须按完整身份拒绝。
    assert(xi.sig_bytes[xoff + 19] == 3 && xi.sig_bytes[xoff + 28] == 2);
    var byte: u32 = 0;
    while byte < 7 {
        remapped.ifaces[0].sigs[xoff + 19 + byte] = xi.sig_bytes[xoff + 28 + byte];
        byte = byte + 1;
    }
    byte = 0;
    while byte < 9 {
        remapped.ifaces[0].sigs[xoff + 26 + byte] = xi.sig_bytes[xoff + 19 + byte];
        byte = byte + 1;
    }
    var wrong_order: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit_with_types(&xc.parsed.file:Read, &xc.parsed.pool:Read, &xc.lexed.names:Read, &remapped:Read, 1, "consumer", &wrong_order:ReadWrite)?;
    assert(diag::diagbuf_count(&wrong_order:Read) == 1 && wrong_order.diags[0].code.raw == 7012);
    byte = 0;
    while byte < 16 {
        remapped.ifaces[0].sigs[xoff + 19 + byte] = xi.sig_bytes[xoff + 19 + byte];
        byte = byte + 1;
    }
    // 改成同一依赖的结构体编号，仍必须按错误成员的 enum kind 拒绝。
    let struct_id: u32 = export_id_of(target, "P", 3);
    assert(struct_id > 0 && struct_id < 256 && remapped.ifaces[0].sigs[xoff + 19] == 3);
    remapped.ifaces[0].sigs[xoff + 22] = struct_id as u8;
    var wrong_error: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit_with_types(&xc.parsed.file:Read, &xc.parsed.pool:Read, &xc.lexed.names:Read, &remapped:Read, 1, "consumer", &wrong_error:ReadWrite)?;
    assert(diag::diagbuf_count(&wrong_error:Read) == 1 && wrong_error.diags[0].code.raw == 7012);
    return;
}
// 把布局结果整理成接口写出所需的尺寸、对齐与已知性三元组。
function collect_layout_data(l: &layout::LayoutResult:Read): iface::LayoutData!AllocError {
    var sizes: u64[] = [];
    var aligns: u8[] = [];
    var known: bool[] = [];
    var i: u32 = 0;
    while i < @len(l.table.items) as u32 {
        @push(sizes, l.table.items[i].size)?;
        @push(aligns, l.table.items[i].align)?;
        @push(known, l.table.items[i].known)?;
        i = i + 1;
    }
    return iface::LayoutData { sizes: sizes, aligns: aligns, known: known };
}
function build_material(name: &[u8], encoded: &iface::InterfaceResult:Read): document_deps::Material!AllocError {
    let bytes: &[u8] = &encoded.data.bytes[0..@len(encoded.data.bytes)]:Read;
    var saved_name: u8[] = [];
    var saved_bytes: u8[] = [];
    var i: u32 = 0;
    while i < @len(name) as u32 { @push(saved_name, name[i])?; i = i + 1u32; }
    i = 0u32;
    while i < @len(bytes) as u32 { @push(saved_bytes, bytes[i])?; i = i + 1u32; }
    var digest: u8[] = [];
    i = 0u32;
    while i < @len(encoded.digest) as u32 { @push(digest, encoded.digest[i])?; i = i + 1u32; }
    return document_deps::Material { module: @move(saved_name), digest: @move(digest), bytes: @move(saved_bytes) };
}

// A 只导入 B，B 的导出签名引用 C；C 只作为类型闭包提供时仍须解码并重映射其名义编号。
function check_typeonly_dependency(): void!AllocError {
    // ── C：只提供名义类型，不参与任何直接导入 ──
    let cunit: Loaded = load("export struct C { a: u32 }\nexport enum Tag { First }\n", 1720)?;
    var dc: diag::DiagBuffer = diag::diagbuf_new();
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let cr: resolve_refs::Resolution = resolve_unit::resolve_unit(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cunit.lexed.names:Read, &empty:Read, "c", &dc:ReadWrite)?;
    let ct: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cr:Read, &dc:ReadWrite)?;
    let cl: layout::LayoutResult = layout::layout_unit(&ct.types:Read, &ct.fields:Read, &ct.enums:Read, &dc:ReadWrite)?;
    let c_layout: iface::LayoutData = collect_layout_data(&cl:Read)?;
    let cw: iface::InterfaceResult = iface_write::write_interface(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cr:Read, &cunit.lexed.names:Read, &ct:Read, &c_layout:Read, "c", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    var c_inputs: iface::LoadedInterface[] = [];
    @push(c_inputs, iface_load::load_interface(&cw.data.bytes[0..@len(cw.data.bytes)]:Read, &dc:ReadWrite)?)?;
    assert(diag::diagbuf_count(&dc:Read) == 0 && @len(c_inputs[0].exports) == 2);
    var c_struct_id: u32 = 0;
    var c_enum_id: u32 = 0;
    var ce: u32 = 0;
    while ce < @len(c_inputs[0].exports) as u32 {
        if c_inputs[0].exports[ce].kind == 3 { c_struct_id = c_inputs[0].exports[ce].export_id; }
        if c_inputs[0].exports[ce].kind == 2 { c_enum_id = c_inputs[0].exports[ce].export_id; }
        ce = ce + 1;
    }
    assert(c_struct_id != 0 && c_enum_id != 0 && c_struct_id != c_enum_id);

    // ── B：导出签名引用 c::C 与 c::Tag，并带一个本地 Pair 作为编号对照 ──
    var bdeps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&bdeps:ReadWrite, &c_inputs[0]:Read)?;
    let bunit: Loaded = load("import c;\nexport struct Pair { left: u32, right: u32 }\nexport enum Wrapped { Empty, Value(c::C) }\nexport function make(): Pair { return Pair { left: 1, right: 2 }; }\nexport function one(): c::C { return c::C { a: 1 }; }\nexport function tag(): c::Tag { return c::Tag::First; }\nexport function pass(x: c::C): c::C { return x; }\nexport function pick(x: c::C, t: c::Tag): c::C { t; return x; }\nexport function pair(p: Pair): u32 { return p.left; }\n", 1721)?;
    let br: resolve_refs::Resolution = resolve_unit::resolve_unit(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &bunit.lexed.names:Read, &bdeps:Read, "b", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let bt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &br:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    var c_layouts: layout::ImportedLayoutTable = layout::ImportedLayoutTable { items: [] };
    var ci: u32 = 0;
    while ci < @len(c_inputs[0].summaries) as u32 {
        let item: &iface::LoadedSummary:Read = &c_inputs[0].summaries[ci]:Read;
        @push(c_layouts.items, layout::ImportedLayout { dep: 1, export_id: item.type_export_id, size: item.size, align: item.align })?;
        ci = ci + 1;
    }
    let bl: layout::LayoutResult = layout::layout_unit_with_imports(&bt.types:Read, &bt.fields:Read, &bt.enums:Read, &c_layouts:Read, &bt.imported_enums:Read, &dc:ReadWrite)?;
    let b_layout: iface::LayoutData = collect_layout_data(&bl:Read)?;
    // 该用例只验证签名与依赖桥，为所有函数提供保守的非分配事实。
    var bmax: u64 = 0;
    var bi: u32 = 0;
    while bi < @len(bt.funcs.items) as u32 {
        if bt.funcs.items[bi].def as u64 > bmax { bmax = bt.funcs.items[bi].def as u64; }
        bi = bi + 1;
    }
    var bfacts: u8[] = [];
    while @len(bfacts) < bmax { @push(bfacts, 1u8)?; }
    let c_order: u32[] = [0u32];
    let bw: iface::InterfaceResult = iface_write::write_interface_with_dependencies(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &br:Read, &bunit.lexed.names:Read, &bt:Read, &b_layout:Read, &bfacts[0..@len(bfacts)]:Read, "b", &c_inputs[0..1]:Read, &c_order[0..1]:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let b_iface: iface::LoadedInterface = iface_load::load_interface(&bw.data.bytes[0..@len(bw.data.bytes)]:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0 && @len(b_iface.dependencies) == 1 && @len(b_iface.exports) == 8);
    var b_pair_id: u32 = 0;
    var be: u32 = 0;
    while be < @len(b_iface.exports) as u32 {
        if b_iface.exports[be].kind == 3 { b_pair_id = b_iface.exports[be].export_id; }
        be = be + 1;
    }
    assert(b_pair_id != 0);

    // ── 选择器：按 B 的依赖记录挑出 C；C 已是直接依赖时不重复返回 ──
    var loaded_all: iface::LoadedInterface[] = [];
    @push(loaded_all, iface_load::load_interface(&bw.data.bytes[0..@len(bw.data.bytes)]:Read, &dc:ReadWrite)?)?;
    @push(loaded_all, iface_load::load_interface(&cw.data.bytes[0..@len(cw.data.bytes)]:Read, &dc:ReadWrite)?)?;
    var ds: diag::DiagBuffer = diag::diagbuf_new();
    let direct_b: u32[] = [0u32];
    let targets: u32[] = iface_load::collect_type_dependencies(&loaded_all[0..2]:Read, &direct_b[0..1]:Read, &ds:ReadWrite)?;
    assert(diag::diagbuf_count(&ds:Read) == 0 && @len(targets) == 1 && targets[0] == 1);
    let direct_bc: u32[] = [0u32, 1u32];
    let targets_direct: u32[] = iface_load::collect_type_dependencies(&loaded_all[0..2]:Read, &direct_bc[0..2]:Read, &ds:ReadWrite)?;
    assert(diag::diagbuf_count(&ds:Read) == 0 && @len(targets_direct) == 0);

    // ── A：只导入 B；C 只出现在 B 的签名里，源码无法命名 C ──
    var adeps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&adeps:ReadWrite, &b_iface:Read)?;
    iface_load::add_binary_dependency(&adeps:ReadWrite, &loaded_all[targets[0]]:Read)?;
    let a_source: &[u8]:Read = "import b;\nfunction get(): b::Pair { return b::make(); }\nfunction total(): u32 { return b::pair(b::make()); }\nfunction chain(): void { b::pass(b::pick(b::one(), b::tag())); return; }\n";
    let aunit: Loaded = load(a_source, 1722)?;
    var da: diag::DiagBuffer = diag::diagbuf_new();
    let ar: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &aunit.lexed.names:Read, &adeps:Read, 1, "a", &da:ReadWrite)?;
    assert(diag::diagbuf_count(&da:Read) == 0);
    // 导入声明在定义表中的下标随保留顺序变化，这里只统计导入项而不假定位置。
    var import_defs: u32 = 0;
    var di: u32 = 0;
    while di < @len(ar.result.tables.defs) as u32 {
        if ar.result.tables.defs[di].kind == 6 {
            import_defs = import_defs + 1;
            assert(ar.result.tables.defs[di].import_dependency == 1);
        }
        di = di + 1;
    }
    assert(import_defs == 1);
    assert(@len(ar.refs.imports) == 6);
    // 传递成员仅为布局和析构保留，不能据此按源码名称访问。
    var hidden_fields: u32 = 0;
    var hidden_variants: u32 = 0;
    di = 0;
    while di < @len(ar.refs.fields) as u32 {
        if ar.refs.fields[di].dep == 2 {
            assert(ar.refs.fields[di].name == 0 && @len(ar.refs.fields[di].types) != 0);
            hidden_fields = hidden_fields + 1;
        }
        di = di + 1;
    }
    di = 0;
    while di < @len(ar.refs.variants) as u32 {
        if ar.refs.variants[di].dep == 2 {
            assert(ar.refs.variants[di].name == 0 && ar.refs.variants[di].known);
            hidden_variants = hidden_variants + 1;
        }
        di = di + 1;
    }
    assert(hidden_fields != 0 && hidden_variants != 0);
    // 导出方编号 1 在消费方改写为 2；B 本地 Pair 仍指向 1。
    var c_slots: u32 = 0;
    var struct_slots: u32 = 0;
    var enum_slots: u32 = 0;
    var pair_slots: u32 = 0;
    var si: u32 = 0;
    while si < @len(ar.refs.imports) as u32 {
        let sig: &resolve_refs::ImportSignature:Read = &ar.refs.imports[si]:Read;
        assert(sig.dep == 1);
        var slot_index: u32[] = [];
        var pi: u32 = 0;
        while pi < sig.param_count as u32 { @push(slot_index, sig.param_start + pi)?; pi = pi + 1; }
        @push(slot_index, sig.ret_slot)?;
        var ti: u32 = 0;
        while ti < @len(slot_index) as u32 {
            let slot: resolve_refs::ImportType = sig.types[slot_index[ti]];
            if slot.kind == 2 {
                // B 本地名义类型不经过依赖重映射，保留 B 自己的导出编号。
                assert(slot.a == b_pair_id);
                pair_slots = pair_slots + 1;
            }
            if slot.kind == 3 {
                // C 只出现在 B 的依赖记录里，消费方编号必须重映射为 A 的第 2 个依赖。
                assert(slot.a == 2 && (slot.b == c_struct_id || slot.b == c_enum_id));
                if slot.b == c_struct_id { struct_slots = struct_slots + 1; }
                if slot.b == c_enum_id { enum_slots = enum_slots + 1; }
                c_slots = c_slots + 1;
            }
            ti = ti + 1;
        }
        si = si + 1;
    }
    assert(c_slots == 7 && struct_slots == 5 && enum_slots == 2 && pair_slots == 2);
    let at: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &ar:Read, &da:ReadWrite)?;
    assert(diag::diagbuf_count(&da:Read) == 0 && @len(at.funcs.items) == 3);

    // 文档和批处理共用已校验的直接前缀、传递后缀及布局摘要。
    var order: u32[] = [0u32];
    let bridge_deps: iface_load::DependencyAssembly = iface_load::assemble_dependencies(&loaded_all[0..2]:Read, &order:ReadWrite, 1u32, &ds:ReadWrite)?;
    assert(bridge_deps.valid && !ds.has_error && @len(bridge_deps.targets) == 1);
    let imported: layout::ImportedLayoutTable = iface_layout::imported_layouts(&loaded_all[0..2]:Read, &order[0..1]:Read, &bridge_deps.targets[0..1]:Read)?;
    let ready: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies(a_source, 1722u16, "a", &bridge_deps.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_checked(ready.analysis.status) && !ready.analysis.diagnostics.has_error);
    let ctor_doc: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import b; function f(): b::Pair { return b::Pair { left: 1, right: 2 }; }\nfunction g(): b::Wrapped { return b::Wrapped::Empty; }\n", 1722u16, "a", &bridge_deps.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_checked(ctor_doc.analysis.status) && !ctor_doc.analysis.diagnostics.has_error);
    assert(@len(ctor_doc.definitions.imported_interfaces) == 1 && @len(ctor_doc.definitions.imported_uses) == 3);
    let typ: types::ImportedDefinitionUse = types::imported_definition_at(&ctor_doc.definitions:Read, 27u32);
    let ctor: types::ImportedDefinitionUse = types::imported_definition_at(&ctor_doc.definitions:Read, 46u32);
    assert(typ.offset == 27u32 && ctor.offset == 44u32 && typ.length == 4u32 && ctor.length == 4u32);
    assert(typ.interface_row == 1u32 && ctor.interface_row == 1u32 && typ.export_id == b_pair_id && ctor.export_id == b_pair_id);
    assert(types::imported_definition_at(&ctor_doc.definitions:Read, 91u32).length == 7u32);
    assert(types::imported_definition_at(&ctor_doc.definitions:Read, 51u32).length == 0u32);
    assert(types::imported_definition_at(&ctor_doc.definitions:Read, 111u32).length == 0u32);
    assert(types::imported_definition_at(&ctor_doc.definitions:Read, 120u32).length == 0u32);
    let hidden_doc: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import b; function f(): u32 { return b::one().a; }\n", 1722u16, "a", &bridge_deps.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_rejected(hidden_doc.analysis.status) && @len(hidden_doc.analysis.diagnostics.diags) == 1 && hidden_doc.analysis.diagnostics.diags[0].code.raw == 5001u16);
    let absent_doc: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import c; function f(): void {}\n", 1722u16, "a", &bridge_deps.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_needs_dependencies(absent_doc.analysis.status) && !absent_doc.analysis.diagnostics.has_error);

    // 可信材料登记先验证原始字节与预期摘要，再按直接／传递身份统一准备。
    var materials: document_deps::Material[] = [];
    @push(materials, build_material("b", &bw:Read)?)?;
    let missing_material: document_deps::Prepared = document_deps::prepare(&materials[0..1]:Read, &direct_b[0..1]:Read, "a")?;
    assert(missing_material.status == 3u8 && @len(missing_material.assembly.deps.ifaces) == 0 && @len(missing_material.layouts.items) == 0);
    let cycle: document_deps::Prepared = document_deps::prepare(&materials[0..1]:Read, &direct_b[0..1]:Read, "c")?;
    assert(cycle.status == 5u8 && @len(cycle.assembly.deps.ifaces) == 0);
    let alternate: Loaded = load("export function version(): u32 { return 2; }\n", 1728u16)?;
    var alt_diag: diag::DiagBuffer = diag::diagbuf_new();
    let alt_res: resolve_refs::Resolution = resolve_unit::resolve_unit(&alternate.parsed.file:Read, &alternate.parsed.pool:Read, &alternate.lexed.names:Read, &empty:Read, "c", &alt_diag:ReadWrite)?;
    let alt_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&alternate.parsed.file:Read, &alternate.parsed.pool:Read, &alt_res:Read, &alt_diag:ReadWrite)?;
    let no_layout: iface::LayoutData = iface::LayoutData { sizes: [], aligns: [], known: [] };
    let alt_bytes: iface::InterfaceResult = iface_write::write_interface(&alternate.parsed.file:Read, &alternate.parsed.pool:Read, &alt_res:Read, &alternate.lexed.names:Read, &alt_types:Read, &no_layout:Read, "c", &alt_diag:ReadWrite)?;
    assert(!alt_diag.has_error);
    @push(materials, build_material("c", &alt_bytes:Read)?)?;
    let stale: document_deps::Prepared = document_deps::prepare(&materials[0..2]:Read, &direct_b[0..1]:Read, "a")?;
    assert(stale.status == 4u8 && @len(stale.assembly.deps.ifaces) == 0);
    materials[1] = build_material("c", &cw:Read)?;
    let trusted: document_deps::Prepared = document_deps::prepare(&materials[0..2]:Read, &direct_b[0..1]:Read, "a")?;
    assert(trusted.status == 0u8 && trusted.direct_count == 1u32 && @len(trusted.assembly.deps.ifaces) == 2 && @len(trusted.layouts.items) != 0);
    let trusted_doc: document_deps::Analysis = document_deps::analyze(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read)?;
    assert(trusted_doc.material_status == 0u8 && pipeline::analysis_checked(trusted_doc.document.analysis.status));
    var opened: document_deps::OpenModule[] = [document_deps::OpenModule { module: [98u8] }];
    let direct_overlay: document_deps::Analysis = document_deps::analyze_with_open_modules(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read, &opened[0..1]:Read)?;
    assert(direct_overlay.material_status == 6u8 && pipeline::analysis_needs_dependencies(direct_overlay.document.analysis.status));
    assert(@len(direct_overlay.document.definitions.links) == 0);
    opened[0] = document_deps::OpenModule { module: [99u8] };
    let type_overlay: document_deps::Analysis = document_deps::analyze_with_open_modules(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read, &opened[0..1]:Read)?;
    assert(type_overlay.material_status == 6u8 && pipeline::analysis_needs_dependencies(type_overlay.document.analysis.status));
    opened[0] = document_deps::OpenModule { module: [100u8] };
    let unrelated: document_deps::Analysis = document_deps::analyze_with_open_modules(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read, &opened[0..1]:Read)?;
    assert(unrelated.material_status == 0u8 && pipeline::analysis_checked(unrelated.document.analysis.status));
    let closed_doc: document_deps::Analysis = document_deps::analyze_with_open_modules(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read, &opened[0..0]:Read)?;
    assert(closed_doc.material_status == 0u8 && pipeline::analysis_checked(closed_doc.document.analysis.status));
    materials[1].bytes[0] = 0u8;
    let corrupt: document_deps::Prepared = document_deps::prepare(&materials[0..2]:Read, &direct_b[0..1]:Read, "a")?;
    assert(corrupt.status == 2u8 && @len(corrupt.assembly.deps.ifaces) == 0);
    let fallback: document_deps::Analysis = document_deps::analyze(a_source, 1722u16, "a", &materials[0..2]:Read, &direct_b[0..1]:Read)?;
    assert(fallback.material_status == 2u8 && pipeline::analysis_needs_dependencies(fallback.document.analysis.status));
    assert(@len(fallback.document.definitions.links) == 0);

    // ── 负例：类型闭包中的 C 不能被源码直接 import 绑定 ──
    let leak: Loaded = load("import c;\nfunction leak(x: c::C): void { x; return; }\n", 1723)?;
    var dn: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit_with_types(&leak.parsed.file:Read, &leak.parsed.pool:Read, &leak.lexed.names:Read, &adeps:Read, 1, "a", &dn:ReadWrite)?;
    assert(diag::diagbuf_count(&dn:Read) == 1 && dn.diags[0].code.raw == 4002);
    let hidden: Loaded = load("import b;\nfunction leak(): void { b::one().a; return; }\n", 1725)?;
    var dh: diag::DiagBuffer = diag::diagbuf_new();
    let hr: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&hidden.parsed.file:Read, &hidden.parsed.pool:Read, &hidden.lexed.names:Read, &adeps:Read, 1, "a", &dh:ReadWrite)?;
    assert(diag::diagbuf_count(&dh:Read) == 0);
    typecheck_driver::typecheck_unit(&hidden.parsed.file:Read, &hidden.parsed.pool:Read, &hr:Read, &dh:ReadWrite)?;
    assert(diag::diagbuf_count(&dh:Read) == 1 && dh.diags[0].code.raw == 5001);
    // 隐藏名义类型仍保留类型规则，不能通过推导绕过比较或匹配检查。
    let invalid: Loaded = load("import b;\nfunction eq(): bool { return b::one() == b::one(); }\nfunction branch(): void { match b::one() { _ => { return; } } }\nfunction wrapped(x: b::Wrapped, y: b::Wrapped): bool { return x == y; }\nfunction tags(): bool { return b::tag() == b::tag(); }\n", 1726)?;
    var dx: diag::DiagBuffer = diag::diagbuf_new();
    let xr: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&invalid.parsed.file:Read, &invalid.parsed.pool:Read, &invalid.lexed.names:Read, &adeps:Read, 1, "a", &dx:ReadWrite)?;
    assert(diag::diagbuf_count(&dx:Read) == 0);
    typecheck_driver::typecheck_unit(&invalid.parsed.file:Read, &invalid.parsed.pool:Read, &xr:Read, &dx:ReadWrite)?;
    assert(diag::diagbuf_count(&dx:Read) == 3);
    assert(dx.diags[0].code.raw == 5001 && dx.diags[1].code.raw == 6001 && dx.diags[2].code.raw == 5809);
    // 对照：把 C 列入直接依赖后，同一源码可以解析并类型检查。
    let reachable: Loaded = load("import c;\nfunction leak(x: c::C): void { x; return; }\n", 1724)?;
    var dr: diag::DiagBuffer = diag::diagbuf_new();
    var full: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&full:ReadWrite, &b_iface:Read)?;
    iface_load::add_binary_dependency(&full:ReadWrite, &c_inputs[0]:Read)?;
    let rr: resolve_refs::Resolution = resolve_unit::resolve_unit(&reachable.parsed.file:Read, &reachable.parsed.pool:Read, &reachable.lexed.names:Read, &full:Read, "a", &dr:ReadWrite)?;
    assert(diag::diagbuf_count(&dr:Read) == 0);
    typecheck_driver::typecheck_unit(&reachable.parsed.file:Read, &reachable.parsed.pool:Read, &rr:Read, &dr:ReadWrite)?;
    assert(diag::diagbuf_count(&dr:Read) == 0);
    return;
}
// 按导出名与导出种类查接口内的导出编号；0 表示没有匹配项。
function export_id_of(loaded: &iface::LoadedInterface:Read, name: &[u8], kind: u8): u32 {
    var i: u32 = 0;
    while i < @len(loaded.exports) as u32 {
        let item: iface::LoadedExport = loaded.exports[i];
        if item.kind == kind && item.name_len as u32 == @len(name) as u32 {
            var same: bool = true;
            var j: u32 = 0;
            while j < @len(name) as u32 {
                if item.name_off + j >= @len(loaded.name_bytes) as u32 || loaded.name_bytes[item.name_off + j] != name[j] { same = false; }
                j = j + 1;
            }
            if same { return item.export_id; }
        }
        i = i + 1;
    }
    return 0;
}
// 依赖名义类型出现在函数引用成员里时，结构体字段与枚举载荷都要能写出、加载，并在消费方按身份重映射。
function check_member_dependency_bridge(): void!AllocError {
    // ── C：只提供被引用的名义类型 ──
    let cunit: Loaded = load("export struct C { a: u32 }\nexport enum Tag { First }\n", 1740)?;
    var dc: diag::DiagBuffer = diag::diagbuf_new();
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let cr: resolve_refs::Resolution = resolve_unit::resolve_unit(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cunit.lexed.names:Read, &empty:Read, "c", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let ct: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cr:Read, &dc:ReadWrite)?;
    let cl: layout::LayoutResult = layout::layout_unit(&ct.types:Read, &ct.fields:Read, &ct.enums:Read, &dc:ReadWrite)?;
    let c_layout: iface::LayoutData = collect_layout_data(&cl:Read)?;
    let cw: iface::InterfaceResult = iface_write::write_interface(&cunit.parsed.file:Read, &cunit.parsed.pool:Read, &cr:Read, &cunit.lexed.names:Read, &ct:Read, &c_layout:Read, "c", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    var c_inputs: iface::LoadedInterface[] = [];
    @push(c_inputs, iface_load::load_interface(&cw.data.bytes[0..@len(cw.data.bytes)]:Read, &dc:ReadWrite)?)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    var c_struct_id: u32 = 0;
    var ce: u32 = 0;
    while ce < @len(c_inputs[0].exports) as u32 {
        if c_inputs[0].exports[ce].kind == 3 { c_struct_id = c_inputs[0].exports[ce].export_id; }
        ce = ce + 1;
    }
    assert(c_struct_id != 0);

    // ── B：函数引用成员引用 c::C；B 对 C 是直接依赖编号 1 ──
    var bdeps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&bdeps:ReadWrite, &c_inputs[0]:Read)?;
    let bunit: Loaded = load("import c;\nexport struct Sink { cb: &function(&c::C): void }\nexport enum Hook { Call(&function(&c::C): c::C[]) }\n", 1741)?;
    let br: resolve_refs::Resolution = resolve_unit::resolve_unit(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &bunit.lexed.names:Read, &bdeps:Read, "b", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let bt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &br:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let bl: layout::LayoutResult = layout::layout_unit(&bt.types:Read, &bt.fields:Read, &bt.enums:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let b_layout: iface::LayoutData = collect_layout_data(&bl:Read)?;
    // B 没有导出函数，因此不需要提供函数事实。
    let bfacts: u8[] = [];
    let c_order: u32[] = [0u32];
    let bw: iface::InterfaceResult = iface_write::write_interface_with_dependencies(&bunit.parsed.file:Read, &bunit.parsed.pool:Read, &br:Read, &bunit.lexed.names:Read, &bt:Read, &b_layout:Read, &bfacts[0..@len(bfacts)]:Read, "b", &c_inputs[0..1]:Read, &c_order[0..1]:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let b_iface: iface::LoadedInterface = iface_load::load_interface(&bw.data.bytes[0..@len(bw.data.bytes)]:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    assert(@len(b_iface.dependencies) == 1 && @len(b_iface.exports) == 2);
    // 依赖记录保留 C 的模块名，供消费方按名称与摘要重映射。
    assert(b_iface.dependencies[0].name_len as u32 == 1 && b_iface.name_bytes[b_iface.dependencies[0].name_off] == 99u8);
    let sink_id: u32 = export_id_of(&b_iface:Read, "Sink", 3);
    let hook_id: u32 = export_id_of(&b_iface:Read, "Hook", 2);
    assert(sink_id != 0 && hook_id != 0 && sink_id != hook_id);
    // 字段与载荷签名都应以函数引用标签开头，形参里的 c::C 保留依赖 1 与 C 的导出编号。
    var sink_field: iface::LoadedStructField = iface::LoadedStructField { struct_export_id: 0, name_off: 0, name_len: 0, field_id: 0, type_sig_off: 0, type_sig_len: 0, name_hash: 0 };
    var sf: u32 = 0;
    while sf < @len(b_iface.struct_fields) as u32 {
        if b_iface.struct_fields[sf].struct_export_id == sink_id && b_iface.struct_fields[sf].field_id == 0 { sink_field = b_iface.struct_fields[sf]; }
        sf = sf + 1;
    }
    var hook_member: iface::LoadedEnumMember = iface::LoadedEnumMember { enum_export_id: 0, name_off: 0, name_len: 0, variant_id: 0, flags: 0, payload_sig_off: 0, payload_sig_len: 0, name_hash: 0 };
    var hm: u32 = 0;
    while hm < @len(b_iface.enum_members) as u32 {
        if b_iface.enum_members[hm].enum_export_id == hook_id && b_iface.enum_members[hm].variant_id == 0 { hook_member = b_iface.enum_members[hm]; }
        hm = hm + 1;
    }
    assert(sink_field.type_sig_len > 0 && hook_member.payload_sig_len > 0);
    assert(b_iface.sig_bytes[sink_field.type_sig_off] == 9u8 && b_iface.sig_bytes[hook_member.payload_sig_off] == 9u8);
    assert(b_iface.sig_bytes[sink_field.type_sig_off + 6] == 1u8 && b_iface.sig_bytes[sink_field.type_sig_off + 7] == 0u8);

    // ── A：只导入 B；C 经 B 的类型闭包以依赖编号 2 出现 ──
    var adeps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&adeps:ReadWrite, &b_iface:Read)?;
    iface_load::add_binary_dependency(&adeps:ReadWrite, &c_inputs[0]:Read)?;
    let aunit: Loaded = load("import b;\nfunction peek(s: b::Sink): void { s.cb; return; }\nfunction hook(h: b::Hook): void { h; return; }\n", 1742)?;
    let ar: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &aunit.lexed.names:Read, &adeps:Read, 1, "a", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    assert(@len(ar.refs.fields) == 2 && @len(ar.refs.variants) == 2);
    assert(ar.refs.fields[1].dep == 2 && ar.refs.fields[1].name == 0);
    assert(ar.refs.variants[1].dep == 2 && ar.refs.variants[1].name == 0);
    // 结构体字段：成员签名根是函数引用，形参引用指向依赖 2 的 C。
    assert(ar.refs.fields[0].dep == 1 && ar.refs.fields[0].export_id == sink_id && ar.refs.fields[0].name != 0);
    let f_root: u32 = ar.refs.fields[0].root;
    let f_fn: resolve_refs::ImportType = ar.refs.fields[0].types[f_root];
    assert(f_fn.kind == 10);
    let fp: u32 = f_fn.a;
    let f_param: resolve_refs::ImportType = ar.refs.fields[0].types[fp];
    assert(f_param.kind == 7);
    let fc: u32 = f_param.b;
    let f_dep: resolve_refs::ImportType = ar.refs.fields[0].types[fc];
    assert(f_dep.kind == 3 && f_dep.a == 2 && f_dep.b == c_struct_id);
    // 枚举载荷：参数及动态数组返回位都重映射到 C；回调本体无需知道 C 的布局。
    assert(ar.refs.variants[0].dep == 1 && ar.refs.variants[0].export_id == hook_id && ar.refs.variants[0].variant == 0 && ar.refs.variants[0].known);
    let v_root: u32 = ar.refs.variants[0].root;
    let v_fn: resolve_refs::ImportType = ar.refs.variants[0].types[v_root];
    assert(v_fn.kind == 10);
    let vp: u32 = v_fn.a;
    let v_param: resolve_refs::ImportType = ar.refs.variants[0].types[vp];
    assert(v_param.kind == 7);
    let vc: u32 = v_param.b;
    let v_dep: resolve_refs::ImportType = ar.refs.variants[0].types[vc];
    assert(v_dep.kind == 3 && v_dep.a == 2 && v_dep.b == c_struct_id);
    let vr: u32 = v_fn.c as u32;
    let v_ret: resolve_refs::ImportType = ar.refs.variants[0].types[vr];
    assert(v_ret.kind == 6);
    let v_elem: u32 = v_ret.a;
    let v_result: resolve_refs::ImportType = ar.refs.variants[0].types[v_elem];
    assert(v_result.kind == 3 && v_result.a == 2 && v_result.b == c_struct_id);
    let at: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &ar:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0 && @len(at.funcs.items) == 2);

    // ── 负例一：成员签名里的依赖编号超过 B 自身的依赖条数，按接口不支持（7012）拒绝 ──
    var bad_deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&bad_deps:ReadWrite, &b_iface:Read)?;
    iface_load::add_binary_dependency(&bad_deps:ReadWrite, &c_inputs[0]:Read)?;
    bad_deps.ifaces[0].sigs[sink_field.type_sig_off + 6] = 3u8;
    var dbad: diag::DiagBuffer = diag::diagbuf_new();
    let rbad: resolve_refs::Resolution = resolve_unit::resolve_unit_with_types(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &aunit.lexed.names:Read, &bad_deps:Read, 1, "a", &dbad:ReadWrite)?;
    assert(diag::diagbuf_count(&dbad:Read) == 1 && dbad.diags[0].code.raw == 7012);
    assert(@len(rbad.refs.fields) == 1 && rbad.refs.fields[0].dep == 2 && rbad.refs.fields[0].name == 0);

    // ── 负例二：C 的摘要与 B 记录的身份不一致，无法重映射 ──
    var mismatched: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&mismatched:ReadWrite, &b_iface:Read)?;
    iface_load::add_binary_dependency(&mismatched:ReadWrite, &c_inputs[0]:Read)?;
    assert(@len(mismatched.ifaces[1].digest) == 32);
    mismatched.ifaces[1].digest[0] = mismatched.ifaces[1].digest[0] ^ 1u8;
    var dmm: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit_with_types(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &aunit.lexed.names:Read, &mismatched:Read, 1, "a", &dmm:ReadWrite)?;
    // 结构体字段与枚举载荷各失败一次。
    assert(diag::diagbuf_count(&dmm:Read) == 2 && dmm.diags[0].code.raw == 7012 && dmm.diags[1].code.raw == 7012);

    // ── 负例三：A 的依赖里缺少 C ──
    var only_b: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&only_b:ReadWrite, &b_iface:Read)?;
    var dob: diag::DiagBuffer = diag::diagbuf_new();
    resolve_unit::resolve_unit_with_types(&aunit.parsed.file:Read, &aunit.parsed.pool:Read, &aunit.lexed.names:Read, &only_b:Read, 1, "a", &dob:ReadWrite)?;
    assert(diag::diagbuf_count(&dob:Read) == 2 && dob.diags[0].code.raw == 7012 && dob.diags[1].code.raw == 7012);

    // ── 正例：外部按值字段、载荷与数组元素有布局摘要，导出后在绑定时核验 ──
    let boxunit: Loaded = load("import c;\nexport struct Box { item: c::C, items: c::C[] }\nexport enum Packet { Empty, Item(c::C) }\n", 1743)?;
    let boxr: resolve_refs::Resolution = resolve_unit::resolve_unit(&boxunit.parsed.file:Read, &boxunit.parsed.pool:Read, &boxunit.lexed.names:Read, &bdeps:Read, "b", &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let boxt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&boxunit.parsed.file:Read, &boxunit.parsed.pool:Read, &boxr:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let c_measures: layout::ImportedLayoutTable = layout::ImportedLayoutTable { items: [layout::ImportedLayout { dep: 1, export_id: c_struct_id, size: 4, align: 4 }] };
    let boxl: layout::LayoutResult = layout::layout_unit_with_imports(&boxt.types:Read, &boxt.fields:Read, &boxt.enums:Read, &c_measures:Read, &boxt.imported_enums:Read, &dc:ReadWrite)?;
    assert(diag::diagbuf_count(&dc:Read) == 0);
    let box_layout: iface::LayoutData = collect_layout_data(&boxl:Read)?;
    var boxd: diag::DiagBuffer = diag::diagbuf_new();
    let boxw: iface::InterfaceResult = iface_write::write_interface_with_dependencies(&boxunit.parsed.file:Read, &boxunit.parsed.pool:Read, &boxr:Read, &boxunit.lexed.names:Read, &boxt:Read, &box_layout:Read, &bfacts[0..@len(bfacts)]:Read, "b", &c_inputs[0..1]:Read, &c_order[0..1]:Read, &boxd:ReadWrite)?;
    assert(diag::diagbuf_count(&boxd:Read) == 0 && @len(boxw.data.bytes) > 0);
    return;
}
function check_import_arena(deps: &resolve_refs::DependencySet:Read): void!AllocError {
    var user: Loaded = load("import dep;\nfunction f(): u32 { return dep::run(1u32); }\n", 1760)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let baseline: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, deps, "user", &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 0 && @len(baseline.bridges.items) == 1);
    let end: u32 = @len(deps.ifaces[0].names) as u32;
    assert(end != 0);
    var i: u32 = 0;
    while i < end { @push(user.lexed.names.arena.data, deps.ifaces[0].names[i])?; i = i + 1; }
    let rejected: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, deps, "user", &diags:ReadWrite)?;
    // rejection_spec: E7013 spec/lang/symbol.md#S-13
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7013 && @len(rejected.refs.items) == 0 && @len(rejected.bridges.items) == 0);
    return;
}
function main(): void {
    check_dependency_order()?;
    check_import_array_comparisons()?;
    check_nested_function_reference()?;
    check_match_import_identity()?;
    check_slot_bounds()?;
    check_function_depth()?;
    check_error_roundtrip()?;
    check_document_dependencies()?;
    check_direct_signatures()?;
    // ── 依赖单元：导出 struct / enum / function ──
    let dep: Loaded = load("export struct P { a: u32 }\nexport enum E { A }\nexport function run(x: u32): u32 { return x; }\nexport function take(p: P): P { return p; }\nexport function take_array(p: [P; 1]): u32 { return p[0].a; }\nexport function composite(x: [u8; 2], y: u16, flag: bool): u16 { if flag { return y; } return x[0] as u16; }\n", 1000)?;
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let empty_deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let dep_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep.lexed.names:Read, &empty_deps:Read, "dep", &d1:ReadWrite)?;
    let dep_tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep_resolution:Read, &d1:ReadWrite)?;
    let dep_layout: layout::LayoutResult = layout::layout_unit(&dep_tc.types:Read, &dep_tc.fields:Read, &dep_tc.enums:Read, &d1:ReadWrite)?;
    var sizes: u64[] = [];
    var aligns: u8[] = [];
    var known: bool[] = [];
    var i: u32 = 0;
    while i < @len(dep_layout.table.items) as u32 {
        @push(sizes, dep_layout.table.items[i].size)?;
        @push(aligns, dep_layout.table.items[i].align)?;
        @push(known, dep_layout.table.items[i].known)?;
        i = i + 1;
    }
    let layout_data: iface::LayoutData = iface::LayoutData { sizes: sizes, aligns: aligns, known: known };
    let built: iface::InterfaceResult = iface_write::write_interface(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep_resolution:Read, &dep.lexed.names:Read, &dep_tc:Read, &layout_data:Read, "dep", &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    let loaded_iface: iface::LoadedInterface = iface_load::load_interface(&built.data.bytes[0..@len(built.data.bytes)]:Read, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&deps:ReadWrite, &loaded_iface:Read)?;

    check_import_arena(&deps:Read)?;
    check_dependency_nominal(&built.data.bytes[0..@len(built.data.bytes)]:Read)?;
    check_typeonly_dependency()?;
    check_member_dependency_bridge()?;

    // ── 导入方经二进制接口 bridge 解析 dep::run / dep::E / dep::P ──
    let user: Loaded = load("import dep;\nfunction f(): u32 { return dep::run(1); }\nfunction g(): dep::P { return dep::P { a: 1 }; }\n", 1001)?;
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let user_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    assert(@len(user_resolution.refs.items) > 0);
    assert(user_resolution.result.tables.defs[0].import_dependency == 1);
    var saw_import_ref: bool = false;
    i = 0;
    while i < @len(user_resolution.refs.items) as u32 {
        if user_resolution.refs.items[i].kind == 2 { saw_import_ref = true; }
        i = i + 1;
    }
    assert(saw_import_ref);

    // ── 跨单元调用一致性：已解码的导入签名参与实参类型检查 ──
    assert(@len(user_resolution.refs.imports) == 4);
    let user_tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user_resolution:Read, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    assert(@len(user_tc.funcs.items) == 2);
    // f 的返回类型必须是导入签名解码出的 u32，而不是占位 0。
    assert(user_tc.funcs.items[0].ret != 0);
    assert(user_tc.types.entries[user_tc.funcs.items[0].ret - 1].kind == 1);
    assert(user_tc.types.entries[user_tc.funcs.items[0].ret - 1].builtin == 4099);

    // 不提供依赖身份表的接口入口必须拒绝导入类型。
    check_public_import("import dep; export function pass(x: dep::P): void { @drop(x); return; }\n", &deps:Read)?;
    check_public_import("import dep; export function pass(x: [dep::P; 1]): void { @drop(x); return; }\n", &deps:Read)?;

    // 错误实参类型必须被拒绝，并报 R-1（5001）。
    let bad: Loaded = load("import dep;\nfunction f(): u32 { return dep::run(true); }\n", 1002)?;
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let bad_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&bad.parsed.file:Read, &bad.parsed.pool:Read, &bad.lexed.names:Read, &deps:Read, "", &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 0);
    typecheck_driver::typecheck_unit(&bad.parsed.file:Read, &bad.parsed.pool:Read, &bad_resolution:Read, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 1);
    assert(d3.diags[0].code.raw == 5001);

    // 错误实参个数同样被拒绝。
    let arity: Loaded = load("import dep;\nfunction f(): u32 { return dep::run(); }\n", 1003)?;
