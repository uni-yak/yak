    let rvoid: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dvoid:ReadWrite)?;
    assert(diag::diagbuf_count(&dvoid:Read) == 1 && dvoid.diags[0].code.raw == 7012 && @len(rvoid.refs.imports) == 3);
    // 检查 void 与失败载体的位置，以及返回和引用的合法例外。
    let void_sigs: u8[][] = [
