    assert(sid == eid);
    @push(deps.ifaces, enums)?;
    check_import_enum_order(&deps:Read, "import choices; function f(a: choices::E, b: choices::E): void { @drop(a < b); @drop(a <= b); @drop(a > b); @drop(a >= b); @drop(a == b); }\n")?;
    check_import_comparisons(&deps:Read, "import records; import choices; function f(a: records::S, b: records::S, x: choices::E, y: choices::E): void { @drop(a == b); @drop(a != b); @drop(x == y); }\n")?;
    let payload: Loaded = load("import records; enum E { A(records::S), B } function f(a: E, b: E): void { @drop(a == b); @drop(a != b); }\n", 1328)?;
