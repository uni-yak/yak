    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(builtin_sig) as u32;
    k = 0;
    while k < @len(builtin_sig) as u32 { @push(deps.ifaces[0].sigs, builtin_sig[k])?; k = k + 1; }
    let builtin_pos: u32 = deps.ifaces[0].exports[index].sig_off + 5;
    let invalid_builtins: u16[] = [0u16, 4096u16, 4114u16, 20481u16];
    k = 0;
    while k < @len(invalid_builtins) as u32 {
        deps.ifaces[0].sigs[builtin_pos] = (invalid_builtins[k] & 255u16) as u8;
        deps.ifaces[0].sigs[builtin_pos + 1] = (invalid_builtins[k] >> 8) as u8;
        var di: diag::DiagBuffer = diag::diagbuf_new();
        let ri: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &di:ReadWrite)?;
        assert(diag::diagbuf_count(&di:Read) == 1 && di.diags[0].code.raw == 7012);
        assert(@len(ri.refs.imports) == 3);
        k = k + 1;
    }
    // 仅激活 base 类型编号；分配错误不得用作普通参数。
    k = 4097;
