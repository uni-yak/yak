    let payload_checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&payload.parsed.file:Read, &payload.parsed.pool:Read, &payload_refs:Read, &payload_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&payload_diags:Read) == 2 && payload_diags.diags[0].code.raw == 5809 && payload_diags.diags[1].code.raw == 5809);
    let input: Loaded = load("import records; import choices; function f(s: records::S, e: choices::E): void { match s { _ => { return; } } match e { _ => { return; } } }\n", 1325)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &input.lexed.names:Read, &deps:Read, "user", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &resolved:Read, &diags:ReadWrite)?;
    assert(@len(resolved.refs.structs) == 1 && @len(resolved.refs.enums) == 1);
    assert(resolved.refs.structs[0].dep != resolved.refs.enums[0].dep && resolved.refs.structs[0].export_id == resolved.refs.enums[0].export_id);
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 6001);
    return;
}
// 未导入接口的函数签名不应污染当前单元，直接导入仍须检查。
function check_direct_signatures(): void!AllocError {
    var deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var other: resolve_refs::Iface = resolve_refs::iface_new("other")?;
    let other_id: u32 = resolve_refs::iface_add_export(&other:ReadWrite, "run", 1)?;
    assert(other_id == 1);
    @push(other.sigs, 255u8)?;
    other.exports[0].sig_len = 1;
    @push(deps.ifaces, other)?;
    var dep: resolve_refs::Iface = resolve_refs::iface_new("dep")?;
    let dep_id: u32 = resolve_refs::iface_add_export(&dep:ReadWrite, "run", 1)?;
    assert(dep_id == 1);
    let signature: u8[] = [0u8, 0u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8];
    var i: u32 = 0;
    while i < @len(signature) as u32 { @push(dep.sigs, signature[i])?; i = i + 1; }
    dep.exports[0].sig_len = @len(signature) as u32;
    @push(deps.ifaces, dep)?;
    let source: Loaded = load("import dep; function f(): void { dep::run(); }\n", 1200)?;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let result: resolve_refs::Resolution = resolve_unit::resolve_unit(&source.parsed.file:Read, &source.parsed.pool:Read, &source.lexed.names:Read, &deps:Read, "user", &d:ReadWrite)?;
    assert(diag::diagbuf_count(&d:Read) == 0 && @len(result.refs.imports) == 1);
    assert(result.refs.imports[0].dep == 2 && result.refs.imports[0].export_id == 1);
    let bad: Loaded = load("import other; function f(): void { other::run(); }\n", 1201)?;
    var bd: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: resolve_refs::Resolution = resolve_unit::resolve_unit(&bad.parsed.file:Read, &bad.parsed.pool:Read, &bad.lexed.names:Read, &deps:Read, "user", &bd:ReadWrite)?;
    assert(diag::diagbuf_count(&bd:Read) == 1 && bd.diags[0].code.raw == 7012 && @len(rejected.refs.imports) == 0);
    // 内存依赖中的零导出编号不能建立有效桥接。
    deps.ifaces[1].exports[0].export_id = 0;
    var zd: diag::DiagBuffer = diag::diagbuf_new();
    let zr: resolve_refs::Resolution = resolve_unit::resolve_unit(&source.parsed.file:Read, &source.parsed.pool:Read, &source.lexed.names:Read, &deps:Read, "user", &zd:ReadWrite)?;
    assert(zd.has_error && @len(zr.bridges.items) == 0);
    deps.ifaces[1].exports[0].export_id = 1;
    // 重复导入虽然本身无效，也不得重复加载同一接口签名。
    let repeated: Loaded = load("import dep; import dep; function f(): void { dep::run(); }\n", 1202)?;
    var rd: diag::DiagBuffer = diag::diagbuf_new();
    let rr: resolve_refs::Resolution = resolve_unit::resolve_unit(&repeated.parsed.file:Read, &repeated.parsed.pool:Read, &repeated.lexed.names:Read, &deps:Read, "user", &rd:ReadWrite)?;
    assert(diag::diagbuf_count(&rd:Read) > 0 && @len(rr.refs.imports) == 1);
    // 模块身份歧义时，两个畸形接口均不得被选中解码。
    var duplicate: resolve_refs::Iface = resolve_refs::iface_new("other")?;
    let duplicate_id: u32 = resolve_refs::iface_add_export(&duplicate:ReadWrite, "run", 1)?;
    assert(duplicate_id == 1);
    @push(duplicate.sigs, 255u8)?;
    duplicate.exports[0].sig_len = 1;
    @push(deps.ifaces, duplicate)?;
    var ad: diag::DiagBuffer = diag::diagbuf_new();
    let ar: resolve_refs::Resolution = resolve_unit::resolve_unit(&bad.parsed.file:Read, &bad.parsed.pool:Read, &bad.lexed.names:Read, &deps:Read, "user", &ad:ReadWrite)?;
    assert(@len(ar.refs.imports) == 0 && diag::diagbuf_count(&ad:Read) > 0);
    var j: u32 = 0;
    while j < diag::diagbuf_count(&ad:Read) { assert(ad.diags[j].code.raw != 7012); j = j + 1; }
    assert(ad.diags[0].code.raw == 4003);
    return;
}
// 参数与返回值各自从根节点计深，超限保留资源诊断。
function check_function_depth(): void!AllocError {
    let exports: resolve_refs::IfaceExport[] = [];
    var test: u32 = 0;
    while test < 3 {
        var bytes: u8[] = [0u8, 0u8, 2u8, 0u8];
        var part: u32 = 0;
        while part < 3 {
            var layers: u32 = 63;
            if test == 1 && part == 1 { layers = 64; }
            if test == 2 && part == 2 { layers = 64; }
            var level: u32 = 0;
            while level < layers { @push(bytes, 6u8)?; level = level + 1; }
            @push(bytes, 1u8)?; @push(bytes, 1u8)?; @push(bytes, 16u8)?; @push(bytes, 0u8)?; @push(bytes, 0u8)?;
            part = part + 1;
        }
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        let valid: bool = resolve_refs::valid_function_signature(&bytes[0..@len(bytes)]:Read, &exports[0..@len(exports)]:Read, &diags:ReadWrite)?;
        if test == 0 { assert(valid && !diags.has_error); }
        else { assert(!valid && diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 9001); }
        test = test + 1;
    }
    return;
}
// 手工传入的可错槽不得越界或通过截断计数绕过检查。
function check_slot_bounds(): void!AllocError {
    let exports: resolve_refs::IfaceExport[] = [];
    var slots: resolve_refs::ImportType[] = [resolve_refs::ImportType { kind: 0, a: 0, b: 0, c: 0 }, resolve_refs::ImportType { kind: 1, a: 4108, b: 0, c: 0 }, resolve_refs::ImportType { kind: 9, a: 0, b: 1, c: 1 }];
    assert(resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    slots[2].a = 3;
    assert(!resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    slots[2].a = 0; slots[2].b = 4294967295u32;
    assert(!resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    slots[2].b = 2; slots[2].c = 2;
    assert(!resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    slots[2].b = 1; slots[2].c = 0;
    assert(!resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    slots[2].c = 4294967297u64;
    assert(!resolve_refs::valid_import_slots(&slots[0..@len(slots)]:Read, &exports[0..@len(exports)]:Read)?);
    return;
}
