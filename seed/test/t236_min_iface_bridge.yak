    assert(diag::diagbuf_count(&d4:Read) == 1);
    assert(d4.diags[0].code.raw == 5001);
    // 复合参数的子槽不能被误当成参数根，后续参数必须保持各自的类型。
    let composite: Loaded = load("import dep; function f(): u16 { return dep::composite([1u8, 2u8], 3u16, true); }\n", 1004)?;
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: resolve_refs::Resolution = resolve_unit::resolve_unit(&composite.parsed.file:Read, &composite.parsed.pool:Read, &composite.lexed.names:Read, &deps:Read, "", &d5:ReadWrite)?;
    typecheck_driver::typecheck_unit(&composite.parsed.file:Read, &composite.parsed.pool:Read, &r5:Read, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 0);
    let bad_composite: Loaded = load("import dep; function f(): u16 { return dep::composite([1u8, 2u8], true, 3u16); }\n", 1005)?;
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    let r6: resolve_refs::Resolution = resolve_unit::resolve_unit(&bad_composite.parsed.file:Read, &bad_composite.parsed.pool:Read, &bad_composite.lexed.names:Read, &deps:Read, "", &d6:ReadWrite)?;
    typecheck_driver::typecheck_unit(&bad_composite.parsed.file:Read, &bad_composite.parsed.pool:Read, &r6:Read, &d6:ReadWrite)?;
    assert(diag::diagbuf_count(&d6:Read) == 2);
    assert(d6.diags[0].code.raw == 5001 && d6.diags[1].code.raw == 5001);

    // 导出方的本地名义类型必须对应导入方的同一依赖及导出编号。
    let nominal: Loaded = load("import dep; function f(): dep::P { return dep::take(dep::P { a: 1 }); }\n", 1006)?;
    var dn: diag::DiagBuffer = diag::diagbuf_new();
