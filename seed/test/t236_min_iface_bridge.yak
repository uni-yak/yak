        [0u8, 0u8, 1u8, 0u8, 9u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 6u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 7u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 7u8, 0u8, 11u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 11u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 8u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 11u8, 11u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 9u8, 1u8, 0u8, 7u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(void_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(void_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(void_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, void_sigs[k][v])?; v = v + 1; }
        var vd: diag::DiagBuffer = diag::diagbuf_new();
        let vr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &vd:ReadWrite)?;
        if k == 0 || k == 3 || k == 7 || k == 8 { assert(diag::diagbuf_count(&vd:Read) == 1 && vd.diags[0].code.raw == 7012 && @len(vr.refs.imports) == 3); }
        else { assert(diag::diagbuf_count(&vd:Read) == 0 && @len(vr.refs.imports) == 4); }
        k = k + 1;
    }
    // 每个顶层参数和返回值独立计深，超限时不保存导入签名。
    var depth_case: u32 = 0;
    while depth_case < 3 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        @push(deps.ifaces[0].sigs, 0)?; @push(deps.ifaces[0].sigs, 0)?;
        @push(deps.ifaces[0].sigs, 2)?; @push(deps.ifaces[0].sigs, 0)?;
        var part: u32 = 0;
        while part < 3 {
            var layers: u32 = 63;
            if depth_case == 1 && part == 1 { layers = 64; }
            if depth_case == 2 && part == 2 { layers = 64; }
            var level: u32 = 0;
            while level < layers { @push(deps.ifaces[0].sigs, 6)?; level = level + 1; }
            @push(deps.ifaces[0].sigs, 1)?; @push(deps.ifaces[0].sigs, 1)?; @push(deps.ifaces[0].sigs, 16)?; @push(deps.ifaces[0].sigs, 0)?; @push(deps.ifaces[0].sigs, 0)?;
            part = part + 1;
        }
        deps.ifaces[0].exports[index].sig_len = @len(deps.ifaces[0].sigs) as u32 - deps.ifaces[0].exports[index].sig_off;
        var depth_diags: diag::DiagBuffer = diag::diagbuf_new();
        let depth_result: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &depth_diags:ReadWrite)?;
        if depth_case == 0 { assert(diag::diagbuf_count(&depth_diags:Read) == 0 && @len(depth_result.refs.imports) == 4); }
        else { assert(diag::diagbuf_count(&depth_diags:Read) == 1 && depth_diags.diags[0].code.raw == 9001 && @len(depth_result.refs.imports) == 3); }
        depth_case = depth_case + 1;
    }
    // 无依赖身份映射时，无论编号如何都必须拒绝依赖名义类型。
    let dependency_sigs: u8[][] = [
        [0u8, 0u8, 1u8, 0u8, 3u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 3u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 6u8, 3u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 3u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 3u8, 1u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(dependency_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(dependency_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(dependency_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, dependency_sigs[k][v])?; v = v + 1; }
        var dd: diag::DiagBuffer = diag::diagbuf_new();
        let dr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dd:ReadWrite)?;
        assert(diag::diagbuf_count(&dd:Read) == 1 && dd.diags[0].code.raw == 7012 && @len(dr.refs.imports) == 3);
        k = k + 1;
    }
    // 依赖名义记录截断时不能从下一个签名借用字节。
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    k = 0;
    while k < @len(dependency_sigs[4]) as u32 { @push(deps.ifaces[0].sigs, dependency_sigs[4][k])?; k = k + 1; }
    k = 0;
    while k < 8 {
        deps.ifaces[0].exports[index].sig_len = 5 + k;
        var td: diag::DiagBuffer = diag::diagbuf_new();
        let tr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &td:ReadWrite)?;
        assert(diag::diagbuf_count(&td:Read) == 1 && td.diags[0].code.raw == 7012 && @len(tr.refs.imports) == 3);
        k = k + 1;
    }
    // 定长数组长度在任意嵌套位置均须非零。
    let fixed_sigs: u8[][] = [
        [0u8, 0u8, 1u8, 0u8, 5u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 6u8, 5u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 5u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 6u8, 5u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 6u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(fixed_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(fixed_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(fixed_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, fixed_sigs[k][v])?; v = v + 1; }
        var fd: diag::DiagBuffer = diag::diagbuf_new();
        let fr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &fd:ReadWrite)?;
        if k < 2 { assert(diag::diagbuf_count(&fd:Read) == 1 && fd.diags[0].code.raw == 7012 && @len(fr.refs.imports) == 3); }
        else { assert(diag::diagbuf_count(&fd:Read) == 0 && @len(fr.refs.imports) == 4); }
        k = k + 1;
    }
    // 记录边界截断数组长度时，不能借用签名池后续字节补全。
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    k = 0;
    while k < @len(fixed_sigs[2]) as u32 { @push(deps.ifaces[0].sigs, fixed_sigs[2][k])?; k = k + 1; }
    k = 0;
    while k < 8 {
        deps.ifaces[0].exports[index].sig_len = 5 + k;
        var td: diag::DiagBuffer = diag::diagbuf_new();
        let tr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &td:ReadWrite)?;
        assert(diag::diagbuf_count(&td:Read) == 1 && td.diags[0].code.raw == 7012 && @len(tr.refs.imports) == 3);
        k = k + 1;
    }
    // 可空载荷不能是函数引用或可空类型，失败成功位也不能是函数引用。
    let payload_sigs: u8[][] = [
        [0u8, 0u8, 0u8, 0u8, 11u8, 9u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 6u8, 11u8, 9u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 11u8, 11u8, 1u8, 3u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 7u8, 0u8, 11u8, 11u8, 1u8, 3u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 9u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 11u8, 1u8, 3u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 11u8, 10u8, 1u8, 3u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 11u8, 6u8, 1u8, 3u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(payload_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(payload_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(payload_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, payload_sigs[k][v])?; v = v + 1; }
        var pd: diag::DiagBuffer = diag::diagbuf_new();
        let pr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &pd:ReadWrite)?;
        if k < 5 { assert(diag::diagbuf_count(&pd:Read) == 1 && pd.diags[0].code.raw == 7012 && @len(pr.refs.imports) == 3); }
        else { assert(diag::diagbuf_count(&pd:Read) == 0 && @len(pr.refs.imports) == 4); }
        k = k + 1;
    }
    // 失败载体错误位只能包含枚举，且本地结构体不能冒充枚举。
    let error_sigs: u8[][] = [
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 6u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(error_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(error_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(error_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, error_sigs[k][v])?; v = v + 1; }
        if k == 2 || k == 3 {
            var e: u32 = 0;
            while e < @len(deps.ifaces[0].exports) as u32 {
                if (k == 2 && deps.ifaces[0].exports[e].kind == 3) || (k == 3 && deps.ifaces[0].exports[e].kind == 2) {
                    deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 15] = deps.ifaces[0].exports[e].export_id as u8;
                }
                e = e + 1;
            }
        }
        var ed: diag::DiagBuffer = diag::diagbuf_new();
        let er: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &ed:ReadWrite)?;
        if k < 3 { assert(diag::diagbuf_count(&ed:Read) == 1 && ed.diags[0].code.raw == 7012 && @len(er.refs.imports) == 3); }
        else { assert(diag::diagbuf_count(&ed:Read) == 0 && @len(er.refs.imports) == 4); }
        k = k + 1;
    }
    // 后续成员也必须逐项检查，不能只验证第一个错误类型。
    let pair_sig: u8[] = [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(pair_sig) as u32;
    k = 0;
    while k < @len(pair_sig) as u32 { @push(deps.ifaces[0].sigs, pair_sig[k])?; k = k + 1; }
    k = 0;
    while k < @len(deps.ifaces[0].exports) as u32 {
        let target: resolve_refs::IfaceExport = deps.ifaces[0].exports[k];
        if target.kind == 2 || target.kind == 3 {
            deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 20] = target.export_id as u8;
            var pd: diag::DiagBuffer = diag::diagbuf_new();
            let pr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &pd:ReadWrite)?;
            if target.kind == 3 { assert(diag::diagbuf_count(&pd:Read) == 1 && pd.diags[0].code.raw == 7012 && @len(pr.refs.imports) == 3); }
            else { assert(diag::diagbuf_count(&pd:Read) == 0 && @len(pr.refs.imports) == 4); }
        }
        k = k + 1;
    }
    // 本地枚举按规范身份键排序；反序与重复均拒绝。
    let long_id: u32 = resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "AA", 2)?;
    let short_id: u32 = resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "B", 2)?;
    // 接口签名的成功枚举不得与错误成员重叠。
    let overlap_sigs: u8[][] = [
        [0u8, 0u8, 0u8, 0u8, 10u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8]
    ];
    var o: u32 = 0;
    while o < @len(overlap_sigs) as u32 {
        let start: u32 = @len(deps.ifaces[0].sigs) as u32;
        var b: u32 = 0;
        while b < @len(overlap_sigs[o]) as u32 { @push(deps.ifaces[0].sigs, overlap_sigs[o][b])?; b = b + 1; }
        deps.ifaces[0].exports[index].sig_off = start;
        deps.ifaces[0].exports[index].sig_len = @len(overlap_sigs[o]) as u32;
        if o == 0 { deps.ifaces[0].sigs[start + 6] = long_id as u8; deps.ifaces[0].sigs[start + 17] = long_id as u8; }
        var overlap: diag::DiagBuffer = diag::diagbuf_new();
        let bad_overlap: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &overlap:ReadWrite)?;
        assert(diag::diagbuf_count(&overlap:Read) == 1 && overlap.diags[0].code.raw == 7012 && @len(bad_overlap.refs.imports) == 3);
        if o == 0 {
            deps.ifaces[0].sigs[start + 17] = short_id as u8;
            var separate: diag::DiagBuffer = diag::diagbuf_new();
            let good_separate: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &separate:ReadWrite)?;
            assert(diag::diagbuf_count(&separate:Read) == 0 && @len(good_separate.refs.imports) == 4);
        }
        o = o + 1;
    }
    let order_sig: u8[] = [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(order_sig) as u32;
    k = 0;
    while k < @len(order_sig) as u32 { @push(deps.ifaces[0].sigs, order_sig[k])?; k = k + 1; }
    k = 0;
    while k < 3 {
        var first_id: u32 = long_id;
        var second_id: u32 = short_id;
        if k == 0 { first_id = short_id; }
        if k == 0 || k == 2 { second_id = long_id; }
        deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 15] = first_id as u8;
        deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 22] = second_id as u8;
        var od: diag::DiagBuffer = diag::diagbuf_new();
        let orr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &od:ReadWrite)?;
        if k == 0 { assert(diag::diagbuf_count(&od:Read) == 0); assert(@len(orr.refs.imports) == 4); }
        else { assert(diag::diagbuf_count(&od:Read) == 1 && od.diags[0].code.raw == 7012 && @len(orr.refs.imports) == 3); }
        k = k + 1;
    }
    // 非相邻重复仍须拒绝；固有类型与本地枚举身份不能混淆。
    let triple_sig: u8[] = [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 3u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(triple_sig) as u32;
    k = 0;
    while k < @len(triple_sig) as u32 { @push(deps.ifaces[0].sigs, triple_sig[k])?; k = k + 1; }
    deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 20] = short_id as u8;
    k = 0;
    while k < 2 {
        var last: u32 = long_id;
        if k == 1 { last = short_id; }
        deps.ifaces[0].sigs[deps.ifaces[0].exports[index].sig_off + 27] = last as u8;
        var td: diag::DiagBuffer = diag::diagbuf_new();
        let tr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &td:ReadWrite)?;
        if k == 0 { assert(diag::diagbuf_count(&td:Read) == 0 && @len(tr.refs.imports) == 4); }
        else { assert(diag::diagbuf_count(&td:Read) == 1 && td.diags[0].code.raw == 7012 && @len(tr.refs.imports) == 3); }
        k = k + 1;
    }
    // 不同堆长度与重复位置均须检查，且不能误拒不同成员。
    var ids: u32[] = [short_id];
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "C", 2)?)?;
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "D", 2)?)?;
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "F", 2)?)?;
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "G", 2)?)?;
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "H", 2)?)?;
    @push(ids, long_id)?;
    @push(ids, resolve_refs::iface_add_export(&deps.ifaces[0]:ReadWrite, "E2", 2)?)?;
    var count: u32 = 1;
    while count <= @len(ids) as u32 {
        let start: u32 = @len(deps.ifaces[0].sigs) as u32;
        let prefix: u8[] = [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
        var v: u32 = 0;
        while v < @len(prefix) as u32 { @push(deps.ifaces[0].sigs, prefix[v])?; v = v + 1; }
        deps.ifaces[0].sigs[start + 10] = count as u8;
        v = 0;
        while v < count {
            @push(deps.ifaces[0].sigs, 2u8)?;
            @push(deps.ifaces[0].sigs, ids[v] as u8)?;
            @push(deps.ifaces[0].sigs, 0u8)?; @push(deps.ifaces[0].sigs, 0u8)?; @push(deps.ifaces[0].sigs, 0u8)?;
            @push(deps.ifaces[0].sigs, 0u8)?; @push(deps.ifaces[0].sigs, 0u8)?;
            v = v + 1;
        }
        deps.ifaces[0].exports[index].sig_off = start;
        deps.ifaces[0].exports[index].sig_len = 14 + count * 7;
        var distinct: diag::DiagBuffer = diag::diagbuf_new();
        let good: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &distinct:ReadWrite)?;
        assert(diag::diagbuf_count(&distinct:Read) == 0 && @len(good.refs.imports) == 4);
        v = 0;
        while v + 1 < count {
            deps.ifaces[0].sigs[start + 15 + (count - 1) * 7] = ids[v] as u8;
            var duplicate: diag::DiagBuffer = diag::diagbuf_new();
            let bad: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &duplicate:ReadWrite)?;
            assert(diag::diagbuf_count(&duplicate:Read) == 1 && duplicate.diags[0].code.raw == 7012 && @len(bad.refs.imports) == 3);
            v = v + 1;
        }
        count = count + 1;
    }
    // 同一个固有或依赖引用连续出现时也不能重复登记。
    let duplicate_sigs: u8[][] = [
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 1u8, 11u8, 16u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 3u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 3u8, 1u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(duplicate_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(duplicate_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(duplicate_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, duplicate_sigs[k][v])?; v = v + 1; }
        var dd: diag::DiagBuffer = diag::diagbuf_new();
        let dr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dd:ReadWrite)?;
        assert(diag::diagbuf_count(&dd:Read) == 1 && dd.diags[0].code.raw == 7012 && @len(dr.refs.imports) == 3);
        k = k + 1;
    }
    // 普通引用与切片仅允许作为参数根节点，函数引用参数必须符合引用类型产生式。
    let view_sigs: u8[][] = [
        [0u8, 0u8, 0u8, 0u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 8u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 6u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 7u8, 0u8, 8u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 10u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 9u8, 1u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 9u8, 0u8, 0u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 0u8, 0u8, 9u8, 0u8, 0u8, 9u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 2u8, 0u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 8u8, 1u8, 1u8, 2u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8],
        [0u8, 0u8, 1u8, 0u8, 9u8, 1u8, 0u8, 8u8, 2u8, 1u8, 1u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8]
    ];
    k = 0;
    while k < @len(view_sigs) as u32 {
        deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
        deps.ifaces[0].exports[index].sig_len = @len(view_sigs[k]) as u32;
        var v: u32 = 0;
        while v < @len(view_sigs[k]) as u32 { @push(deps.ifaces[0].sigs, view_sigs[k][v])?; v = v + 1; }
        var vd: diag::DiagBuffer = diag::diagbuf_new();
        let vr: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &vd:ReadWrite)?;
        if k < 7 { assert(diag::diagbuf_count(&vd:Read) == 1 && vd.diags[0].code.raw == 7012 && @len(vr.refs.imports) == 3); }
        else { assert(diag::diagbuf_count(&vd:Read) == 0 && @len(vr.refs.imports) == 4); }
        k = k + 1;
    }
    // 复合类型内部的非法名义目标也不能形成签名。
    let nested_nominal: u8[] = [0u8, 0u8, 1u8, 0u8, 5u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8];
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(nested_nominal) as u32;
    k = 0;
    while k < @len(nested_nominal) as u32 { @push(deps.ifaces[0].sigs, nested_nominal[k])?; k = k + 1; }
    var dn_nested: diag::DiagBuffer = diag::diagbuf_new();
    let rn_nested: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dn_nested:ReadWrite)?;
    assert(diag::diagbuf_count(&dn_nested:Read) == 1 && dn_nested.diags[0].code.raw == 7012);
    assert(@len(rn_nested.refs.imports) == 3);

    // 函数引用的两个复合形参根槽必须连续，且各自指向正确元素。
    let nested: u8[] = [0u8, 0u8, 1u8, 0u8, 9u8, 2u8, 0u8, 7u8, 0u8, 1u8, 1u8, 16u8, 0u8, 0u8, 7u8, 0u8, 1u8, 2u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8, 1u8, 11u8, 16u8, 0u8, 0u8];
    deps.ifaces[0].exports[index].sig_off = @len(deps.ifaces[0].sigs) as u32;
    deps.ifaces[0].exports[index].sig_len = @len(nested) as u32;
    var n: u32 = 0;
    while n < @len(nested) as u32 { @push(deps.ifaces[0].sigs, nested[n])?; n = n + 1; }
    var d9: diag::DiagBuffer = diag::diagbuf_new();
    let r9: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &d9:ReadWrite)?;
    assert(diag::diagbuf_count(&d9:Read) == 0);
    var sig_index: u32 = 0;
    while r9.refs.imports[sig_index].export_id != deps.ifaces[0].exports[index].export_id { sig_index = sig_index + 1; }
    let nested_sig: &resolve_refs::ImportSignature:Read = &r9.refs.imports[sig_index]:Read;
    let fnslot: resolve_refs::ImportType = nested_sig.types[nested_sig.param_start];
    assert(fnslot.kind == 10 && fnslot.b == 2);
    let first: resolve_refs::ImportType = nested_sig.types[fnslot.a];
    let second: resolve_refs::ImportType = nested_sig.types[fnslot.a + 1];
    assert(first.kind == 7 && second.kind == 7);
    assert(nested_sig.types[first.b].a == 4097 && nested_sig.types[second.b].a == 4098);

    // 零泛型元数下类型参数标签不能冒充引用标签。
    let nested_pos: u32 = deps.ifaces[0].exports[index].sig_off + 7;
    deps.ifaces[0].sigs[nested_pos] = 4;
    var d10: diag::DiagBuffer = diag::diagbuf_new();
    let r10: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &d10:ReadWrite)?;
    assert(diag::diagbuf_count(&d10:Read) == 1 && d10.diags[0].code.raw == 7012);
    assert(@len(r10.refs.imports) == 3);
    return;
}
