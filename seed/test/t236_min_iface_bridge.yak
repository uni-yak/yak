        if k != 4107 {
            deps.ifaces[0].sigs[builtin_pos] = (k & 255) as u8;
            deps.ifaces[0].sigs[builtin_pos + 1] = (k >> 8) as u8;
            var dv: diag::DiagBuffer = diag::diagbuf_new();
            let rv: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dv:ReadWrite)?;
            if k >= 4108 { assert(diag::diagbuf_count(&dv:Read) == 1 && dv.diags[0].code.raw == 7012 && @len(rv.refs.imports) == 3); }
            else { assert(diag::diagbuf_count(&dv:Read) == 0 && @len(rv.refs.imports) == 4); }
        }
