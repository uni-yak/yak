    var full_return_diags: diag::DiagBuffer = diag::diagbuf_new();
    let full_return: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &full_return_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&full_return_diags:Read) == 1 && full_return_diags.diags[0].code.raw == 7012 && @len(full_return.refs.imports) == 3);
    deps.ifaces[0].sigs[builtin_pos + 5] = 11;
