            let rn_ok: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &deps:Read, "", &dn_ok:ReadWrite)?;
            assert(diag::diagbuf_count(&dn_ok:Read) == 0 && @len(rn_ok.refs.imports) == 4);
        }
