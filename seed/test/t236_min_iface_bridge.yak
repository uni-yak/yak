    typecheck_driver::typecheck_unit(&nominal.parsed.file:Read, &nominal.parsed.pool:Read, &rn:Read, &dn:ReadWrite)?;
    assert(diag::diagbuf_count(&dn:Read) == 0);
    let bad_nominal: Loaded = load("import dep; function f(): dep::P { var x: u32 = 1; return dep::take(x); }\n", 1007)?;
    var db: diag::DiagBuffer = diag::diagbuf_new();
