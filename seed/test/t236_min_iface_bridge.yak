foreign assert(cond: bool): void;
struct Loaded { parsed: parse::ParseResult, lexed: lex::LexResult }
function load(src: &[u8], file: u16): Loaded!AllocError {
    let r: lex::LexResult = lex::lex_scan(src, file)?;
    assert(@len(r.diagnostics) == 0);
    let p: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    assert(@len(p.diagnostics) == 0);
    return Loaded { parsed: p, lexed: r };
}
function check_import_comparisons(deps: &resolve_refs::DependencySet:Read, src: &[u8]:Read): void!AllocError {
    let input: Loaded = load(src, 1326)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &input.lexed.names:Read, deps, "user", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &resolved:Read, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 2);
    assert(diags.diags[0].code.raw == 5001 && diags.diags[1].code.raw == 5001);
    return;
}
function check_import_enum_order(deps: &resolve_refs::DependencySet:Read, src: &[u8]:Read): void!AllocError {
    let input: Loaded = load(src, 1327)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &input.lexed.names:Read, deps, "user", &diags:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&input.parsed.file:Read, &input.parsed.pool:Read, &resolved:Read, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 4);
    var i: u32 = 0; while i < 4 { assert(diags.diags[i].code.raw == 5001); i = i + 1; }
    return;
}
function apply_document(store: &documents::Store:ReadWrite, src: &[u8], method: u8): documents::Event!AllocError {
    let parsed: json::Document = json::parse(src)?;
    return documents::apply(store, &parsed:Read, src, 0u32, method)?;
}

function check_workspace_store(store: &documents::Store:ReadWrite, original: &iface::InterfaceResult:Read, changed: &iface::InterfaceResult:Read): void!AllocError {
    let opening: &[u8] = "{\"textDocument\":{\"uri\":\"file:///consumer.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"import service; function wrap(x: u32): u32 { return service::run(x); }\\n\"}}";
    let first: documents::Event = apply_document(store, opening, 1u8)?;
    assert(first.status == 1u8);
    var material: document_deps::Material[] = [];
    @push(material, build_material("service", original)?)?;
    let direct: u32[] = [0u32];
    let opened: document_deps::OpenModule[] = [document_deps::OpenModule { module: [111u8, 116u8, 104u8, 101u8, 114u8] }];
    let a: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, first.ticket, "consumer", "p", 1u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(a.status == 1u8 && a.material_status == 0u8 && pipeline::analysis_checked(a.analysis.status));
    assert(a.ticket.analysis_epoch == 1u64 && !documents::is_current(&*store:Read, first.ticket));
    assert(@len(store.slots[a.ticket.slot].snapshot.definitions.links) == 1);
    assert(@len(store.slots[a.ticket.slot].snapshot.definitions.imported_uses) == 1);
    material[0] = build_material("service", original)?;
    let same: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, a.ticket, "consumer", "p", 1u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..1]:Read)?;
    assert(same.status == 0u8 && same.ticket.analysis_epoch == a.ticket.analysis_epoch);

    material[0] = build_material("service", changed)?;
    let b: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, same.ticket, "consumer", "p", 1u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(b.status == 1u8 && b.ticket.analysis_epoch == 2u64 && pipeline::analysis_rejected(b.analysis.status));
    assert(b.analysis.diagnostics.has_error && @len(store.slots[b.ticket.slot].snapshot.definitions.links) == 0);
    assert(@len(store.slots[b.ticket.slot].snapshot.definitions.imported_uses) == 0);
    let blank: types::DocumentDefinitions = types::empty_definitions();
    let old: bool = documents::commit_definitions(store, a.ticket, @move(blank));
    assert(!old);
    let missing: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, b.ticket, "consumer", "p", 1u64, &material[0..0]:Read, &direct[0..0]:Read, &opened[0..0]:Read)?;
    assert(missing.status == 1u8 && missing.ticket.analysis_epoch == 3u64 && pipeline::analysis_needs_dependencies(missing.analysis.status));
    assert(@len(store.slots[missing.ticket.slot].snapshot.definitions.links) == 0);
    material[0] = build_material("service", original)?;
    let restored: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, missing.ticket, "consumer", "other", 1u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(restored.status == 1u8 && restored.ticket.analysis_epoch == 4u64 && pipeline::analysis_checked(restored.analysis.status));
    let new_profile: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, restored.ticket, "consumer", "p", 1u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(new_profile.status == 1u8 && new_profile.ticket.analysis_epoch == 5u64);
    let rebuilt: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, new_profile.ticket, "consumer", "p", 2u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(rebuilt.status == 1u8 && rebuilt.ticket.analysis_epoch == 6u64);
    let edit: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///consumer.yak\",\"version\":2},\"contentChanges\":[{\"text\":\"import service; function wrap(x: u32): u32 { return service::run(x); }\\n\"}]}", 2u8)?;
    assert(edit.status == 1u8 && !documents::is_current(&*store:Read, rebuilt.ticket));
    let updated: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, edit.ticket, "consumer", "p", 2u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(updated.status == 1u8 && updated.ticket.analysis_epoch == 6u64 && updated.ticket.version == 2i32);
    let close: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///consumer.yak\"}}", 3u8)?;
    assert(close.status == 2u8);
    let reopen: documents::Event = apply_document(store, opening, 1u8)?;
    assert(reopen.status == 1u8 && reopen.ticket.generation != a.ticket.generation);
    let stale: workspace_snapshot::Refresh = workspace_snapshot::refresh(store, updated.ticket, "consumer", "p", 2u64, &material[0..1]:Read, &direct[0..1]:Read, &opened[0..0]:Read)?;
    assert(stale.status == 2u8 && !documents::has_analysis(&*store:Read, reopen.ticket));
    return;
}

function check_workspace_snapshot(original: &iface::InterfaceResult:Read, changed: &iface::InterfaceResult:Read): void!AllocError {
    var store: documents::Store = documents::create(1024u32);
    return check_workspace_store(&store:ReadWrite, original, changed)?;
}

function copy_module_name(name: &[u8]): u8[]!AllocError {
    var bytes: u8[] = [];
    var i: u32 = 0;
    while i < @len(name) as u32 { @push(bytes, name[i])?; i = i + 1u32; }
    return bytes;
}

function plain_binding(ticket: documents::Ticket, name: &[u8]): workspace_snapshot::Binding!AllocError {
    let module_name: u8[] = copy_module_name(name)?;
    return workspace_snapshot::Binding { slot: ticket.slot, generation: ticket.generation, module: @move(module_name), materials: [], direct: [] };
}

function check_workspace_batch(store: &documents::Store:ReadWrite, original: &iface::InterfaceResult:Read, changed: &iface::InterfaceResult:Read): void!AllocError {
    let consumer: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///z.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"import service; function wrap(x: u32): u32 { return service::run(x); }\\n\"}}", 1u8)?;
    let independent: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///a.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"function id(x: u32): u32 { return x; }\\n\"}}", 1u8)?;
    assert(consumer.status == 1u8 && independent.status == 1u8);
    var bindings: workspace_snapshot::Binding[] = [];
    @push(bindings, plain_binding(independent.ticket, "independent")?)?;
    @push(bindings, plain_binding(consumer.ticket, "consumer")?)?;
    @push(bindings[1].materials, build_material("service", original)?)?;
    @push(bindings[1].direct, 0u32)?;
    let initial: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..2]:Read, "p", 1u64)?;
    assert(initial.status == 0u8 && @len(initial.updates) == 2 && initial.updates[0].ticket.slot == independent.ticket.slot);
    assert(initial.updates[0].status == 1u8 && initial.updates[1].status == 1u8 && pipeline::analysis_checked(initial.updates[1].analysis.status));
    let again: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..2]:Read, "p", 1u64)?;
    assert(again.updates[0].status == 0u8 && again.updates[1].status == 0u8);

    bindings[1].materials[0] = build_material("service", changed)?;
    let signed: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..2]:Read, "p", 1u64)?;
    assert(signed.updates[0].status == 0u8 && signed.updates[1].status == 1u8 && pipeline::analysis_rejected(signed.updates[1].analysis.status));
    bindings[1].materials[0] = build_material("service", original)?;
    let restored: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..2]:Read, "p", 1u64)?;
    assert(restored.updates[0].status == 0u8 && pipeline::analysis_checked(restored.updates[1].analysis.status));
    let service_source: &[u8] = "{\"textDocument\":{\"uri\":\"file:///m.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"export function run(x: u64): u64 { return x; }\\n\"}}";
    let opened: documents::Event = apply_document(store, service_source, 1u8)?;
    assert(opened.status == 1u8);
    @push(bindings, plain_binding(opened.ticket, "consumer")?)?;
    let duplicate: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..3]:Read, "p", 1u64)?;
    assert(duplicate.status == 1u8 && @len(duplicate.updates) == 0);
    assert(documents::has_analysis(&*store:Read, restored.updates[1].ticket));
    bindings[2] = plain_binding(opened.ticket, "service")?;
    let shadowed: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..3]:Read, "p", 1u64)?;
    assert(shadowed.status == 0u8 && @len(shadowed.updates) == 3 && shadowed.updates[1].ticket.slot == opened.ticket.slot);
    assert(shadowed.updates[0].status == 0u8 && shadowed.updates[2].status == 1u8 && shadowed.updates[2].material_status == 6u8);
    assert(pipeline::analysis_needs_dependencies(shadowed.updates[2].analysis.status));
    assert(@len(store.slots[consumer.ticket.slot].snapshot.definitions.links) == 0);

    let close: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///m.yak\"}}", 3u8)?;
    assert(close.status == 2u8);
    let reopened: documents::Event = apply_document(store, service_source, 1u8)?;
    assert(reopened.status == 1u8 && reopened.ticket.slot == opened.ticket.slot && reopened.ticket.generation != opened.ticket.generation);
    let unshadowed: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..3]:Read, "p", 1u64)?;
    assert(unshadowed.status == 0u8 && @len(unshadowed.updates) == 2 && unshadowed.updates[0].status == 0u8);
    assert(unshadowed.updates[1].status == 1u8 && pipeline::analysis_checked(unshadowed.updates[1].analysis.status));
    let revoked: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..1]:Read, "p", 1u64)?;
    assert(revoked.status == 0u8 && @len(revoked.updates) == 2 && revoked.updates[0].status == 0u8);
    assert(revoked.updates[1].status == 1u8 && pipeline::analysis_needs_dependencies(revoked.updates[1].analysis.status));
    assert(!documents::is_current(&*store:Read, unshadowed.updates[1].ticket));
    assert(@len(store.slots[consumer.ticket.slot].snapshot.definitions.links) == 0);
    let steady: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..1]:Read, "p", 1u64)?;
    assert(steady.status == 0u8 && @len(steady.updates) == 1 && steady.updates[0].status == 0u8);
    return;
}

function check_workspace_dispatch(original: &iface::InterfaceResult:Read, changed: &iface::InterfaceResult:Read): void!AllocError {
    var store: documents::Store = documents::create(4096u32);
    return check_workspace_batch(&store:ReadWrite, original, changed)?;
}

function check_source_target(source: &[u8], binary: &[u8], digest: &[u8]): void!AllocError {
    let expected: u8[] = iface::sha256(source)?;
    let target: documents::DefinitionTarget = workspace_targets::build("file:///service.yak", "service", &expected[0..32]:Read, digest, source, binary)?;
    assert(target.status == 0u8 && @len(target.locations) == 1);
    let at: positions::RangeResult = workspace_targets::location(&target:Read, "service", digest, 1u32);
    assert(at.valid && at.range.start.line == 0u32 && at.range.start.character == 16u32);
    assert(at.range.end.line == 0u32 && at.range.end.character == 19u32);
    assert(!workspace_targets::location(&target:Read, "other", digest, 1u32).valid);
    assert(!workspace_targets::location(&target:Read, "service", &expected[0..32]:Read, 1u32).valid);
    assert(!workspace_targets::location(&target:Read, "service", digest, 0u32).valid);
    assert(!workspace_targets::location(&target:Read, "service", digest, 2u32).valid);
    let changed: documents::DefinitionTarget = workspace_targets::build("file:///service.yak", "service", &expected[0..32]:Read, digest, "export function run(x: u32): u32 { return x; }", binary)?;
    assert(changed.status == 2u8 && @len(changed.locations) == 0);
    let wrong_module: documents::DefinitionTarget = workspace_targets::build("file:///service.yak", "other", &expected[0..32]:Read, digest, source, binary)?;
    assert(wrong_module.status == 2u8 && @len(wrong_module.locations) == 0);
    let wrong_binary: documents::DefinitionTarget = workspace_targets::build("file:///service.yak", "service", &expected[0..32]:Read, digest, source, "corrupt")?;
    assert(wrong_binary.status == 2u8 && @len(wrong_binary.locations) == 0);
    let wrong_uri: documents::DefinitionTarget = workspace_targets::build("file:///bad%XX", "service", &expected[0..32]:Read, digest, source, binary)?;
    assert(wrong_uri.status == 1u8 && @len(wrong_uri.locations) == 0);
    let wrong_source: &[u8] = "export enum run { Bad }";
    let wrong_digest: u8[] = iface::sha256(wrong_source)?;
    let wrong_kind: documents::DefinitionTarget = workspace_targets::build("file:///service.yak", "service", &wrong_digest[0..32]:Read, digest, wrong_source, binary)?;
    assert(wrong_kind.status == 3u8 && @len(wrong_kind.locations) == 0);
    return;
}

function check_sorted_targets(source: &[u8], binary: &[u8], loaded: &iface::LoadedInterface:Read): void!AllocError {
    let digest: &[u8] = &loaded.digest[0..32]:Read;
    let expected: u8[] = iface::sha256(source)?;
    let target: documents::DefinitionTarget = workspace_targets::build("file:///callbacks.yak", "callbacks", &expected[0..32]:Read, digest, source, binary)?;
    assert(target.status == 0u8 && @len(target.locations) == 4 && @len(target.symbols) == 4);
    let first: documents::TargetSymbol = target.symbols[0];
    let last: documents::TargetSymbol = target.symbols[3];
    assert(first.kind == 3u8 && last.kind == 1u8);
    assert(iface::bytes_order(&target.names[first.name_start..first.name_start + first.name_len as u32]:Read, "Holder") == 0);
    assert(iface::bytes_order(&target.names[last.name_start..last.name_start + last.name_len as u32]:Read, "use") == 0);
    var targets: documents::DefinitionTarget[] = [];
    @push(targets, @move(target))?;
    let store: documents::Store = documents::create(4096u32);
    let selected: documents::SymbolResult = workspace_targets::symbols(&store:Read, &targets[0..1]:Read, "OE")?;
    assert(selected.status == 0u8 && selected.covered == 1u32 && @len(selected.hits) == 2);
    assert(selected.hits[0].symbol == 0u32 && selected.hits[1].symbol == 2u32);
    let indexed: &documents::DefinitionTarget:Read = &targets[0]:Read;
    var i: u32 = 0;
    while i < @len(loaded.exports) as u32 {
        let row: iface::LoadedExport = loaded.exports[i];
        let name: &[u8] = &loaded.name_bytes[row.name_off..row.name_off + row.name_len as u32]:Read;
        let at: positions::RangeResult = workspace_targets::location(indexed, "callbacks", digest, row.export_id);
        assert(at.valid && at.range.start.line == at.range.end.line && at.range.end.character == at.range.start.character + row.name_len as u32);
        if iface::bytes_order(name, "Holder") == 0 { assert(at.range.start.line == 0u32 && at.range.start.character == 14u32); }
        elseif iface::bytes_order(name, "Point") == 0 { assert(at.range.start.line == 1u32 && at.range.start.character == 14u32); }
        elseif iface::bytes_order(name, "Choice") == 0 { assert(at.range.start.line == 2u32 && at.range.start.character == 12u32); }
        else { assert(iface::bytes_order(name, "use") == 0 && at.range.start.line == 3u32 && at.range.start.character == 16u32); }
        i = i + 1u32;
    }
    return;
}

function expect_definition(store: &documents::Store:Read, targets: &[documents::DefinitionTarget]:Read, request: &[u8], expected: &[u8]): void!AllocError {
    let doc: json::Document = json::parse(request)?;
    let route: rpc::Route = rpc::classify_configured(&doc:Read, request, 2u8, true);
    assert(route.kind == 9u8);
    let reply: rpc_reply::Reply = session::definition_reply(store, &route:Read, &doc:Read, request, targets)?;
    assert(reply.status == 1u8 && iface::bytes_order(&reply.bytes[0..@len(reply.bytes)]:Read, expected) == 0);
    return;
}

function check_definition_store(store: &documents::Store:ReadWrite, original: &iface::InterfaceResult:Read, source: &[u8], binary: &[u8], digest: &[u8]): void!AllocError {
    let consumer: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///consumer.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"import service; function wrap(x: u32): u32 { return service::run(x); }\\n\"}}", 1u8)?;
    assert(consumer.status == 1u8);
    var bindings: workspace_snapshot::Binding[] = [];
    @push(bindings, plain_binding(consumer.ticket, "consumer")?)?;
    @push(bindings[0].materials, build_material("service", original)?)?;
    @push(bindings[0].direct, 0u32)?;
    let refreshed: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..1]:Read, "p", 1u64)?;
    assert(refreshed.status == 0u8 && pipeline::analysis_checked(refreshed.updates[0].analysis.status));
    let source_id: u8[] = iface::sha256(source)?;
    var targets: documents::DefinitionTarget[] = [];
    @push(targets, workspace_targets::build("file:///service.yak", "service", &source_id[0..32]:Read, digest, source, binary)?)?;
    @push(targets, workspace_targets::build("file:///alias.yak", "service", &source_id[0..32]:Read, digest, source, binary)?)?;
    assert(targets[0].status == 0u8 && targets[1].status == 0u8);
    let empty_query: documents::SymbolResult = workspace_targets::symbols(&*store:Read, &targets[0..1]:Read, "")?;
    assert(empty_query.status == 0u8 && empty_query.covered == 1u32 && empty_query.shadowed == 0u32 && @len(empty_query.hits) == 1);
    let private_name: documents::SymbolResult = workspace_targets::symbols(&*store:Read, &targets[0..1]:Read, "hidden")?;
    assert(private_name.status == 0u8 && @len(private_name.hits) == 0);
    let ambiguous: documents::SymbolResult = workspace_targets::symbols(&*store:Read, &targets[0..2]:Read, "run")?;
    assert(ambiguous.status == 3u8 && @len(ambiguous.hits) == 0);
    let remote: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file:///consumer.yak\"},\"position\":{\"line\":0,\"character\":61}}}";
    let local: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file:///consumer.yak\"},\"position\":{\"line\":0,\"character\":65}}}";
    let prefix: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file:///consumer.yak\"},\"position\":{\"line\":0,\"character\":52}}}";
    let bad: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file:///consumer.yak\"},\"position\":{\"line\":0,\"character\":-1}}}";
    let found: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"result\":{\"uri\":\"file:///service.yak\",\"range\":{\"start\":{\"line\":0,\"character\":16},\"end\":{\"line\":0,\"character\":19}}}}";
    let found_local: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"result\":{\"uri\":\"file:///consumer.yak\",\"range\":{\"start\":{\"line\":0,\"character\":30},\"end\":{\"line\":0,\"character\":31}}}}";
    let missing: &[u8] = "{\"jsonrpc\":\"2.0\",\"id\":90,\"result\":null}";
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, found)?;
    expect_definition(&*store:Read, &targets[0..2]:Read, local, found_local)?;
    expect_definition(&*store:Read, &targets[0..1]:Read, prefix, missing)?;
    expect_definition(&*store:Read, &targets[0..1]:Read, bad, "{\"jsonrpc\":\"2.0\",\"id\":90,\"error\":{\"code\":-32602,\"message\":\"Invalid params\"}}")?;
    expect_definition(&*store:Read, &targets[0..2]:Read, remote, missing)?;
    expect_definition(&*store:Read, &targets[0..0]:Read, remote, missing)?;

    let opened: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///service.yak\",\"languageId\":\"yak\",\"version\":1,\"text\":\"export function run(x: u32): u32 { return x; }\\n\"}}", 1u8)?;
    assert(opened.status == 1u8);
    let shadowed: documents::SymbolResult = workspace_targets::symbols(&*store:Read, &targets[0..1]:Read, "run")?;
    assert(shadowed.status == 0u8 && shadowed.covered == 0u32 && shadowed.shadowed == 1u32 && @len(shadowed.hits) == 0);
    // 即使宿主还未重新分析消费者，也不能跳到已打开 URI 的旧磁盘位置。
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, missing)?;
    let closed: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///service.yak\"}}", 3u8)?;
    assert(closed.status == 2u8);
    let restored: documents::SymbolResult = workspace_targets::symbols(&*store:Read, &targets[0..1]:Read, "RU")?;
    assert(restored.status == 0u8 && restored.covered == 1u32 && @len(restored.hits) == 1);
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, found)?;
    let changed: documents::Event = apply_document(store, "{\"textDocument\":{\"uri\":\"file:///consumer.yak\",\"version\":2},\"contentChanges\":[{\"text\":\"import service; function wrap(x: u32): u32 { return service::run(x); }\\n\"}]}", 2u8)?;
    assert(changed.status == 1u8 && !documents::is_current(&*store:Read, refreshed.updates[0].ticket));
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, missing)?;
    let next: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..1]:Read, "p", 1u64)?;
    assert(next.status == 0u8 && pipeline::analysis_checked(next.updates[0].analysis.status));
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, found)?;
    let revoked: workspace_snapshot::Batch = workspace_snapshot::refresh_workspace(store, &bindings[0..0]:Read, "p", 1u64)?;
    assert(revoked.status == 0u8 && pipeline::analysis_needs_dependencies(revoked.updates[0].analysis.status));
    expect_definition(&*store:Read, &targets[0..1]:Read, remote, missing)?;
    return;
}

function check_workspace_definition(original: &iface::InterfaceResult:Read, source: &[u8], binary: &[u8], digest: &[u8]): void!AllocError {
    var store: documents::Store = documents::create(4096u32);
    return check_definition_store(&store:ReadWrite, original, source, binary, digest)?;
}

function check_symbol_order(source: &[u8], first: &[u8], first_digest: &[u8], second: &[u8], second_digest: &[u8]): void!AllocError {
    let digest: u8[] = iface::sha256(source)?;
    var targets: documents::DefinitionTarget[] = [];
    @push(targets, workspace_targets::build("file:///z.yak", "service", &digest[0..32]:Read, first_digest, source, first)?)?;
    @push(targets, workspace_targets::build("file:///a.yak", "sibling", &digest[0..32]:Read, second_digest, source, second)?)?;
    @push(targets, workspace_targets::build("file:///ignored.yak", "sibling", &digest[0..32]:Read, second_digest, source, "bad")?)?;
    assert(targets[0].status == 0u8 && targets[1].status == 0u8 && targets[2].status == 2u8);
    let store: documents::Store = documents::create(4096u32);
    let sorted: documents::SymbolResult = workspace_targets::symbols(&store:Read, &targets[0..3]:Read, "Rn")?;
    assert(sorted.status == 0u8 && sorted.covered == 2u32 && @len(sorted.hits) == 2);
    assert(sorted.hits[0].target == 1u32 && sorted.hits[1].target == 0u32);
    let invalid: u8[] = [255u8];
    let bad: documents::SymbolResult = workspace_targets::symbols(&store:Read, &targets[0..3]:Read, &invalid[0..1]:Read)?;
    assert(bad.status == 1u8 && @len(bad.hits) == 0);
    var long_query: u8[] = [];
    var i: u32 = 0;
    while i < 257u32 { @push(long_query, 97u8)?; i = i + 1u32; }
    let at_limit: documents::SymbolResult = workspace_targets::symbols(&store:Read, &targets[0..3]:Read, &long_query[0..256]:Read)?;
    let oversized: documents::SymbolResult = workspace_targets::symbols(&store:Read, &targets[0..3]:Read, &long_query[0..257]:Read)?;
    assert(at_limit.status == 0u8 && @len(at_limit.hits) == 0 && oversized.status == 2u8 && @len(oversized.hits) == 0);
    var collision: documents::DefinitionTarget[] = [];
    @push(collision, workspace_targets::build("file:///z.yak", "service", &digest[0..32]:Read, first_digest, source, first)?)?;
    @push(collision, workspace_targets::build("file:///z.yak", "sibling", &digest[0..32]:Read, second_digest, source, second)?)?;
    assert(collision[0].status == 0u8 && collision[1].status == 0u8);
    let conflicting_uri: documents::SymbolResult = workspace_targets::symbols(&store:Read, &collision[0..2]:Read, "run")?;
    assert(conflicting_uri.status == 3u8 && @len(conflicting_uri.hits) == 0);
    return;
}

// 文档精确绑定真实导出接口，私有名和无位置的导出不产生定义目标。
function check_document_dependencies(): void!AllocError {
    let target_source: &[u8] = "export function run(x: u32): u32 { return hidden(x); }\nfunction hidden(x: u32): u32 { return x; }\n";
    let lib: Loaded = load(target_source, 1330u16)?;
    var build: diag::DiagBuffer = diag::diagbuf_new();
    let no_deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&lib.parsed.file:Read, &lib.parsed.pool:Read, &lib.lexed.names:Read, &no_deps:Read, "service", &build:ReadWrite)?;
    let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&lib.parsed.file:Read, &lib.parsed.pool:Read, &resolution:Read, &build:ReadWrite)?;
    let info: iface::LayoutData = iface::LayoutData { sizes: [], aligns: [], known: [] };
    let written: iface::InterfaceResult = iface_write::write_interface(&lib.parsed.file:Read, &lib.parsed.pool:Read, &resolution:Read, &lib.lexed.names:Read, &checked:Read, &info:Read, "service", &build:ReadWrite)?;
    let bytes: &[u8]:Read = &written.data.bytes[0..@len(written.data.bytes)]:Read;
    let digest: u8[] = iface::sha256_zero_header_digest(bytes, 24u32)?;
    let lib_iface: iface::LoadedInterface = iface_load::load_expected_interface(bytes, "service", &digest[0..32]:Read, &build:ReadWrite)?;
    check_source_target(target_source, bytes, &digest[0..32]:Read)?;
    check_workspace_definition(&written:Read, target_source, bytes, &digest[0..32]:Read)?;
    let sibling: iface::InterfaceResult = iface_write::write_interface(&lib.parsed.file:Read, &lib.parsed.pool:Read, &resolution:Read, &lib.lexed.names:Read, &checked:Read, &info:Read, "sibling", &build:ReadWrite)?;
    let sibling_bytes: &[u8] = &sibling.data.bytes[0..@len(sibling.data.bytes)]:Read;
    let sibling_digest: u8[] = iface::sha256_zero_header_digest(sibling_bytes, 24u32)?;
    check_symbol_order(target_source, bytes, &digest[0..32]:Read, sibling_bytes, &sibling_digest[0..32]:Read)?;
    assert(!build.has_error);
    var candidates: iface::LoadedInterface[] = [];
    @push(candidates, @move(lib_iface))?;
    var order: u32[] = [0u32];
    let assembly: iface_load::DependencyAssembly = iface_load::assemble_dependencies(&candidates[0..1]:Read, &order:ReadWrite, 1u32, &build:ReadWrite)?;
    assert(assembly.valid && !build.has_error);
    let imported: layout::ImportedLayoutTable = layout::ImportedLayoutTable { items: [] };
    let src: &[u8]:Read = "import service; function wrap(x: u32): u32 { return service::run(service :: run(x)); }\n";
    let plain: pipeline::DocumentAnalysis = pipeline::run_document_frontend(src, 1331u16)?;
    assert(pipeline::analysis_needs_dependencies(plain.status) && !plain.diagnostics.has_error);
    let ready: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies(src, 1331u16, "consumer", &assembly.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_checked(ready.analysis.status) && !ready.analysis.diagnostics.has_error && @len(ready.definitions.links) == 1);
    let local: types::DefinitionLink = types::definition_at(&ready.definitions:Read, 80u32);
    assert(local.target_offset == 30u32 && local.target_length == 1u32);
    let remote: types::DefinitionLink = types::definition_at(&ready.definitions:Read, 61u32);
    assert(remote.use_length == 0u32);
    let first: types::ImportedDefinitionUse = types::imported_definition_at(&ready.definitions:Read, 61u32);
    let second: types::ImportedDefinitionUse = types::imported_definition_at(&ready.definitions:Read, 78u32);
    assert(@len(ready.definitions.imported_interfaces) == 1 && @len(ready.definitions.imported_uses) == 2);
    assert(first.offset == 61u32 && second.offset == 76u32 && first.length == 3u32 && second.length == 3u32);
    assert(first.interface_row == 1u32 && second.interface_row == 1u32 && first.export_id == 1u32 && second.export_id == 1u32);
    assert(types::imported_definition_at(&ready.definitions:Read, 52u32).length == 0u32);
    assert(types::imported_definition_at(&ready.definitions:Read, 60u32).length == 0u32);
    assert(types::imported_definition_at(&ready.definitions:Read, 79u32).length == 0u32);
    assert(iface::bytes_order(&ready.definitions.imported_interfaces[0].module[0..7]:Read, "service") == 0);
    assert(iface::bytes_order(&ready.definitions.imported_interfaces[0].digest[0..32]:Read, &digest[0..32]:Read) == 0);
    let missing: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies(src, 1331u16, "consumer", &assembly.deps:Read, 0u32, &imported:Read)?;
    assert(pipeline::analysis_needs_dependencies(missing.analysis.status) && !missing.analysis.diagnostics.has_error && @len(missing.definitions.links) == 0);
    let private: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import service; function wrap(x: u32): u32 { return service::hidden(x); }\n", 1331u16, "consumer", &assembly.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_rejected(private.analysis.status) && @len(private.analysis.diagnostics.diags) == 1 && private.analysis.diagnostics.diags[0].code.raw == 4008u16);
    assert(private.analysis.diagnostics.diags[0].span.file == 1331u16 && @len(private.definitions.links) == 0);
    let unknown: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import service; function wrap(x: u32): u32 { return service::absent(x); }\n", 1331u16, "consumer", &assembly.deps:Read, 1u32, &imported:Read)?;
    assert(pipeline::analysis_rejected(unknown.analysis.status) && @len(unknown.analysis.diagnostics.diags) == 1 && unknown.analysis.diagnostics.diags[0].code.raw == 4002u16);
    assert(@len(missing.definitions.imported_uses) == 0 && @len(private.definitions.imported_uses) == 0);
    let self_import: pipeline::DocumentWithDefinitions = pipeline::run_document_with_dependencies("import consumer; function f(): void {}\n", 1331u16, "consumer", &no_deps:Read, 0u32, &imported:Read)?;
    assert(pipeline::analysis_rejected(self_import.analysis.status) && self_import.analysis.diagnostics.diags[0].code.raw == 4007u16);
    let modified: Loaded = load("export function run(x: u64): u64 { return x; }\n", 1332u16)?;
    let changed_resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&modified.parsed.file:Read, &modified.parsed.pool:Read, &modified.lexed.names:Read, &no_deps:Read, "service", &build:ReadWrite)?;
    let changed_types: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&modified.parsed.file:Read, &modified.parsed.pool:Read, &changed_resolution:Read, &build:ReadWrite)?;
    let changed: iface::InterfaceResult = iface_write::write_interface(&modified.parsed.file:Read, &modified.parsed.pool:Read, &changed_resolution:Read, &modified.lexed.names:Read, &changed_types:Read, &info:Read, "service", &build:ReadWrite)?;
    assert(!build.has_error);
    check_workspace_snapshot(&written:Read, &changed:Read)?;
    check_workspace_dispatch(&written:Read, &changed:Read)?;
    return;
}

// 用真实源码往返验证接口写出顺序与导入检查兼容。
function check_error_roundtrip(): void!AllocError {
    let dep: Loaded = load("export enum AA { X }\nexport enum B { Y }\nexport function f(): u32!(AA | B) { return 1; }\n", 1100)?;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep.lexed.names:Read, &empty:Read, "errors", &d:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &resolution:Read, &d:ReadWrite)?;
    let data: layout::LayoutResult = layout::layout_unit(&tc.types:Read, &tc.fields:Read, &tc.enums:Read, &d:ReadWrite)?;
    var sizes: u64[] = []; var aligns: u8[] = []; var known: bool[] = []; var i: u32 = 0;
    while i < @len(data.table.items) as u32 { @push(sizes, data.table.items[i].size)?; @push(aligns, data.table.items[i].align)?; @push(known, data.table.items[i].known)?; i = i + 1; }
    let info: iface::LayoutData = iface::LayoutData { sizes: sizes, aligns: aligns, known: known };
    let built: iface::InterfaceResult = iface_write::write_interface(&dep.parsed.file:Read, &dep.parsed.pool:Read, &resolution:Read, &dep.lexed.names:Read, &tc:Read, &info:Read, "errors", &d:ReadWrite)?;
    assert(diag::diagbuf_count(&d:Read) == 0);
    let bytes: &[u8]:Read = &built.data.bytes[0..@len(built.data.bytes)]:Read;
    // 夹具明确登记刚写出的接口身份，不从待验接口的自述决定模块名。
    let expected_digest: u8[] = iface::sha256_zero_header_digest(bytes, 24u32)?;
    let loaded: iface::LoadedInterface = iface_load::load_expected_interface(bytes, "errors", &expected_digest[0..32]:Read, &d:ReadWrite)?;
    assert(!d.has_error && @len(loaded.digest) == 32);
    var wrong_name: diag::DiagBuffer = diag::diagbuf_new();
    let renamed: iface::LoadedInterface = iface_load::load_expected_interface(bytes, "other", &expected_digest[0..32]:Read, &wrong_name:ReadWrite)?;
    assert(wrong_name.has_error && @len(renamed.module_name) == 0);
    var wrong_digest: diag::DiagBuffer = diag::diagbuf_new();
    let stale_digest: u8[] = iface::sha256("different interface identity")?;
    let stale: iface::LoadedInterface = iface_load::load_expected_interface(bytes, "errors", &stale_digest[0..32]:Read, &wrong_digest:ReadWrite)?;
    assert(wrong_digest.has_error && @len(stale.exports) == 0);
    var candidates: iface::LoadedInterface[] = [];
    @push(candidates, @move(loaded))?;
    var order: u32[] = [0u32];
    let assembled: iface_load::DependencyAssembly = iface_load::assemble_dependencies(&candidates[0..1]:Read, &order:ReadWrite, 1u32, &d:ReadWrite)?;
    assert(assembled.valid && @len(assembled.deps.ifaces) == 1 && @len(assembled.targets) == 0 && order[0] == 0);
    var bad_order: u32[] = [1u32];
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: iface_load::DependencyAssembly = iface_load::assemble_dependencies(&candidates[0..1]:Read, &bad_order:ReadWrite, 1u32, &bad:ReadWrite)?;
    assert(!rejected.valid && bad.has_error && @len(rejected.deps.ifaces) == 0 && @len(rejected.targets) == 0);
    var too_short: diag::DiagBuffer = diag::diagbuf_new();
    let invalid_prefix: iface_load::DependencyAssembly = iface_load::assemble_dependencies(&candidates[0..1]:Read, &order:ReadWrite, 2u32, &too_short:ReadWrite)?;
    assert(!invalid_prefix.valid && too_short.has_error && order[0] == 0);
    let user: Loaded = load("import errors; function test(): void { errors::f(); }\n", 1101)?;
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&user.parsed.file:Read, &user.parsed.pool:Read, &user.lexed.names:Read, &assembled.deps:Read, "", &d:ReadWrite)?;
    assert(diag::diagbuf_count(&d:Read) == 0 && @len(resolved.refs.imports) == 1);
    // 从真实接口解析按值依赖，未知导入布局不得伪装为有效尺寸。
    let consumer: Loaded = load("import errors; struct Holder { value: errors::AA } function check(): u32!(errors::AA | errors::B) { return 1; }\n", 1102)?;
    var cd: diag::DiagBuffer = diag::diagbuf_new();
    let cr: resolve_refs::Resolution = resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &assembled.deps:Read, "consumer", &cd:ReadWrite)?;
    let ct: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &cr:Read, &cd:ReadWrite)?;
    let cl: layout::LayoutResult = layout::layout_unit(&ct.types:Read, &ct.fields:Read, &ct.enums:Read, &cd:ReadWrite)?;
    assert(!cd.has_error);
    var error_count: u32 = 0; var fallible_count: u32 = 0; var struct_count: u32 = 0;
    i = 0;
    while i < @len(ct.types.entries) as u32 {
        if ct.types.entries[i].kind == 11 { assert(!cl.table.items[i].known); error_count = error_count + 1; }
        elseif ct.types.entries[i].kind == 9 { assert(!cl.table.items[i].known); fallible_count = fallible_count + 1; }
        elseif ct.types.entries[i].kind == 2 { assert(!cl.table.items[i].known); struct_count = struct_count + 1; }
        i = i + 1;
    }
    assert(error_count == 1 && fallible_count == 1 && struct_count == 1);
    return;
}
function check_public_import(src: &[u8]:Read, deps: &resolve_refs::DependencySet:Read): void!AllocError {
    let source: Loaded = load(src, 1010)?;
    var pd: diag::DiagBuffer = diag::diagbuf_new();
    let pr: resolve_refs::Resolution = resolve_unit::resolve_unit(&source.parsed.file:Read, &source.parsed.pool:Read, &source.lexed.names:Read, deps, "user", &pd:ReadWrite)?;
    let pt: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&source.parsed.file:Read, &source.parsed.pool:Read, &pr:Read, &pd:ReadWrite)?;
    assert(diag::diagbuf_count(&pd:Read) == 0);
    // 公共编码接口仍供 YSM 使用，不能因接口依赖限制改变编码能力。
    let map: iface::ExportMap = iface_write::build_export_map(&source.parsed.file:Read, &source.parsed.pool:Read, &pr:Read, &source.lexed.names:Read)?;
    var piece: iface::ByteSink = iface::ByteSink { bytes: [] };
    iface::encode_function_signature(&pt.types:Read, &pt.funcs:Read, &map:Read, pt.funcs.items[0].def, &piece:ReadWrite, &pd:ReadWrite, @len(deps.ifaces) as u32)?;
    assert(diag::diagbuf_count(&pd:Read) == 0 && @len(piece.bytes) > 4);
    iface_write::write_function_interface(&source.parsed.file:Read, &source.parsed.pool:Read, &pr:Read, &source.lexed.names:Read, &pt:Read, "user", &pd:ReadWrite)?;
    assert(diag::diagbuf_count(&pd:Read) == 1 && pd.diags[0].code.raw == 7012);
    return;
}
// 回归当前嵌套函数引用桥接行为；语法与接口编码约束的分歧尚待裁决。
function check_nested_function_reference(): void!AllocError {
    let target_source: &[u8] = "export struct Holder { cb: &function(&function(&u8): u32): void }\nexport struct Point { x: u32, y: u16 }\nexport enum Choice { Empty, Value(u16) }\nexport function use(cb: &function(&function(&u8): u32): void): void { cb; }\n";
    let dep: Loaded = load(target_source, 1300)?;
    var d: diag::DiagBuffer = diag::diagbuf_new();
    let empty: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &dep.lexed.names:Read, &empty:Read, "callbacks", &d:ReadWrite)?;
    assert(!d.has_error);
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&dep.parsed.file:Read, &dep.parsed.pool:Read, &resolution:Read, &d:ReadWrite)?;
    let data: layout::LayoutResult = layout::layout_unit(&tc.types:Read, &tc.fields:Read, &tc.enums:Read, &d:ReadWrite)?;
    assert(!d.has_error);
