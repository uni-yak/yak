import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
foreign assert(cond: bool): void;
function check(src: &[u8], count: u32): void!AllocError {
    let tokens: lex::LexResult = lex::lex_scan(src, 1)?;
    assert(@len(tokens.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_file(&tokens.tokens[0..@len(tokens.tokens)]:Read, &tokens.names:Read, 1)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let refs: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &tokens.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    let result: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &refs:Read, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == count);
    if count != 0 { assert(diags.diags[0].code.raw == 5804); }
    return;
}
function run(): void!AllocError {
    // 无载荷标签的括号形式与实参数量无关，均应按构造形态拒绝。
    check("function f(): void!AllocError { return AllocError::OutOfMemory(); }\n", 1)?;
    check("function f(): void!AllocError { return AllocError::OutOfMemory(1u32); }\n", 1)?;
    check("enum E { Empty } function f(): E { return E::Empty; }\n", 0)?;
    return;
}
function main(): void { run()?; }
