function check_char_constants(): void!AllocError {
    var invalid: diag::DiagBuffer = diag::diagbuf_new();
    let bad: typecheck::TypeCheckResult = run_case("const K: u32 = 55296u32; function f(): void { @drop(K as char); @drop((55295u32 + 1u32) as char); @drop((57343u16 as u32) as char); @drop(1114112u32 as char); }\n", 490, &invalid:ReadWrite)?;
    assert(diag::diagbuf_count(&invalid:Read) == 4);
    var i: u32 = 0; while i < 4 { assert(invalid.diags[i].code.raw == 5001); i = i + 1; }
    var valid: diag::DiagBuffer = diag::diagbuf_new();
    let good: typecheck::TypeCheckResult = run_case("function f(x: u32): void { @drop((55294u32 + 1u32) as char); @drop((57344u16 as u32) as char); @drop(1114111u32 as char); @drop(x as char); @drop((1u32 / 0u32) as char); }\n", 491, &valid:ReadWrite)?;
    assert(diag::diagbuf_count(&valid:Read) == 0);
    return;
}
function check_foreign_write_arguments(): void!AllocError {
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: typecheck::TypeCheckResult = run_case("foreign assert(cond: bool): void; function f(x: &bool:Write): void { assert(x); out slot: bool; assert(out slot); }\n", 506, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 2);
    assert(bad.diags[0].code.raw == 9202 && bad.diags[0].span.offset == 76 && bad.diags[0].span.length == 1);
    assert(bad.diags[1].code.raw == 9202 && bad.diags[1].span.offset == 103 && bad.diags[1].span.length == 3);
    var good: diag::DiagBuffer = diag::diagbuf_new();
    let allowed: typecheck::TypeCheckResult = run_case("foreign read(dst: &[u8]:ReadWrite): u32; function fill(x: &bool:Write): void { *x = true; } function f(): void { var buf: [u8; 1] = [0u8]; @drop(read(&buf[0..1]:ReadWrite)); out slot: bool; fill(out slot); @drop(@move(slot)); }\n", 507, &good:ReadWrite)?;
    assert(diag::diagbuf_count(&good:Read) == 0);
    return;
}
function main(): void {
    check_foreign_write_arguments()?;
    check_char_constants()?;
    check_index_bounds()?;
    check_projection_deref_depth()?;
    check_cast_truncation()?;
    check_untyped_integers()?; check_bool_comparisons()?; check_array_comparisons()?; check_slice_equality()?; check_ref_equality()?; check_ref_ordering()?; check_struct_comparisons()?; check_ordering()?; check_enum_payload_comparisons()?;
    check_expression_types()?;
    check_propagation()?;
    check_clone_type()?;
    check_integer_ranges()?;
    check_array_types()?;
    check_foreign_services()?;
    // 显式切片构造和普通取引用必须产生不同的类型。
    var slices: diag::DiagBuffer = diag::diagbuf_new();
    let slice_types: typecheck::TypeCheckResult = run_case("foreign read(dst: &[u8]:ReadWrite): u32; foreign write(src: &[u8]): void; function f(): void { var a: [u8; 2] = [0u8, 0u8]; let n: u32 = read(&a[0..2]:ReadWrite); write(&a[0..n]:Read); let b: &u32 = &n:Read; if *b == n { return; } }\n", 460, &slices:ReadWrite)?;
    if diag::diagbuf_has_error(&slices:Read) { diag::diagbuf_print_terminal(&slices:Read)?; }
    assert(diag::diagbuf_count(&slices:Read) == 0);
    var upgrade: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: typecheck::TypeCheckResult = run_case("foreign read(dst: &[u8]:ReadWrite): u32; function f(a: &[u8]): void { let n: u32 = read(&a[0..1]:ReadWrite); if n == 0 { return; } }\n", 461, &upgrade:ReadWrite)?;
    assert(diag::diagbuf_count(&upgrade:Read) == 1 && upgrade.diags[0].code.raw == 6008);
    check_cast_whitelist()?;
    check_match_rules()?;
    // ── 返回类型匹配（P-5）正例 ──
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("function f(x: u32): u32 { return x; }\n", 400, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    assert(@len(r1.funcs.items) == 1);

    // ── P-5：bool 返回 u32 ──
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("function f(): u32 { return true; }\n", 401, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 1);
    assert(d2.diags[0].code.raw == 2005);

    // ── P-4：整数条件不是 bool ──
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("function f(): void { if 1 { return; } return; }\n", 402, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 1);
    assert(d3.diags[0].code.raw == 2004);

    // ── P-4：bool 条件正例 ──
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("function f(x: bool): void { if x { return; } return; }\n", 403, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 0);

    // ── 局部初始化类型不一致 ──
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("function f(): void { let x: u32 = true; @drop(x); return; }\n", 404, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 1);
    assert(d5.diags[0].code.raw == 5001);

    // ── 可错返回：成功值 ──
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    let r6: typecheck::TypeCheckResult = run_case("enum E { Bad }\nfunction f(): u32!E { return 1; }\n", 405, &d6:ReadWrite)?;
    assert(diag::diagbuf_count(&d6:Read) == 0);

    // ── 可错返回：错误标签 ──
    var d7: diag::DiagBuffer = diag::diagbuf_new();
    let r7: typecheck::TypeCheckResult = run_case("enum E { Bad }\nfunction f(): u32!E { return E::Bad; }\n", 406, &d7:ReadWrite)?;
    assert(diag::diagbuf_count(&d7:Read) == 0);

    // ── 可错返回：既非成功值也非错误标签 ──
    var d8: diag::DiagBuffer = diag::diagbuf_new();
    let r8: typecheck::TypeCheckResult = run_case("enum E { Bad }\nfunction f(): u32!E { return true; }\n", 407, &d8:ReadWrite)?;
    assert(diag::diagbuf_count(&d8:Read) == 1);
    assert(d8.diags[0].code.raw == 2005);

    // ── 整数字面量后缀定型 ──
    var d9: diag::DiagBuffer = diag::diagbuf_new();
    let r9: typecheck::TypeCheckResult = run_case("function f(): u8 { return 255u8; }\n", 408, &d9:ReadWrite)?;
    assert(diag::diagbuf_count(&d9:Read) == 0);

    // ── 调用实参类型不匹配 ──
    var d10: diag::DiagBuffer = diag::diagbuf_new();
    let r10: typecheck::TypeCheckResult = run_case("function g(x: u32): void { @drop(x); return; } function f(): void { g(true); return; }\n", 409, &d10:ReadWrite)?;
    assert(diag::diagbuf_count(&d10:Read) == 1);
    assert(d10.diags[0].code.raw == 5001);

    // ── 二元运算操作数不一致 ──
    var d11: diag::DiagBuffer = diag::diagbuf_new();
    let r11: typecheck::TypeCheckResult = run_case("function f(): void { let x: u32 = 1 + true; @drop(x); return; }\n", 410, &d11:ReadWrite)?;
    assert(diag::diagbuf_count(&d11:Read) == 1);
    assert(d11.diags[0].code.raw == 5001);

    // ── 调用返回类型参与 P-5 ──
    var d12: diag::DiagBuffer = diag::diagbuf_new();
    let r12: typecheck::TypeCheckResult = run_case("function g(): u32 { return 1; } function f(): u32 { return g(); }\n", 411, &d12:ReadWrite)?;
    assert(diag::diagbuf_count(&d12:Read) == 0);

    // ── 多成员 ErrorSet 的成功 / 错误返回 ──
    var d13: diag::DiagBuffer = diag::diagbuf_new();
    let r13: typecheck::TypeCheckResult = run_case("enum A { X } enum B { Y } function f(ok: bool): u32!(A | B) { if ok { return 1; } return B::Y; }\n", 412, &d13:ReadWrite)?;
    assert(diag::diagbuf_count(&d13:Read) == 0);

    // ── void!E 的成功返回 ──
    var d14: diag::DiagBuffer = diag::diagbuf_new();
    let r14: typecheck::TypeCheckResult = run_case("enum E { Bad } function f(): void!E { return; }\n", 413, &d14:ReadWrite)?;
    assert(diag::diagbuf_count(&d14:Read) == 0);

    // ── struct 字段读取类型 ──
    var d15: diag::DiagBuffer = diag::diagbuf_new();
    let r15: typecheck::TypeCheckResult = run_case("struct P { x: u32 } function f(p: P): u32 { return p.x; }\n", 414, &d15:ReadWrite)?;
    assert(diag::diagbuf_count(&d15:Read) == 0);

    // ── void 返回携带表达式 ──
    var d16: diag::DiagBuffer = diag::diagbuf_new();
    let r16: typecheck::TypeCheckResult = run_case("function f(): void { return 1; }\n", 415, &d16:ReadWrite)?;
    assert(diag::diagbuf_count(&d16:Read) == 1);
    assert(d16.diags[0].code.raw == 2005);
    return;
}
