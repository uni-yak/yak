    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let a: typecheck::TypeCheckResult = run_case("enum E { A, B } function f(a: E, b: E): void { @drop(a < b); @drop(a <= b); @drop(a > b); @drop(a >= b); }\n", 494, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 4);
