function check_ordering(): void!AllocError {
    var aggregate: diag::DiagBuffer = diag::diagbuf_new();
    let aggregates: typecheck::TypeCheckResult = run_case("struct S { x: u32 } function f(a: [u32; 2], b: u32[], c: &[u8], s: S): void { @drop(a < a); @drop(b <= b); @drop(c > c); @drop(s >= s); @drop(\"a\" < \"b\"); }\n", 508, &aggregate:ReadWrite)?;
