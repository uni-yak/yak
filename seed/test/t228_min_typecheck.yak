    var wrong: diag::DiagBuffer = diag::diagbuf_new();
    let invalid: typecheck::TypeCheckResult = run_case("struct S { x: u32 } function f(r: &S:Read, s: &u32:Read): void { @drop((&r).missing); @drop((&s)[0u32]); }\n", 504, &wrong:ReadWrite)?;
    assert(diag::diagbuf_count(&wrong:Read) == 2 && wrong.diags[0].code.raw == 5001 && wrong.diags[1].code.raw == 5001);
    var explicit: diag::DiagBuffer = diag::diagbuf_new();
    let good: typecheck::TypeCheckResult = run_case("struct S { x: u32 } function f(r: &S:Read, a: &([u32; 2]):Read, s: &u32:Read): void { @drop(r.x); @drop(a[0u32]); @drop((*(&r)).x); @drop((*(&a))[0u32]); @drop(*(*(&s))); }\n", 505, &explicit:ReadWrite)?;
    assert(diag::diagbuf_count(&explicit:Read) == 0);
    return;
}
function check_index_bounds(): void!AllocError {
