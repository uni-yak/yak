import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
foreign assert(cond: bool): void;
foreign write(data: &[u8]): void;
struct Loaded { parsed: parse::ParseResult, lexed: lex::LexResult }
function load(src: &[u8], file: u16): Loaded!AllocError {
    let r: lex::LexResult = lex::lex_scan(src, file)?;
    if @len(r.diagnostics) != 0 { write(src); }
    assert(@len(r.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    return Loaded { parsed: parsed, lexed: r };
}
function run_case(src: &[u8], file: u16, diags: &diag::DiagBuffer:ReadWrite): typecheck::TypeCheckResult!AllocError {
    let loaded: Loaded = load(src, file)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", diags)?;
    return typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, diags)?;
}
function count_expr_builtin(result: &typecheck::TypeCheckResult:Read, builtin: u16): u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    while i < @len(result.expr_types.items) as u32 {
        let id: u32 = result.expr_types.items[i];
        if id != 0 && id <= @len(result.types.entries) as u32 {
            if result.types.entries[id - 1].kind == 1 && result.types.entries[id - 1].builtin == builtin { count = count + 1; }
        }
        i = i + 1;
    }
    return count;
}
function check_expression_types(): void!AllocError {
    // 已知右操作数反向定型，不引入默认整数宽度。
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("function f(x: u32): bool { return 1 + x < 3; }\n", 420, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    assert(count_expr_builtin(&r1:Read, 4099) >= 4);
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("function f(x: u8): u8 { return @wrap_add(1, x); }\n", 421, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    assert(count_expr_builtin(&r2:Read, 4097) >= 3);
    // 枚举 payload 的类型由标签声明给出，而非函数的成功类型。
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("enum E { Bad(u16) } function f(): u32!E { return E::Bad(7); }\n", 422, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 0);
    assert(count_expr_builtin(&r3:Read, 4098) == 1);
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("enum E { Bad(u16) } function f(): u32!E { return E::Bad; }\n", 423, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 1);
    assert(d4.diags[0].code.raw == 5804);
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("enum E { Bad(u16) } function f(): u32!E { return E::Bad(true); }\n", 424, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 1);
    assert(d5.diags[0].code.raw == 5805);
    var empty_ok: diag::DiagBuffer = diag::diagbuf_new();
    let ok: typecheck::TypeCheckResult = run_case("enum E { Empty } function f(): E { return E::Empty; }\n", 450, &empty_ok:ReadWrite)?;
    assert(diag::diagbuf_count(&empty_ok:Read) == 0);
    var empty_call: diag::DiagBuffer = diag::diagbuf_new();
    let wrong: typecheck::TypeCheckResult = run_case("enum E { Empty } function f(): E { return E::Empty(); }\n", 451, &empty_call:ReadWrite)?;
    assert(diag::diagbuf_count(&empty_call:Read) == 1 && empty_call.diags[0].code.raw == 5804);
    // 模块与局部常量的初始化都记录真实表达式类型。
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    let r6: typecheck::TypeCheckResult = run_case("const X: i16 = 4; function f(): i16 { return X; }\n", 425, &d6:ReadWrite)?;
    assert(diag::diagbuf_count(&d6:Read) == 0);
    assert(count_expr_builtin(&r6:Read, 4102) == 2);
    var d7: diag::DiagBuffer = diag::diagbuf_new();
    let r7: typecheck::TypeCheckResult = run_case("function f(): u8 { const K: u8 = 2; return @copy(K); }\n", 426, &d7:ReadWrite)?;
    assert(diag::diagbuf_count(&d7:Read) == 0);
    assert(count_expr_builtin(&r7:Read, 4097) >= 3);
    var d8: diag::DiagBuffer = diag::diagbuf_new();
    let r8: typecheck::TypeCheckResult = run_case("function f(): u16 { return 1 as u16; }\n", 427, &d8:ReadWrite)?;
    assert(diag::diagbuf_count(&d8:Read) == 0);
    assert(count_expr_builtin(&r8:Read, 4098) == 2);
    var d9: diag::DiagBuffer = diag::diagbuf_new();
    let r9: typecheck::TypeCheckResult = run_case("function f(): u8 { return @wrap_add(1u8, 2u16); }\n", 428, &d9:ReadWrite)?;
    assert(diag::diagbuf_count(&d9:Read) == 1);
    assert(d9.diags[0].code.raw == 5001);
    return;
}
function check_propagation(): void!AllocError {
    // 错误集子集可扩大传播；成员不兼容与非 carrier 目标均明确拒绝。
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("enum A { X } enum B { Y } function source(): u32!A { return 1; } function f(): u32!(A | B) { return source()?; }\n", 430, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("enum A { X } enum B { Y } function source(): u32!A { return 1; } function f(): u32!B { return source()?; }\n", 431, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 1);
    assert(d2.diags[0].code.raw == 6007);
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("enum E { Bad } function source(): u32!E { return 1; } function f(): u32 { return source()?; }\n", 432, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 1);
    assert(d3.diags[0].code.raw == 6007);
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("enum E { Bad } function source(): void!E { return; } function f(): void!E { source()?; return; }\n", 433, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 0);
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("enum E { Bad } function source(): u32!E { return 1; } function f(): u32!E { return source(); }\n", 434, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 0);
    return;
}
function check_clone_type(): void!AllocError {
    // 克隆结果携带分配错误，传播时必须检查目标错误集。
    var good: diag::DiagBuffer = diag::diagbuf_new();
    let result: typecheck::TypeCheckResult = run_case("function f(x: u32[]): u32[]!AllocError { return @clone(x); }\n", 450, &good:ReadWrite)?;
    assert(diag::diagbuf_count(&good:Read) == 0);
    var propagated: diag::DiagBuffer = diag::diagbuf_new();
    let p: typecheck::TypeCheckResult = run_case("function f(x: u32[]): u32[]!AllocError { return @clone(x)?; }\n", 451, &propagated:ReadWrite)?;
    assert(diag::diagbuf_count(&propagated:Read) == 0);
    var incompatible: diag::DiagBuffer = diag::diagbuf_new();
    let bad: typecheck::TypeCheckResult = run_case("enum E { Bad } function f(x: u32[]): u32[]!E { return @clone(x)?; }\n", 452, &incompatible:ReadWrite)?;
    assert(diag::diagbuf_count(&incompatible:Read) == 1);
    assert(incompatible.diags[0].code.raw == 6007);
    var wrong_type: diag::DiagBuffer = diag::diagbuf_new();
    let wrong: typecheck::TypeCheckResult = run_case("function f(x: u32[]): void { let y: u32[] = @clone(x); @drop(y); }\n", 454, &wrong_type:ReadWrite)?;
    assert(diag::diagbuf_count(&wrong_type:Read) == 1);
    assert(wrong_type.diags[0].code.raw == 5001);
    var unhandled: diag::DiagBuffer = diag::diagbuf_new();
    let missing: typecheck::TypeCheckResult = run_case("function f(x: u32[]): u32[] { return @clone(x)?; }\n", 453, &unhandled:ReadWrite)?;
    assert(diag::diagbuf_count(&unhandled:Read) == 1);
    assert(unhandled.diags[0].code.raw == 6007);
    return;
}
function check_integer_ranges(): void!AllocError {
    // 直接取负的有符号最小值合法，正数必须位于目标范围。
    var good: diag::DiagBuffer = diag::diagbuf_new();
    let a: typecheck::TypeCheckResult = run_case("function f(): void { let a: i8 = -128; let b: i16 = -32768i16; let c: i32 = -2147483648; let d: i64 = -9223372036854775808i64; let e: u8 = 255; @drop(a); @drop(b); @drop(c); @drop(d); @drop(e); }\n", 470, &good:ReadWrite)?;
    assert(diag::diagbuf_count(&good:Read) == 0);
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let b: typecheck::TypeCheckResult = run_case("function f(): void { let a: u8 = 256; let b: i8 = 128i8; let c: i16 = 32768; let d: i32 = 2147483648i32; let e: i64 = 9223372036854775808; @drop(a); @drop(b); @drop(c); @drop(d); @drop(e); }\n", 471, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 5);
    var i: u32 = 0;
    while i < diag::diagbuf_count(&bad:Read) { assert(bad.diags[i].code.raw == 1004); i = i + 1; }
    var nested: diag::DiagBuffer = diag::diagbuf_new();
    let c: typecheck::TypeCheckResult = run_case("function f(x: u8): bool { let a: u16[] = [65536]; @drop(a); return 256 == x; }\n", 472, &nested:ReadWrite)?;
    assert(diag::diagbuf_count(&nested:Read) == 2);
    assert(nested.diags[0].code.raw == 1004 && nested.diags[1].code.raw == 1004);
    var constants: diag::DiagBuffer = diag::diagbuf_new();
    let d: typecheck::TypeCheckResult = run_case("const bad: u8 = 256; function f(): u8 { return bad; }\n", 473, &constants:ReadWrite)?;
    assert(diag::diagbuf_count(&constants:Read) == 1);
    assert(constants.diags[0].code.raw == 1004);
    var lower: diag::DiagBuffer = diag::diagbuf_new();
    let e: typecheck::TypeCheckResult = run_case("function f(): i16 { return -32769; }\n", 474, &lower:ReadWrite)?;
    assert(diag::diagbuf_count(&lower:Read) == 1 && lower.diags[0].code.raw == 1004);
    return;
}
function check_array_types(): void!AllocError {
    // 动态数组的元素和空字面量均由预期类型定型。
    var good: diag::DiagBuffer = diag::diagbuf_new();
    let result: typecheck::TypeCheckResult = run_case("function f(): void { let a: u32[] = []; let b: u16[] = [1, 2]; let c: [u8; 2] = [3, 4]; let d: u16[][] = [[5], []]; @drop(a); @drop(b); @drop(c); @drop(d); return; }\n", 460, &good:ReadWrite)?;
    assert(diag::diagbuf_count(&good:Read) == 0);
    assert(count_expr_builtin(&result:Read, 4098) >= 2);
    // 后续已定型的元素必须约束前面尚未定型的整数字面量。
    var inferred: diag::DiagBuffer = diag::diagbuf_new();
    let backward: typecheck::TypeCheckResult = run_case("function f(): void { @drop([1, 2u8]); }\n", 464, &inferred:ReadWrite)?;
    assert(diag::diagbuf_count(&inferred:Read) == 0);
    assert(count_expr_builtin(&backward:Read, 4097) == 2);
    var overflow: diag::DiagBuffer = diag::diagbuf_new();
    let too_large: typecheck::TypeCheckResult = run_case("function f(): void { @drop([256, 1u8]); }\n", 465, &overflow:ReadWrite)?;
    assert(diag::diagbuf_count(&overflow:Read) == 1 && overflow.diags[0].code.raw == 1004);
    // 直接负号与操作数都必须从后续元素取得同一类型。
    var signed: diag::DiagBuffer = diag::diagbuf_new();
    let minimum: typecheck::TypeCheckResult = run_case("function f(): void { @drop([-128, 0i8]); }\n", 468, &signed:ReadWrite)?;
    assert(diag::diagbuf_count(&signed:Read) == 0);
    assert(count_expr_builtin(&minimum:Read, 4101) == 3);
    var underflow: diag::DiagBuffer = diag::diagbuf_new();
    let below: typecheck::TypeCheckResult = run_case("function f(): void { @drop([-129, 0i8]); }\n", 469, &underflow:ReadWrite)?;
    assert(diag::diagbuf_count(&underflow:Read) == 1 && underflow.diags[0].code.raw == 1004);
    var several: diag::DiagBuffer = diag::diagbuf_new();
    let limits: typecheck::TypeCheckResult = run_case("function f(): void { @drop([-32768, -1, 0i16]); }\n", 475, &several:ReadWrite)?;
    assert(diag::diagbuf_count(&several:Read) == 0 && count_expr_builtin(&limits:Read, 4102) == 5);
    var different: diag::DiagBuffer = diag::diagbuf_new();
    let mismatch_signed: typecheck::TypeCheckResult = run_case("function f(): void { @drop([-1i16, 0i8]); }\n", 476, &different:ReadWrite)?;
    assert(diag::diagbuf_count(&different:Read) == 1 && different.diags[0].code.raw == 5001);
    // 后续元素的类型传入前面的纯整数算术树。
    var arithmetic: diag::DiagBuffer = diag::diagbuf_new();
    let expression: typecheck::TypeCheckResult = run_case("function f(): void { @drop([1 + 2 * 3, 0u8]); }\n", 477, &arithmetic:ReadWrite)?;
    assert(diag::diagbuf_count(&arithmetic:Read) == 0 && count_expr_builtin(&expression:Read, 4097) == 6);
    // 后续元素也能约束纯整数回绕原语的返回值和实参。
    var wraps: diag::DiagBuffer = diag::diagbuf_new();
    let wrap_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([@wrap_add(1, 2), 0u8]); }\n", 502, &wraps:ReadWrite)?;
    assert(diag::diagbuf_count(&wraps:Read) == 0 && count_expr_builtin(&wrap_result:Read, 4097) == 4);
    var wraps_range: diag::DiagBuffer = diag::diagbuf_new();
    let wrap_bad: typecheck::TypeCheckResult = run_case("function f(): void { @drop([@wrap_add(256, 1), 0u8]); }\n", 503, &wraps_range:ReadWrite)?;
    assert(diag::diagbuf_count(&wraps_range:Read) == 1 && wraps_range.diags[0].code.raw == 1004);
    var wraps_deep: diag::DiagBuffer = diag::diagbuf_new();
    let wrap_deep: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[@wrap_sub(@wrap_mul(-129, 2), 3)], [0i8]]); }\n", 504, &wraps_deep:ReadWrite)?;
    assert(diag::diagbuf_count(&wraps_deep:Read) == 1 && wraps_deep.diags[0].code.raw == 1004);
    var wraps_invalid: diag::DiagBuffer = diag::diagbuf_new();
    let wrap_invalid: typecheck::TypeCheckResult = run_case("function f(): void { @drop([@wrap_add(), 0u8]); }\n", 505, &wraps_invalid:ReadWrite)?;
    assert(diag::diagbuf_count(&wraps_invalid:Read) == 1 && wraps_invalid.diags[0].code.raw == 5001);
    var wraps_array: diag::DiagBuffer = diag::diagbuf_new();
    let wrap_array: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[@wrap_add([], []), @clone()], [0u8]]); }\n", 506, &wraps_array:ReadWrite)?;
    assert(diag::diagbuf_count(&wraps_array:Read) == 1 && wraps_array.diags[0].code.raw == 5001);
    var arithmetic_range: diag::DiagBuffer = diag::diagbuf_new();
    let expression_bad: typecheck::TypeCheckResult = run_case("function f(): void { @drop([256 + 1, 0u8]); }\n", 478, &arithmetic_range:ReadWrite)?;
    assert(diag::diagbuf_count(&arithmetic_range:Read) == 1 && arithmetic_range.diags[0].code.raw == 1004);
    var negative_expr: diag::DiagBuffer = diag::diagbuf_new();
    let nested_signed: typecheck::TypeCheckResult = run_case("function f(): void { @drop([-129 + 1, 0i8]); }\n", 479, &negative_expr:ReadWrite)?;
    assert(diag::diagbuf_count(&negative_expr:Read) == 1 && negative_expr.diags[0].code.raw == 1004);
    var unrelated: diag::DiagBuffer = diag::diagbuf_new();
    let invalid_expr: typecheck::TypeCheckResult = run_case("function f(): void { @drop([true + 1, 0u8]); }\n", 480, &unrelated:ReadWrite)?;
    assert(diag::diagbuf_count(&unrelated:Read) == 2 && unrelated.diags[0].code.raw == 5001 && unrelated.diags[1].code.raw == 5001);
    // 内层数组的元素类型也可由后续同层数组提供。
    var nested_inferred: diag::DiagBuffer = diag::diagbuf_new();
    let nested_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[1], [2u8]]); }\n", 481, &nested_inferred:ReadWrite)?;
    assert(diag::diagbuf_count(&nested_inferred:Read) == 0 && count_expr_builtin(&nested_result:Read, 4097) == 2);
    var nested_range: diag::DiagBuffer = diag::diagbuf_new();
    let nested_bad: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[256], [2u8]]); }\n", 482, &nested_range:ReadWrite)?;
    assert(diag::diagbuf_count(&nested_range:Read) == 1 && nested_range.diags[0].code.raw == 1004);
    var empty_first: diag::DiagBuffer = diag::diagbuf_new();
    let empty_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[], [2u8]]); }\n", 483, &empty_first:ReadWrite)?;
    assert(diag::diagbuf_count(&empty_first:Read) == 0);
    var deep: diag::DiagBuffer = diag::diagbuf_new();
    let deep_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[1 + 2]], [[3u8]]]); }\n", 484, &deep:ReadWrite)?;
    assert(diag::diagbuf_count(&deep:Read) == 0 && count_expr_builtin(&deep_result:Read, 4097) == 4);
    var shape: diag::DiagBuffer = diag::diagbuf_new();
    let shape_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[]], [1u8]]); }\n", 486, &shape:ReadWrite)?;
    assert(diag::diagbuf_count(&shape:Read) > 0 && shape.diags[0].code.raw == 5001);
    // 即使元素无法定型，数组形状仍与后续标量不兼容。
    var nonpure: diag::DiagBuffer = diag::diagbuf_new();
    let nonpure_shape: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[@clone(1)], true]); }\n", 491, &nonpure:ReadWrite)?;
    assert(diag::diagbuf_count(&nonpure:Read) == 1 && nonpure.diags[0].code.raw == 5001);
    var nonpure_deep: diag::DiagBuffer = diag::diagbuf_new();
    let deep_shape: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[@clone(1)]], [1u8]]); }\n", 494, &nonpure_deep:ReadWrite)?;
    assert(diag::diagbuf_count(&nonpure_deep:Read) == 1 && nonpure_deep.diags[0].code.raw == 5001);
    // 仅对独立的纯整数子树回填类型，不重推旁边的错误调用。
    var mixed_range: diag::DiagBuffer = diag::diagbuf_new();
    let mixed_range_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[256, @clone()], [2u8]]); }\n", 498, &mixed_range:ReadWrite)?;
    assert(diag::diagbuf_count(&mixed_range:Read) == 2 && mixed_range.diags[0].code.raw == 5001 && mixed_range.diags[1].code.raw == 1004);
    var mixed_deep: diag::DiagBuffer = diag::diagbuf_new();
    let mixed_deep_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[-129 + 1, @clone()]], [[0i8]]]); }\n", 499, &mixed_deep:ReadWrite)?;
    assert(diag::diagbuf_count(&mixed_deep:Read) == 2 && mixed_deep.diags[0].code.raw == 5001 && mixed_deep.diags[1].code.raw == 1004);
    var mixed_good: diag::DiagBuffer = diag::diagbuf_new();
    let mixed_good_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[-128, @clone(256)]], [[0i8]]]); }\n", 500, &mixed_good:ReadWrite)?;
    assert(diag::diagbuf_count(&mixed_good:Read) == 0 && count_expr_builtin(&mixed_good_result:Read, 4101) == 3);
    var mixed_shape: diag::DiagBuffer = diag::diagbuf_new();
    let mixed_shape_result: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[1], @clone()], [2u8]]); }\n", 501, &mixed_shape:ReadWrite)?;
    assert(diag::diagbuf_count(&mixed_shape:Read) == 2 && mixed_shape.diags[0].code.raw == 5001 && mixed_shape.diags[1].code.raw == 5001);
    var nonpure_same: diag::DiagBuffer = diag::diagbuf_new();
    let same_shape: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[@clone(1)]], [[2u8]]]); }\n", 495, &nonpure_same:ReadWrite)?;
    assert(diag::diagbuf_count(&nonpure_same:Read) == 0);
    var nonpure_multiple: diag::DiagBuffer = diag::diagbuf_new();
    let multiple_shape: typecheck::TypeCheckResult = run_case("function f(): void { @drop([[[@clone()], [@clone()]], [1u8]]); }\n", 496, &nonpure_multiple:ReadWrite)?;
    assert(diag::diagbuf_count(&nonpure_multiple:Read) == 4);
    var nonpure_fixed: diag::DiagBuffer = diag::diagbuf_new();
    let fixed_shape: typecheck::TypeCheckResult = run_case("function pair(): [u8; 2] { return [1u8, 2u8]; } function f(): void { @drop([[@clone(1)], pair()]); }\n", 497, &nonpure_fixed:ReadWrite)?;
    assert(diag::diagbuf_count(&nonpure_fixed:Read) == 1 && nonpure_fixed.diags[0].code.raw == 5001);
    var nonpure_reverse: diag::DiagBuffer = diag::diagbuf_new();
