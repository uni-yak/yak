    var length: diag::DiagBuffer = diag::diagbuf_new();
    let short: typecheck::TypeCheckResult = run_case("function f(): void { let a: [u32; 2] = [1u32]; @drop(a); return; }\n", 463, &length:ReadWrite)?;
    assert(diag::diagbuf_count(&length:Read) == 1);
    assert(length.diags[0].code.raw == 5001);
    return;
}
function check_foreign_services(): void!AllocError {
    // 名称与固定签名共同决定服务身份，参数拼写和无分配标记不改变身份。
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("enum Marker { Tag } foreign #exit(status: u8): void; foreign #assert(flag: bool): void; foreign read(dst: &[u8]:ReadWrite): u32; foreign write(src: &[u8]): void;\n", 440, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);
    assert(@len(r1.funcs.items) == 4);
    assert(r1.funcs.items[0].def == 2);
    assert(r1.funcs.items[0].service == 1);
    assert(r1.funcs.items[1].service == 2);
    assert(r1.funcs.items[2].service == 3);
    assert(r1.funcs.items[3].service == 4);
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("foreign #args_count(): u32; foreign args_len(index: u32): u32; foreign args_read(index: u32, dst: &[u8]:ReadWrite): u32; foreign file_size(name: &[u8]): u64; foreign file_read(name: &[u8], offset: u64, dst: &[u8]:ReadWrite): u32; foreign file_write(name: &[u8], data: &[u8]): void;\n", 441, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    assert(@len(r2.funcs.items) == 6);
    var i: u32 = 0;
    while i < 6 { assert(r2.funcs.items[i].service as u32 == 16 + i); i = i + 1; }
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("foreign leave(code: u8): void;\n", 442, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 1);
    assert(d3.diags[0].code.raw == 8001);
    assert(r3.funcs.items[0].service == 0);
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("foreign exit(code: u32): void;\n", 443, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 1);
    assert(d4.diags[0].code.raw == 8001);
    assert(r4.funcs.items[0].service == 0);
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("foreign read(dst: &[u8]:ReadWrite): u64;\n", 444, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 1);
    assert(d5.diags[0].code.raw == 8001);
    assert(r5.funcs.items[0].service == 0);
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    let r6: typecheck::TypeCheckResult = run_case("foreign write(data: &[u8]:ReadWrite): void;\n", 445, &d6:ReadWrite)?;
    assert(diag::diagbuf_count(&d6:Read) == 1);
    assert(d6.diags[0].code.raw == 8001);
    assert(r6.funcs.items[0].service == 0);
    return;
}
function check_cast_whitelist(): void!AllocError {
    // ── 整数之间的显式转换允许 ──
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("function f(x: u32): u8 { return x as u8; }\n", 420, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);

    // ── char 与 u32 双向允许 ──
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("function f(c: char): u32 { return c as u32; }\n", 421, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 0);
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("function f(x: u32): char { return x as char; }\n", 422, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 0);

    // ── 编译期已知的代理对码点转 char 必须在检查期拒绝，变量转换保持合法 ──
    var d8: diag::DiagBuffer = diag::diagbuf_new();
    let r8: typecheck::TypeCheckResult = run_case("function f(): char { return 55296u32 as char; }\n", 427, &d8:ReadWrite)?;
    assert(diag::diagbuf_count(&d8:Read) == 1);
    var d9: diag::DiagBuffer = diag::diagbuf_new();
    let r9: typecheck::TypeCheckResult = run_case("function f(): char { return 57343u32 as char; }\n", 428, &d9:ReadWrite)?;
    assert(diag::diagbuf_count(&d9:Read) == 1);
    var d10: diag::DiagBuffer = diag::diagbuf_new();
    let r10: typecheck::TypeCheckResult = run_case("function f(): char { return 57344u32 as char; }\n", 429, &d10:ReadWrite)?;
    assert(diag::diagbuf_count(&d10:Read) == 0);
    var d11: diag::DiagBuffer = diag::diagbuf_new();
    let r11: typecheck::TypeCheckResult = run_case("function f(): char { return 55295u32 as char; }\n", 430, &d11:ReadWrite)?;
    assert(diag::diagbuf_count(&d11:Read) == 0);

    // ── char 与其他整数必须经 u32 中转 ──
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("function f(c: char): u8 { return c as u8; }\n", 423, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 1);

    // ── 整数转 bool 不在白名单 ──
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("function f(x: u32): bool { return x as bool; }\n", 424, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 1);

    // ── bool 转整数不在白名单 ──
    var d6: diag::DiagBuffer = diag::diagbuf_new();
    let r6: typecheck::TypeCheckResult = run_case("function f(b: bool): u32 { return b as u32; }\n", 425, &d6:ReadWrite)?;
    assert(diag::diagbuf_count(&d6:Read) == 1);

    // 枚举与整数双向转换使用专有码；其他枚举转换继续使用通用码。
    var d7: diag::DiagBuffer = diag::diagbuf_new();
    let r7: typecheck::TypeCheckResult = run_case("enum E { A } function from_int(x: u32): E { return x as E; } function to_int(x: E): i16 { return x as i16; }\n", 426, &d7:ReadWrite)?;
    assert(diag::diagbuf_count(&d7:Read) == 2 && d7.diags[0].code.raw == 5808 && d7.diags[1].code.raw == 5808);
    var enum_other: diag::DiagBuffer = diag::diagbuf_new();
    let enum_other_result: typecheck::TypeCheckResult = run_case("enum E { A } enum F { A } function same(x: E): E { return x as E; } function distinct(x: E): F { return x as F; } function boolean(x: E): bool { return x as bool; } function character(x: char): E { return x as E; }\n", 431, &enum_other:ReadWrite)?;
    assert(diag::diagbuf_count(&enum_other:Read) == 4);
    assert(enum_other.diags[0].code.raw == 5001 && enum_other.diags[1].code.raw == 5001 && enum_other.diags[2].code.raw == 5001 && enum_other.diags[3].code.raw == 5001);
    return;
}
function check_match_rules(): void!AllocError {
    // 已知非枚举和值载体分别使用规格规定的诊断。
    var scalar_match: diag::DiagBuffer = diag::diagbuf_new();
    let scalar_result: typecheck::TypeCheckResult = run_case("function f(x: u32): void { match x { _ => { return; } } }\n", 494, &scalar_match:ReadWrite)?;
    assert(diag::diagbuf_count(&scalar_match:Read) == 1 && scalar_match.diags[0].code.raw == 6001);
    var struct_match: diag::DiagBuffer = diag::diagbuf_new();
    let struct_result: typecheck::TypeCheckResult = run_case("struct S { x: u32 } function f(s: S): void { match s { _ => { return; } } }\n", 495, &struct_match:ReadWrite)?;
    assert(diag::diagbuf_count(&struct_match:Read) == 1 && struct_match.diags[0].code.raw == 6001);
    var ref_match: diag::DiagBuffer = diag::diagbuf_new();
    let ref_result: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: &E:Read): void { match e { _ => { return; } } }\n", 496, &ref_match:ReadWrite)?;
    assert(diag::diagbuf_count(&ref_match:Read) == 1 && ref_match.diags[0].code.raw == 6001);
    var carrier_match: diag::DiagBuffer = diag::diagbuf_new();
    let carrier_result: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: u32!E): void { match e { _ => { return; } } }\n", 497, &carrier_match:ReadWrite)?;
    assert(diag::diagbuf_count(&carrier_match:Read) == 1 && carrier_match.diags[0].code.raw == 2012);
    // 裸标签使用 scrutinee 的成员表，并与完整路径共享覆盖状态。
    var bare_ok: diag::DiagBuffer = diag::diagbuf_new();
    let bare_types: typecheck::TypeCheckResult = run_case("enum E { A(u16), B } function f(e: E): u16 { match e { A(v) => { return v; }, B => { return 0; } } }\n", 490, &bare_ok:ReadWrite)?;
    assert(!bare_ok.has_error);
    // 同名局部变量不能改变标签解析，遗漏标签仍须报告非穷尽。
    var bare_shadow: diag::DiagBuffer = diag::diagbuf_new();
    let shadow_types: typecheck::TypeCheckResult = run_case("enum E { A(u16), B } function f(e: E, A: u32): u16 { A; match e { A(v) => { return v; }, B => { return 0; } } }\n", 498, &bare_shadow:ReadWrite)?;
    assert(!bare_shadow.has_error);
    var bare_unused: diag::DiagBuffer = diag::diagbuf_new();
    let unused_types: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: E, A: u32): void { match e { A => { return; } } }\n", 500, &bare_unused:ReadWrite)?;
    assert(diag::diagbuf_count(&bare_unused:Read) == 1 && bare_unused.diags[0].code.raw == 4009);
    var bare_incomplete: diag::DiagBuffer = diag::diagbuf_new();
    let incomplete_types: typecheck::TypeCheckResult = run_case("enum E { A, B } function f(e: E): void { match e { A => { return; } } }\n", 499, &bare_incomplete:ReadWrite)?;
    assert(diag::diagbuf_count(&bare_incomplete:Read) == 1 && bare_incomplete.diags[0].code.raw == 2002);
    var bare_missing: diag::DiagBuffer = diag::diagbuf_new();
    let bare_wrong: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: E): void { match e { Missing => { return; }, _ => { return; } } }\n", 491, &bare_missing:ReadWrite)?;
    assert(diag::diagbuf_count(&bare_missing:Read) == 1 && bare_missing.diags[0].code.raw == 2013);
    var bare_duplicate: diag::DiagBuffer = diag::diagbuf_new();
    let duplicate_types: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: E): void { match e { A => { return; }, E::A => { return; } } }\n", 492, &bare_duplicate:ReadWrite)?;
    assert(diag::diagbuf_count(&bare_duplicate:Read) == 1 && bare_duplicate.diags[0].code.raw == 2014);
    var bare_binding: diag::DiagBuffer = diag::diagbuf_new();
    let binding_types: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: E): void { match e { A(v) => { v; } } }\n", 493, &bare_binding:ReadWrite)?;
    assert(diag::diagbuf_count(&bare_binding:Read) == 1 && bare_binding.diags[0].code.raw == 2003);
    var payload_diags: diag::DiagBuffer = diag::diagbuf_new();
    let payload_types: typecheck::TypeCheckResult = run_case("enum E { A(u16), B } function f(e: E): u16 { match e { E::A(v) => { return v; }, E::B => { return 0; } } }\n", 435, &payload_diags:ReadWrite)?;
    assert(!payload_diags.has_error);
    var empty_diags: diag::DiagBuffer = diag::diagbuf_new();
    let empty_types: typecheck::TypeCheckResult = run_case("enum E { A } function f(e: E): void { match e { E::A(v) => { v; } } }\n", 436, &empty_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&empty_diags:Read) == 1 && empty_diags.diags[0].code.raw == 2003);
    // ── 穷尽全部标签，无需通配臂 ──
    var d1: diag::DiagBuffer = diag::diagbuf_new();
    let r1: typecheck::TypeCheckResult = run_case("enum E { A, B }\nfunction f(e: E): u32 { match e { E::A => { return 1; }, E::B => { return 2; } } }\n", 430, &d1:ReadWrite)?;
    assert(diag::diagbuf_count(&d1:Read) == 0);

    // ── 缺少标签报 P-2 ──
    var d2: diag::DiagBuffer = diag::diagbuf_new();
    let r2: typecheck::TypeCheckResult = run_case("enum E { A, B }\nfunction f(e: E): u32 { match e { E::A => { return 1; } } }\n", 431, &d2:ReadWrite)?;
    assert(diag::diagbuf_count(&d2:Read) == 1);
    assert(d2.diags[0].code.raw == 2002);

    // ── 通配臂覆盖剩余标签 ──
    var d3: diag::DiagBuffer = diag::diagbuf_new();
    let r3: typecheck::TypeCheckResult = run_case("enum E { A, B }\nfunction f(e: E): u32 { match e { E::A => { return 1; }, _ => { return 2; } } }\n", 432, &d3:ReadWrite)?;
    assert(diag::diagbuf_count(&d3:Read) == 0);

    // ── 重复标签报 P-14 ──
    var d4: diag::DiagBuffer = diag::diagbuf_new();
    let r4: typecheck::TypeCheckResult = run_case("enum E { A, B }\nfunction f(e: E): u32 { match e { E::A => { return 1; }, E::A => { return 2; }, E::B => { return 3; } } }\n", 433, &d4:ReadWrite)?;
    assert(diag::diagbuf_count(&d4:Read) == 1);
    assert(d4.diags[0].code.raw == 2014);

    // ── 通配臂后仍有 arm 报 P-14 ──
    var d5: diag::DiagBuffer = diag::diagbuf_new();
    let r5: typecheck::TypeCheckResult = run_case("enum E { A, B }\nfunction f(e: E): u32 { match e { _ => { return 1; }, E::A => { return 2; } } }\n", 434, &d5:ReadWrite)?;
    assert(diag::diagbuf_count(&d5:Read) == 1);
    assert(d5.diags[0].code.raw == 2014);
    return;
}
function check_array_comparisons(): void!AllocError {
