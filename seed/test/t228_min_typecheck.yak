    assert(diag::diagbuf_count(&conflict:Read) == 1 && conflict.diags[0].code.raw == 5001);
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let mixed: typecheck::TypeCheckResult = run_case("function f(): void { let a: u32[] = [1u32, true]; @drop(a); return; }\n", 461, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 1);
    assert(bad.diags[0].code.raw == 5001);
    var fixed: diag::DiagBuffer = diag::diagbuf_new();
