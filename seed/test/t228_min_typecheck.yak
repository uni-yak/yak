function check_cast_truncation(): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: typecheck::TypeCheckResult = run_case("const K: u32 = 65536u32; function f(x: u32): void { @drop(256u16 as u8); @drop(K as u16); @drop((255u16 + 1u16) as u8); @drop(4294967296u64 as u32); @drop(255u16 as u8); @drop(65535u32 as u16); @drop(0u64 as u8); @drop(x as u8); @drop(256u16 as u32); }\n", 475, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) == 4);
    var i: u32 = 0;
    while i < 4 { assert(diags.diags[i].code.raw == 5004); i = i + 1; }
    var mixed: diag::DiagBuffer = diag::diagbuf_new();
    let converted: typecheck::TypeCheckResult = run_case("const K: u64 = 4294967296u64; function f(x: u16): void { @drop(256u16 as i8); @drop(65536u32 as i16); @drop(K as i32); @drop(255u16 as i8); @drop(65535u32 as i16); @drop(4294967295u64 as i32); @drop(x as i8); @drop(256u16 as i32); @drop(65535u16 as i16); }\n", 477, &mixed:ReadWrite)?;
    assert(diag::diagbuf_count(&mixed:Read) == 3);
    i = 0; while i < 3 { assert(mixed.diags[i].code.raw == 5004); i = i + 1; }
    var positive: diag::DiagBuffer = diag::diagbuf_new();
    let signed: typecheck::TypeCheckResult = run_case("const K: i64 = 4294967296i64; function f(x: i16): void { @drop(256i16 as u8); @drop(65536i32 as i16); @drop(K as u32); @drop(255i16 as u8); @drop(0i16 as i8); @drop(x as u8); @drop((-1i16) as u8); @drop((-32768i16) as i8); @drop((-2147483648i32) as u16); @drop((-9223372036854775808i64) as i32); @drop(256i16 as i16); }\n", 478, &positive:ReadWrite)?;
    assert(diag::diagbuf_count(&positive:Read) == 3);
    i = 0; while i < 3 { assert(positive.diags[i].code.raw == 5004); i = i + 1; }
    var nested: diag::DiagBuffer = diag::diagbuf_new();
    let chain: typecheck::TypeCheckResult = run_case("function f(a: [u8; 2], x: u8): void { @drop(a[(2u8 as u16) as u64]); @drop(a[((-1i8) as i16) as i64]); @drop(a[(1u8 as u16) as u64]); @drop(a[(x as u16) as u64]); @drop((256u16 as u32) as u8); @drop(a[(256u16 as u8) as u64]); @drop(a[((-1i8) as u8) as u64]); }\n", 479, &nested:ReadWrite)?;
    assert(diag::diagbuf_count(&nested:Read) == 5);
    var found_bounds: u32 = 0; var found_cast: u32 = 0;
    i = 0; while i < 5 { if nested.diags[i].code.raw == 6002 { found_bounds = found_bounds + 1; } if nested.diags[i].code.raw == 5004 { found_cast = found_cast + 1; } i = i + 1; }
    assert(found_bounds == 3 && found_cast == 2);
    var repeated: diag::DiagBuffer = diag::diagbuf_new();
    let cached: typecheck::TypeCheckResult = run_case("function f(): void { @drop(((((((1u8 as u64) as u8) as u64) as u8) as u64) as u8) as u64) as u8); }\n", 480, &repeated:ReadWrite)?;
    assert(diag::diagbuf_count(&repeated:Read) == 0);
    assert(@len(cached.consts.values) == 1);
    var shared: diag::DiagBuffer = diag::diagbuf_new();
    let reuse: typecheck::TypeCheckResult = run_case("function f(a: [u8; 2], x: u8): void { @drop(a[((1u8 as u64) as u8) as u64]); @drop(a[((x as u64) as u8) as u64]); @drop(a[(((1u16 / 0u16) as u64) as u8) as u64]); }\n", 481, &shared:ReadWrite)?;
    assert(diag::diagbuf_count(&shared:Read) == 0);
    assert(@len(reuse.consts.values) == 3);
    var retry: diag::DiagBuffer = diag::diagbuf_new();
    let next: typecheck::TypeCheckResult = run_case("const K: u16 = 256u16; function f(x: u16): void { @drop((1u16 / 0u16) as u8); @drop((65535u16 + 1u16) as u8); @drop((x + K) as u8); @drop(K as u8); }\n", 476, &retry:ReadWrite)?;
    assert(diag::diagbuf_count(&retry:Read) == 1 && retry.diags[0].code.raw == 5004);
    return;
}
function check_projection_deref_depth(): void!AllocError {
    // 仅当继续解引用会得到有效投影时才使用专有码。
    var nested: diag::DiagBuffer = diag::diagbuf_new();
