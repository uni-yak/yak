    assert(diag::diagbuf_count(&reference:Read) == 2);
    assert(reference.diags[0].code.raw == 6002 && reference.diags[1].code.raw == 6002);
    var limits: diag::DiagBuffer = diag::diagbuf_new();
    let d: typecheck::TypeCheckResult = run_case("function f(a: [u8; 2], i: u8): u8 { @drop(a[18446744073709551615u64]); @drop(a[-128i8]); @drop(a[-32768i16]); @drop(a[-2147483648i32]); @drop(a[-9223372036854775808i64]); @drop(a[i + 1u8]); @drop(a[1u8 / 0u8]); return a[1]; }\n", 473, &limits:ReadWrite)?;
    assert(diag::diagbuf_count(&limits:Read) == 5);
    i = 0; while i < 5 { assert(limits.diags[i].code.raw == 6002); i = i + 1; }
    var casts: diag::DiagBuffer = diag::diagbuf_new();
    let e: typecheck::TypeCheckResult = run_case("function f(a: [u8; 2], x: i8): u8 { @drop(a[2u8 as u64]); @drop(a[(-1i8) as i64]); @drop(a[(-1i8) as u64]); @drop(a[258u16 as u8]); @drop(a[x as i64]); @drop(a[1u8 as u64]); @drop(a[256u16 as u8]); return a[0]; }\n", 474, &casts:ReadWrite)?;
    assert(diag::diagbuf_count(&casts:Read) == 6);
    assert(casts.diags[0].code.raw == 5004 && casts.diags[1].code.raw == 5004);
    i = 2; while i < 6 { assert(casts.diags[i].code.raw == 6002); i = i + 1; }
