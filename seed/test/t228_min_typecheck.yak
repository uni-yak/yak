function check_enum_payload_comparisons(): void!AllocError {
    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let a: typecheck::TypeCheckResult = run_case("struct S { x: u32 } enum E { Empty, Value(S) } function f(a: E, b: E): void { @drop(a == b); @drop(a != b); }\n", 496, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 2);
    assert(bad.diags[0].code.raw == 5809 && bad.diags[1].code.raw == 5809);
    var arrays: diag::DiagBuffer = diag::diagbuf_new();
    let c: typecheck::TypeCheckResult = run_case("enum Fixed { Empty, Value([u32; 2]) } enum Dynamic { Empty, Value(u32[]) } function f(a: Fixed, b: Fixed, x: Dynamic, y: Dynamic): void { @drop(a == b); @drop(a != b); @drop(x == y); @drop(x != y); }\n", 498, &arrays:ReadWrite)?;
    assert(diag::diagbuf_count(&arrays:Read) == 4);
    var i: u32 = 0; while i < 4 { assert(arrays.diags[i].code.raw == 5809); i = i + 1; }
    var nested: diag::DiagBuffer = diag::diagbuf_new();
    let n: typecheck::TypeCheckResult = run_case("struct S { x: u32 } enum Inner { A, B(S) } enum Middle { A(Inner), B } enum Outer { A, B(Middle) } function f(a: Outer, b: Outer): void { @drop(a == b); @drop(a != b); }\n", 499, &nested:ReadWrite)?;
    assert(diag::diagbuf_count(&nested:Read) == 2 && nested.diags[0].code.raw == 5809 && nested.diags[1].code.raw == 5809);
    var nested_array: diag::DiagBuffer = diag::diagbuf_new();
    let na: typecheck::TypeCheckResult = run_case("enum Inner { A([u32; 2]), B } enum Outer { A(Inner), B } function f(a: Outer, b: Outer): void { @drop(a == b); @drop(a != b); }\n", 501, &nested_array:ReadWrite)?;
    assert(diag::diagbuf_count(&nested_array:Read) == 2 && nested_array.diags[0].code.raw == 5809 && nested_array.diags[1].code.raw == 5809);
    var valid: diag::DiagBuffer = diag::diagbuf_new();
    let v: typecheck::TypeCheckResult = run_case("enum Inner { A, B(u32) } enum Outer { A(Inner), B } function f(a: Outer, b: Outer): void { @drop(a == b); @drop(a != b); }\n", 500, &valid:ReadWrite)?;
    assert(diag::diagbuf_count(&valid:Read) == 0);
    var good: diag::DiagBuffer = diag::diagbuf_new();
    let b: typecheck::TypeCheckResult = run_case("enum E { Empty, Number(u32), Flag(bool) } function f(a: E, b: E): void { @drop(a == b); @drop(a != b); }\n", 497, &good:ReadWrite)?;
    assert(diag::diagbuf_count(&good:Read) == 0);
    return;
}
