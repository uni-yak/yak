    var bad: diag::DiagBuffer = diag::diagbuf_new();
    let a: typecheck::TypeCheckResult = run_case("const K: u16 = 2; function f(i: u32): u8 { let a: [u8; 2] = [1u8, 2u8]; const L: i8 = -1; @drop(a[2]); @drop(a[-1]); @drop(a[2u8]); @drop(a[L]); @drop(a[K + 1u16]); return a[i]; }\n", 470, &bad:ReadWrite)?;
    assert(diag::diagbuf_count(&bad:Read) == 5);
