import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import typecheck_body;
import typecheck_shape;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

// 单独核对字段、定义、载荷与队列候选的总步数。
function small_steps(src: &[u8], steps: u32, expected: u16, document: bool): void!AllocError {
    let lexed: lex::LexResult = lex::lex_scan(src, 121u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 121u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var name_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &name_diags:ReadWrite)?;
    assert(name_diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= steps + 1u32 {
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        var shape: typecheck_shape::BodyInferenceBudget = typecheck_shape::body_inference_budget(0u32, 0u32, 0u32, 0u32, 0u32, 0u32, limit);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_with_body_budget(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite, &shape:ReadWrite, document)?;
        assert(typecheck_shape::body_equality_exceeded(&shape:Read) == (limit < steps));
        if limit < steps { assert(@len(checked.expr_types.items) == 0 && shape.equality_remaining == 0u32 && diags.count == 0u32); }
        else {
            assert(@len(checked.expr_types.items) == @len(parsed.pool.exprs) && shape.equality_remaining == limit - steps);
            if expected == 0u16 { assert(diags.count == 0u32); }
            else { assert(diags.count == 1u32 && diags.diags[0].code.raw == expected); }
        }
        limit = limit + 1u32;
    }
    return;
}

// 前 31 次各比较两条枚举行并读 30 个槽；末次比较一行并读 31 或 32 个槽。
function boundary(over: bool, bad: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&text:ReadWrite, "enum E { V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29 }\nenum Q { V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28")?;
    if over { buf::buf_push_bytes(&text:ReadWrite, ", Pad")?; }
    buf::buf_push_bytes(&text:ReadWrite, ", V29, Last")?;
    if bad { buf::buf_push_bytes(&text:ReadWrite, "([u32; 2])")?; }
    buf::buf_push_bytes(&text:ReadWrite, " }\nfunction consume(value: bool): void { if value { return; } }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function f(a: E, b: E): void { consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function g(a: E, b: E): void { consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function h(a: E, b: E): void { consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); consume(a == b); }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function k(a: E, b: E): void { consume(a != b); consume(a != b); consume(a != b); consume(a != b); consume(a != b); consume(a != b); consume(a != b); }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function last(a: Q, b: Q): bool { return a == b; }\n")?;
    let src: &[u8] = &text.data[0..text.pos]:Read;
    let doc: pipeline::DocumentAnalysis = pipeline::run_document_frontend(src, 122u16)?;
    if over {
        assert(pipeline::analysis_equality_exceeded(doc.status));
        assert(doc.diagnostics.count == 0u32 && !doc.diagnostics.truncated);
    } elseif bad {
        assert(pipeline::analysis_rejected(doc.status));
        assert(doc.diagnostics.count == 1u32 && doc.diagnostics.diags[0].code.raw == 5809u16);
    } else { assert(pipeline::analysis_checked(doc.status) && doc.diagnostics.count == 0u32); }
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let ok: bool = pipeline::run_frontend(src, 122u16, &batch:ReadWrite)?;
    assert(ok == !bad);
    if bad { assert(batch.count == 1u32 && batch.diags[0].code.raw == 5809u16); }
    else { assert(batch.count == 0u32); }
    return;
}

function main(): void {
    let comparable: &[u8] = "struct Pad { x: u32 } enum Inner { A, B(u32) } enum Outer { A(Inner), B(Inner) } function f(a: Outer, b: Outer): bool { return a == b; }\n";
    small_steps(comparable, 14u32, 0u16, false)?;
    small_steps(comparable, 13u32, 0u16, true)?;
    let uncomparable: &[u8] = "struct S { x: u32 } enum Inner { A, B(S) } enum Outer { A(Inner), B(Inner) } function f(a: Outer, b: Outer): bool { return a != b; }\n";
    small_steps(uncomparable, 14u32, 5809u16, false)?;
    small_steps(uncomparable, 14u32, 5809u16, true)?;
    let structure: &[u8] = "struct S { x: u32 } struct T { x: u32, y: u32 } function f(a: T, b: T): bool { return a == b; }\n";
    small_steps(structure, 2u32, 5001u16, false)?;
    small_steps(structure, 1u32, 5001u16, true)?;
    boundary(false, false)?;
    boundary(false, true)?;
    boundary(true, false)?;
    boundary(true, true)?;
    return;
}
