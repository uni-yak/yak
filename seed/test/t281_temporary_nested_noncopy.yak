// mem_limit: 500000
// module: nested=fixtures/nested_fields.yak
import nested;
foreign assert(cond: bool): void;
struct Inner { value: u32, data: u32[] }
struct Middle { inner: Inner, more: u32[] }
struct Outer { middle: Middle, other: u32[] }
function make(counter: &u32:ReadWrite): Outer {
    *counter = *counter + 1u32;
    return Outer { middle: Middle { inner: Inner { value: 42u32, data: [1u32, 2u32] }, more: [3u32] }, other: [4u32] };
}
enum Failure { Bad }
function maybe(ok: bool): Outer!Failure {
    if !ok { return Failure::Bad; }
    var count: u32 = 0;
    return make(&count:ReadWrite);
}
function number(ok: bool): u32!Failure { return (maybe(ok)?).middle.inner.value; }
function recover(e: &Failure): u32 { return 99u32; }
function main(): void {
    assert(number(false).catch(&recover) == 99u32);
    assert(number(true).catch(&recover) == 42u32);
    let local: Outer = Outer { middle: Middle { inner: Inner { value: 17u32, data: [1u32] }, more: [2u32] }, other: [3u32] };
    assert((&local).middle.inner.value == 17u32);
    assert(nested::make().inner.value == 71u32);
    assert(nested::make().inner.data.len == 1u64);
    var count: u32 = 0;
    var i: u32 = 0;
    while i < 500 {
        assert(make(&count:ReadWrite).middle.inner.value == 42u32);
        assert(make(&count:ReadWrite).middle.inner.data.len == 2u64);
        assert(make(&count:ReadWrite).middle.inner.data.cap >= 2u64);
        i = i + 1u32;
    }
    assert(count == 1500u32);
}
