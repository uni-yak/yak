import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import parse;
import resolve;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;

function constant_name(text: &buf::ByteBuf:ReadWrite, i: u32): void!AllocError {
    buf::buf_push_u8(text, 67u8)?;
    buf::buf_push_u8(text, 48u8 + (i / 10u32) as u8)?;
    buf::buf_push_u8(text, 48u8 + (i % 10u32) as u8)?;
    return;
}

function source(padding: u32, bad: bool): buf::ByteBuf!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    var i: u32 = 0u32;
    while i < 63u32 {
        if i == padding {
            buf::buf_push_bytes(&text:ReadWrite, "function padding(): u32 { return 1; }\n")?;
        }
        buf::buf_push_bytes(&text:ReadWrite, "const ")?;
        constant_name(&text:ReadWrite, i)?;
        if bad && i == 0u32 { buf::buf_push_bytes(&text:ReadWrite, ": u32 = 1 / 0;\n")?; }
        else { buf::buf_push_bytes(&text:ReadWrite, ": u32 = 1;\n")?; }
        i = i + 1u32;
    }
    // 最后使用所有常量，不改变查找命中位置。
    buf::buf_push_bytes(&text:ReadWrite, "function use_all(): u32 { return ")?;
    i = 0u32;
    while i < 63u32 {
        if i != 0u32 { buf::buf_push_bytes(&text:ReadWrite, " + ")?; }
        constant_name(&text:ReadWrite, i)?;
        i = i + 1u32;
    }
    buf::buf_push_bytes(&text:ReadWrite, "; }\n")?;
    return text;
}

function pipeline_steps(): void!AllocError {
    let exact: buf::ByteBuf = source(31u32, false)?;
    let finished: pipeline::DocumentAnalysis = pipeline::run_document_frontend(&exact.data[0..exact.pos]:Read, 101u16)?;
    assert(pipeline::analysis_checked(finished.status) && finished.diagnostics.count == 0u32);
    let over: buf::ByteBuf = source(30u32, false)?;
    let clean: &[u8] = &over.data[0..over.pos]:Read;
    let stopped: pipeline::DocumentAnalysis = pipeline::run_document_frontend(clean, 101u16)?;
    assert(pipeline::analysis_checked(stopped.status) && stopped.diagnostics.count == 0u32);
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(clean, 101u16, &batch:ReadWrite)?;
    assert(accepted && batch.count == 0u32);
    let bad: buf::ByteBuf = source(30u32, true)?;
    let negative: &[u8] = &bad.data[0..bad.pos]:Read;
    let partial: pipeline::DocumentAnalysis = pipeline::run_document_frontend(negative, 101u16)?;
    assert(partial.status == 1u8 && partial.diagnostics.count == 1u32 && !partial.diagnostics.truncated);
    let rejected: bool = !pipeline::run_frontend(negative, 101u16, &batch:ReadWrite)?;
    assert(rejected && batch.count == 1u32 && batch.diags[0].code.raw == 5008u16);
    let a: diag::Diag = batch.diags[0];
    let b: diag::Diag = partial.diagnostics.diags[0];
    assert(a.code.raw == b.code.raw && a.severity == b.severity && a.unit == b.unit);
    assert(a.span.file == b.span.file && a.span.offset == b.span.offset && a.span.length == b.span.length);
    return;
}

// 顶层常量命中一次，局部常量再扫两个顶层条目及两个局部声明。
function local_steps(): void!AllocError {
    let small: &[u8] = "const A: u32 = 1; function f(): u32 { let a: u32 = 2; const B: u32 = A + 3; return a + B; }\n";
    let lexed: lex::LexResult = lex::lex_scan(small, 102u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 102u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    assert(diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= 5u32 {
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(limit);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe_work: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe_work:ReadWrite, &scan:ReadWrite)?;
        assert(lookup.exhausted == (limit < 5u32) && lookup.remaining == 0u32 && diags.count == 0u32);
        if limit < 5u32 { assert(@len(checked.consts.bindings) == 0 && @len(checked.consts.values) == 0); }
        else {
            assert(@len(checked.consts.bindings) == 2);
            let value: u32 = checked.consts.bindings[1].value;
            assert(checked.consts.values[value - 1u32].bits == 4u64);
        }
        limit = limit + 1u32;
    }
    return;
}

// 有前置形参、普通局部和同名常量时，只读取实际常量，保留 DefId 顺序。
function indexed_steps(): void!AllocError {
    let source: &[u8] = "const A: u32 = 1; function f(a: bool): u32 { let x: u32 = 2; const B: u32 = A + 3; if a { const A: u32 = B + 5; return A + x; } return B + x; } const C: u32 = 7; function g(): u32 { return C; }\n";
    let lexed: lex::LexResult = lex::lex_scan(source, 103u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 103u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let batch: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &diags:ReadWrite)?;
    var names: resolve::LookupBudget = resolve::lookup_budget(0u32, 0u32);
    var reserve: resolve::ReservationBudget = resolve::reservation_budget(0u32);
    reserve.index_locals = true;
    var output: resolve_unit::ReferenceOutputBudget = resolve_unit::reference_output_budget(0u64);
    let document: resolve_refs::Resolution = resolve_unit::resolve_unit_limited(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, 0, "", &diags:ReadWrite, &names:ReadWrite, &reserve:ReadWrite, &output:ReadWrite)?;
    assert(diags.count == 0u32 && @len(batch.result.tables.const_inits) == 0);
    assert(@len(document.result.tables.const_inits) == 4);
    assert(document.result.tables.const_inits[0].expr == 0u32 && document.result.tables.const_inits[0].expr == parsed.pool.consts[0].init);
    assert(document.result.tables.const_inits[1].expr == parsed.pool.locals[1].init);
    assert(document.result.tables.const_inits[2].expr == parsed.pool.locals[2].init);
    assert(document.result.tables.const_inits[3].expr == parsed.pool.consts[1].init);
    let old: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&parsed.file:Read, &parsed.pool:Read, &batch:Read, &diags:ReadWrite)?;
    assert(diags.count == 0u32 && @len(old.consts.bindings) == 4);
    assert(old.consts.values[old.consts.bindings[2].value - 1u32].bits == 9u64);
    var limit: u32 = 1u32;
    while limit <= 4u32 {
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(limit);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_limited(&parsed.file:Read, &parsed.pool:Read, &document:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite)?;
        assert(lookup.exhausted == (limit < 4u32) && lookup.remaining == 0u32 && diags.count == 0u32);
        if limit < 4u32 { assert(@len(checked.consts.bindings) == 0 && @len(checked.consts.values) == 0); }
        else {
            assert(@len(checked.consts.bindings) == 4 && @len(checked.consts.values) == @len(old.consts.values));
            var i: u32 = 0u32;
            while i < 4u32 {
                let a: consteval::ConstBinding = old.consts.bindings[i];
                let b: consteval::ConstBinding = checked.consts.bindings[i];
                assert(a.def == b.def && b.def == document.result.tables.const_inits[i].def);
                assert(a.value_type_id == b.value_type_id && a.value == b.value);
                assert(old.consts.values[a.value - 1u32].bits == checked.consts.values[b.value - 1u32].bits);
                i = i + 1u32;
            }
        }
        limit = limit + 1u32;
    }
    return;
}

function main(): void {
    local_steps()?;
    indexed_steps()?;
    pipeline_steps()?;
    return;
}
