// module: pe=../../compiler/min/src/emit/pe.yak
// module: x86_validate=../../compiler/min/src/emit/x86_validate.yak
import pe;
import x86_validate;
foreign assert(condition: bool): void;
foreign exit(code: u8): void;

function encoding(bytes: &[u8], expected: u16): void!AllocError {
    var code: pe::Code = pe::code_new();
    pe::code_bytes(&code:ReadWrite, bytes)?;
    assert(x86_validate::validate(&code:Read, 0)? == expected);
    return;
}

function verify(): void!AllocError {
    // 普通和扩展寄存器优先比较低字节，SPL 等改用无需 REX 的 32 位形式。
    let shortest: [u8; 12] = [0x38, 0xc0, 0x45, 0x38, 0xc0, 0x39, 0xe4,
        0x39, 0xff, 0x45, 0x38, 0xff];
    encoding(&shortest[0..12]:Read, 0)?;
    var code: pe::Code = pe::code_new();
    pe::cmp_rr(&code:ReadWrite, 0, 0)?;
    pe::cmp_rr(&code:ReadWrite, 8, 8)?;
    pe::cmp_rr(&code:ReadWrite, 4, 4)?;
    pe::cmp_rr(&code:ReadWrite, 7, 7)?;
    pe::cmp_rr(&code:ReadWrite, 15, 15)?;
    assert(pe::code_len(&code:Read) == 12);
    var i: u32 = 0;
    while i < 12 { assert(code.bytes[i] == shortest[i]); i = i + 1; }
    assert(x86_validate::validate(&code:Read, 0)? == 0);

    let alternatives: [u8; 23] = [0x48, 0x39, 0xc0, 0x66, 0x39, 0xc0, 0x39, 0xc0,
        0x4d, 0x39, 0xc0, 0x45, 0x39, 0xc0, 0x40, 0x38, 0xe4, 0x48, 0x39, 0xe4,
        0x66, 0x39, 0xe4];
    encoding(&alternatives[0..3]:Read, 7103)?;
    encoding(&alternatives[3..6]:Read, 7103)?;
    encoding(&alternatives[6..8]:Read, 7102)?;
    encoding(&alternatives[8..11]:Read, 7102)?;
    encoding(&alternatives[11..14]:Read, 7102)?;
    encoding(&alternatives[14..17]:Read, 7103)?;
    encoding(&alternatives[17..20]:Read, 7103)?;
    encoding(&alternatives[20..23]:Read, 7103)?;
    encoding(&alternatives[8..10]:Read, 7101)?;

    // AH 自比较、不同寄存器（包括仅扩展位不同）及内存比较保持原形态。
    let controls: [u8; 10] = [0x38, 0xe4, 0x48, 0x39, 0xc8, 0x4c, 0x39, 0xc0, 0x39, 0x00];
    encoding(&controls[0..10]:Read, 0)?;
    exit(0);
    return;
}

function main(): void {
    let status: void!AllocError = verify();
    @drop(status);
    assert(false);
    return;
}
