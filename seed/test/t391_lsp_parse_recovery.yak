import buf;
import lex;
import parse;
import diag;
import pipeline;
foreign assert(cond: bool): void;

// 精确配额保留诊断及静态池，不足时应抛弃所有已收集诊断。
function check_steps(src: &[u8], steps: u32, diagnostic_limit: u32): void!AllocError {
    let scanned: lex::LexResult = lex::lex_scan(src, 116u16)?;
    assert(@len(scanned.diagnostics) == 0);
    let batch: parse::ParseResult = parse::parse_lexed(&scanned:Read, 116u16)?;
    assert(!batch.recovery_exceeded && @len(batch.diagnostics) > 0);
    var budget: u32 = 1u32;
    while budget <= steps {
        let doc: parse::ParseResult = parse::parse_lexed_limited(&scanned:Read, 116u16, diagnostic_limit, 64u32, 0u32, budget)?;
        assert(!doc.depth_exceeded && !doc.match_path_exceeded);
        assert(doc.recovery_exceeded == (budget < steps));
        if budget < steps {
            assert(!doc.diagnostics_truncated && @len(doc.diagnostics) == 0);
            assert(@len(doc.pool.statics) == 0 && @len(doc.pool.static_bytes) == 0);
        } else {
            assert(@len(doc.file.items) == @len(batch.file.items));
            assert(@len(doc.pool.static_bytes) == @len(batch.pool.static_bytes));
            if diagnostic_limit == 64u32 {
                assert(!doc.diagnostics_truncated && @len(doc.diagnostics) == @len(batch.diagnostics));
                var i: u32 = 0u32;
                while i < @len(batch.diagnostics) as u32 {
                    assert(doc.diagnostics[i].code.raw == batch.diagnostics[i].code.raw);
                    assert(doc.diagnostics[i].span.offset == batch.diagnostics[i].span.offset);
                    assert(doc.diagnostics[i].span.length == batch.diagnostics[i].span.length);
                    i = i + 1u32;
                }
            } else { assert(doc.diagnostics_truncated); }
        }
        budget = budget + 1u32;
    }
    return;
}

function boundary(over: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    var i: u32 = 0u32;
    while i < 512u32 { buf::buf_push_bytes(&text:ReadWrite, ") ")?; i = i + 1u32; }
    buf::buf_push_bytes(&text:ReadWrite, "\nfunction f(): void { ")?;
    i = 0u32;
    while i < 512u32 { buf::buf_push_bytes(&text:ReadWrite, ") ")?; i = i + 1u32; }
    if over { buf::buf_push_bytes(&text:ReadWrite, ") ")?; }
    buf::buf_push_bytes(&text:ReadWrite, "}\n")?;
    let input: &[u8] = &text.data[0..text.pos]:Read;
    let doc: pipeline::DocumentAnalysis = pipeline::run_document_frontend(input, 116u16)?;
    if over {
        assert(pipeline::analysis_parse_recovery_exceeded(doc.status));
        assert(doc.diagnostics.count == 0u32 && !doc.diagnostics.truncated);
    } else {
        assert(pipeline::analysis_rejected(doc.status));
        assert(doc.diagnostics.count == 2u32);
        assert(doc.diagnostics.diags[0].code.raw == 2001u16 && doc.diagnostics.diags[1].code.raw == 2001u16);
    }
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    assert(!pipeline::run_frontend(input, 116u16, &batch:ReadWrite)?);
    assert(batch.count == 2u32 && !batch.truncated);
    assert(batch.diags[0].code.raw == 2001u16 && batch.diags[1].code.raw == 2001u16);
    return;
}

function main(): void {
    // 文件项两步，函数体两步，作为恢复分隔符消费的分号再一步。
    check_steps(") )\nfunction f(): void { ) ) ; }\nconst C: &[u8] = \"x\";\n", 5u32, 64u32)?;
    // 已截断的局部诊断在恢复超限时不能带出截断标志。
    check_steps(") )\nfunction f(): void { ) ) ; }\n", 5u32, 1u32)?;
    check_steps("function f(): void { match 0u32 { _ ) ) , _ => {} } }\n", 3u32, 64u32)?;
    check_steps("enum E { A ) ) , B }\n", 3u32, 64u32)?;
    check_steps("struct S { a: u32 ) ) , b: u32 }\n", 3u32, 64u32)?;
    // 双右尖括号是一个实际 token；未闭合时 EOF 不扣费。
    check_steps("function f<A<B>>(): void {}\n", 5u32, 64u32)?;
    check_steps("function f<A<B\n", 4u32, 64u32)?;
    check_steps("foreign f(x: A<B>): void;\n", 3u32, 64u32)?;
    check_steps("enum E { _, A }\n", 2u32, 64u32)?;
    check_steps(")\nfunction f(move x: u32): void {}\n", 2u32, 64u32)?;
    boundary(false)?;
    boundary(true)?;
    return;
}
