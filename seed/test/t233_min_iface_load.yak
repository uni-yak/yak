import lex;
import parse;
import diag;
import resolve_refs;
import resolve_unit;
import typecheck;
import typecheck_driver;
import iface;
import iface_write;
import iface_load;
foreign assert(cond: bool): void;
struct Loaded { parsed: parse::ParseResult, lexed: lex::LexResult }
function load(src: &[u8], file: u16): Loaded!AllocError {
    let r: lex::LexResult = lex::lex_scan(src, file)?;
    assert(@len(r.diagnostics) == 0);
    let p: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    assert(@len(p.diagnostics) == 0);
    return Loaded { parsed: p, lexed: r };
}
function bytes_equal(left: &[u8], right: &[u8]): bool {
    if @len(left) as u32 != @len(right) as u32 { return false; }
    var i: u32 = 0;
    while i < @len(right) as u32 {
        if left[i] != right[i] { return false; }
        i = i + 1;
    }
    return true;
}
function read_u32(bytes: &[u8], offset: u32): u32 {
    return bytes[offset] as u32 | (bytes[offset + 1] as u32 << 8) | (bytes[offset + 2] as u32 << 16) | (bytes[offset + 3] as u32 << 24);
}
function refresh_digest(bytes: &u8[]:ReadWrite, size: u32): void!AllocError {
    var i: u32 = 24;
    while i < 56 { bytes[i] = 0; i = i + 1; }
    let digest: u8[] = iface::sha256(&bytes[0..size]:Read)?;
    i = 0;
    while i < 32 { bytes[24 + i] = digest[i]; i = i + 1; }
    return;
}
function reject_mutation(original: &[u8], offset: u32, value: u8): void!AllocError {
    var bytes: u8[] = [];
    var i: u32 = 0;
    while i < @len(original) as u32 { @push(bytes, original[i])?; i = i + 1; }
    bytes[offset] = value;
    let size: u32 = @len(bytes) as u32;
    refresh_digest(&bytes:ReadWrite, size)?;
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: iface::LoadedInterface = iface_load::load_interface(&bytes[0..size]:Read, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) > 0 && diags.diags[0].code.raw == 7012);
    assert(@len(rejected.exports) == 0 && @len(rejected.privates) == 0);
    return;
}
function set_u32(bytes: &u8[]:ReadWrite, offset: u32, value: u32): void {
    bytes[offset] = value as u8;
    bytes[offset + 1] = (value >> 8) as u8;
    bytes[offset + 2] = (value >> 16) as u8;
    bytes[offset + 3] = (value >> 24) as u8;
    return;
}
function reject_name(loaded: &Loaded:Read, resolution: &resolve_refs::Resolution:Read, tc: &typecheck::TypeCheckResult:Read, name: &[u8]): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, resolution, &loaded.lexed.names:Read, tc, name, &diags:ReadWrite)?;
    assert(diag::diagbuf_count(&diags:Read) > 0 && diags.diags[0].code.raw == 7012);
    assert(@len(result.data.bytes) == 0);
    return;
}
// 引用的子类型与可失败成功位共享泛型作用域，错误成员仍必须是名义枚举。
function check_generic_positions(): void!AllocError {
    let exports: resolve_refs::IfaceExport[] = [];
    var bytes: u8[] = [1u8, 0u8, 1u8, 0u8, 7u8, 0u8, 6u8, 4u8, 0u8, 0u8, 10u8, 4u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 1u8, 12u8, 16u8, 0u8, 0u8];
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    assert(resolve_refs::valid_function_signature(&bytes[0..@len(bytes)]:Read, &exports[0..0]:Read, &diags:ReadWrite)?);
    assert(diag::diagbuf_count(&diags:Read) == 0);
    bytes[18] = 4;
    bytes[19] = 0;
    bytes[20] = 0;
    assert(!resolve_refs::valid_function_signature(&bytes[0..21]:Read, &exports[0..0]:Read, &diags:ReadWrite)?);
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7012);
    return;
}
function reject_json_interface(bytes: &[u8]): void!AllocError {
    var diags: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: iface::LoadedInterface = iface_load::load_interface(bytes, &diags:ReadWrite)?;
    // rejection_spec: E7015 spec/lang/symbol.md#S-15
    assert(diag::diagbuf_count(&diags:Read) == 1 && diags.diags[0].code.raw == 7015 && @len(rejected.name_bytes) == 0 && @len(rejected.exports) == 0 && @len(rejected.digest) == 0);
    return;
}
function check_json_interfaces(): void!AllocError {
    reject_json_interface("{\"module\":\"demo\",\"exports\":[]}")?;
    reject_json_interface("\t\n [ { \"module\": \"demo\" } ]")?;
    let bom: [u8; 5] = [239u8, 187u8, 191u8, 123u8, 125u8];
    reject_json_interface(&bom[0..5]:Read)?;
    return;
}
function check_header_profile(data: &[u8]): void!AllocError {
    // 当前位仅声明私有名节。保留位不可改变，即使摘要正确。
    assert(data[6] == 1 && data[7] == 0);
    reject_mutation(data, 6, 0)?;
    reject_mutation(data, 6, 3)?;
    reject_mutation(data, 7, 128)?;
    // 布局与 ABI 编号各占十六位，任一半部的高位也不得被忽略。
    assert(read_u32(data, 8) == 65537);
    reject_mutation(data, 8, 0)?;
    reject_mutation(data, 9, 1)?;
    reject_mutation(data, 10, 2)?;
    reject_mutation(data, 11, 1)?;
    return;
}

function main(): void {
    check_json_interfaces()?;
    check_generic_positions()?;
    let loaded: Loaded = load("export function add(a: u32, b: u32): u32 { return a + b; }\nexport function noop(): void { return; }\nfunction helper(): void { return; }\n", 900)?;
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    var build_diags: diag::DiagBuffer = diag::diagbuf_new();
    let resolution: resolve_refs::Resolution = resolve_unit::resolve_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &loaded.lexed.names:Read, &deps:Read, "", &build_diags:ReadWrite)?;
    let tc: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &build_diags:ReadWrite)?;
    let result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, "demo", &build_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&build_diags:Read) == 0);
    // 写出端不得生成空身份或截断身份的接口。
    var empty_diags: diag::DiagBuffer = diag::diagbuf_new();
    let empty_result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, "", &empty_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&empty_diags:Read) > 0 && empty_diags.diags[0].code.raw == 7012);
    assert(@len(empty_result.data.bytes) == 0);
    var long_name: u8[] = [];
    var n: u32 = 0;
    while n < 65536 { @push(long_name, 97)?; n = n + 1; }
    var long_diags: diag::DiagBuffer = diag::diagbuf_new();
    let long_result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, &long_name[0..@len(long_name)]:Read, &long_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&long_diags:Read) > 0 && long_diags.diags[0].code.raw == 7012);
    assert(@len(long_result.data.bytes) == 0);
    var invalid_diags: diag::DiagBuffer = diag::diagbuf_new();
    let invalid_result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, "bad::import", &invalid_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&invalid_diags:Read) > 0 && invalid_diags.diags[0].code.raw == 7012);
    assert(@len(invalid_result.data.bytes) == 0);
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "::a")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a::")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a:::b")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a:b")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a::_")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a::loop")?;
    reject_name(&loaded:Read, &resolution:Read, &tc:Read, "a::2b")?;
    var path_diags: diag::DiagBuffer = diag::diagbuf_new();
    let path_result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, "_ok::Read2", &path_diags:ReadWrite)?;
    let path_iface: iface::LoadedInterface = iface_load::load_interface(&path_result.data.bytes[0..@len(path_result.data.bytes)]:Read, &path_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&path_diags:Read) == 0);
    assert(bytes_equal(&path_iface.module_name[0..@len(path_iface.module_name)]:Read, "_ok::Read2"));
    var enum_diags: diag::DiagBuffer = diag::diagbuf_new();
    let enum_result: iface::InterfaceResult = iface_write::write_function_interface(&loaded.parsed.file:Read, &loaded.parsed.pool:Read, &resolution:Read, &loaded.lexed.names:Read, &tc:Read, "Enum", &enum_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&enum_diags:Read) == 0);
    let enum_data: &[u8]:Read = &enum_result.data.bytes[0..@len(enum_result.data.bytes)]:Read;
    let enum_identity: u32 = read_u32(enum_data, 60) + read_u32(enum_data, read_u32(enum_data, 76));
    reject_mutation(enum_data, enum_identity, 101)?;
    var load_diags: diag::DiagBuffer = diag::diagbuf_new();
    let loaded_iface: iface::LoadedInterface = iface_load::load_interface(&result.data.bytes[0..@len(result.data.bytes)]:Read, &load_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&load_diags:Read) == 0);
    assert(bytes_equal(&loaded_iface.module_name[0..@len(loaded_iface.module_name)]:Read, "demo"));
    assert(@len(loaded_iface.exports) == 2);
    assert(loaded_iface.exports[0].export_id == 1);
    assert(loaded_iface.exports[0].kind == 1);
    assert(loaded_iface.exports[0].sig_len > 0);
    let first: iface::LoadedExport = loaded_iface.exports[0];
    let second: iface::LoadedExport = loaded_iface.exports[1];
    assert(bytes_equal(&loaded_iface.name_bytes[first.name_off..first.name_off + first.name_len as u32]:Read, "noop"));
    assert(bytes_equal(&loaded_iface.name_bytes[second.name_off..second.name_off + second.name_len as u32]:Read, "add"));
    assert(@len(loaded_iface.digest) == 32);
    assert(first.name_hash < second.name_hash);
    assert(@len(loaded_iface.privates) == 1);
    let private_item: iface::LoadedPrivate = loaded_iface.privates[0];
    assert(private_item.kind == 1);
    assert(bytes_equal(&loaded_iface.name_bytes[private_item.name_off..private_item.name_off + private_item.name_len as u32]:Read, "helper"));
    // 名称字节应包含两个导出名。
    var saw_add: bool = false;
    var saw_noop: bool = false;
    var i: u32 = 0;
    while i < @len(loaded_iface.name_bytes) as u32 {
        if i + 2 < @len(loaded_iface.name_bytes) as u32 && loaded_iface.name_bytes[i] == 97 && loaded_iface.name_bytes[i + 1] == 100 && loaded_iface.name_bytes[i + 2] == 100 { saw_add = true; }
        if i + 3 < @len(loaded_iface.name_bytes) as u32 && loaded_iface.name_bytes[i] == 110 && loaded_iface.name_bytes[i + 1] == 111 && loaded_iface.name_bytes[i + 2] == 111 && loaded_iface.name_bytes[i + 3] == 112 { saw_noop = true; }
        i = i + 1;
    }
    assert(saw_add && saw_noop);
    // 破坏摘要后必须拒绝。
    var tampered: u8[] = [];
    i = 0;
    while i < @len(result.data.bytes) as u32 { @push(tampered, result.data.bytes[i])?; i = i + 1; }
    tampered[24] = tampered[24] ^ 1;
    var tamper_diags: diag::DiagBuffer = diag::diagbuf_new();
    let ignored: iface::LoadedInterface = iface_load::load_interface(&tampered[0..@len(tampered)]:Read, &tamper_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&tamper_diags:Read) > 0);
    assert(@len(ignored.exports) == 0);
    // 节偏移越界必须产生诊断，不能继续读取不可信地址。
    tampered[60] = 255; tampered[61] = 255; tampered[62] = 255; tampered[63] = 255;
    var bounds_diags: diag::DiagBuffer = diag::diagbuf_new();
    let rejected: iface::LoadedInterface = iface_load::load_interface(&tampered[0..@len(tampered)]:Read, &bounds_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&bounds_diags:Read) > 0 && bounds_diags.diags[0].code.raw == 7012);
    assert(@len(rejected.exports) == 0);
    // 重新计算摘要，确保结构校验独立拒绝每种畸形输入。
    let data: &[u8]:Read = &result.data.bytes[0..@len(result.data.bytes)]:Read;
    reject_mutation(data, 63, 255)?;
    reject_mutation(data, 68 + 3 * 16 + 3, 255)?;
    // 模块身份节固定为一条八字节记录。
    reject_mutation(data, 64 + 1 * 16, 7)?;
    reject_mutation(data, 68 + 1 * 16, 0)?;
    reject_mutation(data, 68 + 1 * 16, 2)?;
    reject_mutation(data, 58, 1)?;
    check_header_profile(data)?;
    let module_offset: u32 = read_u32(data, 60 + 16);
    reject_mutation(data, module_offset + 3, 255)?;
    // 模块身份不可为空，摘要有效也必须拒绝。
    reject_mutation(data, module_offset + 4, 0)?;
    let names_offset: u32 = read_u32(data, 60);
    let identity_offset: u32 = names_offset + read_u32(data, module_offset);
    reject_mutation(data, identity_offset, 49)?;
    reject_mutation(data, identity_offset + 1, 58)?;
    reject_mutation(data, identity_offset, 255)?;
    let export_offset: u32 = read_u32(data, 60 + 3 * 16);
    // noop、add 的哈希顺序与字节顺序相反；归并必须找到第二个导出的重名。
    let private_record: u32 = read_u32(data, 60 + 14 * 16);
    let second_record: u32 = export_offset + 32;
    var overlap: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(overlap, data[i])?; i = i + 1; }
    i = 0;
    while i < 16 {
        // 沿用私有记录的种类和保留位，只复用导出的名字范围与哈希。
        if i < 6 || i >= 8 { overlap[private_record + i] = data[second_record + i]; }
        i = i + 1;
    }
    let overlap_size: u32 = @len(overlap) as u32;
    refresh_digest(&overlap:ReadWrite, overlap_size)?;
    var overlap_diags: diag::DiagBuffer = diag::diagbuf_new();
    let overlap_iface: iface::LoadedInterface = iface_load::load_interface(&overlap[0..overlap_size]:Read, &overlap_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&overlap_diags:Read) == 1 && overlap_diags.diags[0].code.raw == 7012);
    assert(@len(overlap_iface.exports) == 0 && @len(overlap_iface.privates) == 0);
    // 合法依赖记录读回后保留名字范围和摘要；非法变体使用重签摘要单独验证。
    var with_dependency: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(with_dependency, data[i])?; i = i + 1; }
    let dependency_offset: u32 = @len(with_dependency) as u32;
    i = 0;
    while i < 80 { @push(with_dependency, 0)?; i = i + 1; }
    // 摘要相同时按名字字节排序，与导出表中的顺序相反。
    set_u32(&with_dependency:ReadWrite, dependency_offset, second.name_off);
    with_dependency[dependency_offset + 4] = second.name_len as u8;
    set_u32(&with_dependency:ReadWrite, dependency_offset + 40, first.name_off);
    with_dependency[dependency_offset + 44] = first.name_len as u8;
    set_u32(&with_dependency:ReadWrite, 60 + 2 * 16, dependency_offset);
    set_u32(&with_dependency:ReadWrite, 64 + 2 * 16, 80);
    set_u32(&with_dependency:ReadWrite, 68 + 2 * 16, 2);
    let dependency_size: u32 = @len(with_dependency) as u32;
    set_u32(&with_dependency:ReadWrite, 20, dependency_size);
    with_dependency[dependency_offset + 8] = 123;
    with_dependency[dependency_offset + 48] = 123;
    i = 24;
    while i < 56 { with_dependency[i] = 0; i = i + 1; }
    let dependency_digest: u8[] = iface::sha256(&with_dependency[0..dependency_size]:Read)?;
    i = 0;
    while i < 32 { with_dependency[24 + i] = dependency_digest[i]; i = i + 1; }
    let wire: &[u8] = &with_dependency[0..dependency_size]:Read;
    var dependency_diags: diag::DiagBuffer = diag::diagbuf_new();
    let dependency_iface: iface::LoadedInterface = iface_load::load_interface(wire, &dependency_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&dependency_diags:Read) == 0 && @len(dependency_iface.dependencies) == 2);
    assert(dependency_iface.dependencies[0].name_off == second.name_off);
    assert(dependency_iface.dependencies[1].name_off == first.name_off);
    assert(dependency_iface.dependencies[0].digest[0] == 123 && @len(dependency_iface.dependencies[0].digest) == 32);
    reject_mutation(wire, dependency_offset + 3, 255)?;
    reject_mutation(wire, dependency_offset + 4, 0)?;
    reject_mutation(wire, dependency_offset + 6, 1)?;
    reject_mutation(wire, dependency_offset + 8, 124)?;
    reject_mutation(wire, dependency_offset + 40, read_u32(data, module_offset) as u8)?;
    // 重排记录但保留连续编号，模拟接口与链接符号错配。
    var reordered: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(reordered, data[i])?; i = i + 1; }
    i = 0;
    while i < 32 {
        let temp: u8 = reordered[export_offset + i];
        reordered[export_offset + i] = reordered[export_offset + 32 + i];
        reordered[export_offset + 32 + i] = temp;
        i = i + 1;
    }
    set_u32(&reordered:ReadWrite, export_offset + 16, 1);
    set_u32(&reordered:ReadWrite, export_offset + 48, 2);
    reject_mutation(&reordered[0..@len(reordered)]:Read, export_offset + 16, 1)?;
    // 两条记录引用相同名称和哈希时，不能仅凭编号连续通过。
    var duplicate_export: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(duplicate_export, data[i])?; i = i + 1; }
    i = 0;
    while i < 16 { duplicate_export[export_offset + 32 + i] = duplicate_export[export_offset + i]; i = i + 1; }
    reject_mutation(&duplicate_export[0..@len(duplicate_export)]:Read, export_offset + 16, 1)?;
    reject_mutation(data, export_offset + 8, data[export_offset + 8] ^ 1)?;
    reject_mutation(data, export_offset + 23, 255)?;
    reject_mutation(data, export_offset + 7, 2)?;
    reject_mutation(data, module_offset + 6, 1)?;
    reject_mutation(data, export_offset + 6, 0)?;
    // 函数的 no_alloc 位为合法格式，不能因加强校验而拒绝。
    var valid: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(valid, data[i])?; i = i + 1; }
    valid[export_offset + 7] = 1;
    i = 24;
    while i < 56 { valid[i] = 0; i = i + 1; }
    let valid_digest: u8[] = iface::sha256(&valid[0..@len(valid)]:Read)?;
    i = 0;
    while i < 32 { valid[24 + i] = valid_digest[i]; i = i + 1; }
    var valid_diags: diag::DiagBuffer = diag::diagbuf_new();
    let valid_iface: iface::LoadedInterface = iface_load::load_interface(&valid[0..@len(valid)]:Read, &valid_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&valid_diags:Read) == 0 && @len(valid_iface.exports) == 2);
    // 构造带一条泛型函数索引的容器，内容摘要覆盖新增记录。
    var generic: u8[] = [];
    i = 0;
    while i < @len(data) as u32 { @push(generic, data[i])?; i = i + 1; }
    let index_offset: u32 = @len(generic) as u32;
    i = 0;
    while i < 16 { @push(generic, 0)?; i = i + 1; }
    @push(generic, 0)?;
    set_u32(&generic:ReadWrite, 60 + 10 * 16, index_offset + 16);
    set_u32(&generic:ReadWrite, 64 + 10 * 16, 1);
    set_u32(&generic:ReadWrite, 68 + 10 * 16, 1);
    set_u32(&generic:ReadWrite, 60 + 9 * 16, index_offset);
    set_u32(&generic:ReadWrite, 64 + 9 * 16, 16);
    set_u32(&generic:ReadWrite, 68 + 9 * 16, 1);
    let generic_size: u32 = @len(generic) as u32;
    set_u32(&generic:ReadWrite, 20, generic_size);
    set_u32(&generic:ReadWrite, index_offset, 1);
    set_u32(&generic:ReadWrite, index_offset + 8, 1);
    let sig_offset: u32 = read_u32(data, 60 + 4 * 16);
    let first_sig: u32 = read_u32(data, export_offset + 20);
    let signature: u32 = sig_offset + first_sig;
    generic[signature] = 1;
    // 将五字节的 void 返回位替换为三个字节的 type_param(0)。
    generic[signature + 4] = 4;
    generic[signature + 5] = 0;
    generic[signature + 6] = 0;
    set_u32(&generic:ReadWrite, export_offset + 24, 7);
    i = 24;
    while i < 56 { generic[i] = 0; i = i + 1; }
    let generic_digest: u8[] = iface::sha256(&generic[0..@len(generic)]:Read)?;
    i = 0;
    while i < 32 { generic[24 + i] = generic_digest[i]; i = i + 1; }
    var generic_diags: diag::DiagBuffer = diag::diagbuf_new();
    let generic_iface: iface::LoadedInterface = iface_load::load_interface(&generic[0..@len(generic)]:Read, &generic_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&generic_diags:Read) == 0 && @len(generic_iface.exports) == 2);
    // 格式有效不代表 T1 能导入泛型函数；同一接口的非泛型签名仍正常桥接。
    var generic_deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    iface_load::add_binary_dependency(&generic_deps:ReadWrite, &generic_iface:Read)?;
    let consumer: Loaded = load("import demo;\nfunction main(): void { demo::noop(); return; }\n", 901)?;
    let resolved: resolve_refs::Resolution = resolve_unit::resolve_unit(&consumer.parsed.file:Read, &consumer.parsed.pool:Read, &consumer.lexed.names:Read, &generic_deps:Read, "consumer", &generic_diags:ReadWrite)?;
    assert(diag::diagbuf_count(&generic_diags:Read) == 1 && generic_diags.diags[0].code.raw == 7012);
    assert(@len(resolved.refs.imports) == 1 && resolved.refs.imports[0].export_id == 2);
    let generic_data: &[u8]:Read = &generic[0..@len(generic)]:Read;
    reject_mutation(generic_data, index_offset + 12, 1)?;
    reject_mutation(generic_data, index_offset + 4, 1)?;
    reject_mutation(generic_data, index_offset + 4, 2)?;
    reject_mutation(generic_data, index_offset + 8, 2)?;
    reject_mutation(generic_data, index_offset, 0)?;
    reject_mutation(generic_data, index_offset, 3)?;
    reject_mutation(generic_data, 64 + 9 * 16, 0)?;
    reject_mutation(generic_data, index_offset, 2)?;
    reject_mutation(generic_data, signature, 0)?;
    reject_mutation(generic_data, export_offset + 7, 1)?;
    // 保持泛型索引有效，只破坏签名操作码、索引或消费边界。
    reject_mutation(generic_data, signature + 4, 255)?;
    reject_mutation(generic_data, signature + 5, 1)?;
    reject_mutation(generic_data, signature + 6, 1)?;
    reject_mutation(generic_data, signature + 2, 1)?;
    reject_mutation(generic_data, export_offset + 24, 6)?;
    reject_mutation(generic_data, export_offset + 24, 8)?;
    reject_mutation(data, export_offset + 16, 0)?;
    reject_mutation(data, export_offset + 28, 1)?;
    reject_mutation(data, export_offset + 24, 0)?;
    // 节目录合法但泛型函数缺少索引时仍须拒绝。
    var missing: u8[] = [];
    i = 0;
    while i < @len(generic) as u32 { @push(missing, generic[i])?; i = i + 1; }
    set_u32(&missing:ReadWrite, 64 + 9 * 16, 0);
    set_u32(&missing:ReadWrite, 68 + 9 * 16, 0);
    reject_mutation(&missing[0..@len(missing)]:Read, index_offset, 1)?;
    // 重复索引须拒绝，即使两条记录均单独满足范围要求。
    var duplicate: u8[] = [];
    i = 0;
    while i < index_offset + 16 { @push(duplicate, generic[i])?; i = i + 1; }
    i = 0;
    while i < 16 { @push(duplicate, generic[index_offset + i])?; i = i + 1; }
    @push(duplicate, 0)?;
    set_u32(&duplicate:ReadWrite, 64 + 9 * 16, 32);
    set_u32(&duplicate:ReadWrite, 68 + 9 * 16, 2);
    set_u32(&duplicate:ReadWrite, 60 + 10 * 16, index_offset + 32);
    let duplicate_size: u32 = @len(duplicate) as u32;
    set_u32(&duplicate:ReadWrite, 20, duplicate_size);
    reject_mutation(&duplicate[0..@len(duplicate)]:Read, index_offset + 16, 1)?;
    return;
}
