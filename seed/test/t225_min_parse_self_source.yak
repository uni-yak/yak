import lex;
import parse;
import host;
foreign assert(cond: bool): void;
function parse_source(name: &[u8], file: u16): void!AllocError {
    let bytes: u8[] = host::input_bytes(name)?;
    let size: u32 = @len(bytes) as u32;
    let r: lex::LexResult = lex::lex_scan(&bytes[0..size], file)?;
    assert(@len(r.diagnostics) == 0);
    let parsed: parse::ParseResult = parse::parse_file(&r.tokens[0..@len(r.tokens)]:Read, &r.names:Read, file)?;
    assert(@len(parsed.diagnostics) == 0);
    return;
}
function main(): void {
    parse_source("parse", 60)?;
    parse_source("parse_core", 61)?;
    parse_source("type_parser", 62)?;
    parse_source("position", 63)?;
    parse_source("ast", 64)?;
    parse_source("parse_expr", 66)?;
    parse_source("owner", 65)?;
    parse_source("owner_write", 67)?;
    parse_source("owner_flow", 68)?;
    parse_source("owner_expr", 69)?;
    return;
}
