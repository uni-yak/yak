// module: buf=../../compiler/min/lib/buf.yak
// module: hash=../../compiler/min/lib/hash.yak
// module: hashmap=../../compiler/min/lib/hashmap.yak
// module: types=../../compiler/min/lib/types.yak
// module: lextables=../../compiler/min/src/lex/lextables.yak
// module: lex=../../compiler/min/src/lex/lex.yak
import buf;
import hashmap;
import lex;
foreign assert(cond: bool): void;

function slot(off: u32, id: u32): hashmap::Slot {
    return hashmap::Slot { hash: 0, name_off: off, name_len: 1, value: id, occupied: true };
}

function small_map(): void!AllocError {
    var arena: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&arena:ReadWrite, "ab")?;
    var map: hashmap::HashMap = hashmap::hashmap_new();
    var init: hashmap::ProbeBudget = hashmap::probe_budget(16);
    assert(!hashmap::hashmap_insert_metered(&map:ReadWrite, slot(0, 1), &init:ReadWrite)?);
    assert(init.stopped && init.left == 0 && map.cap == 0 && map.size == 0 && @len(map.slots) == 0);
    var fill: hashmap::ProbeBudget = hashmap::probe_budget(52);
    assert(hashmap::hashmap_insert_metered(&map:ReadWrite, slot(0, 1), &fill:ReadWrite)?);
    var i: u32 = 2;
    while i <= 8 {
        assert(hashmap::hashmap_insert_metered(&map:ReadWrite, slot(1, i), &fill:ReadWrite)?);
        i = i + 1;
    }
    assert(fill.left == 0 && !fill.stopped && map.size == 8 && map.cap == 16);
    var equal: hashmap::ProbeBudget = hashmap::probe_budget(4);
    assert(hashmap::hashmap_lookup_metered(&map:Read, &arena:Read, 0, "b", &equal:ReadWrite) == 2);
    assert(equal.left == 0 && !equal.stopped);
    var unequal: hashmap::ProbeBudget = hashmap::probe_budget(3);
    assert(hashmap::hashmap_lookup_metered(&map:Read, &arena:Read, 0, "b", &unequal:ReadWrite) == 0);
    assert(unequal.stopped);
    var miss: hashmap::ProbeBudget = hashmap::probe_budget(1);
    assert(hashmap::hashmap_lookup_metered(&map:Read, &arena:Read, 12, "z", &miss:ReadWrite) == 0);
    assert(miss.left == 0 && !miss.stopped);
    // 48 步预扣、36 次迁移探测及 9 次新行探测；最后一步不足时保留旧表。
    var short: hashmap::ProbeBudget = hashmap::probe_budget(92);
    assert(!hashmap::hashmap_insert_metered(&map:ReadWrite, slot(1, 9), &short:ReadWrite)?);
    assert(short.stopped && short.left == 0 && map.cap == 16 && map.size == 8);
    assert(hashmap::hashmap_lookup(&map:Read, &arena:Read, 0, "b") == 2);
    var exact: hashmap::ProbeBudget = hashmap::probe_budget(93);
    assert(hashmap::hashmap_insert_metered(&map:ReadWrite, slot(1, 9), &exact:ReadWrite)?);
    assert(!exact.stopped && exact.left == 0 && map.cap == 32 && map.size == 9);
    assert(hashmap::hashmap_lookup(&map:Read, &arena:Read, 0, "b") == 2);
    return;
}

function main(): void {
    small_map()?;
    let src: &[u8] = "a #a @drop _\n";
    let batch: lex::LexResult = lex::lex_scan(src, 119u16)?;
    let exact: lex::LexResult = lex::lex_scan_budgeted(src, 119u16, 4u32, 4u32, 19u64)?;
    assert(exact.resource_status == 0u8 && @len(exact.tokens) == @len(batch.tokens));
    assert(@len(exact.names.entries) == 1 && exact.names.entries[0].hash == batch.names.entries[0].hash);
    var i: u64 = 0;
    while i < @len(batch.tokens) {
        assert(exact.tokens[i].kind == batch.tokens[i].kind && exact.tokens[i].payload == batch.tokens[i].payload);
        assert(exact.tokens[i].span.offset == batch.tokens[i].span.offset && exact.tokens[i].span.length == batch.tokens[i].span.length);
        i = i + 1;
    }
    let stopped: lex::LexResult = lex::lex_scan_budgeted(src, 119u16, 4u32, 4u32, 18u64)?;
    assert(lex::lex_intern_limit_exceeded(stopped.resource_status));
    assert(@len(stopped.tokens) == 0 && @len(stopped.names.entries) == 0 && @len(stopped.names.arena.data) == 0);
    assert(stopped.names.hash_map.cap == 0 && @len(stopped.diagnostics) == 0);
}
