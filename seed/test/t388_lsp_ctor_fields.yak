import buf;
import lex;
import diag;
import pipeline;
import consteval;
import typecheck;
import typecheck_driver;
import typecheck_body;
import typecheck_shape;
import parse;
import resolve_refs;
import resolve_unit;
foreign assert(cond: bool): void;


// 用逐步增长的配额检查每次停点，不足时不得返回部分类型表。
function small_steps(src: &[u8], steps: u32, rows: u32, document: bool): void!AllocError {
    let lexed: lex::LexResult = lex::lex_scan(src, 111u16)?;
    let parsed: parse::ParseResult = parse::parse_lexed(&lexed:Read, 111u16)?;
    assert(@len(lexed.diagnostics) == 0 && @len(parsed.diagnostics) == 0);
    var name_diags: diag::DiagBuffer = diag::diagbuf_new();
    let deps: resolve_refs::DependencySet = resolve_refs::DependencySet { ifaces: [] };
    let res: resolve_refs::Resolution = resolve_unit::resolve_unit(&parsed.file:Read, &parsed.pool:Read, &lexed.names:Read, &deps:Read, "", &name_diags:ReadWrite)?;
    assert(name_diags.count == 0u32);
    var limit: u32 = 1u32;
    while limit <= steps {
        var diags: diag::DiagBuffer = diag::diagbuf_new();
        var intern: typecheck::InternBudget = typecheck::intern_budget(0u32);
        var lookup: consteval::InitLookupBudget = consteval::init_lookup_budget(0u32);
        var material: consteval::MaterialBudget = consteval::material_budget(0u32);
        var fold: consteval::FoldBudget = consteval::fold_budget(0u32);
        var probe: consteval::FoldBudget = consteval::fold_budget(0u32);
        var scan: typecheck_driver::IntegerScanBudget = typecheck_driver::integer_scan_budget(0u32);
        var shape: typecheck_shape::BodyInferenceBudget = typecheck_shape::body_inference_budget(0u32, 0u32, limit, 0u32, 0u32, 0u32, 0u32);
        let checked: typecheck::TypeCheckResult = typecheck_driver::typecheck_unit_with_body_budget(&parsed.file:Read, &parsed.pool:Read, &res:Read, &diags:ReadWrite, &intern:ReadWrite, &lookup:ReadWrite, &material:ReadWrite, &fold:ReadWrite, &probe:ReadWrite, &scan:ReadWrite, &shape:ReadWrite, document)?;
        assert(typecheck_shape::body_ctor_exceeded(&shape:Read) == (limit < steps));
        if limit < steps && limit + rows > steps { assert(shape.ctor_remaining == limit - (steps - rows)); }
        else { assert(shape.ctor_remaining == 0u32); }
        assert(diags.count == 0u32);
        if limit < steps { assert(@len(checked.expr_types.items) == 0); }
        else { assert(@len(checked.expr_types.items) == @len(parsed.pool.exprs)); }
        limit = limit + 1u32;
    }
    return;
}

function boundary(src: &[u8], over: bool, bad: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    if bad { buf::buf_push_bytes(&text:ReadWrite, "function broken(): void { let n: bool = 1u32; if n { return; } }\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, src)?;
    let input: &[u8] = &text.data[0..text.pos]:Read;
    let checked: pipeline::DocumentAnalysis = pipeline::run_document_frontend(input, 114u16)?;
    if over {
        assert(pipeline::analysis_ctor_fields_exceeded(checked.status));
        assert(checked.diagnostics.count == 0u32 && !checked.diagnostics.truncated);
    } elseif bad {
        assert(checked.diagnostics.count == 1u32 && checked.diagnostics.diags[0].code.raw == 5001u16);
    } else {
        assert(pipeline::analysis_checked(checked.status) && checked.diagnostics.count == 0u32);
    }
    var batch: diag::DiagBuffer = diag::diagbuf_new();
    let accepted: bool = pipeline::run_frontend(input, 114u16, &batch:ReadWrite)?;
    assert(accepted == !bad);
    if bad { assert(batch.count == 1u32 && batch.diags[0].code.raw == 5001u16); }
    else { assert(batch.count == 0u32); }
    return;
}

function run_boundary(over: bool, bad: bool): void!AllocError {
    var text: buf::ByteBuf = buf::buf_new();
    buf::buf_push_bytes(&text:ReadWrite, "struct B { a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32 }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "struct A { a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32, a8: u32, a9: u32, a10: u32, a11: u32, a12: u32, a13: u32, a14: u32, a15: u32, a16: u32, a17: u32, a18: u32, a19: u32, a20: u32, a21: u32, a22: u32, a23: u32, a24: u32, a25: u32, a26: u32, a27: u32, a28: u32, a29: u32 }\n")?;
    if over { buf::buf_push_bytes(&text:ReadWrite, "struct Pad { a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32, a8: u32, a9: u32 }\n")?; }
    else { buf::buf_push_bytes(&text:ReadWrite, "struct Pad { a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32, a8: u32 }\n")?; }
    buf::buf_push_bytes(&text:ReadWrite, "function small(): B { return B { a0: 0u32, a1: 0u32, a2: 0u32, a3: 0u32, a4: 0u32, a5: 0u32, a6: 0u32, a7: 0u32 }; }\n")?;
    buf::buf_push_bytes(&text:ReadWrite, "function large(): A { return A { a0: 0u32, a1: 0u32, a2: 0u32, a3: 0u32, a4: 0u32, a5: 0u32, a6: 0u32, a7: 0u32, a8: 0u32, a9: 0u32, a10: 0u32, a11: 0u32, a12: 0u32, a13: 0u32, a14: 0u32, a15: 0u32, a16: 0u32, a17: 0u32, a18: 0u32, a19: 0u32, a20: 0u32, a21: 0u32, a22: 0u32, a23: 0u32, a24: 0u32, a25: 0u32, a26: 0u32, a27: 0u32, a28: 0u32, a29: 0u32 }; }\n")?;
    boundary(&text.data[0..text.pos]:Read, over, bad)?;
    return;
}

function main(): void {
    // 兼容入口仍预扣整表；文档二分两端后复用区间，不另扫计数。
    let two: &[u8] = "struct S { a: u32, b: u32 } function f(): S { return S { a: 1u32, b: 2u32 }; }\n";
    small_steps(two, 8u32, 2u32, false)?;
    small_steps(two, 9u32, 0u32, true)?;
    // 两个函数共享余额；单字段构造各用两次比较、一个初始化槽和一个字段行。
    let shared: &[u8] = "struct S { a: u32 } function f(): S { return S { a: 1u32 }; } function g(): S { return S { a: 2u32 }; }\n";
    small_steps(shared, 6u32, 1u32, false)?;
    small_steps(shared, 8u32, 0u32, true)?;
    run_boundary(false, false)?;
    run_boundary(true, false)?;
    run_boundary(true, true)?;
    run_boundary(false, true)?;
    return;
}
