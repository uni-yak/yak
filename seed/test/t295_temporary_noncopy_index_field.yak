// mem_limit: 500000
foreign assert(cond: bool): void;
struct Inner { value: u32, data: u32[] }
struct Item { inner: Inner }
enum Failure { Bad }
function items(ok: bool, count: &u32:ReadWrite): Item[]!Failure {
    *count = *count + 1u32;
    if !ok { return Failure::Bad; }
    return [Item { inner: Inner { value: 42u32, data: [1u32, 2u32] } }];
}
function index(ok: bool, count: &u32:ReadWrite): u32!Failure {
    assert(*count % 2u32 == 0u32);
    *count = *count + 1u32;
    if !ok { return Failure::Bad; }
    return 0u32;
}
function read(base_ok: bool, index_ok: bool, count: &u32:ReadWrite): u32!Failure {
    return (items(base_ok, count)?)[index(index_ok, count)?].inner.value;
}
function recover(e: &Failure): u32 { return 99u32; }
function fixed(): [Item; 1] { return [Item { inner: Inner { value: 17u32, data: [3u32] } }]; }
function main(): void {
    assert(fixed()[0u32].inner.value == 17u32);
    let held: [Item; 1] = fixed();
    assert((&held[0u32..1u32])[0u32].inner.value == 17u32);
    var count: u32 = 0u32;
    assert(read(false, true, &count:ReadWrite).catch(&recover) == 99u32);
    assert(count == 1u32);
    var i: u32 = 0u32;
    while i < 500u32 {
        assert(read(true, false, &count:ReadWrite).catch(&recover) == 99u32);
        assert(read(true, true, &count:ReadWrite).catch(&recover) == 42u32);
        i = i + 1u32;
    }
    assert(count == 2001u32);
}
