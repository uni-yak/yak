// t33: 递归 Fibonacci（中等深度）+ assert
foreign assert(cond: bool): void;

function fib(n: u32): u32 {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

function main(): void {
    let r: u32 = fib(10);
    assert(r == 55);
    assert(fib(0) == 0);
    assert(fib(1) == 1);
    assert(fib(5) == 5);
    return;
}
