// module: lsp_frontend_cases=lsp_frontend_cases.yak
import lsp_frontend_cases;

function main(): void {
    lsp_frontend_cases::compare("function f(): void { return missing; }\n", 43, false, 4002)?;
    lsp_frontend_cases::compare("function f(): u32 { return true; }\n", 44, false, 2005)?;
    lsp_frontend_cases::compare("struct Bad {}\n", 45, false, 5502)?;
    lsp_frontend_cases::compare("struct S { v: u32[] }\nfunction f(s: S, b: bool): void { if b { @drop(s); } @drop(s); }\n", 46, false, 6003)?;
    // 同名结构体的不同版本不能沿用分类；与批处理对拍完整诊断元组。
    lsp_frontend_cases::compare("struct S { v: u32 }\nfunction f(x: S): void { let y: S = @copy(x); @drop(y); @drop(x); }\n", 55, true, 0)?;
    lsp_frontend_cases::compare("struct S { v: u32[] }\nfunction f(x: S): void { let y: S = @copy(x); @drop(y); @drop(x); }\n", 55, false, 6202)?;
    // 注释和字面量不参与导入判断；只读文档也不要求存在 main。
    lsp_frontend_cases::compare("// import phantom;\nfunction size(a: &[u8]): u64 { return @len(a); }\nfunction f(): u64 { return size(\"import lib;\"); }\n", 43, true, 0)?;
}
