foreign assert(cond: bool): void;
struct Leaf { value: u32, owned: u32[] }
struct Item { data: Leaf[] }
function replace(items: &Item[]:ReadWrite, count: &u32:ReadWrite): u32 {
    *count = *count + 1u32;
    *items = [Item { data: [Leaf { value: 42u32, owned: [5u32] }] }];
    return 0u32;
}
function main(): void {
    var items: Item[] = [Item { data: [Leaf { value: 1u32, owned: [2u32] }] }];
    let ref: &Item[]:ReadWrite = &items:ReadWrite;
    var count: u32 = 0u32;
    assert(@copy(ref)[0u32].data[replace(ref, &count:ReadWrite)].value == 42u32);
    assert(count == 1u32);
}
