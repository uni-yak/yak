// 统计标准输入的 LF 字节；读、写、计数溢出分别退出 1、2、3。
import io;

function main(): void {
    var data: [u8; 24] = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                           0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                           0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    var count: u64 = 0;
    while true {
        let result: io::ReadResult = io::read(&data[0..24]:ReadWrite);
        if !result.ok { @exit(1u8); }
        if result.count == 0 { break; }
        var i: u32 = 0;
        while i < result.count {
            if data[i] == 10u8 {
                if count == 18446744073709551615u64 { @exit(3u8); }
                count = count + 1;
            }
            i = i + 1;
        }
    }

    // 输入读完后复用缓冲；u64 最多二十位，末尾另存一个 LF。
    data[23] = 10u8;
    var pos: u64 = 23;
    while pos == 23 || count != 0 {
        pos = pos - 1;
        data[pos] = 48u8 + ((count % 10) as u8);
        count = count / 10;
    }
    if !io::write(&data[pos..24]:Read) { @exit(2u8); }
}
