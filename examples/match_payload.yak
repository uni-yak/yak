// 臂载荷绑定：`Code(v)` 的 v 由 177 臂块载荷桩从枚举值中取出并写入隐式局部。
// 验收方式：链接后运行，pick(41) 必须返回 42。
foreign exit(code: u8): void;

enum E { Empty, Code(u32) }

function pick(x: u32): u32 {
    var e: E = E::Empty;
    if x != 0u32 { e = E::Code(x); }
    var r: u32 = 0u32;
    match e {
        Empty => { r = 7u32; },
        Code(v) => { r = v + 1u32; }
    }
    return r;
}

function main(): void {
    exit(pick(41u32) as u8);
    return;
}
