// expected_exit: 42
// spec: spec/lang/owner.md 6.1-6.2
// 验证块级正常落尾、continue 与带标签 break 均按退出作用域逆序析构局部动态数组且不重复释放。
// 注：seed 解释器拒绝带标签控制流，本案例经编译器产物验证。
foreign exit(code: u8): void;

function run(): void!AllocError {
    var outer_v: u64[] = [];
    @push(outer_v, 10u64)?;
    var i: u32 = 0;
    outer: while i < 2 {
        var loop_a: u32[] = [];
        @push(loop_a, 20u32)?;
        if i == 0 {
            var cont_v: u16[] = [];
            @push(cont_v, 30u16)?;
            i = 1;
            continue outer;
        }
        inner: while true {
            var inner_b: u8[] = [];
            @push(inner_b, 40u8)?;
            break outer;
        }
    }
    if i == 1 {
        var if_v: u8[] = [];
        @push(if_v, 2u8)?;
    }
    let code: u8 = (outer_v[0u64] + 32u64) as u8;
    exit(code);
    return;
}

function main(): void {
    let failed: void!AllocError = run();
    @drop(failed);
    exit(99u8);
    return;
}
