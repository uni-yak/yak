// expected_exit: 2
// spec: spec/lang/base.md 7.13、spec/lang/type/slice.md
// 定长数组的半开切片 [1..3)：切片长度为 2，经 @len 读取胖指针长度。
// 注：seed 解释器对定长数组切片求值缺失，本案例只能经编译器产物验证。
foreign exit(code: u8): void;

function main(): void {
    let data: [u32; 4] = [10u32, 20u32, 30u32, 40u32];
    let view: &[u32] = data[1..3];
    let n: u64 = @len(view);
    exit(n as u8);
    return;
}
