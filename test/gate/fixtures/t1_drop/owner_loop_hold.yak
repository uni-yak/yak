// 循环两迭代持有/消费：值在循环外取得，第二轮显式消费，循环后不得再次释放。
function loop_hold(): void!AllocError {
    var a: u32[] = [];
    @push(a, 121u32)?;
    var i: u32 = 0;
    while i < 2u32 {
        if i == 1u32 {
            @drop(a);
        }
        i = i + 1u32;
    }
    return;
}

function main(): void { loop_hold(); return; }
